          }
        }
      }
      int c0 = b0 + (((cc[0] - b0) * dens) >> 8), c1 = b1 + (((cc[1] - b1) * dens) >> 8), c2 = b2 + (((cc[2] - b2) * dens) >> 8);
      if (kind == 2) {                              // heavenly light: rays and a glow from behind the cross
        int q = ((lq[gx] * wx + lq[gx + 1] * fx) >> 4) + cloudGlowT[k > 127 ? 127 : k];
        if (q > 255) q = 255;
