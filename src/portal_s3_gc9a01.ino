        uint16_t c = woodPx((y - y0) * SCR_W + x);
        if (kind == 1 && ce <= 1) c = max565(c, to565raw(64, 42, 22));
        if (kind == 2 && ce <= 2) c = max565(c, ce == 1 ? to565raw(170, 156, 120) : to565raw(110, 100, 78));
        *p++ = c;
