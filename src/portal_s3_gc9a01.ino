// ---------- scenes: the portal and pictures shown in turn, with fades ----------
uint8_t sceneA = PORTAL, sceneB = PORTAL;
int     sceneMix = 0;                    // 0 = all scene A, 256 = all scene B
float   ageA = 0, ageB = 0;              // seconds since each scene started to appear

// ---------- each scene's own settings ----------
void grabLook(Look &L) {                 // the settings in use now
  L.radius = RADIUS; L.oval = OVAL; L.twist = TWIST; L.speed = SPEED; L.ripSpeed = RIP_SPEED; L.glow = GLOW_SIZE;
  L.core = COLOR_CORE; L.rim = COLOR_RIM; for (int k = 0; k < 4; k++) L.spaceCols[k] = SPACE_COLS[k];
  L.arms = ARMS; L.sparks = NUM_SPARKS; L.drift = DRIFT; L.bright = BRIGHTNESS; L.ripples = RIPPLES; L.stars = STARS; L.rimSmooth = RIM_SMOOTH; L.fadeOn = FADE_ON;
  L.style = STYLE; L.crossFill = CROSS_FILL; L.crossRipple = CROSS_RIPPLE; L.beam = BEAM; L.crossW = CROSS_W; L.bar = BAR;
  for (int j = 0; j < 4; j++) L.ripC[j] = RIP_C[j];
  L.rimW = RIM_W; L.crossOut = CROSS_OUT; L.crossCol = CROSS_COL;
}
void putLook(const Look &L) {
  RADIUS = L.radius; OVAL = L.oval; TWIST = L.twist; SPEED = L.speed; RIP_SPEED = L.ripSpeed; GLOW_SIZE = L.glow;
  COLOR_CORE = L.core; COLOR_RIM = L.rim; for (int k = 0; k < 4; k++) SPACE_COLS[k] = L.spaceCols[k];
  ARMS = L.arms; NUM_SPARKS = L.sparks; DRIFT = L.drift; BRIGHTNESS = L.bright; RIPPLES = L.ripples; STARS = L.stars; RIM_SMOOTH = L.rimSmooth; FADE_ON = L.fadeOn;
  STYLE = L.style; CROSS_FILL = L.crossFill; CROSS_RIPPLE = L.crossRipple; BEAM = L.beam; CROSS_W = L.crossW; BAR = L.bar;
  for (int j = 0; j < 4; j++) RIP_C[j] = L.ripC[j];
  RIM_W = L.rimW >= 25 && L.rimW <= 200 ? L.rimW : 100;   // (a cross scene: its cross is drawn as the main style)
  CROSS_OUT = validOut(L.crossOut) ? L.crossOut : 255;
  CROSS_COL = L.crossCol > 0xFFFFFF ? 0x1000000 : L.crossCol;
}
void useSceneLook(int id) {              // load a scene's settings (or the main ones) and rebuild what depends on them
  if (id == curLook) return;
  putLook(id < 0 ? mainLook : SCENE_LOOKS[id]);
  if (id == -3) { float pr = min(SCR_W, SCR_H) / 2 - 1; if (RADIUS > pr) RADIUS = pr; }   // the cross size would be too big for a portal
  if (spaceLUT) buildSpaceLUT();
  buildParams();
  buildPalette();
  resetSparks();
  curLook = id;
}
void saveScenes() {
  SceneSaved z; z.id = BUILD_ID ^ 0x5CE20007UL;   // (^: this layout of scene settings)
  for (int k = 0; k < 8; k++) { z.has[k] = SCENE_HAS[k]; z.look[k] = SCENE_LOOKS[k]; }
  EEPROM.put(128, z);
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.commit();
#endif
}
void saveExtra() {
  Extra x; x.id = BUILD_ID ^ 0xE7A00005UL; for (int j = 0; j < 4; j++) x.ripC[j] = RIP_C[j]; x.rimW = RIM_W; x.crossOut = CROSS_OUT; x.crossCol = CROSS_COL;
  EEPROM.put(EXTRA_AT, x);
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.commit();
#endif
}
void loadScenes() {                      // after loadSettings()
  { Extra x; EEPROM.get(EXTRA_AT, x); if (x.id == (BUILD_ID ^ 0xE7A00005UL)) { for (int j = 0; j < 4; j++) RIP_C[j] = x.ripC[j] & 0xFFFFFF; if (x.rimW >= 25 && x.rimW <= 200) RIM_W = x.rimW; if (validOut(x.crossOut)) CROSS_OUT = x.crossOut; CROSS_COL = x.crossCol > 0xFFFFFF ? 0x1000000 : x.crossCol; } }
  grabLook(mainLook); curLook = -1;
  SceneSaved z; EEPROM.get(128, z);
  if (z.id == (BUILD_ID ^ 0x5CE20007UL)) for (int k = 0; k < 8; k++) {
    const Look &L = z.look[k];
    bool ok = z.has[k] == 1 && L.radius >= 6 && L.radius <= RADIUS_MAX && L.oval >= 1 && L.oval <= 2 && L.arms >= 1 && L.arms <= 8 && L.twist >= 0 && L.twist <= 6 &&
              L.speed >= 0 && L.speed <= 0.4f && L.sparks <= MAX_SPARKS && L.bright >= 10 && L.bright <= 100 && L.stars >= 1 && L.stars <= 6 && L.ripples <= 6 &&
              L.ripSpeed >= 0.03f && L.ripSpeed <= 0.3f && L.glow >= 0.3f && L.glow <= 0.9f && L.rimSmooth <= 100 &&
              L.style <= 17 && validFill(L.crossFill) && L.crossRipple <= 10 && L.beam >= 5 && L.beam <= 30 && L.crossW >= 25 && L.crossW <= 100 && L.bar >= 20 && L.bar <= 50;
    SCENE_HAS[k] = ok; if (ok) SCENE_LOOKS[k] = L;
  }
  for (int k = 0; k < 8; k++) { pendHas[k] = SCENE_HAS[k]; pendLook[k] = SCENE_LOOKS[k]; }
}
inline int lookOf(int idx, uint8_t code) {
  if (idx >= 0 && idx < 8 && SCENE_HAS[idx] && isStyleScene(code)) return idx;   // its own settings
  if (isStyleScene(code) && !isCrossSt(code - 200) && isCrossSt(mainLook.style)) return -3;   // another style while the main one is a cross: portal-sized
  return -1;
}
void pickSceneLook() {                   // load the settings of the scene showing; scenes with different settings fade through black
  int ia = lookOf(idxA, sceneA), ib = lookOf(idxB, sceneB);
  dipK = 256;
  if (sceneMix > 0 && ia != ib) {
    if (sceneMix >= 128) { sceneA = sceneB; ageA = ageB; ia = ib; dipK = (sceneMix - 128) * 2; }
    else dipK = (128 - sceneMix) * 2;
    sceneB = sceneA; ageB = ageA; sceneMix = 0;
  } else if (sceneMix >= 128 && sceneA == sceneB) ia = ib;
  useSceneLook(ia);
  if (isStyleScene(sceneA) && isCrossSt(sceneA - 200)) sceneA = PORTAL;   // a cross scene: its cross is now the main style, so draw it as that
  if (isStyleScene(sceneB) && isCrossSt(sceneB - 200)) sceneB = PORTAL;   // (one with no settings of its own shows the main style)
}


const uint8_t TAP_STYLES[] = { 0, 1, 2, 3, 4, 6, 14, 15, 16 };   // styles a tap steps through (after your own)
const int TAP_N = sizeof(TAP_STYLES);

void onTap() {
#if TAP_PIN >= 0
  if (SCENE_COUNT >= 2 && !TAP_OFF) {    // tap for next scene: only a tap moves on
    if (tapCur != tapNext) tapCur = tapNext;                         // (still fading: finish that one first)
    tapNext = (tapCur + 1) % SCENE_COUNT; tapSceneAt = millis();
    return;
  }
#endif
  if (SCENE_COUNT >= 2) {                // scenes: go on to the next one now
    float per = HOLD_SECS + SCENE_FADE;
    float pos = fmodf((millis() + sceneShiftMs) / 1000.0f, per * SCENE_COUNT);
    float w = pos - min((int)(pos / per), SCENE_COUNT - 1) * per;
    sceneShiftMs += (uint32_t)(((w < HOLD_SECS && SCENE_FADE > 0 ? HOLD_SECS : per) - w) * 1000) + 1;   // holding: start the fade; fading: finish it
    return;
  }
  uint8_t own = SCENE_COUNT == 1 ? SCENES[0] : PORTAL;   // your own style (or your one scene)
  uint8_t shown = tapMode ? tapTo : own;
  int k = tapIdx;
  do { k = k + 1 >= TAP_N ? -1 : k + 1; } while (k >= 0 && TAP_STYLES[k] == STYLE && own == PORTAL);   // (skip the style already yours)
  tapIdx = k;
  tapFrom = shown; tapTo = k < 0 ? own : 200 + TAP_STYLES[k];
  tapAt = millis(); tapMode = true;
}

void updateScene() {
  static uint8_t tapSeen = 0;
  if (tapCount != tapSeen) { tapSeen = tapCount; onTap(); }
  if (tapMode && SCENE_COUNT < 2) {      // a style picked by tapping: a quick fade into it
    uint32_t el = millis() - tapAt;
    idxA = idxB = (SCENE_COUNT == 1 && tapTo == SCENES[0]) ? 0 : -1;
    if (tapFrom != tapTo) idxA = (SCENE_COUNT == 1 && tapFrom == SCENES[0]) ? 0 : -1;
    if (el >= 800) { sceneA = sceneB = tapTo; sceneMix = 0; idxA = idxB; ageA = ageB = el / 1000.0f + 1; if (tapIdx < 0) tapMode = false; }
    else { float f = el / 800.0f; f = f * f * (3 - 2 * f); sceneA = tapFrom; sceneB = tapTo; sceneMix = (int)(f * 256); ageA = el / 1000.0f + 1; ageB = el / 1000.0f; }
    return;
  }
  tapMode = false;
  if (SCENE_COUNT == 0) { sceneA = sceneB = PORTAL; sceneMix = 0; idxA = idxB = -1; return; }
  if (SCENE_COUNT == 1) { sceneA = sceneB = SCENES[0]; sceneMix = 0; ageA = millis() / 1000.0f; idxA = idxB = 0; return; }
#if TAP_PIN >= 0
  if (!TAP_OFF) {                        // tap for next scene: each scene stays until the screen is tapped
    if (tapCur >= SCENE_COUNT || tapNext >= SCENE_COUNT) tapCur = tapNext = 0;
    float el = (millis() - tapSceneAt) / 1000.0f;
    if (tapCur != tapNext && el >= 1) tapCur = tapNext;              // a one-second fade into the next scene
    sceneA = SCENES[tapCur]; sceneB = SCENES[tapNext]; idxA = tapCur; idxB = tapNext;
    ageA = el + 1; ageB = el;
    if (tapCur == tapNext) sceneMix = 0;
    else { float f = el * el * (3 - 2 * el); sceneMix = (int)(f * 256); }
    return;
  }
#endif
  float per = HOLD_SECS + SCENE_FADE;
  float pos = fmodf((millis() + sceneShiftMs) / 1000.0f, per * SCENE_COUNT);
  int i = min((int)(pos / per), SCENE_COUNT - 1);
  float w = pos - i * per;
  sceneA = SCENES[i];
  sceneB = SCENES[(i + 1) % SCENE_COUNT];
  idxA = i; idxB = (i + 1) % SCENE_COUNT;
  ageA = w + SCENE_FADE;                 // it began fading in during the previous scene
  ageB = max(0.0f, w - HOLD_SECS);
  if (w < HOLD_SECS || SCENE_FADE <= 0) sceneMix = 0;
  else { float f = (w - HOLD_SECS) / SCENE_FADE; f = f * f * (3 - 2 * f); sceneMix = (int)(f * 256); }
}

// "Portal around a picture": the picture shows through the portal's centre. When the scene
// starts, the portal forms at its outer edge and closes in until it covers FRAME_PCT.
inline bool isFramed(uint8_t s) { return s >= 128 && isPicture(s - 128); }

inline uint16_t mix565(uint16_t x, uint16_t y, int m) {
  int r  = ((x >> 11) * (256 - m) + (y >> 11) * m) >> 8;
  int g  = (((x >> 5) & 63) * (256 - m) + ((y >> 5) & 63) * m) >> 8;
  int bl = ((x & 31) * (256 - m) + (y & 31) * m) >> 8;
  return (r << 11) | (g << 5) | bl;
}

void framePicture(uint8_t pic, float age, int y0, int rows, uint16_t *dst) {
  static uint16_t line[SCR_WMAX];
  float close = SCENE_FADE + 1.5f;                            // seconds to close in (keeps going after the fade)
  float k = min(1.0f, age / close); k = k * k * (3 - 2 * k);
  float hole = RADIUS * (1.0f - FRAME_PCT / 100.0f * k);      // radius where the picture shows
  int16_t alpha[256];                                          // soft 8-pixel edge
  for (int r = 0; r < 256; r++) { float a = (hole + 4 - r) / 8.0f; alpha[r] = a <= 0 ? 0 : a >= 1 ? 256 : (int16_t)(a * 256); }
  for (int y = y0; y < y0 + rows; y++) {
    int qy = y < QY ? QY - 1 - y : y - QY;
    if (qy > hole + 4) continue;                                // this row is all portal
    readPicture(pic, y, 1, line);
    uint16_t *d = dst + (y - y0) * SCR_W;
    for (int x = 0; x < SCR_W; x++) {
      int m = alpha[rT[qy * TQX + colMap[x]]];
      if (m) d[x] = m == 256 ? line[x] : mix565(d[x], line[x], m);
    }
  }
}

HOT void dimStrip(uint16_t *a, int n, int k) {   // a = a * k / 256
  for (int i = 0; i < n; i++) { uint16_t x = a[i]; a[i] = ((((x >> 11) * k) >> 8) << 11) | (((((x >> 5) & 63) * k) >> 8) << 5) | (((x & 31) * k) >> 8); }
}
HOT void blendStrip(uint16_t *a, const uint16_t *b, int n, int m) {   // a = a + (b - a) * m / 256
  for (int i = 0; i < n; i++) a[i] = mix565(a[i], b[i], m);
}

void renderStrip(int y0, int rows, uint16_t *strip);
void useLook(int L, bool cross);
int  lookA = 0, lookB = 0;               // the style each scene draws (another style, or the main one)
bool crossA = false, crossB = false;     // and whether it's the main cross
uint8_t outLook = 255;                   // this frame: what's drawn outside a glowing cross (255: black)
inline bool isGridSpace(int L) { return L == 4 || (L >= 14 && L <= 16); }

HOT void drawScene(uint8_t s, float age, int y0, int rows, uint16_t *dst, int L, bool cross) {
  if (isPicture(s)) { readPicture(s, y0, rows, dst); return; }
  useLook(L, cross);
  renderStrip(y0, rows, dst);
  if (isFramed(s)) framePicture(s - 128, age, y0, rows, dst);
}

HOT void composeStrip(int y0, int rows, uint16_t *dst) {
  bool fading = sceneMix > 0 && sceneA != sceneB;
  if (!fading || !picBuf) {
    if (sceneMix >= 128) drawScene(sceneB, ageB, y0, rows, dst, lookB, crossB); else drawScene(sceneA, ageA, y0, rows, dst, lookA, crossA);
    if (dipK < 256) dimStrip(dst, rows * SCR_W, dipK);   // fading through black between scenes with their own settings
    return;
  }
  drawScene(sceneA, ageA, y0, rows, dst, lookA, crossA);
  uint16_t *fb = CORE_ID() && picBuf2 ? picBuf2 : picBuf;   // each core fades in its own buffer
  drawScene(sceneB, ageB, y0, rows, fb, lookB, crossB);
  blendStrip(dst, fb, rows * SCR_W, sceneMix);
}

// ---------- one frame ----------
uint8_t look = 0;                        // the style being drawn (crosses fall back to Vortex without flash storage)
extern bool woodOn; extern int woodPulse; void prepareWood();   // Wooden cross (below)
extern float cloudDrift; bool cloudMemory(); void prepareClouds(int kind, int amount); void prepareFullDay();
