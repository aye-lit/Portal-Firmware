void frameStart() {
  updateScene();
  if (havePending) {
    apply(pendingSettings);
    saveSettings();
    if (pendRip) { pendRip = false; for (int j = 0; j < 4; j++) RIP_C[j] = pendRipC[j]; saveExtra(); }
    if (pendRim) { pendRim = false; if (pendRimW != RIM_W) { RIM_W = pendRimW; saveExtra(); buildParams(); } }
    if (pendXout) { pendXout = false; if (pendOut != CROSS_OUT) { CROSS_OUT = pendOut; saveExtra(); } }
    if (pendXcol) { pendXcol = false; if (pendCol != CROSS_COL) { CROSS_COL = pendCol; saveExtra(); } }
    grabLook(mainLook); curLook = -1;      // the main settings are loaded now
    buildTone();
    if (spaceLUT) buildSpaceLUT();       // space colours go through the colour curve too
    buildParams();
    buildPalette();
    resetSparks();
    havePending = false;
  }
  if (scenePending) {                    // a scene's own settings changed
    scenePending = false;
    for (int k = 0; k < 8; k++) { SCENE_HAS[k] = pendHas[k]; SCENE_LOOKS[k] = pendLook[k]; }
    saveScenes();
    if (curLook >= 0) { int c = curLook; curLook = -2; useSceneLook(c); }   // showing one now: load its new settings
  }
  pickSceneLook();
#if TURNS
  if (wantPortrait != PORTRAIT) turnScreen(wantPortrait);
  if (wantFlip != FLIP) { FLIP = wantFlip; turnPending = true; }   // a half turn: the same size, the panel just faces the other way
#endif
  bool isCross = ((STYLE >= 8 && STYLE <= 13) || STYLE == 17) && curLook != -3;   // 17: Wooden cross (-3: another style is showing, sized as a portal: no cross needed)
  if (isCross && crossAvailable() && edgeBuf) prepareCross();
  crossOn = isCross && crossReady;
  woodOn = crossOn && STYLE == 17;
  look = crossOn ? CROSS_FILL : isCross ? 0 : STYLE;   // crosses: the chosen style is drawn inside (the Wooden cross: behind)
  if (crossOn && ((look >= 7 && look <= 10) || look == 18) && !woodOn) look = 0;   // the warm glow and the skies are only for the Wooden cross
  if (woodOn && look == 11) look = 7;                            // solid colour is for the glowing crosses
  if (woodOn) { prepareWood(); woodPulse = (int)(256 * (0.75f + 0.25f * sinf(millis() / 1000.0f * 1.3f))); }
  if (crossOn && !woodOn) buildCrossRipple(); else memset(crossRipT, 0, sizeof(crossRipT));
  if (woodOn && ((look >= 8 && look <= 10) || look == 18)) {           // a cloud sky (no room: the warm glow)
    if (cloudMemory()) { prepareClouds(look == 18 ? 1 : look - 8, look == 18 ? FD_CLOUDS : -1); if (look == 18) prepareFullDay(); } else look = 7;
  }
  bool baseCross = crossOn;
  int baseLook = look;
  lookA = isStyleScene(sceneA) ? sceneA - 200 : baseLook; crossA = !isStyleScene(sceneA) && baseCross;
  lookB = isStyleScene(sceneB) ? sceneB - 200 : baseLook; crossB = !isStyleScene(sceneB) && baseCross;
  bool needB = sceneMix > 0 && sceneA != sceneB;
  for (int k = 0; k < 2; k++) {                       // space styles: worked out per frame (no room: show the Vortex)
    int &L = k ? lookB : lookA;
    if (k && !needB && sceneMix < 128) break;
    if (L == 4 || (L >= 14 && L <= 16)) { look = L; if (spaceMemory()) prepareSpace(); else L = 0; }
  }
  if (!needB && sceneMix < 128) lookB = lookA;
  outLook = baseCross && !woodOn && validOut(CROSS_OUT) ? CROSS_OUT : 255;   // outside the glowing cross
  if (isGridSpace(outLook)) {                         // a space picture outside: only one space picture at a time
    bool other = (isGridSpace(lookA) && lookA != outLook) || (isGridSpace(lookB) && lookB != outLook);
    if (other) outLook = 255;
    else if (!isGridSpace(lookA) && !isGridSpace(lookB)) { look = outLook; if (spaceMemory()) prepareSpace(); else outLook = 255; }
  }
  {
    auto gridLook = [](int L) { return L == 4 || (L == 14 && !nebReady) || L == 16; };

    if (gridLook(lookA) || gridLook(lookB) || gridLook(outLook)) ringMemory(); else if (ringTried) freeRing();
  }
  look = lookA;
  crossOn = baseCross;
  spCY = crossOn ? crossYC : QY;
  updateColourFade();
  updateSparks();
  for (int a = 0; a < 256; a++) {                     // wobbly rim edge for this frame
    float ang = a * TWO_PI / 256;
    float wob = sinf(ang * 5 + t * 2) * 1.2f + sinf(ang * 3 - t * 3) * 0.8f;
    edgeT[a] = (int16_t)(RADIUS * (1 + wob * 0.025f * (1 - RIM_SMOOTH / 100.0f)));
  }
