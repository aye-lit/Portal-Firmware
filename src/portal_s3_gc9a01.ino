bool prepareNebula() {                  // once per frame while the Nebula shows (the slow part only the first time)
  nebHue = (int)(spaceT * 0.0198) & 63;  // colours move round the four space colours (about 2 minutes at the usual speed)
  if (!picPart || !planeMap || nPlanes < 4) return false;   // no room: the simpler Nebula
  uint32_t key = 2166136261UL;
  uint32_t parts[] = { (uint32_t)SCR_W, (uint32_t)SCR_H, 1 };
  for (uint32_t v : parts) key = (key ^ v) * 16777619UL;
