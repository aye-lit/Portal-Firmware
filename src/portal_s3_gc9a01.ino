      + ((((wave + 127) * 85 >> 8) * sbRingT[r]) >> 8)     // soft rings near the centre
      + ((((tex * 26) >> 7) * sbRingT[r]) >> 8)
      + ((((ray * 32) >> 7) * sbOuterT[r]) >> 8)            // rays toward the rim
      + ((ripCrestT[r] * (141 + ((sdp * 115) >> 7))) >> 8) - ripTroughT[r];   // expanding ripples
    if (v < 0) v = 0;
  }
  return v < 0 ? 0 : v;
}

inline uint16_t max565(uint16_t a, uint16_t b) {   // brighter of two colours, channel by channel
  return max(a & 0xF800, b & 0xF800) | max(a & 0x07E0, b & 0x07E0) | max(a & 0x001F, b & 0x001F);
}

// ---------- Ripple (glowing crosses): copies of the outline echo through the inside of the cross ----------
uint8_t crossRipT[128];                 // extra brightness by distance inside the cross edge, this frame
float   ripplePh = 0;
uint8_t  ripA[128];                     // how strongly each ring covers what's below
uint16_t ripC565[128];                  // Gradient ripple: each ring's colour by distance inside the cross edge
bool     ripColOn = false;
HOT inline uint16_t add565(uint16_t a, uint16_t b) {   // brighten a by b, channel by channel
  int r = (a >> 11) + (b >> 11), g = ((a >> 5) & 63) + ((b >> 5) & 63), bl = (a & 31) + (b & 31);
