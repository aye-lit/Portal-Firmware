// ---------- Nebula (14): worked out once in detail (wisps, haze, dust lanes) and kept in flash; it stays still while its colours cycle ----------
const uint32_t NEBH_MAGIC = 0x4842454EUL, NEBV_MAGIC = 0x5642454EUL;   // "NEBH", "NEBV"
