}
HOT void nebulaStrip(int y0, int rows, uint16_t *strip) {
  const uint8_t *H0 = planeMap + (nebHOff - planesOff) + 16, *V0 = planeMap + (nebVOff - planesOff) + 16;
  const int hs = nebHue, dens = 7 * STARS / 3, gapMax = dens > 0 ? max(2, 2048 / dens) : 0;
  uint16_t *p = strip;
  for (int y = y0; y < y0 + rows; y++) {
    const uint8_t *hr = H0 + (uint32_t)y * SCR_W, *vr = V0 + (uint32_t)y * SCR_W;
    uint32_t rs = hash32((uint32_t)y * 2654435761UL + 0x5bd1e995UL);
    int sx = gapMax ? (int)(rs % (uint32_t)gapMax) : SCR_W;
    for (int x = 0; x < SCR_W; x++) {
      int hi = (hr[x] + hs) & 63, vi = vr[x];
