uint16_t *xpal = pal;                     // what the cross outline is drawn with
bool xOwn = false;
void buildCrossPal() {                    // black -> the cross colour -> a lighter one -> near-white
  xOwn = CROSS_COL <= 0xFFFFFF; xpal = xOwn ? xPalOwn : pal;
  if (!xOwn) return;
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (CROSS_COL >> (16 - 8 * i)) & 0xFF; b[i] = a[i] + (255 - a[i]) * 35 / 100; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    xPalOwn[i] = to565(c[0], c[1], c[2]);
  }
}
void buildPalette() { buildPaletteFrom(COLOR_CORE, COLOR_RIM); buildCrossPal(); buildSpaceLUT(); }

void updateColourFade() {             // fade through the colour sets in order, FADE_SECS per fade
  if (!FADE_ON || FADE_COUNT < 1) return;
  int n = 1 + FADE_COUNT;              // main colours + extra sets
  float pos = fmodf(millis() / 1000.0f / FADE_SECS, (float)n);
  int i = (int)pos, j = (i + 1) % n;
  float f = pos - i;
  f = f * f * (3 - 2 * f);
  uint32_t coreA = i == 0 ? COLOR_CORE : FADE_COLS[(i - 1) * 2], rimA = i == 0 ? COLOR_RIM : FADE_COLS[(i - 1) * 2 + 1];
  uint32_t coreB = j == 0 ? COLOR_CORE : FADE_COLS[(j - 1) * 2], rimB = j == 0 ? COLOR_RIM : FADE_COLS[(j - 1) * 2 + 1];
  buildPaletteFrom(mixColor(coreA, coreB, f), mixColor(rimA, rimB, f));
}

// ---------- space helpers ----------
#if defined(ESP32)
  #define HOT IRAM_ATTR                  // the drawing loops run from the chip's own fast memory, not through the flash cache
#else
  #define HOT
#endif
static inline __attribute__((always_inline)) uint32_t hash32(uint32_t n) {   // (inline: it runs for every pixel of the space styles)
  n = (n ^ 61) ^ (n >> 16);
  n *= 9;
  n ^= n >> 4;
  n *= 0x27d4eb2dUL;
  n ^= n >> 15;
  return n;
}

int starAt(int a, int r) {             // one twinkling star per small patch of sky
  uint32_t h = hash32((uint32_t)((a >> 1) * 977 + (r >> 2) * 131));
  if ((int)(h & 63) >= STARS * 2) return 0;
  if ((a & 1) != (int)((h >> 8) & 1) || (r & 3) != (int)((h >> 10) & 3)) return 0;
  return 120 + ((sinT[((h >> 12) + (uint32_t)twinkle) & 255] + 127) >> 1);
}

// ---------- sparks ----------
void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS * 1.05 + random(0, (int)(RADIUS / 5) + 1);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}

float frameK = 1;                                        // how many Studio frames (1/28 s) the last frame took
void updateSparks() {
  float fall = powf(0.95f, frameK);
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= fall;                                         // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + RADIUS * 0.22)) * frameK;  // faster near the centre
    if (s.r < 3) respawn(s);
    sparkX[i] = (int16_t)floorf(QX + cosf(s.a) * s.r * OVAL);
    sparkY[i] = (int16_t)floorf((crossOn ? crossYC : QY) + sinf(s.a) * s.r);
  }
}

// ---------- saved settings (EEPROM) ----------
bool validOut(uint8_t f) { return f == 255 || f <= 4 || f == 6 || f == 11 || (f >= 14 && f <= 16); }   // what can go outside a glowing cross
bool validFill(uint8_t f) { return f <= 11 || (f >= 14 && f <= 16) || f == 18; }   // styles that can go inside a cross (Wooden cross only: 7 warm glow, 8 blue sky, 9 sunset, 10 heavenly light, 18 full day)

inline bool isStyleScene(uint8_t c) { return c >= 200 && c <= 217; }   // 200 + style: another style to fade into (crosses too)
inline bool isCrossSt(uint8_t st) { return (st >= 8 && st <= 13) || st == 17; }
inline bool validScene(uint8_t c) { return c == PORTAL || c < MAX_PICS || (c >= 128 && c < 128 + MAX_PICS) || isStyleScene(c); }

bool validScenes(const Saved &s) {
  if (s.sceneCount > 8 || !(s.holdSecs >= 1 && s.holdSecs <= 3600) || !(s.sceneFade >= 0 && s.sceneFade <= 600)) return false;
  if (s.framePct < 10 || s.framePct > 95) return false;
  if (s.crossW < 25 || s.crossW > 100 || s.beam < 5 || s.beam > 30 || s.bar < 20 || s.bar > 50) return false;
  for (int k = 0; k < 4; k++) if (s.spaceCols[k] > 0xFFFFFF) return false;
  if (!validFill(s.crossFill)) return false;
  if (s.crossRipple > 10) return false;   // (crosses: ripple 0-2; the Wooden cross: wood style 0-10)
  for (uint8_t i = 0; i < s.sceneCount; i++) {
    if (!validScene(s.scenes[i])) return false;
  }
  return true;
}

// ---------- tapping the screen ----------
volatile uint8_t tapCount = 0;           // taps seen (core 1 counts them, the frame code acts on them)
bool    tapMode = false;                 // showing a style picked by tapping
int8_t  tapIdx = -1;                     // which one (-1 = your own style or scene)
uint8_t tapFrom = 255, tapTo = 255;      // fading from / to
uint32_t tapAt = 0, sceneShiftMs = 0;    // when the tap fade began; how far taps have moved the scene clock
#if TAP_PIN >= 0
uint8_t  tapCur = 0, tapNext = 0;        // tap for next scene: the scene showing, and the one it's fading into
uint32_t tapSceneAt = 0;                 // when the last tap started that fade
#endif
#if TAP_PIN >= 0
void pollTap() {                         // the touch chip pulls its pin low while the screen is pressed
  static uint32_t lowSince = 0, highSince = 0;
  static bool down = false;
  if (TAP_OFF) return;                   // turned off in the Studio
  uint32_t now = millis() | 1;
  if (digitalRead(TAP_PIN) == LOW) {
    highSince = 0;
    if (!lowSince) lowSince = now;
    if (!down && now - lowSince >= 15) { down = true; tapCount++; }   // held a moment: a real press, not a blip
  } else {
    lowSince = 0;
    if (!highSince) highSince = now;
    if (down && now - highSince >= 150) down = false;                   // let go
  }
}
void beginTap() {                        // put the touch chip in its waiting mode, where its pin shows presses
  pinMode(TAP_CS, OUTPUT); digitalWrite(TAP_CS, HIGH);
  pinMode(PIN_CS, OUTPUT); digitalWrite(PIN_CS, HIGH);
  SPI.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE0));
  digitalWrite(TAP_CS, LOW); SPI.transfer(0x80); SPI.transfer(0); SPI.transfer(0); digitalWrite(TAP_CS, HIGH);
  SPI.endTransaction();
  pinMode(TAP_PIN, INPUT);
}
#else
inline void pollTap() {}
inline void beginTap() {}
#endif

bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4f && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF && s.bright >= 10 && s.bright <= 100 && s.style <= 17 && s.stars >= 1 && s.stars <= 6 && s.fadeCount >= 1 && s.fadeCount <= 3 && s.fadeSecs >= 1 && s.fadeSecs <= 3600 && s.rimSmooth <= 100 &&
         s.ripples <= 6 && s.ripSpeed >= 0.03f && s.ripSpeed <= 0.3f && s.glow >= 0.3f && s.glow <= 0.9f &&
         validScenes(s);
}

void apply(const Saved &s) {
  tapMode = false; tapIdx = -1;          // new settings: show them (not a style picked by tapping)
#if TAP_PIN >= 0
  tapCur = tapNext = 0;                  // tap for next scene: start again from the first scene
#endif
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim; BRIGHTNESS = s.bright; STYLE = s.style;
  RIPPLES = s.ripples; RIP_SPEED = s.ripSpeed; GLOW_SIZE = s.glow; STARS = s.stars;
  FADE_ON = s.fadeOn; FADE_COUNT = s.fadeCount; FADE_SECS = s.fadeSecs; RIM_SMOOTH = s.rimSmooth;
  for (int k = 0; k < 6; k++) FADE_COLS[k] = s.fadeCols[k] & 0xFFFFFF;
  SCENE_COUNT = s.sceneCount; HOLD_SECS = s.holdSecs; SCENE_FADE = s.sceneFade; FRAME_PCT = s.framePct;
  CROSS_W = s.crossW; BEAM = s.beam; BAR = s.bar;
  for (int k = 0; k < 8; k++) SCENES[k] = s.scenes[k];
  for (int k = 0; k < 4; k++) SPACE_COLS[k] = s.spaceCols[k];
  CROSS_FILL = s.crossFill;
  CROSS_RIPPLE = s.crossRipple;
#if TURNS
  wantPortrait = (s.portrait & 1) != 0;  // turned at the start of the next frame
  wantFlip = (s.portrait & 2) != 0;       // (and the other way round)
#endif
  TONE = s.tone <= 100 ? s.tone : 0;
  WARM = s.warm <= 100 ? s.warm : 0;
  TAP_OFF = s.tapOff == 1;               // (older saved settings: tapping stays on)
  if (s.fdLen >= 2 && s.fdLen <= 30 && s.fdStars <= 100 && s.fdClouds <= 100 && s.fdGlow >= 20 && s.fdGlow <= 150) {   // (older saved settings: Full day keeps its defaults)
    FD_LEN = s.fdLen; FD_STARCNT = s.fdStars; FD_CLOUDS = s.fdClouds; FD_GLOW = s.fdGlow;
  }
}

void loadSettings() {
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.begin(EE_SIZE);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void saveSettings() {
  Saved s = { BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM, BRIGHTNESS, STYLE, RIPPLES, RIP_SPEED, GLOW_SIZE, STARS, (uint8_t)FADE_ON, FADE_COUNT };
  for (int k = 0; k < 6; k++) s.fadeCols[k] = FADE_COLS[k];
  s.fadeSecs = FADE_SECS;
  s.rimSmooth = RIM_SMOOTH;
  s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
  s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
  for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
  for (int k = 0; k < 4; k++) s.spaceCols[k] = SPACE_COLS[k];
  s.crossFill = CROSS_FILL;
  s.crossRipple = CROSS_RIPPLE;
  s.portrait = (wantPortrait ? 1 : 0) | (wantFlip ? 2 : 0);
  s.tone = TONE;
  s.warm = WARM;
  s.tapOff = TAP_OFF;
  s.fdLen = FD_LEN; s.fdStars = FD_STARCNT; s.fdClouds = FD_CLOUDS; s.fdGlow = FD_GLOW;
  EEPROM.put(0, s);
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.commit();
#endif
}

Saved pendingSettings;

float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
uint8_t clampb(uint8_t v, uint8_t lo, uint8_t hi) { return v < lo ? lo : v > hi ? hi : v; }
void clampSettings(Saved &s) {
  s.radius = clampf(s.radius, 6, RADIUS_MAX); s.oval = clampf(s.oval, 1, 2); s.arms = clampb(s.arms, 1, 8);
  s.twist = clampf(s.twist, 0, 6); s.speed = clampf(s.speed, 0, 0.4f); if (s.sparks > MAX_SPARKS) s.sparks = MAX_SPARKS;
  s.core &= 0xFFFFFF; s.rim &= 0xFFFFFF; s.bright = clampb(s.bright, 10, 100); if (s.style > 17) s.style = 0;
  s.stars = clampb(s.stars, 1, 6); s.fadeCount = clampb(s.fadeCount, 1, 3); s.fadeSecs = clampf(s.fadeSecs, 1, 3600);
  if (s.rimSmooth > 100) s.rimSmooth = 100; if (s.ripples > 6) s.ripples = 6;
  s.ripSpeed = clampf(s.ripSpeed, 0.03f, 0.3f); s.glow = clampf(s.glow, 0.3f, 0.9f);
  for (int k = 0; k < 6; k++) s.fadeCols[k] &= 0xFFFFFF;
  for (int k = 0; k < 4; k++) s.spaceCols[k] &= 0xFFFFFF;
  if (s.sceneCount > 8) s.sceneCount = 8;
  s.holdSecs = clampf(s.holdSecs, 1, 3600); s.sceneFade = clampf(s.sceneFade, 0, 600); s.framePct = clampb(s.framePct, 10, 95);
  s.crossW = clampb(s.crossW, 25, 100); s.beam = clampb(s.beam, 5, 30); s.bar = clampb(s.bar, 20, 50);
  for (int k = 0; k < 8; k++) if (!validScene(s.scenes[k])) s.scenes[k] = PORTAL;
  if (!validFill(s.crossFill)) s.crossFill = 0;
  if (s.crossRipple > 10) s.crossRipple = 0;
  if (s.portrait > 3) s.portrait = 0;
  if (s.tone > 100) s.tone = 100;
  if (s.warm > 100) s.warm = 0;
}

// ---------- pictures (ESP32 boards: kept in the flash "spiffs" partition) ----------
// The Studio crops each picture to this screen, sends it as a small JPEG and the
// board unpacks it into flash. Tools -> Partition Scheme -> "No OTA (2MB APP/2MB SPIFFS)"
// gives the most room. Commands: INFO, IMG slot bytes id, D base64..., END.
// (HAS_PICS and the JPEG decoder are set up with the other #includes at the top)
bool    crossReady = false;               // cross outline ready to read (styles 8-13)
extern uint32_t woodPlaneKey, galFlashKey;
int8_t *edgeBuf = NULL;                   // one strip of the cross outline
uint8_t crossRimT[128], crossHaloT[128];  // rim and outer glow, sized to the beam

#if HAS_PICS
struct PicHead { uint32_t magic; uint16_t w, h; uint32_t id, check; };
const uint32_t PIC_MAGIC = 0x43495056UL;   // "VPIC"
const uint32_t STAGE_SIZE = 0x30000;       // room for one arriving JPEG (192 KB, enough for high quality on big screens)
const esp_partition_t *picPart = NULL;
uint32_t slotSize = 0, stageOff = 0;      // stageOff: where an arriving JPEG waits (last 64 KB)
uint32_t crossOff = 0, crossSize = 0, crossPlane = 0, woodOff = 0;   // the cross outline (distance to the edge for every pixel) and the wood in use
uint8_t  picSlots = 0;
#define MAX_PLANES 10                     // cross outlines and wood kept side by side, so scenes can switch crosses without rebuilding them
uint8_t  nPlanes = 0;
uint32_t planesOff = 0;                   // the first one (they sit just before the staging area)
uint32_t planeMagic[MAX_PLANES], planeKeyOf[MAX_PLANES], planeUse[MAX_PLANES], planeTick = 0;
int8_t   crossSlot = -1, woodSlot = -1;   // the ones in use now
int8_t   nebHSlot = -1, nebVSlot = -1;   // the Nebula's colour and brightness planes
volatile uint32_t picId[MAX_PICS];        // 0 = empty slot
uint16_t picW[MAX_PICS];                  // the width each picture was made for (the screen may have been turned since)
volatile bool uploading = false;
uint32_t upLen = 0, upPos = 0, upId = 0, upLast = 0, jpgPos = 0;
uint8_t  upSlot = 0;
uint16_t *band = NULL;
int      bandTop = 0;

void mapPlanes();
void beginPictures() {
  picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_SPIFFS, NULL);
  if (!picPart) picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_FAT, NULL);
  if (!picPart || picPart->size < 0x80000) { picPart = NULL; return; }
  slotSize = (sizeof(PicHead) + (uint32_t)SCR_W * SCR_H * 2 + 4095) & ~4095UL;
  stageOff = (picPart->size - STAGE_SIZE) & ~4095UL;
  crossPlane = (16 + (uint32_t)SCR_W * SCR_H + 4095) & ~4095UL;
  crossSize = crossPlane;
  {                                        // room for several cross outlines (and wood), keeping at least 5 pictures where possible
    uint32_t room = stageOff, keepPics = min((uint32_t)5, room / slotSize);
    uint32_t n = (room - keepPics * slotSize) / crossPlane;
    if (n < 1) { n = 1; }
    nPlanes = min((uint32_t)MAX_PLANES, n);
  }
  planesOff = stageOff - nPlanes * crossPlane;
  crossOff = woodOff = planesOff;
  picSlots = min((uint32_t)MAX_PICS, planesOff / slotSize);
  for (uint8_t i = 0; i < nPlanes; i++) {   // what each one holds
    uint32_t h[4]; esp_partition_read(picPart, planesOff + (uint32_t)i * crossPlane, h, 16);
    planeMagic[i] = h[0]; planeKeyOf[i] = h[1]; planeUse[i] = 0;
  }
  for (uint8_t i = 0; i < picSlots; i++) {
    PicHead h;
    esp_partition_read(picPart, i * slotSize, &h, sizeof(h));
    bool ok = h.magic == PIC_MAGIC && (uint32_t)h.w * h.h == (uint32_t)SCR_W * SCR_H && h.id && h.check == (h.id ^ 0xA5A5A5A5UL);
    picId[i] = ok ? h.id : 0;
    picW[i] = h.w;
  }
  mapPlanes();                             // the cross and wood strips are read through the flash cache
}

int  picturesAvailable() { return picSlots; }
bool isPicture(uint8_t s) { return s < picSlots && picId[s] != 0 && picW[s] == SCR_W; }

void readPicture(uint8_t s, int y0, int rows, uint16_t *dst) {
  esp_partition_read(picPart, s * slotSize + sizeof(PicHead) + (uint32_t)y0 * SCR_W * 2, dst, (uint32_t)rows * SCR_W * 2);
}

bool pausedForUpload() {
  if (uploading && millis() - upLast > 10000) uploading = false;   // the Studio went away mid-picture
  if (uploading) delay(1);
  return uploading;
}

int b64(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
  if (c >= '0' && c <= '9') return c - '0' + 52;
  if (c == '+') return 62;
  if (c == '/') return 63;
  return -1;
}

int unbase64(const char *in, uint8_t *out) {   // returns bytes written, -1 on bad data
  int n = 0, bits = 0;
  uint32_t acc = 0;
  for (; *in && *in != '='; in++) {
    int v = b64(*in);
    if (v < 0) return -1;
    acc = (acc << 6) | v; bits += 6;
    if (bits >= 8) { bits -= 8; out[n++] = (acc >> bits) & 0xFF; }
  }
  return n;
}

UINT jpgIn(JDEC *jd, BYTE *buf, UINT n) {        // JPEG bytes come from the staging area
  if (n > upLen - jpgPos) n = upLen - jpgPos;
  if (buf) esp_partition_read(picPart, stageOff + jpgPos, buf, n);
  jpgPos += n;
  return n;
}

UINT jpgOut(JDEC *jd, void *bmp, JRECT *r) {     // one block of pixels: collect a band, then store it
  BYTE *c = (BYTE *)bmp;
  for (int y = r->top; y <= r->bottom; y++)
    for (int x = r->left; x <= r->right; x++, c += 3)
      band[(y - bandTop) * SCR_W + x] = to565(c[0], c[1], c[2]);
  if (r->right == SCR_W - 1) {
    esp_partition_write(picPart, upSlot * slotSize + sizeof(PicHead) + (uint32_t)bandTop * SCR_W * 2,
                        band, (uint32_t)(r->bottom - bandTop + 1) * SCR_W * 2);
    bandTop = r->bottom + 1;
  }
  return 1;
}

const char *finishPicture() {
  uploading = false;
  if (upPos != upLen) return "ERR incomplete";
  static uint8_t pool[3100];               // the JPEG decoder's work area
  JDEC jd;
  jpgPos = 0;
  if (jd_prepare(&jd, jpgIn, pool, sizeof(pool), NULL) != JDR_OK) return "ERR jpeg";
  if (jd.width != SCR_W || jd.height != SCR_H) return "ERR size";
  band = (uint16_t *)malloc(SCR_W * 16 * 2);
  if (!band) return "ERR memory";
  esp_partition_erase_range(picPart, upSlot * slotSize, slotSize);
  bandTop = 0;
  JRESULT r = jd_decomp(&jd, jpgOut, 0);
  free(band); band = NULL;
  if (r != JDR_OK) return "ERR jpeg";
  PicHead h = { PIC_MAGIC, SCR_W, SCR_H, upId, upId ^ 0xA5A5A5A5UL };
  esp_partition_write(picPart, upSlot * slotSize, &h, sizeof(h));
  picId[upSlot] = upId;
  picW[upSlot] = SCR_W;
  return "OK";
}

// ---------- cross shapes (styles 8-13), from the Cross Portal Tuner ----------
// Each cross is a union of simple shapes around its junction (the screen centre). The board works out
// the distance to the cross edge for every pixel once, stores it in flash, and reads it back per strip.
struct XShape { uint8_t t, dir; float cx, cy, hw, hh, r, w, a, b, len; };   // t: 0 box, 1 circle, 2 ring, 3 tilted box, 4 flared arm
XShape xs[6];
uint8_t nxs = 0;
const uint32_t CROSS_MAGIC = 0x52435856UL;   // "VXCR"
uint32_t crossKey = 0;

void addX(uint8_t t, float cx, float cy, float hw, float hh, float r = 0, float w = 0, float a = 0, float b = 0, float len = 0, uint8_t dir = 0) {
  XShape &o = xs[nxs++];
  o.t = t; o.cx = cx; o.cy = cy; o.hw = hw; o.hh = hh; o.r = r; o.w = w; o.a = a; o.b = b; o.len = len; o.dir = dir;
}

void crossShapes() {
  float R = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100);   // never taller than the screen (the cross is centred)
  float bot = R, top = bot * BAR / (100.0f - BAR);
  float AW = max(2.0f, R * BEAM / 100.0f), HHL = max(AW + 1, min(R * CROSS_W / 100.0f, SCR_W / 2.0f - 2));
  nxs = 0;
  switch (STYLE - 8) {
    case 1:                                        // Celtic: ring around the junction
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(2, 0, 0, 0, 0, max(AW * 1.9f, 0.62f * min(HHL, top)), max(2.0f, AW * 0.42f));
      break;
    case 2: {                                      // Budded: round ends
      float br = AW * 1.45f;
      addX(0, 0, (bot - top) / 2, AW, (bot - br - (-top + br)) / 2); addX(0, 0, 0, HHL - br, AW);
      addX(1, 0, -top + br, 0, 0, br); addX(1, 0, bot - br, 0, 0, br);
      addX(1, -(HHL - br), 0, 0, 0, br); addX(1, HHL - br, 0, 0, 0, br);
      break;
    }
    case 3: case 4: {                              // Patriarchal / Orthodox: extra bars
      float th = AW * 0.85f, gap = min(AW * 3.4f, top - th - 2);
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(0, 0, -gap, HHL * 0.6f, th);
      if (STYLE == 12) addX(3, 0, bot * 0.62f, HHL * 0.55f, th, 0, 0, -0.35f);
      break;
    }
    case 5: {                                      // Pattee: flared arms
      float a = AW * 0.55f, b = AW * 1.75f;
      addX(0, 0, 0, a, a);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, top, 0); addX(4, 0, 0, 0, 0, 0, 0, a, b, bot, 1);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 2); addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 3);
      break;
    }
    default:                                       // Latin
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
  }
}

float sdBox(float x, float y, float cx, float cy, float hw, float hh) {
  float dx = fabsf(x - cx) - hw, dy = fabsf(y - cy) - hh;
  return hypotf(fmaxf(dx, 0), fmaxf(dy, 0)) + fminf(fmaxf(dx, dy), 0);
}

float crossSD(float x, float y) {               // signed distance: negative inside the cross
  float d = 1e9f;
  for (uint8_t i = 0; i < nxs; i++) {
    const XShape &o = xs[i];
    float e;
    switch (o.t) {
      case 0: e = sdBox(x, y, o.cx, o.cy, o.hw, o.hh); break;
      case 1: e = hypotf(x - o.cx, y - o.cy) - o.r; break;
      case 2: e = fabsf(hypotf(x, y) - o.r) - o.w; break;
      case 3: { float c = cosf(o.a), s = sinf(o.a), dx = x - o.cx, dy = y - o.cy; e = sdBox(c * dx + s * dy, -s * dx + c * dy, 0, 0, o.hw, o.hh); break; }
      default: {
        float u = o.dir == 0 ? -y : o.dir == 1 ? y : o.dir == 2 ? -x : x, v = o.dir < 2 ? x : y, k = (o.b - o.a) / o.len;
        float side = (fabsf(v) - (o.a + k * constrain(u, 0.0f, o.len))) / sqrtf(1 + k * k);
        e = fmaxf(side, fmaxf(-u, u - o.len));
      }
    }
    d = fminf(d, e);
  }
  return d;
}

bool crossAvailable() { return picPart != NULL; }

int crossShift() {                              // move the crossing up so the whole cross is centred on the screen
  float bot = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100), top = bot * BAR / (100.0f - BAR);
  return (int)lroundf((bot - top) / 2);
}

int findPlane(uint32_t magic, uint32_t key) {
  for (int i = 0; i < nPlanes; i++) if (planeMagic[i] == magic && planeKeyOf[i] == key) return i;
  return -1;
}
int freePlane() {                               // one to (re)build: never the cross or wood in use, otherwise the longest unused
  int best = -1;
  for (int i = 0; i < nPlanes; i++) {
    if (i == crossSlot || i == woodSlot || i == nebHSlot || i == nebVSlot) continue;
    if (best < 0 || planeUse[i] < planeUse[best]) best = i;
  }
  return best >= 0 ? best : (crossSlot == 0 && nPlanes > 1 ? 1 : 0);
}
void prepareCross() {                           // (re)build the outline when the cross settings change
  int shift = crossShift();
  crossYC = QY - shift;
  uint32_t key = 2166136261UL;
  uint32_t parts[] = { STYLE, (uint32_t)(RADIUS * 16), CROSS_W, BEAM, BAR, SCR_W, SCR_H, 2 };
  for (uint32_t v : parts) key = (key ^ v) * 16777619UL;
  if (key == crossKey && crossReady) return;
  crossReady = false;
  int slot = findPlane(CROSS_MAGIC, key);       // made before (another scene's cross): use it as it is
  bool build = slot < 0;
  if (build) { slot = freePlane(); if (slot == woodSlot) { woodSlot = -1; woodPlaneKey = 0; } }
  crossOff = planesOff + (uint32_t)slot * crossPlane; crossSlot = slot; planeUse[slot] = ++planeTick;
  float rw = max(1.5f, max(2.0f, min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100) * BEAM / 100.0f) * 0.18f);
  for (int k = 0; k < 128; k++) { crossRimT[k] = (uint8_t)(255 * expf(-(k / rw) * (k / rw))); crossHaloT[k] = (uint8_t)(115 * expf(-k / 12.0f)); }
  if (build) {
    planeMagic[slot] = 0;
    crossShapes();
    esp_partition_erase_range(picPart, crossOff, crossSize);
    static int8_t row[SCR_WMAX];
    for (int y = 0; y < SCR_H; y++) {
      float fy = y + 0.5f - crossYC;            // relative to the crossing
      for (int x = 0; x < SCR_W; x++) {
        float e = -crossSD(x + 0.5f - SCR_W / 2.0f, fy);
        if (e > 0 && e < 1) e = 1;
        if (e <= 0 && e > -1) e = -1;
        row[x] = (int8_t)constrain((int)e, -127, 127);
      }
      esp_partition_write(picPart, crossOff + 16 + (uint32_t)y * SCR_W, row, SCR_W);
      if ((y & 7) == 7) delay(1);
    }
    uint32_t h2[4] = { CROSS_MAGIC, key, 0, 0 };
    esp_partition_write(picPart, crossOff, h2, 16);
    planeMagic[slot] = CROSS_MAGIC; planeKeyOf[slot] = key;
  }
  crossKey = key;
  crossReady = true;
}

const uint8_t *planeMap = NULL;           // the cross outline and the wood, mapped into memory: read through the fast flash cache
esp_partition_mmap_handle_t planeH;
void mapPlanes() {
  const void *ptr;
  if (!planeMap && esp_partition_mmap(picPart, planesOff, stageOff + STAGE_SIZE - planesOff, ESP_PARTITION_MMAP_DATA, &ptr, &planeH) == ESP_OK) planeMap = (const uint8_t *)ptr;   // (the staging area too: the galaxy picture sits at its end)
}
void readCrossRows(int y0, int rows) {   // (mapped: nothing to copy, edgeRows() points straight at it)
  if (!planeMap) esp_partition_read(picPart, crossOff + 16 + (uint32_t)y0 * SCR_W, edgeBuf, (uint32_t)rows * SCR_W);
}
const int8_t *edgeRows(int y0) { return planeMap ? (const int8_t *)(planeMap + (crossOff - planesOff) + 16 + (uint32_t)y0 * SCR_W) : edgeBuf; }   // a strip of the cross outline (either core)
void readEdgeRow(int y, int8_t *dst) { esp_partition_read(picPart, crossOff + 16 + (uint32_t)y * SCR_W, dst, SCR_W); }
const uint32_t WOOD_MAGIC = 0x444F4F57UL;  // "WOOD"
bool woodPlaneReady(uint32_t key) {             // made before? then use it (otherwise pick a place to make it)
  int s = findPlane(WOOD_MAGIC, key), had = s >= 0;
  if (!had) { s = freePlane(); planeMagic[s] = 0; }
  woodSlot = s; woodOff = planesOff + (uint32_t)s * crossPlane; planeUse[s] = ++planeTick;
  return had;
}
void woodPlaneBegin() { esp_partition_erase_range(picPart, woodOff, crossPlane); }
void woodPlaneRow(int y, const uint8_t *row) { esp_partition_write(picPart, woodOff + 16 + (uint32_t)y * SCR_W, row, SCR_W); }
void woodPlaneEnd(uint32_t key) { uint32_t h[4] = { WOOD_MAGIC, key, 0, 0 }; esp_partition_write(picPart, woodOff, h, 16); planeMagic[woodSlot] = WOOD_MAGIC; planeKeyOf[woodSlot] = key; }
void readWoodRows(int y0, int rows, uint8_t *dst) {
  if (!planeMap) esp_partition_read(picPart, woodOff + 16 + (uint32_t)y0 * SCR_W, dst, (uint32_t)rows * SCR_W);
}
extern uint8_t *woodBuf;
const uint8_t *woodRows(int y0) { return planeMap ? planeMap + (woodOff - planesOff) + 16 + (uint32_t)y0 * SCR_W : woodBuf; }   // a strip of the wood (either core)

const char *pictureCommand(char *line) {
  if (strcasecmp(line, "INFO") == 0) {           // PICS slots width height id1 id2 ...
    static char info[128];
    int n = snprintf(info, sizeof(info), "PICS %u %u %u", picSlots, SCR_W, SCR_H);
    for (uint8_t i = 0; i < picSlots; i++) n += snprintf(info + n, sizeof(info) - n, " %lx", (unsigned long)(picW[i] == SCR_W ? picId[i] : 0));   // made the other way round: send again
    return info;
  }
  if (strncasecmp(line, "IMG ", 4) == 0) {       // start a picture: slot, JPEG size, picture id
    unsigned slot; unsigned long len, id;
    if (!picPart || sscanf(line + 4, "%u %lu %lx", &slot, &len, &id) != 3 || slot >= picSlots || !len || len > STAGE_SIZE || !id) return "ERR";
    picId[slot] = 0;                             // stop showing the old picture
    upSlot = slot; upLen = len; upId = id; upPos = 0;
    esp_partition_erase_range(picPart, stageOff, (len + 4095) & ~4095UL);   // only what this picture needs
    uploading = true; upLast = millis();
    galFlashKey = 0;                             // the galaxy picture shares this space: work it out again afterwards
    return "READY";
  }
  if (line[0] == 'D' && line[1] == ' ' && uploading) {   // a piece of the JPEG, in base64
    uint8_t data[200];
    int n = strlen(line + 2) <= 264 ? unbase64(line + 2, data) : -1;
    if (n < 0 || upPos + n > upLen) { uploading = false; return "ERR data"; }
    esp_partition_write(picPart, stageOff + upPos, data, n);
    upPos += n; upLast = millis();
    return "K";
  }
  if (strcasecmp(line, "END") == 0 && uploading) return finishPicture();
  return NULL;
}
