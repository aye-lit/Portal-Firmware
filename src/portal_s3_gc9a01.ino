    const int bdy = y - fdBodyY, nearRow = fdOn && fdBodyOn && bdy * bdy <= bR2o;   // rows the sun's (or moon's) disc crosses
    for (int x = 0; x < SCR_W; x++) {
      int ce = eb[x];
