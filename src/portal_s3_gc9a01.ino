  }
}

HOT void renderWoodStrip(int y0, int rows, uint16_t *strip, int phase, int phase2) {
  const uint8_t look = lk[CORE_ID()].look;
  if ((look >= 8 && look <= 10) || look == 18) { renderCloudStrip(y0, rows, strip); return; }   // a cloud sky behind the cross
  if (woodBuf) readWoodRows(y0, rows, woodBuf);
  const int8_t *edgeBuf = edgeRows(y0); const uint8_t *woodBuf = woodRows(y0);
  if (look == 4 || look >= 14) {                 // a space picture behind the cross
    renderSpaceStrip(y0, rows, strip);
    for (int y = y0, i = 0; y < y0 + rows; y++) for (int x = 0; x < SCR_W; x++, i++) {
      int ce = edgeBuf[i];
      if (ce > 0) strip[i] = woodPx(i);
      else if (-ce < 12) strip[i] = dim565(strip[i], woodShT[-ce]);
    }
    return;
  }
  uint16_t *p = strip;
  for (int y = y0; y < y0 + rows; y++) {
    const int8_t *eb = edgeBuf + (y - y0) * SCR_W;
    for (int x = 0; x < SCR_W; x++) {
      int ce = eb[x];
      if (ce > 0) {
        uint16_t c = woodPx((y - y0) * SCR_W + x);
        if (look == 7 && ce <= 3) c = max565(c, pal[min(255, ((3 - ce) * 60 * woodPulse) >> 8)]);   // warm light on the edge
        *p++ = c;
        continue;
      }
      int k = -ce, r, a, v;
      polarAt(x, y, crossYC, r, a);
      if (look == 7) { *p++ = glowPx(((woodGlowT[k] + woodWideT[r]) * woodPulse) >> 8, x, y); continue; }   // warm glow, slowly breathing (smooth, dithered)
      else {                                         // a portal behind the cross, centred on the crossing
        int e = edgeT[a];
        if (r < e) { v = styleV(look, a, r, phase, phase2); int kk = e - r; if (kk < 64 && rimT[kk] > v) v = rimT[kk]; }
        else { int kk = r - e; v = kk < 64 ? rimT[kk] : 0; int hh = haloT[kk > 255 ? 255 : kk]; if (hh > v) v = hh; }
        v = (((v * woodShT[k]) >> 8) * woodVigT[r]) >> 8;   // soft shadow around the wood, fading toward the edge
      }
      *p++ = pal[v > 255 ? 255 : v];
    }
  }
}

HOT void useLook(int L, bool cross) {        // the style and cross a scene draws with (set before each scene's strip)
  look = L;
  crossOn = cross;
  woodOn = cross && STYLE == 17;
  spCY = cross ? crossYC : QY;
  spU = L == 15 ? 118.0f / SP_EXT : 236.0f / min(SCR_W, SCR_H);
  spExt = SP_EXT * spU;
  SceneLook &k = lk[CORE_ID()];          // and this core's own copy
  k.look = L; k.cross = cross; k.wood = woodOn; k.spCY = spCY; k.spU = spU; k.spExt = spExt;
}

HOT void renderStrip(int y0, int rows, uint16_t *strip) {
  const SceneLook &LKc = lk[CORE_ID()]; const uint8_t look = LKc.look; const bool crossOn = LKc.cross, woodOn = LKc.wood;   // this core's style
  const int8_t *edgeBuf = edgeRows(y0);
  const int phase = (int)(t * 1.5f * 40.74f), phase2 = (int)(-t * 40.74f);
  uint16_t *p = strip;
  bool cross = crossOn;
  if (cross) readCrossRows(y0, rows);
  if (cross && woodOn) { renderWoodStrip(y0, rows, strip, phase, phase2); return; }
  if (look == 4 || look >= 14) {                   // Galaxy, Nebula, Wormhole, Meteor Shower (also inside a cross)
    renderSpaceStrip(y0, rows, strip);
    if (cross) crossMask(y0, rows, strip, look, phase, phase2);
    return;
  }
  const bool outPortal = cross && outLook != 255 && !isGridSpace(outLook), outSpace = cross && isGridSpace(outLook);
  if (outSpace) {                                  // a space picture outside the cross: drawn first, the cross goes over it
    SceneLook &K = lk[CORE_ID()]; SceneLook keep = K;
    K.look = outLook; K.spCY = crossYC; K.spU = outLook == 15 ? 118.0f / SP_EXT : 236.0f / min(SCR_W, SCR_H); K.spExt = SP_EXT * K.spU;
    renderSpaceStrip(y0, rows, strip);
    K = keep;
  }
  for (int y = y0; y < y0 + rows; y++) {
    int qy = y < QY ? QY - 1 - y : y - QY;
    bool low = y >= QY;
    const int8_t *eb = cross ? edgeBuf + (y - y0) * SCR_W : NULL;
    for (int x = 0; x < SCR_W; x++) {
      int qi = qy * TQX + colMap[x], r = rT[qi], a0 = aT[qi];
      int a = (x >= QX ? (low ? a0 : 256 - a0) : (low ? 128 - a0 : 128 + a0)) & 255;
      int e = edgeT[a];
      int v, rk = 0, gx = 0;
      if (eb) {                                        // Cross: the chosen style inside, glowing rim along the cross edge
        int ce = eb[x];
        if (ce > 0) {
          if (outLook != look) polarAt(x, y, crossYC, r, a);   // centred on the crossing (the same style behind the whole cross: one picture, centred on the screen)
          v = styleV(look, a, r, phase, phase2) + crossRipT[ce];   // Ripple rings on top of the fill
          if (xOwn) gx = crossRimT[ce]; else if (crossRimT[ce] > v) v = crossRimT[ce];   // (its own colour: the rim goes on top below)
          rk = ce;
        } else {
          int g = max(crossRimT[-ce], crossHaloT[-ce]);
          if (xOwn) { gx = g; v = 0; } else v = g;
          if (outPortal) { int ov = (styleV(outLook, a, r, phase, phase2) * OUT_DIM) >> 8; if (ov > v) v = ov; }   // a portal style outside (centred on the screen)
        }
      } else if (look == 7) {                                // Cartoon Sticker: ragged edge, light outline, no glow
        int jag = (((nz(nzB, 63, a * 4 + (phase >> 1)) - 128) * 7 + (nz(nzC, 255, a * 16 + phase) - 128) * 4) >> 7) * (100 - RIM_SMOOTH) / 100;
        int e2 = (int)(RADIUS * 1.02f + jag / 4.0f);
        v = r >= e2 ? 0 : r >= e2 - max(1, (int)lroundf(4 * RIM_W / 100.0f)) ? 235 : cartoonV(a, r, phase);   // outline: Rim thickness
      } else if (r < e) {
        v = styleV(look, a, r, phase, phase2);
        int k = e - r; if (k < 64 && rimT[k] > v) v = rimT[k];
      } else {
        int k = r - e; v = k < 64 ? rimT[k] : 0;       // rim
        int h = haloT[k > 255 ? 255 : k]; if (h > v) v = h;   // outer halo
      }
      uint16_t px = pal[v > 255 ? 255 : v];
      if (rk && ripColOn && ripA[rk]) px = mix565(px, ripC565[rk], ripA[rk]);   // Gradient ripple
      if (outSpace && !rk) px = max565(dim565(*p, OUT_DIM), px);              // the space picture outside, under the glow
      if (gx) px = max565(px, xpal[gx]);                                      // the cross outline in its own colour
      *p++ = px;
    }
  }
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {           // sparks in this strip
    if (look == 11) break;                             // a solid-colour cross has no sparks
    if (look == 5 && sparks[i].r < bhHole) continue;  // they vanish into the black hole
    for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
      int xx = sparkX[i] + dx, yy = sparkY[i] + dy;
      if (xx >= 0 && xx < SCR_W && yy >= y0 && yy < y0 + rows && !(cross && edgeBuf[(yy - y0) * SCR_W + xx] <= 0)) strip[(yy - y0) * SCR_W + xx] = pal[235];
    }
  }
}

// ---------- frame-rate readout (Serial Monitor, 115200 baud) ----------
uint32_t fpsFrames = 0, fpsSince = 0;
volatile uint32_t drawUs = 0, sendUs = 0;   // time spent working out the pixels and sending them to the screen
#if USE_DMA
extern bool lcdDma;
#endif
#if DUAL_CORE
extern volatile float helpShare; extern volatile bool sharing;
#endif
void countFrame() {
  fpsFrames++;
  uint32_t now = millis();
  if (now - fpsSince >= 5000) {
    Serial.print(F("FPS: "));
    Serial.print(fpsFrames * 1000.0f / (now - fpsSince), 1);
    Serial.print(F(" draw ")); Serial.print(drawUs / 1000.0f / fpsFrames, 1);
    Serial.print(F(" ms send ")); Serial.print(sendUs / 1000.0f / fpsFrames, 1); Serial.print(F(" ms"));
#if USE_DMA
    Serial.print(lcdDma ? F(" (dma") : F(" (no dma"));
#elif DUAL_CORE
    Serial.print(F(" ("));
#endif
#if DUAL_CORE
    Serial.print(F(", core 1 draws ")); Serial.print(sharing ? (int)(helpShare * 100 + 0.5f) : 0); Serial.print(F("%)"));
#endif
    Serial.println();
    fpsFrames = 0; drawUs = 0; sendUs = 0;
    fpsSince = now;
  }
}

#if USE_DMA
// ---------- DMA to the screen: the chip sends each strip by itself while the cores draw ----------
spi_device_handle_t lcdDev;
bool lcdDma = false;
spi_transaction_t lcdTr[2];
volatile int64_t lcdDoneAt[3];
int64_t lcdQueuedAt[2], lcdLastDone = 0;
void IRAM_ATTR lcdDoneCb(spi_transaction_t *t) { lcdDoneAt[(int)(intptr_t)t->user] = esp_timer_get_time(); }

bool lcdSend(const uint8_t *d, int n, bool dc, uint32_t waitMs) {   // a command byte (dc low) or its few data bytes (dc high)
  digitalWrite(PIN_DC, dc);
  spi_transaction_t t;
  memset(&t, 0, sizeof(t));
  t.length = n * 8; t.flags = SPI_TRANS_USE_TXDATA; t.user = (void *)2;
  memcpy(t.tx_data, d, n);
  if (spi_device_polling_start(lcdDev, &t, portMAX_DELAY) != ESP_OK) return false;   // (polling only accepts "wait as long as needed")
  return spi_device_polling_end(lcdDev, pdMS_TO_TICKS(waitMs)) == ESP_OK;
}

bool lcdWindow(uint32_t waitMs) {        // whole screen, then "write memory": the strips follow
  const uint8_t ca = 0x2A, ra = 0x2B, wr = 0x2C;
  const uint8_t x[4] = { 0, 0, (uint8_t)((SCR_W - 1) >> 8), (uint8_t)(SCR_W - 1) };
  const uint8_t y[4] = { 0, 0, (uint8_t)((SCR_H - 1) >> 8), (uint8_t)(SCR_H - 1) };
  if (!lcdSend(&ca, 1, false, waitMs) || !lcdSend(x, 4, true, waitMs)) return false;
  if (!lcdSend(&ra, 1, false, waitMs) || !lcdSend(y, 4, true, waitMs)) return false;
  if (!lcdSend(&wr, 1, false, waitMs)) return false;
  digitalWrite(PIN_DC, HIGH);
  lcdLastDone = esp_timer_get_time();
  return true;
}

bool lcdQueue(int b, int rows, uint32_t waitMs) {
  spi_transaction_t &t = lcdTr[b];
  memset(&t, 0, sizeof(t));
  t.length = SCR_W * rows * 16; t.tx_buffer = stripBuf[b]; t.user = (void *)(intptr_t)b;
  lcdQueuedAt[b] = esp_timer_get_time();
  return spi_device_queue_trans(lcdDev, &t, pdMS_TO_TICKS(waitMs)) == ESP_OK;
}

bool lcdFinish(int b, uint32_t waitMs) {   // wait for strip b to finish sending
  spi_transaction_t *r;
  if (spi_device_get_trans_result(lcdDev, &r, pdMS_TO_TICKS(waitMs)) != ESP_OK) return false;
  int64_t start = lcdQueuedAt[b] > lcdLastDone ? lcdQueuedAt[b] : lcdLastDone;
  sendUs += (uint32_t)(lcdDoneAt[b] - start);
  lcdLastDone = lcdDoneAt[b];
  return true;
}

bool beginDma() {                        // after the screen is set up: move its pins to the DMA driver, and check it works
  SPI.end();
  spi_bus_config_t bc;
  memset(&bc, 0, sizeof(bc));
  bc.mosi_io_num = PIN_MOSI; bc.miso_io_num = -1; bc.sclk_io_num = PIN_SCK; bc.quadwp_io_num = -1; bc.quadhd_io_num = -1;
  bc.max_transfer_sz = SCR_WMAX * STRIP * 2;
  if (spi_bus_initialize(SPI2_HOST, &bc, SPI_DMA_CH_AUTO) != ESP_OK) return false;
  spi_device_interface_config_t dc;
  memset(&dc, 0, sizeof(dc));
  dc.clock_speed_hz = SPI_HZ; dc.mode = 0; dc.spics_io_num = -1; dc.queue_size = 3; dc.post_cb = lcdDoneCb;
  dc.flags = SPI_DEVICE_HALFDUPLEX | SPI_DEVICE_NO_DUMMY;
  if (spi_bus_add_device(SPI2_HOST, &dc, &lcdDev) != ESP_OK) { spi_bus_free(SPI2_HOST); return false; }
  pinMode(PIN_CS, OUTPUT); digitalWrite(PIN_CS, LOW);   // the screen is the only thing listening on these pins
  if (!lcdWindow(100)) return false;
  memset(stripBuf[0], 0, SCR_WMAX * STRIP * 2);
  if (!lcdQueue(0, STRIP, 100) || !lcdFinish(0, 300)) return false;   // one strip of black: the DMA really runs
  sendUs = 0;
  return true;
}
#endif

#if DUAL_CORE
// Both cores draw: core 0 the top of each strip, core 1 the bottom (when the style allows), then core 1 sends it.
SemaphoreHandle_t readySem[2], freeSem[2], goSem[2], helperIdle;
volatile int stripY0[2], stripRows[2], stripHelp[2];   // the strip in each buffer, and how many of its bottom rows core 1 draws
volatile uint32_t wait0Us = 0, wait1Us = 0;           // time each core spent waiting for the other
volatile float helpShare = 0.3f;                       // part of each strip core 1 draws, balanced every frame
volatile bool sharing = false;

bool shareable(uint8_t s, int L, bool cross) {   // one scene: can both cores draw it at once?
  if (isFramed(s)) return false;                        // portal around a picture keeps one strip buffer
  if (cross && !planeMap) return false;                 // crosses: both cores read the outline and wood straight from mapped flash
  if (isPicture(s)) return true;
  return spX1 || !(L == 4 || L == 14 || L == 16) || (L == 14 && nebReady);       // Galaxy, Nebula and Meteor Shower need core 1's own gas grid (not the stored Nebula)
}

bool canShare() {                        // styles whose drawing can be split between the two cores
  if (sceneMix > 0 && sceneA != sceneB)                 // fading: both scenes on both cores (each core has its own fade buffer)
  {
    if (!picBuf2 && picBuf && STYLE != 17) picBuf2 = (uint16_t *)malloc(SCR_WMAX * STRIP * 2);   // (given back to the clouds earlier: take it again if there's room)
    return picBuf && picBuf2 && shareable(sceneA, lookA, crossA) && shareable(sceneB, lookB, crossB);
  }
  bool useB = sceneMix >= 128;
  uint8_t s = useB ? sceneB : sceneA;
  if (s != PORTAL && !isStyleScene(s)) return false;   // pictures
  return shareable(s, useB ? lookB : lookA, useB ? crossB : crossA);
}

inline void swapBytes565(uint16_t *p, int n) {   // DMA: the screen wants each pixel's high byte first
#if USE_DMA
  if (!lcdDma) return;
  uint32_t *w = (uint32_t *)p;
  for (int i = 0; i < n / 2; i++) { uint32_t v = w[i]; w[i] = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu); }
#endif
}

void balanceCores(uint32_t frameUs) {    // move rows toward whichever core is waiting
  if (sharing && frameUs > 0) {
    float d = ((float)wait1Us - (float)wait0Us) / frameUs, h = helpShare + 0.25f * d;
    helpShare = h < 0 ? 0 : h > 0.85f ? 0.85f : h;
  }
  wait0Us = 0; wait1Us = 0;
}

void renderTask(void *) {         // runs on core 0
  uint8_t b = 0;
  bool first = true;
  for (;;) {
    uint32_t w = micros();
    xSemaphoreTake(helperIdle, portMAX_DELAY);   // core 1 has finished its part of the last frame
    wait0Us += micros() - w;
    if (!first) frameEnd();
    first = false;
    frameStart();
    bool share = canShare();
    sharing = share;
    for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
      w = micros();
      xSemaphoreTake(freeSem[b], portMAX_DELAY);
      wait0Us += micros() - w;
      int rows = min(STRIP, SCR_H - y0), help = share ? (int)(rows * helpShare + 0.5f) : 0;
      if (help > rows - 1) help = rows - 1;
      stripY0[b] = y0; stripRows[b] = rows; stripHelp[b] = help;
      xSemaphoreGive(goSem[b]);
      uint32_t t0 = micros();
      composeStrip(y0, rows - help, stripBuf[b]);
      swapBytes565(stripBuf[b], SCR_W * (rows - help));
      drawUs += micros() - t0;
      xSemaphoreGive(readySem[b]);
      b ^= 1;
    }
    vTaskDelay(1);                // let core 0's housekeeping run
  }
}
#endif

// Big tables live on the heap so large screens fit next to Bluetooth
bool allocBuffers() {
  rT = (uint8_t *)malloc(TQX * TQY);
  aT = (uint8_t *)malloc(TQX * TQY);
  if (!rT || !aT) return false;
  const int first = STRIP;
  for (int withSpace = 1; withSpace >= 0; withSpace--) {   // try to make room for the space styles too, then without
    for (STRIP = first; STRIP >= (withSpace ? 4 : 2); STRIP /= 2) {   // smaller strips if memory is tight
#if USE_DMA
      stripBuf[0] = (uint16_t *)heap_caps_malloc(SCR_WMAX * STRIP * 2, MALLOC_CAP_DMA);
      stripBuf[1] = (uint16_t *)heap_caps_malloc(SCR_WMAX * STRIP * 2, MALLOC_CAP_DMA);
#else
      stripBuf[0] = (uint16_t *)malloc(SCR_WMAX * STRIP * 2);
      stripBuf[1] = (uint16_t *)malloc(SCR_WMAX * STRIP * 2);
#endif
      picBuf = picturesAvailable() ? (uint16_t *)malloc(SCR_WMAX * STRIP * 2) : NULL;   // for fades (pictures and other styles)
      edgeBuf = crossAvailable() ? (int8_t *)malloc(SCR_WMAX * STRIP) : NULL;            // for the cross styles
      bool space = !withSpace || spaceMemory();                                        // Galaxy, Nebula, Wormhole, Meteor Shower
      if (stripBuf[0] && stripBuf[1] && (picBuf || !picturesAvailable()) && (edgeBuf || !crossAvailable()) && space) return true;
      free(stripBuf[0]); free(stripBuf[1]); free(picBuf); free(edgeBuf); picBuf = NULL; edgeBuf = NULL;
      free(spH); free(spV); free(spX); free(spaceLUT); free(noise8); spH = spV = spX = NULL; spaceLUT = NULL; noise8 = NULL;
      free(spH1); free(spV1); free(spX1); spH1 = spV1 = spX1 = NULL;
      freeRing();
    }
  }
  return false;
}

void setup() {
#if defined(ESP32)
  Serial.setRxBufferSize(1024);          // room for picture data
#endif
  Serial.begin(115200);
  delay(300);
  Serial.println(F("[portal] starting"));
  beginBus();
  tft.begin(SPI_HZ);
  tft.fillScreen(0);
  beginTap();
  Serial.println(F("[portal] screen ready"));
#if HAS_BLE
  beginBluetooth();                      // Bluetooth first: it needs one big block of memory
  Serial.println(F("[portal] bluetooth ready"));
#endif
  beginPictures();
  bool bufsOk = allocBuffers();
#if DUAL_CORE
  if (bufsOk && picBuf) picBuf2 = (uint16_t *)malloc(SCR_WMAX * STRIP * 2);   // optional: smoother fades
#endif
  if (!bufsOk) {
    tft.setTextColor(0xFFFF); tft.setTextSize(2); tft.setCursor(10, SCR_H * PX / 2 - 8); tft.print(F("Not enough memory"));   // say so on the screen too
    for (;;) { Serial.println(F("[portal] not enough memory for this screen")); delay(2000); }
  }
#if defined(ESP32)
  Serial.printf("[portal] memory ok, %u bytes free, %d rows per strip, room for %d pictures, space styles %s\n", (unsigned)ESP.getFreeHeap(), STRIP, picturesAvailable(), spaceLUT ? "ready" : "off (not enough memory)");
#endif
  loadSettings();
  loadScenes();
  buildTone();
  if (spaceLUT) buildSpaceLUT();
#if TURNS
  if (wantPortrait != PORTRAIT || wantFlip != FLIP) {   // saved turned another way
    setSize(wantPortrait); FLIP = wantFlip;
    tft.setRotation(rotNow());
    tft.fillScreen(0);
  }
#endif
  randomSeed(micros());
  buildGeometry();
  buildParams();
  buildPalette();
  resetSparks();
#if USE_DMA
  lcdDma = beginDma();
  if (!lcdDma) { beginBus(); tft.setSPISpeed(SPI_HZ); }   // DMA didn't answer: back to the Arduino way
  Serial.println(lcdDma ? F("[portal] screen DMA on") : F("[portal] screen DMA off"));
#endif
#if DUAL_CORE
  for (int i = 0; i < 2; i++) {
    readySem[i] = xSemaphoreCreateBinary();
    freeSem[i] = xSemaphoreCreateBinary();
    goSem[i] = xSemaphoreCreateBinary();
    xSemaphoreGive(freeSem[i]);
  }
  helperIdle = xSemaphoreCreateBinary();
  xSemaphoreGive(helperIdle);
  xTaskCreatePinnedToCore(renderTask, "portal", 4096, NULL, 1, NULL, 0);
#endif
  Serial.println(F("[portal] running"));
}

#if PX > 1
uint16_t pxLine[SCR_WMAX * PX];                // one screen row, each drawn pixel repeated PX times
void sendStrip(uint16_t *buf, int rows) {
  for (int r = 0; r < rows; r++) {
    const uint16_t *src = buf + r * SCR_W;
    for (int k = 0; k < PX; k++) {             // refilled each time: the SPI driver may byte-swap the buffer
      for (int x = 0; x < SCR_W; x++) for (int j = 0; j < PX; j++) pxLine[x * PX + j] = src[x];
      tft.writePixels(pxLine, SCR_W * PX);
    }
  }
}
#else
void sendStrip(uint16_t *buf, int rows) { tft.writePixels(buf, SCR_W * rows); }
#endif

void loop() {
  readSerial();
#if defined(ESP32)
  if (rebootAt && (int32_t)(millis() - rebootAt) >= 0) ESP.restart();   // Restart board button in the Studio
#endif
#if HAS_BLE
  readBluetooth();
#endif
  if (pausedForUpload()) return;         // the screen holds still while a picture arrives
#if DUAL_CORE
  static uint8_t b = 0;
  uint32_t frameT0 = micros();
  int pending = -1;
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    xSemaphoreTake(goSem[b], portMAX_DELAY);
    int rows = stripRows[b], help = stripHelp[b];
    if (y0 == 0) {                       // a new frame: its size is settled now
#if TURNS
      if (turnPending) {                 // the screen was turned: tell the panel
#if USE_DMA
        if (lcdDma) { uint8_t c = 0x36, m = MADCTL_ROT[rotNow()]; lcdSend(&c, 1, false, 1000); lcdSend(&m, 1, true, 1000); } else
#endif
        tft.setRotation(rotNow());
        turnPending = false;
      }
#endif
#if USE_DMA
      if (lcdDma) lcdWindow(1000); else
#endif
      { tft.startWrite(); tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX); }
    }
    if (help) {                          // core 1's share of the drawing: the bottom rows
      uint16_t *dst = stripBuf[b] + (rows - help) * SCR_W;
      composeStrip(stripY0[b] + rows - help, help, dst);
      swapBytes565(dst, SCR_W * help);
    }
    if (y0 + STRIP >= SCR_H) xSemaphoreGive(helperIdle);   // core 0 can start the next frame
    uint32_t t0 = micros();
    xSemaphoreTake(readySem[b], portMAX_DELAY);
    wait1Us += micros() - t0;
#if USE_DMA
    if (lcdDma) {                        // send this strip in the background, then free the one before
      lcdQueue(b, rows, 1000);
      if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
      pending = b;
    } else
#endif
    {
      t0 = micros();
      sendStrip(stripBuf[b], rows);
      sendUs += micros() - t0;
      xSemaphoreGive(freeSem[b]);
    }
    b ^= 1;
    readSerialQuick();                   // new settings get an answer even while a slow frame is drawn
    pollTap();
  }
#if USE_DMA
  if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
  if (!lcdDma)
#endif
  tft.endWrite();
  countFrame();
  balanceCores(micros() - frameT0);
  return;
#else
  frameStart();
#if TURNS
  if (turnPending) { tft.setRotation(rotNow()); turnPending = false; }
#endif
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX);
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    int rows = min(STRIP, SCR_H - y0);
    uint32_t t0 = micros();
    composeStrip(y0, rows, stripBuf[0]);
    uint32_t t1 = micros();
    sendStrip(stripBuf[0], rows);
    drawUs += t1 - t0; sendUs += micros() - t1;
    readSerialQuick();
    pollTap();
  }
  frameEnd();
  tft.endWrite();
  countFrame();
#endif
}
