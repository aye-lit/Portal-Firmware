// ---------- scenes: the portal and pictures shown in turn, with fades ----------
uint8_t sceneA = PORTAL, sceneB = PORTAL;
int     sceneMix = 0;                    // 0 = all scene A, 256 = all scene B
float   ageA = 0, ageB = 0;              // seconds since each scene started to appear

void updateScene() {
  if (SCENE_COUNT == 0) { sceneA = sceneB = PORTAL; sceneMix = 0; return; }
  if (SCENE_COUNT == 1) { sceneA = sceneB = SCENES[0]; sceneMix = 0; ageA = millis() / 1000.0f; return; }
  float per = HOLD_SECS + SCENE_FADE;
  float pos = fmodf(millis() / 1000.0f, per * SCENE_COUNT);
  int i = min((int)(pos / per), SCENE_COUNT - 1);
  float w = pos - i * per;
  sceneA = SCENES[i];
  sceneB = SCENES[(i + 1) % SCENE_COUNT];
  ageA = w + SCENE_FADE;                 // it began fading in during the previous scene
  ageB = max(0.0f, w - HOLD_SECS);
  if (w < HOLD_SECS || SCENE_FADE <= 0) sceneMix = 0;
  else { float f = (w - HOLD_SECS) / SCENE_FADE; f = f * f * (3 - 2 * f); sceneMix = (int)(f * 256); }
}

// "Portal around a picture": the picture shows through the portal's centre. When the scene
// starts, the portal forms at its outer edge and closes in until it covers FRAME_PCT.
inline bool isFramed(uint8_t s) { return s >= 128 && isPicture(s - 128); }

inline uint16_t mix565(uint16_t x, uint16_t y, int m) {
  int r  = ((x >> 11) * (256 - m) + (y >> 11) * m) >> 8;
  int g  = (((x >> 5) & 63) * (256 - m) + ((y >> 5) & 63) * m) >> 8;
  int bl = ((x & 31) * (256 - m) + (y & 31) * m) >> 8;
  return (r << 11) | (g << 5) | bl;
}

void framePicture(uint8_t pic, float age, int y0, int rows, uint16_t *dst) {
  static uint16_t line[SCR_W];
  float close = SCENE_FADE + 1.5f;                            // seconds to close in (keeps going after the fade)
  float k = min(1.0f, age / close); k = k * k * (3 - 2 * k);
  float hole = RADIUS * (1.0f - FRAME_PCT / 100.0f * k);      // radius where the picture shows
  int16_t alpha[256];                                          // soft 8-pixel edge
  for (int r = 0; r < 256; r++) { float a = (hole + 4 - r) / 8.0f; alpha[r] = a <= 0 ? 0 : a >= 1 ? 256 : (int16_t)(a * 256); }
  for (int y = y0; y < y0 + rows; y++) {
    int qy = y < QY ? QY - 1 - y : y - QY;
    if (qy > hole + 4) continue;                                // this row is all portal
    readPicture(pic, y, 1, line);
    uint16_t *d = dst + (y - y0) * SCR_W;
    for (int x = 0; x < SCR_W; x++) {
      int m = alpha[rT[qy * TQX + colMap[x]]];
      if (m) d[x] = m == 256 ? line[x] : mix565(d[x], line[x], m);
    }
  }
}

void blendStrip(uint16_t *a, const uint16_t *b, int n, int m) {   // a = a + (b - a) * m / 256
  for (int i = 0; i < n; i++) a[i] = mix565(a[i], b[i], m);
}

void renderStrip(int y0, int rows, uint16_t *strip);

void drawScene(uint8_t s, float age, int y0, int rows, uint16_t *dst) {
  if (isPicture(s)) { readPicture(s, y0, rows, dst); return; }
  renderStrip(y0, rows, dst);
  if (isFramed(s)) framePicture(s - 128, age, y0, rows, dst);
}

void composeStrip(int y0, int rows, uint16_t *dst) {
  bool fading = sceneMix > 0 && sceneA != sceneB;
  if (!fading || !picBuf) { if (sceneMix >= 128) drawScene(sceneB, ageB, y0, rows, dst); else drawScene(sceneA, ageA, y0, rows, dst); return; }
  drawScene(sceneA, ageA, y0, rows, dst);
  drawScene(sceneB, ageB, y0, rows, picBuf);
  blendStrip(dst, picBuf, rows * SCR_W, sceneMix);
}

// ---------- one frame ----------
uint8_t look = 0;                        // the style being drawn (crosses fall back to Vortex without flash storage)

// ---------- Nebula, Wormhole, Meteor Shower ----------
uint8_t  *noise8 = NULL;                // smooth value noise for the gas clouds (allocated when first needed)
double   spaceT = 0;                    // space clock (runs on its own so it never jumps)
float    spU = 1, spExt = 118;          // space units per pixel, edge of the picture in space units
float    nbCa = 1, nbSa = 0, nbO1 = 0, nbO2 = 0, nbO3 = 0;
int      spTw = 0, whPh = 0;
#define SP_GRID ((SCR_W / 2 + 2) * (STRIP / 2 + 3))   // gas worked out every 2 or 4 pixels, smoothed in between (one strip at a time)
uint8_t  *spH = NULL, *spV = NULL, *spX = NULL;
// Galaxy: a Hubble-style spiral (like M51, M100, NGC 4414)
#define GAL_TILT 0.86f                   // how tilted toward you (1 = face on)
#define GAL_PA   -0.55f                  // which way it points
#define GAL_ZOOM 0.7f                    // size (smaller = bigger galaxy)
float    gax = 1, gbx = 0, gay = 0, gby = 1, galK = 9;   // galK: how tightly the arms wind (the Spiral setting)
// The galaxy is one picture turning in its own plane: worked out once on a polar grid (per Spiral setting), then looked up
#define  GT_R  64
#define  GT_DR 1.65f
uint8_t  *gtH = NULL, *gtV = NULL, *gtX = NULL;
int      gtA = 0;
float    gtK = -1, gpx = 1, gqx = 0, gpy = 0, gqy = 1, gRot = 0;
bool     gtReady = false;
uint8_t  powT[256], whRingT[256], whNearT[256];
int16_t  whOffT[256], whCoreT[256];
int32_t  whHueT[256];
struct Meteor { float x, y, len; uint8_t hue; };
Meteor   meteors[30];
int      meteorCount = 7;

void buildNoise() {
  uint32_t sd = 11;
  for (int i = 0; i < 64 * 64; i++) { sd = (sd * 1103515245UL + 12345UL) & 0x7fffffffUL; noise8[i] = sd >> 23; }
  for (int i = 0; i < 256; i++) powT[i] = (uint8_t)(255 * powf(i / 255.0f, 1.6f));
}

bool spaceMemory() {                    // reserved at startup (allocBuffers), so every space style always has room
  if (spaceLUT && noise8 && spX) return true;
  if (!spH) spH = (uint8_t *)malloc(SP_GRID);
  if (!spV) spV = (uint8_t *)malloc(SP_GRID);
  if (!spX) spX = (uint8_t *)malloc(SP_GRID);
  if (!spH || !spV || !spX) return false;
  if (!spaceLUT) { spaceLUT = (uint16_t *)malloc(64 * 64 * 2); if (spaceLUT) buildSpaceLUT(); }
  if (!noise8) { noise8 = (uint8_t *)malloc(64 * 64); if (noise8) buildNoise(); }
  return spaceLUT && noise8;
}

inline float smf(float x) { x = x < 0 ? 0 : x > 1 ? 1 : x; return x * x * (3 - 2 * x); }

float vn(float x, float y) {            // smooth noise, 0..1, repeats every 64 units
  float xf = floorf(x), yf = floorf(y);
  int xi = (int)xf, yi = (int)yf;
  float fx = x - xf, fy = y - yf;
  fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy);
  int x0 = xi & 63, x1 = (xi + 1) & 63, y0 = (yi & 63) << 6, y1 = ((yi + 1) & 63) << 6;
  float a = noise8[y0 | x0], b = noise8[y0 | x1], c = noise8[y1 | x0], d = noise8[y1 | x1];
  return (a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy) * (1 / 255.0f);
}

inline uint8_t to8(float v) { return v <= 0 ? 0 : v >= 1 ? 255 : (uint8_t)(v * 255); }

void galaxyNode(float xr, float yr, uint8_t &h, uint8_t &v, uint8_t &a8) {   // light, colour and "arm" at one point of the galaxy's plane
  float gr = sqrtf(xr * xr + yr * yr), ga = atan2f(yr, xr), lr = logf(gr / 5 + 1);
  float wob = (vn(xr / 16 + 50, yr / 16) - 0.5f) * 1.3f;              // arms wander and break up
  float ph = 2 * ga - galK * lr + wob;
  float c = 0.5f + 0.5f * cosf(ph), c2 = c * c, c4 = c2 * c2, c8 = c4 * c4;
  float b = 0.5f + 0.5f * cosf(2 * ga - galK * 1.12f * lr + 2.3f + wob * 1.5f), b2 = b * b, b6 = b2 * b2 * b2;   // fainter branch arms
  float e = 0.5f + 0.5f * cosf(5 * ga - galK * 1.5f * lr + wob * 2.2f), e2 = e * e, e4 = e2 * e2, e10 = e4 * e4 * e2;   // feathery spurs
  float arm = min(1.0f, 0.7f * c2 + 0.3f * c8 + 0.5f * b6 * smf((gr - 8) / 20) + 0.28f * e10 * smf((gr - 14) / 16));
  float clump = vn(xr / 3.2f, yr / 3.2f) * 0.55f + vn(xr / 8 + 7, yr / 8) * 0.45f;   // star clouds along the arms
  float l = 0.5f + 0.5f * cosf(ph - 0.6f), l2 = l * l, l4 = l2 * l2, l8 = l4 * l4, l16 = l8 * l8;   // dust on the inner edge of each arm
  float lane = l16 * l8 * l4 * l2 * (0.35f + 0.9f * vn(xr / 2.6f + 20, yr / 2.6f));
  float f = 0.5f + 0.5f * cosf(4 * ga - galK * 1.05f * lr + vn(xr / 7 + 31, yr / 7) * 5), f2 = f * f, f8 = f2 * f2 * f2 * f2, f16 = f8 * f8;   // thin dust filaments
  float wisp = f16 * f8 * f2 * 0.8f * smf((gr - 6) / 14) + max(0.0f, vn(xr / 4.5f + 3, yr / 4.5f - 9) - 0.64f) * 1.4f * c;
  float edge = smf((104 - gr) / 44);
  float dust = min(1.0f, lane + wisp) * smf(gr / 14) * edge;
  float q = gr / 6.5f, bulge = expf(-q * q) + expf(-gr / 11) * 0.5f;
  float disk = expf(-gr / 48) * edge, halo = expf(-gr / 22) * 0.32f;
  float cl = clump * clump * 1.6f;
  float lv = bulge + halo + disk * (0.3f + 0.12f * cl + 1.6f * arm * (0.25f + cl));
  lv *= 1 - 0.55f * dust * (1 - min(1.0f, bulge));
  float hue = 0.75f - 0.23f * smf((gr - 14) / 34) + 0.16f * dust;   // yellow-cream core, blue outer arms, brown dust
  h = to8(hue / 2); v = to8(lv); a8 = to8(arm * edge * (1 - dust));
}

float fastAtan2(float y, float x) {     // quick angle, good to about 0.1 degree
  float ax = fabsf(x), ay = fabsf(y), mx = max(ax, ay), mn = min(ax, ay);
  if (mx == 0) return 0;
  float a = mn / mx, q = a * a;
  float r = ((-0.0464964749f * q + 0.15931422f) * q - 0.327622764f) * q * a + a;
  if (ay > ax) r = 1.57079637f - r;
  if (x < 0) r = 3.14159274f - r;
  return y < 0 ? -r : r;
}

bool galaxyTex() {                      // build the galaxy picture once per Spiral setting
  if (!gtH) {
    for (int a = 256; a >= 128 && !gtH; a /= 2) {
      gtH = (uint8_t *)malloc(GT_R * a); gtV = (uint8_t *)malloc(GT_R * a); gtX = (uint8_t *)malloc(GT_R * a);
      if (gtH && gtV && gtX) gtA = a;
      else { free(gtH); free(gtV); free(gtX); gtH = gtV = gtX = NULL; }
    }
    if (!gtH) return false;             // no room: the galaxy is worked out every frame instead
    gtK = -1;
  }
  if (gtK == galK) return true;
  gtK = galK;
  for (int ri = 0; ri < GT_R; ri++)
    for (int ai = 0; ai < gtA; ai++) {
      float gr = ri * GT_DR, an = ai * TWO_PI / gtA;
      int i = ri * gtA + ai;
      galaxyNode(gr * cosf(an), gr * sinf(an), gtH[i], gtV[i], gtX[i]);
    }
  return true;
}

void spaceNode(float X, float Y, uint8_t &h, uint8_t &v, uint8_t &x8) {   // gas and dust at one point
  if (look == 4) {
    if (!gtReady) { galaxyNode(gax * X + gbx * Y, gay * X + gby * Y, h, v, x8); return; }
    float px = gpx * X + gqx * Y, py = gpy * X + gqy * Y;                 // look the galaxy up, turned
    float fr = sqrtf(px * px + py * py) / GT_DR; if (fr > GT_R - 1.001f) fr = GT_R - 1.001f;
    float fa = (fastAtan2(py, px) - gRot) * (gtA / TWO_PI); fa -= floorf(fa / gtA) * gtA;
    int ri = (int)fr; float wr = fr - ri; int ai = (int)fa; float wa = fa - ai; if (ai >= gtA) ai -= gtA;
    int a1 = ai + 1 == gtA ? 0 : ai + 1, i00 = ri * gtA + ai, i01 = ri * gtA + a1, i10 = i00 + gtA, i11 = i01 + gtA;
    h  = (uint8_t)((gtH[i00] * (1 - wa) + gtH[i01] * wa) * (1 - wr) + (gtH[i10] * (1 - wa) + gtH[i11] * wa) * wr);
    v  = (uint8_t)((gtV[i00] * (1 - wa) + gtV[i01] * wa) * (1 - wr) + (gtV[i10] * (1 - wa) + gtV[i11] * wa) * wr);
    x8 = (uint8_t)((gtX[i00] * (1 - wa) + gtX[i01] * wa) * (1 - wr) + (gtX[i10] * (1 - wa) + gtX[i11] * wa) * wr);
    return;
  }
  if (look == 14) {                                                       // Nebula
    float x = (X * nbCa - Y * nbSa) / 36, y = (X * nbSa + Y * nbCa) / 36;
    float w = vn(x + nbO1, y) * 2.2f;                                     // warp so the clouds fold
    float d = vn(x + w, y - w + nbO2) * 0.6f + vn(x * 2.2f - w, y * 2.2f + nbO1) * 0.28f + vn(x * 4.6f, y * 4.6f) * 0.12f;
    float dust = max(0.0f, vn(x * 1.7f + 9, y * 1.7f - w) * 1.9f - 1.05f);   // dark dust lanes
    d = max(0.0f, d * 1.7f - 0.5f - dust);
    float hue = vn(x * 0.7f + 20 + nbO3, y * 0.7f) * 1.6f + w * 0.15f;    // big patches of different colour
    float rr = sqrtf(X * X + Y * Y) / spExt;
    h = to8(hue / 2); v = to8(d * (1 - rr * rr * rr) * 0.95f); x8 = 0;
  } else {                                                                // Meteor Shower: faint Milky Way
    float q = (X * 0.5f + Y * 0.87f) / 30, band = expf(-q * q);
    float cloud = vn(X / 14 + 3, Y / 14) * vn(X / 6, Y / 6 + 8);
    h = to8((0.05f + vn(X / 40, Y / 40 + 2) * 0.8f) / 2); v = to8(band * (0.12f + cloud * 0.35f)); x8 = band > 0.3f;
  }
}

inline bool spaceStar(uint32_t i, int density, int &hi, int &vi) {   // a twinkling star with its own colour
  uint32_t h = hash32(i * 2654435761UL);
  if ((int)(h & 1023) >= density) return false;
  vi = 47 + sinT[(spTw + (h >> 10)) & 255] / 10;
  hi = (h >> 20) & 63;
  return true;
}

void prepareSpace() {                   // once per frame
  spU = look == 15 ? 118.0f / SP_EXT : 236.0f / min(SCR_W, SCR_H);   // scaled to the screen
  spExt = SP_EXT * spU;
  double T = spaceT;
  float ang = (float)fmod(T * 0.004, TWO_PI);
  nbCa = cosf(ang); nbSa = sinf(ang);
  nbO1 = (float)fmod(T * 0.004, 64.0); nbO2 = (float)fmod(T * 0.003, 64.0); nbO3 = (float)fmod(T * 0.002, 64.0);
  spTw = (int)(fmod(T * 0.25, TWO_PI) * 40.74f);
  if (look == 4) {                      // Galaxy: screen -> the galaxy's own slowly turning plane
    float rot = (float)fmod(T * 0.007, TWO_PI), cr = cosf(rot), sr = sinf(rot), cp = cosf(GAL_PA), sp = sinf(GAL_PA);
    gax = (cp * cr + sp * sr / GAL_TILT) * GAL_ZOOM; gbx = (-sp * cr + cp * sr / GAL_TILT) * GAL_ZOOM;
    gay = (-cp * sr + sp * cr / GAL_TILT) * GAL_ZOOM; gby = (sp * sr + cp * cr / GAL_TILT) * GAL_ZOOM;
    galK = 3 + TWIST * 2.5f;            // Spiral setting (TWIST 0-6)
    gpx = cp * GAL_ZOOM; gqx = -sp * GAL_ZOOM; gpy = sp / GAL_TILT * GAL_ZOOM; gqy = cp / GAL_TILT * GAL_ZOOM;   // before turning
    gRot = rot;
    gtReady = galaxyTex();
  }
  if (look == 15) {                     // Wormhole: rings falling away, worked out per distance
    float rev = DRIFT ? -1 : 1;          // Reverse: rings fly out toward you
    whPh = (int)(rev * fmod(T * 0.06, TWO_PI) * 40.74f);
    float off = rev * (float)fmod(T * 0.09, 100.0);
    for (int r = 0; r < 256; r++) {
      float ru = max(r * spU, 1.0f), depth = 90 / ru, ringPos = depth * 2.6f - off, fl = floorf(ringPos);
      whRingT[r] = (uint8_t)(255 * (0.5f + 0.5f * cosf((ringPos - fl) * TWO_PI)));
      float near = min(1.0f, ru / 95);
      whNearT[r] = (uint8_t)(255 * (0.25f + 0.75f * near * near));
      whOffT[r] = (int16_t)((int)(TWIST * (depth * 0.667f + 3 * logf(ru / 20)) * 40.74f) & 255);   // Twist: how much the walls spiral
      whHueT[r] = (int32_t)floorf(fl * 0.27f * 256) & 255;               // each ring its own colour
      whCoreT[r] = ru < 18 ? (int16_t)min(63.0f, expf(-(ru / 9) * (ru / 9)) * 1.05f * 63) : -1;
    }
  }
  if (look == 16) {                     // Meteor Shower: where each shooting star is
    float P = sqrtf((float)SCR_W * SCR_W + (float)SCR_H * SCR_H) / 340;
    int N = NUM_SPARKS < 2 ? 2 : NUM_SPARKS > 30 ? 30 : NUM_SPARKS;   // Meteors setting
    meteorCount = N;
    for (int m = 0; m < N; m++) {
      float ph = (float)fmod(T * 0.006 * (1 + (m % 4) * 0.12) + (double)m / N + (m % 3) * 0.13, 1.0), lane = (m * 37 % 100) / 100.0f;
      float side = ((m * 61 % 100) / 100.0f - 0.5f) * 160;   // spread across the sky
      meteors[m].x = QX + (110 - ph * 320 + lane * 110 + side * 0.6f) * P;
      meteors[m].y = QY + (-170 + ph * 240 + lane * 70 + side * 0.8f) * P;
      meteors[m].len = (38 + lane * 30) * P;
      meteors[m].hue = m * 64 / N;
    }
  }
}

void renderSpaceStrip(int y0, int rows, uint16_t *strip) {
  uint16_t *p = strip;
  if (look == 15) {                     // Wormhole
    for (int y = y0; y < y0 + rows; y++) {
      int qy = y < QY ? QY - 1 - y : y - QY;
      bool low = y >= QY;
      for (int x = 0; x < SCR_W; x++) {
        int qi = qy * TQX + colMap[x], r = rT[qi], a0 = aT[qi];
        int a = (x >= QX ? (low ? a0 : 256 - a0) : (low ? 128 - a0 : 128 + a0)) & 255;
        int s = sinT[(a * 6 + whOffT[r] + whPh) & 255] + 127;          // spokes, 0..254
        int vi = (powT[(whRingT[r] * 133 + s * 123) >> 8] * whNearT[r]) >> 10;
        if (whCoreT[r] >= 0) { if (whCoreT[r] > vi) vi = whCoreT[r]; *p++ = spaceLUT[48 * 64 + vi]; continue; }   // glowing far end
        *p++ = spaceLUT[(((whHueT[r] + s * 20 / 254) >> 2) & 63) * 64 + vi];
      }
    }
    return;
  }
  // Galaxy, Nebula and Meteor Shower: gas worked out on a coarse grid, smoothed in between
  const int C = look == 4 && min(SCR_W, SCR_H) < 300 ? 2 : 4, SH = C == 2 ? 2 : 4, GC = SCR_W / C + 2;
  int gy0 = y0 / C, gy1 = (y0 + rows - 1) / C + 1;
  for (int gy = gy0; gy <= gy1; gy++)
    for (int gx = 0; gx < GC; gx++) {
      int i = (gy - gy0) * GC + gx;
      spaceNode((gx * C + 0.5f - QX) * spU, (gy * C + 0.5f - QY) * spU, spH[i], spV[i], spX[i]);
    }
  int dens = (look == 14 ? 7 : look == 4 ? 4 : 10) * STARS / 3, densBand = 22 * STARS / 3;
  for (int y = y0; y < y0 + rows; y++) {
    int gy = y / C - gy0, fy = y % C;
    float Y = (y + 0.5f - QY) * spU;
    for (int x = 0; x < SCR_W; x++) {
      int fx = x % C, i = gy * GC + x / C;
      int w00 = (C - fx) * (C - fy), w01 = fx * (C - fy), w10 = (C - fx) * fy, w11 = fx * fy;
      int h = (spH[i] * w00 + spH[i + 1] * w01 + spH[i + GC] * w10 + spH[i + GC + 1] * w11) >> SH;
      int v = (spV[i] * w00 + spV[i + 1] * w01 + spV[i + GC] * w10 + spV[i + GC + 1] * w11) >> SH;
      int hi = (h >> 1) & 63, vi = v >> 2, shi, svi;
      uint32_t pix = (uint32_t)(y * SCR_W + x);
      if (look == 4) {
        int am = (spX[i] * w00 + spX[i + 1] * w01 + spX[i + GC] * w10 + spX[i + GC + 1] * w11) >> SH;
        if (am > 90) {                                   // knots on the arms: pink star nurseries, blue clusters
          float X = (x + 0.5f - QX) * spU, xr = gax * X + gbx * Y, yr = gay * X + gby * Y;
          int kx = (int)floorf(xr / 4), ky = (int)floorf(yr / 4);
          uint32_t kh = hash32((uint32_t)(kx + 4096) * 7919u + (uint32_t)(ky + 4096) * 104729u);
          int kind = kh & 15;
          if (kind < 3) {
            float dx = xr - (kx * 4 + 1 + (int)((kh >> 8) & 1) * 2), dy = yr - (ky * 4 + 1 + (int)((kh >> 9) & 1) * 2), d2 = dx * dx + dy * dy, size = kind == 0 ? 1.6f : 0.9f;
            if (d2 < size) { int kv = (int)((0.62f + am / 700.0f) * 63 * (1 - d2 / size * 0.4f)); if (kv > vi) { hi = kind == 0 ? 17 : 33; vi = min(63, kv); } }
          }
        }
        if (spaceStar(pix, dens, shi, svi) && svi > vi + 8) { hi = 42; vi = svi; }
      } else if (look == 14) { if (spaceStar(pix, dens, shi, svi) && svi > vi) { hi = shi; vi = min(63, svi + 13); } }
      else if (spaceStar(pix, spX[i] ? densBand : dens, shi, svi)) { hi = shi; vi = svi; }
      *p++ = spaceLUT[hi * 64 + vi];
    }
  }
  if (look == 16) for (int m = 0; m < meteorCount; m++) {           // shooting stars with coloured tails
    const Meteor &M = meteors[m];
    for (int k = 0; k < M.len; k++) {
      float f = 1 - k / M.len;
      int x = (int)floorf(M.x + 0.8f * k + 0.5f), y = (int)floorf(M.y - 0.6f * k + 0.5f);
      int vi = k < 3 ? 63 : (int)((0.9f * f * f + 0.05f) * 63);
      for (int yy = y; yy < y + 2; yy++)
        if (x >= 0 && x < SCR_W && yy >= y0 && yy < y0 + rows) strip[(yy - y0) * SCR_W + x] = spaceLUT[M.hue * 64 + vi];
    }
  }
}

void frameStart() {
  updateScene();
  if (havePending) {
    apply(pendingSettings);
    saveSettings();
    buildParams();
    buildPalette();
    resetSparks();
    havePending = false;
  }
  bool isCross = STYLE >= 8 && STYLE <= 13;
  if (isCross && crossAvailable() && edgeBuf) prepareCross();
  look = isCross && !crossReady ? 0 : STYLE;
  if (look == 4 || look >= 14) { if (spaceMemory()) prepareSpace(); else look = 0; }   // no room: show the Vortex
  updateColourFade();
  updateSparks();
  for (int a = 0; a < 256; a++) {                     // wobbly rim edge for this frame
    float ang = a * TWO_PI / 256;
    float wob = sinf(ang * 5 + t * 2) * 1.2f + sinf(ang * 3 - t * 3) * 0.8f;
    edgeT[a] = (int16_t)(RADIUS * (1 + wob * 0.025f * (1 - RIM_SMOOTH / 100.0f)));
  }
  // Hyperspace: where each streaking star is this frame (3 layers x 256 directions)
  bhHole = (int)(0.22f * RADIUS);
  twinkle = (int)(t * 25);
  if (STYLE == 3) {
    for (int L = 0; L < 3; L++) {
      for (int a = 0; a < 256; a++) {
        uint32_t h = hash32((uint32_t)(a * 3 + L * 7919));
        int i = L * 256 + a;
        warpOn[i] = (int)(h & 15) < STARS + 1;
        float pos = fmodf((float)((h >> 8) & 1023) + t * (60 + L * 25), 1024.0f) / 1024.0f;
        float rr = pos * pos * 1.15f * RADIUS;
        warpRR[i] = rr;
        warpLen[i] = 1.5f + rr * 0.22f;
        warpB[i] = 145 * min(1.0f, rr / (0.8f * RADIUS));
      }
    }
  }
  // Starburst ripples: rings expanding outward, precomputed per distance for this frame
  memset(ripCrestT, 0, sizeof(ripCrestT));
  memset(ripTroughT, 0, sizeof(ripTroughT));
  if (STYLE == 2) {
    for (uint8_t i = 0; i < RIPPLES; i++) {
      float pr = fmodf(t * RIP_SPEED + (float)i / RIPPLES, 1.0f);
      float rr = 0.16f + pr * 0.62f, w = 0.04f + pr * 0.04f, fade = powf(1 - pr, 1.1f);
      for (int r = 0; r < 256; r++) {
        float d = (r / RADIUS - rr) / w;
        ripCrestT[r]  = (uint8_t)min(255, ripCrestT[r] + (int)(fade * 110 * expf(-d * d)));
        ripTroughT[r] = (uint8_t)min(255, ripTroughT[r] + (int)(fade * 35 * expf(-(d + 1.6f) * (d + 1.6f))));
      }
    }
  }
}

void frameEnd() {
  t += SPEED;
  static uint32_t lastMs = millis();     // space styles move by the clock, so they match the Studio at any frame rate
  uint32_t now = millis();
  spaceT += SPEED * 8 * min(8.0f, (now - lastMs) / 35.7f);   // the Studio preview steps 28 times a second
  lastMs = now;
  if (spaceT > 1e7) spaceT = 0;
  if (t > TWO_PI * 100) t -= TWO_PI * 100;   // wrap seamlessly so it can run forever
}

inline int cartoonV(int a, int r, int phase) {   // blobby flat-shaded swirl
  int warp = (((nz(nzA, 31, a * 2 + r * 3 + (phase >> 1)) - 128) * 7) >> 3) + ((nz(nzB, 63, a * 4 + r * 6 - phase) - 128) >> 2);
  int sp = sinT[(a * ARMS - linT[r] + phase + warp) & 255];
  return r < 7 ? 232 : sp > 25 ? 232 : sp > -45 ? 182 : 120;
}

void renderStrip(int y0, int rows, uint16_t *strip) {
  const int phase = (int)(t * 1.5f * 40.74f), phase2 = (int)(-t * 40.74f);
  uint16_t *p = strip;
  if (look == 4 || look >= 14) { renderSpaceStrip(y0, rows, strip); return; }   // Galaxy, Nebula, Wormhole, Meteor Shower
  bool cross = look >= 8;
  if (cross) readCrossRows(y0, rows);
  for (int y = y0; y < y0 + rows; y++) {
    int qy = y < QY ? QY - 1 - y : y - QY;
    bool low = y >= QY;
    const int8_t *eb = cross ? edgeBuf + (y - y0) * SCR_W : NULL;
    int cy = y < crossYC ? crossYC - 1 - y : y - crossYC;   // crosses: swirl around the crossing
    bool clow = y >= crossYC;
    for (int x = 0; x < SCR_W; x++) {
      int qi = qy * TQX + colMap[x], r = rT[qi], a0 = aT[qi];
      int a = (x >= QX ? (low ? a0 : 256 - a0) : (low ? 128 - a0 : 128 + a0)) & 255;
      int e = edgeT[a];
      int v;
      if (eb) {                                        // Cross: Vortex swirl inside, glowing rim along the cross edge
        int ce = eb[x];
        if (ce > 0) {
          int ca0;
          if (cy < TQY) { int ci = cy * TQX + colMap[x]; r = rT[ci]; ca0 = aT[ci]; }
          else {                                       // below the tables: work it out (only the lower arm)
            float fx = colMap[x] + 0.5f, fy = cy + 0.5f;
            r = min(255, (int)lroundf(sqrtf(fx * fx + fy * fy)));
            ca0 = (int)lroundf(atan2f(fy, fx) / (PI / 2) * 64);
          }
          a = (x >= QX ? (clow ? ca0 : 256 - ca0) : (clow ? 128 - ca0 : 128 + ca0)) & 255;
          int s  = sinT[(a * ARMS + twistT[r] + phase) & 255];
          int s2 = sinT[(a * 2 - twist2T[r] + phase2) & 255];
          int d = depthT[r];
          int band = ((s + 127) * 5 + (s2 + 127) * 3) >> 3;
          v = (d * (60 + ((band * 195) >> 8))) >> 8;
          if (s > 100) v += ((s - 100) * 3 * d) >> 8;
          if (coreT[r] > v) v = coreT[r];
          if (crossRimT[ce] > v) v = crossRimT[ce];
        } else {
          v = max(crossRimT[-ce], crossHaloT[-ce]);
        }
      } else if (look == 7) {                                // Cartoon Sticker: ragged edge, light outline, no glow
        int jag = (((nz(nzB, 63, a * 4 + (phase >> 1)) - 128) * 7 + (nz(nzC, 255, a * 16 + phase) - 128) * 4) >> 7) * (100 - RIM_SMOOTH) / 100;
        int e2 = (int)(RADIUS * 1.02f + jag / 4.0f);
        v = r >= e2 ? 0 : r >= e2 - 4 ? 235 : cartoonV(a, r, phase);
      } else if (r < e) {
        if (look == 0) {                              // Vortex
          int s  = sinT[(a * ARMS + twistT[r] + phase) & 255];
          int s2 = sinT[(a * 2 - twist2T[r] + phase2) & 255];
          int d = depthT[r];
          int band = ((s + 127) * 5 + (s2 + 127) * 3) >> 3;
          v = (d * (60 + ((band * 195) >> 8))) >> 8;   // swirling bands, darker toward the throat
          if (s > 100) v += ((s - 100) * 3 * d) >> 8; // bright spiral crests
          if (coreT[r] > v) v = coreT[r];              // glowing core
        } else if (look == 1) {                       // Toon Spiral: flat-shaded wavy bands
          int w  = sinT[(a * 6 + r * 4 + phase2) & 255] >> 2;
          int sp = sinT[(a * ARMS - linT[r] + phase + w) & 255];
          v = sp > 40 ? 235 : sp > -20 ? 190 : sp > -70 ? 150 : 95;
          if (coreT[r] > v) v = coreT[r];
        } else if (look == 6) {                       // Cartoon Swirl: blobby flat-shaded bands
          v = cartoonV(a, r, phase);
        } else if (look == 3) {                       // Hyperspace: stars streak outward
          v = 30 + ((sinT[(a * 3 + (phase >> 3)) & 255] + 127) >> 4) + (spCoreT[r] >> 2);
          for (int L = 0; L < 3; L++) {
            int i = L * 256 + a;
            if (!warpOn[i]) continue;
            float rr = warpRR[i], len = warpLen[i];
            if (r <= rr && r > rr - len) {
              int sv = (int)(110 + warpB[i] * (1 - (rr - r) / len * 0.6f));
              if (sv > v) v = sv;
            }
          }
        } else if (look == 5) {                       // Black hole: shadow, bright ring, swirling disk
          if (r < bhHole) v = 0;
          else {
            int swirl = sinT[(a * 3 + r * 6 - phase * 2) & 255] + (sinT[(a * 7 - r * 3 - phase) & 255] >> 1);
            int disk  = bhDiskT[r] * (310 + swirl) / 500;
            v = bhRingT[r] > disk ? bhRingT[r] : disk;
            if (bhStarT[r]) { int st = starAt(a, r); if (st > v) v = st; }
          }
        } else {                                       // Starburst: glowing centre, soft rings, rays, ripples
          int ray  = sinT[(a * 11 + (phase >> 2)) & 255] + (sinT[(a * 19 - (phase >> 1)) & 255] >> 1) + (sinT[(a * 37 + phase) & 255] >> 1);
          int wave = sinT[(r * 4 - phase * 2 + (sinT[(a * 9 + (phase >> 2)) & 255] >> 4)) & 255];
          int tex  = sinT[(r * 9 - phase * 3 + (sinT[(a * 7 + (phase >> 1)) & 255] >> 3)) & 255];
          int sd   = sinT[(a * 22 + (phase >> 3)) & 255], sdp = sd > 0 ? sd : 0;
          v = 115 + sbGlowT[r]
            + ((((wave + 127) * 85 >> 8) * sbRingT[r]) >> 8)     // soft rings near the centre
            + ((((tex * 26) >> 7) * sbRingT[r]) >> 8)
            + ((((ray * 32) >> 7) * sbOuterT[r]) >> 8)            // rays toward the rim
            + ((ripCrestT[r] * (141 + ((sdp * 115) >> 7))) >> 8) - ripTroughT[r];   // expanding ripples
          if (v < 0) v = 0;
        }
        int k = e - r; if (k < 64 && rimT[k] > v) v = rimT[k];
      } else {
        int k = r - e; v = k < 64 ? rimT[k] : 0;       // rim
        int h = haloT[k > 255 ? 255 : k]; if (h > v) v = h;   // outer halo
      }
      *p++ = pal[v > 255 ? 255 : v];
    }
  }
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {           // sparks in this strip
    if (look == 5 && sparks[i].r < bhHole) continue;  // they vanish into the black hole
    for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
      int xx = sparkX[i] + dx, yy = sparkY[i] + dy;
      if (xx >= 0 && xx < SCR_W && yy >= y0 && yy < y0 + rows && !(cross && edgeBuf[(yy - y0) * SCR_W + xx] <= 0)) strip[(yy - y0) * SCR_W + xx] = pal[235];
    }
  }
}

// ---------- frame-rate readout (Serial Monitor, 115200 baud) ----------
uint32_t fpsFrames = 0, fpsSince = 0;
void countFrame() {
  fpsFrames++;
  uint32_t now = millis();
  if (now - fpsSince >= 5000) {
    Serial.print(F("FPS: "));
    Serial.println(fpsFrames * 1000.0f / (now - fpsSince), 1);
    fpsFrames = 0;
    fpsSince = now;
  }
}

#if DUAL_CORE
SemaphoreHandle_t readySem[2], freeSem[2];

void renderTask(void *) {         // runs on core 0
  uint8_t b = 0;
  for (;;) {
    frameStart();
    for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
      xSemaphoreTake(freeSem[b], portMAX_DELAY);
      composeStrip(y0, min(STRIP, SCR_H - y0), stripBuf[b]);
      xSemaphoreGive(readySem[b]);
      b ^= 1;
    }
    frameEnd();
    vTaskDelay(1);                // let core 0's housekeeping run
  }
}
#endif

// Big tables live on the heap so large screens fit next to Bluetooth
bool allocBuffers() {
  rT = (uint8_t *)malloc(TQX * TQY);
  aT = (uint8_t *)malloc(TQX * TQY);
  if (!rT || !aT) return false;
  const int first = STRIP;
  for (int withSpace = 1; withSpace >= 0; withSpace--) {   // try to make room for the space styles too, then without
    for (STRIP = first; STRIP >= (withSpace ? 4 : 2); STRIP /= 2) {   // smaller strips if memory is tight
      stripBuf[0] = (uint16_t *)malloc(SCR_W * STRIP * 2);
      stripBuf[1] = (uint16_t *)malloc(SCR_W * STRIP * 2);
      picBuf = picturesAvailable() ? (uint16_t *)malloc(SCR_W * STRIP * 2) : NULL;   // for fades with pictures
      edgeBuf = crossAvailable() ? (int8_t *)malloc(SCR_W * STRIP) : NULL;            // for the cross styles
      bool space = !withSpace || spaceMemory();                                        // Galaxy, Nebula, Wormhole, Meteor Shower
      if (stripBuf[0] && stripBuf[1] && (picBuf || !picturesAvailable()) && (edgeBuf || !crossAvailable()) && space) return true;
      free(stripBuf[0]); free(stripBuf[1]); free(picBuf); free(edgeBuf); picBuf = NULL; edgeBuf = NULL;
      free(spH); free(spV); free(spX); free(spaceLUT); free(noise8); spH = spV = spX = NULL; spaceLUT = NULL; noise8 = NULL;
    }
  }
  return false;
}

void setup() {
#if defined(ESP32)
  Serial.setRxBufferSize(1024);          // room for picture data
#endif
  Serial.begin(115200);
  delay(300);
  Serial.println(F("[portal] starting"));
  // Board extras: backlight on, touch chip off the shared SPI bus, speaker and RGB LED off
  pinMode(27, OUTPUT); digitalWrite(27, HIGH);
  pinMode(33, OUTPUT); digitalWrite(33, HIGH);
  pinMode(4, OUTPUT);  digitalWrite(4, HIGH);
  pinMode(22, OUTPUT); digitalWrite(22, HIGH);
  pinMode(16, OUTPUT); digitalWrite(16, HIGH);
  pinMode(17, OUTPUT); digitalWrite(17, HIGH);
  beginBus();
  tft.init(320, 480, 0, 0, ST7796S_BGR);   // if red and blue look swapped, change ST7796S_BGR to ST7796S_RGB
  tft.invertDisplay(true);               // if the colours look like a photo negative, change true to false
  tft.setSPISpeed(SPI_HZ);
  tft.setRotation(1);                // landscape
  tft.fillScreen(0);
  Serial.println(F("[portal] screen ready"));
#if HAS_BLE
  beginBluetooth();                      // Bluetooth first: it needs one big block of memory
  Serial.println(F("[portal] bluetooth ready"));
#endif
  beginPictures();
  if (!allocBuffers()) {
    for (;;) { Serial.println(F("[portal] not enough memory for this screen")); delay(2000); }
  }
#if defined(ESP32)
  Serial.printf("[portal] memory ok, %u bytes free, %d rows per strip, room for %d pictures, space styles %s\n", (unsigned)ESP.getFreeHeap(), STRIP, picturesAvailable(), spaceLUT ? "ready" : "off (not enough memory)");
#endif
  loadSettings();
  randomSeed(micros());
  buildGeometry();
  buildParams();
  buildPalette();
  resetSparks();
#if DUAL_CORE
  for (int i = 0; i < 2; i++) {
    readySem[i] = xSemaphoreCreateBinary();
    freeSem[i] = xSemaphoreCreateBinary();
    xSemaphoreGive(freeSem[i]);
  }
  xTaskCreatePinnedToCore(renderTask, "portal", 4096, NULL, 1, NULL, 0);
#endif
  Serial.println(F("[portal] running"));
}

void loop() {
  readSerial();
#if HAS_BLE
  readBluetooth();
#endif
  if (pausedForUpload()) return;         // the screen holds still while a picture arrives
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W, SCR_H);
#if DUAL_CORE
  static uint8_t b = 0;
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    xSemaphoreTake(readySem[b], portMAX_DELAY);
    tft.writePixels(stripBuf[b], SCR_W * min(STRIP, SCR_H - y0));
    xSemaphoreGive(freeSem[b]);
    b ^= 1;
    readSerialQuick();                   // new settings get an answer even while a slow frame is drawn
  }
#else
  frameStart();
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    int rows = min(STRIP, SCR_H - y0);
    composeStrip(y0, rows, stripBuf[0]);
    tft.writePixels(stripBuf[0], SCR_W * rows);
    readSerialQuick();
  }
  frameEnd();
#endif
  tft.endWrite();
  countFrame();
}
