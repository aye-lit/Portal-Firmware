// ---------- Board: 3.5″ ESP32 display board (Hosyond / LCDwiki E32R35T, screen built in) ----------
// SPI pins (GPIO numbers). On boards with fixed SPI pins (Uno, Nano, Mega,
// ESP8266, Teensy) CLK and DIN must go to the hardware SPI pins shown in the
// Studio; CS, DC and RST can be any free pins.
#define PIN_SCK   14
#define PIN_MOSI  13
#define PIN_CS    15
#define PIN_DC    2
#define PIN_RST   -1

// Declared early so the Arduino IDE's automatic function prototypes compile
struct Spark;
struct Saved;

void beginBus() {
#if defined(ESP32)
  SPI.begin(PIN_SCK, -1, PIN_MOSI, PIN_CS);
#elif defined(ARDUINO_ARCH_RP2040)
  SPI.setSCK(PIN_SCK);
  SPI.setTX(PIN_MOSI);
  SPI.begin();
#else
  SPI.begin();                     // fixed hardware SPI pins
#endif
}
#define SPI_HZ    27000000UL   // screen speed; lower it if the picture glitches

#define SCR_W      480          // screen width and height as mounted
#define SCR_H      320
#define QX         240          // centre of the screen
#define QY         160
#define TQX        (SCR_W - QX)
#define TQY        (SCR_H - QY)
int      STRIP = 9600 / SCR_W;          // rows drawn per chunk (fewer if memory is tight)
#define MAX_SPARKS 30
#define MAX_PICS   8                     // picture slots
#define PORTAL     255                   // scene number for the portal itself
#define RADIUS_MAX 249
#define SP_EXT     288          // space styles: distance from the centre to the edge of the picture area

// ---------- Settings baked in from the Studio ----------
float    RADIUS     = 150.00;   // portal size in pixels
float    OVAL       = 1.00;    // 1.0 = round, higher = wide oval
uint8_t  ARMS       = 4;       // spiral arms
float    TWIST      = 2.40;    // how tightly the arms coil
float    SPEED      = 0.12;    // spin per frame
uint8_t  NUM_SPARKS = 28;      // particles being sucked in
bool     DRIFT      = false;    // Wormhole: true = Reverse, the rings fly out toward you (LCDs don't need burn-in drift)
uint32_t COLOR_CORE = 0x3B1CFF;  // inner colour
uint32_t COLOR_RIM  = 0x38F0FF;  // outer colour
uint8_t  BRIGHTNESS = 100;     // 10-100 %: dims the portal's colours
uint8_t  STYLE      = 0;       // 0 Vortex, 1 Toon Spiral, 2 Starburst, 3 Hyperspace, 4 Galaxy (Hubble-style spiral), 5 Black hole, 6 Cartoon Swirl, 7 Cartoon Sticker,
                                // crosses: 8 Latin, 9 Celtic, 10 Budded, 11 Patriarchal, 12 Orthodox, 13 Pattee (ESP32 boards)
                                // more space: 14 Nebula, 15 Wormhole, 16 Meteor Shower
uint32_t SPACE_COLS[4] = { 0x4A2C1A, 0xFF5C9A, 0x6EA8FF, 0xFFF0CF };   // Galaxy, Nebula, Wormhole, Meteor Shower: four colours blended together
uint8_t  CROSS_W    = 46;      // crosses: how far the crossbar reaches, % of the lower arm (25-100)
uint8_t  BEAM       = 14;      // crosses: beam thickness, % of the portal size (5-30)
uint8_t  BAR        = 32;      // crosses: crossbar height (20-50, 50 = all arms the same length)
uint8_t  STARS      = 3;       // space styles: star density (1-6)
bool     FADE_ON    = false;    // fade through the colour sets
uint8_t  FADE_COUNT = 1;       // extra colour sets after the main colours (1-3)
uint32_t FADE_COLS[6] = { 0xFF3D00, 0xFFD36B, 0x000000, 0x000000, 0x000000, 0x000000 };   // core, rim pairs
uint8_t  RIM_SMOOTH = 0;       // 0 = wobbly energy edge, 100 = perfectly smooth ring
float    FADE_SECS  = 8;       // seconds for each fade (0 min 8 sec)
uint8_t  RIPPLES    = 2;       // Starburst: rings expanding at once (0-6)
float    RIP_SPEED  = 0.09;    // Starburst: ripple speed (0.03-0.30)
float    GLOW_SIZE  = 0.55;    // Starburst: centre glow size (0.30-0.90)
uint8_t  SCENE_COUNT = 0;      // scenes shown in turn (0 = just the portal)
uint8_t  SCENES[8]  = { 255, 255, 255, 255, 255, 255, 255, 255 };   // 255 = the portal, 0-7 = pictures, 128-135 = portal around a picture
float    HOLD_SECS  = 10;       // seconds each scene stays on screen
float    SCENE_FADE = 2;       // seconds to fade into the next scene (0 = instant)
uint8_t  FRAME_PCT  = 50;      // "portal around a picture" scenes (128 + picture): how much of the picture the portal covers, 10-95 %
// --------------------------------------------------------

// Changes every time you copy a new sketch, so freshly uploaded settings
// win over ones saved earlier by live tuning.
const uint32_t BUILD_ID = 0x5DD7B671UL;

Adafruit_ST7796S tft(PIN_CS, PIN_DC, PIN_RST);   // needs the Adafruit ST7735 and ST7789 Library 1.11 or newer

// Lookup tables: distance and angle for one quarter of the screen (mirrored for the rest)
uint8_t  *rT, *aT;                     // TQX x TQY each, allocated in setup()
uint8_t  colMap[SCR_W];
int8_t   sinT[256];
int16_t  twistT[256], twist2T[256], edgeT[256];
uint8_t  depthT[256], coreT[256], haloT[256], rimT[64], centerT[256];
uint8_t  sbGlowT[256], sbRingT[256], sbOuterT[256], ripCrestT[256], ripTroughT[256];
uint8_t  spCoreT[256], bhRingT[256], bhDiskT[256], bhStarT[256];
uint16_t galFadeT[256];
uint8_t  warpOn[768];
float    warpRR[768], warpLen[768], warpB[768];
int      bhHole = 20, twinkle = 0;
int16_t  linT[256];
uint16_t pal[256];
uint16_t *stripBuf[2];                 // two strips: one is drawn while the other is sent (allocated in setup)
uint16_t *picBuf = NULL;               // a third strip, for fading between scenes
int      crossYC = QY;                 // crosses: row of the crossing (the cross is centred, so this sits above the middle)

// Dual-core chips (ESP32, ESP32-S3) draw on core 0 while core 1 feeds the screen.
#if defined(ESP32) && !CONFIG_FREERTOS_UNICORE
  #define DUAL_CORE 1
#else
  #define DUAL_CORE 0
#endif

// New settings from live tuning are applied between frames
volatile bool havePending = false;

struct Spark { float a, r; };
Spark sparks[MAX_SPARKS];
int16_t sparkX[MAX_SPARKS], sparkY[MAX_SPARKS];
float t = 0;

struct Saved { uint32_t id; float radius, oval, twist, speed; uint8_t arms, sparks, drift; uint32_t core, rim; uint8_t bright, style, ripples; float ripSpeed, glow; uint8_t stars, fadeOn, fadeCount; uint32_t fadeCols[6]; float fadeSecs; uint8_t rimSmooth; uint8_t sceneCount, scenes[8]; float holdSecs, sceneFade; uint8_t framePct, crossW, beam, bar; uint32_t spaceCols[4]; };
static_assert(sizeof(Saved) <= 128, "settings must fit the 128 bytes of EEPROM");

// ---------- tables ----------
// Cartoon styles: smooth looping noise tables
uint8_t nzA[32], nzB[64], nzC[256];
uint32_t nzSeed = 12345;
uint8_t nzRnd() { nzSeed = (nzSeed * 1103515245UL + 12345UL) & 0x7fffffffUL; return (nzSeed >> 16) & 255; }

void nzTable(uint8_t *t, int len, int passes) {
  int tmp[256], n[256];
  for (int i = 0; i < len; i++) n[i] = nzRnd();
  for (int p = 0; p < passes; p++) {
    for (int i = 0; i < len; i++) tmp[i] = (n[(i + len - 1) % len] + 2 * n[i] + n[(i + 1) % len]) >> 2;
    for (int i = 0; i < len; i++) n[i] = tmp[i];
  }
  int lo = 255, hi = 0;
  for (int i = 0; i < len; i++) { if (n[i] < lo) lo = n[i]; if (n[i] > hi) hi = n[i]; }
  for (int i = 0; i < len; i++) t[i] = (uint8_t)lroundf((n[i] - lo) * 255.0f / (hi - lo));
}

inline int nz(const uint8_t *t, int mask, int x) {
  int i = x >> 4, f = x & 15;
  return (t[i & mask] * (16 - f) + t[(i + 1) & mask] * f) >> 4;
}

void buildGeometry() {
  nzTable(nzA, 32, 1);
  nzTable(nzB, 64, 1);
  nzTable(nzC, 256, 2);
  for (int qy = 0; qy < TQY; qy++) {
    for (int qx = 0; qx < TQX; qx++) {
      float fx = qx + 0.5f, fy = qy + 0.5f;
      rT[qy * TQX + qx] = (uint8_t)min(255L, lroundf(sqrtf(fx * fx + fy * fy)));
      aT[qy * TQX + qx] = (uint8_t)lroundf(atan2f(fy, fx) / (PI / 2) * 64);
    }
  }
  for (int i = 0; i < 256; i++) sinT[i] = (int8_t)lroundf(127 * sinf(i * TWO_PI / 256));
}

void buildParams() {
  float R = RADIUS;
  for (int r = 0; r < 256; r++) {
    float rn = max((float)r, 0.5f) / R, lr = logf(rn), x = min(rn, 1.0f);
    twistT[r]  = (int16_t)(TWIST * 3.0f * lr * 40.74f);
    twist2T[r] = (int16_t)(TWIST * 1.6f * lr * 40.74f);
    depthT[r]  = (uint8_t)(255 * x * x * (3 - 2 * x));
    coreT[r]   = (uint8_t)(210 * expf(-rn * rn * 18));
    haloT[r]   = (uint8_t)(115 * expf(-r / R * 3.2f));
    linT[r]    = (int16_t)(r * TWIST * 1.2f * 256 / R);
    centerT[r] = (uint8_t)(55 * expf(-powf(rn * 2.2f, 2)));
    // Starburst: glowing centre, soft rings near the centre, rays toward the rim
    float sr = r / R, f1 = min(1.0f, sr / GLOW_SIZE), f2 = min(1.0f, max(0.0f, (sr - 0.15f) / 0.55f));
    int inner = (int)(256 * (1 - f1 * f1 * (3 - 2 * f1)));
    sbOuterT[r] = (uint8_t)min(255, (int)(256 * f2 * f2 * (3 - 2 * f2)));
    sbRingT[r]  = (uint8_t)min(255, (inner * inner * inner) >> 16);
    sbGlowT[r]  = (uint8_t)(105 * expf(-powf(sr / GLOW_SIZE * 1.4f, 2)));
    // Space: bright core, galaxy arm fade, black hole ring and disk
    spCoreT[r]  = (uint8_t)(230 * expf(-powf(rn / 0.16f, 2)));
    galFadeT[r] = (uint16_t)max(0, (int)(256 * (1 - sr * 0.7f)));
    float hr = 0.22f * R, dn = (sr - 0.22f) / 0.45f;
    bhRingT[r]  = (uint8_t)(255 * expf(-powf((r - hr - 1.5f) / 1.8f, 2)));
    bhDiskT[r]  = (dn >= 0 && dn < 1) ? (uint8_t)(235 - dn * 200) : 0;
    bhStarT[r]  = dn > 0.85f ? 1 : 0;
  }
  for (int d = 0; d < 64; d++) rimT[d] = (uint8_t)(255 * expf(-powf(d * 9.0f / R, 2)));
  for (int x = 0; x < SCR_W; x++) {
    int dx = x < QX ? QX - 1 - x : x - QX;
    colMap[x] = (uint8_t)min((long)(TQX - 1), lroundf(dx / OVAL));
  }
}

uint16_t to565(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }

uint32_t mixColor(uint32_t x, uint32_t y, float f) {   // blend two 0xRRGGBB colours
  uint32_t out = 0;
  for (int i = 0; i < 3; i++) {
    int cx = (x >> (16 - 8 * i)) & 0xFF, cy = (y >> (16 - 8 * i)) & 0xFF;
    out |= (uint32_t)(int)(cx + (cy - cx) * f) << (16 - 8 * i);
  }
  return out;
}

void buildPaletteFrom(uint32_t core, uint32_t rim) {   // black -> core -> rim -> near-white
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (core >> (16 - 8 * i)) & 0xFF; b[i] = (rim >> (16 - 8 * i)) & 0xFF; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    pal[i] = to565(c[0], c[1], c[2]);
  }
}

// Space colour table: 64 hues blended around the four space colours x 64 brightness levels
uint16_t *spaceLUT = NULL;             // allocated the first time a space style is shown
void buildSpaceLUT() {
  if (!spaceLUT) return;
  for (int h = 0; h < 64; h++) {
    float p = h / 16.0f; int i = (int)p; float f = p - i; f = f * f * (3 - 2 * f);
    uint32_t A = SPACE_COLS[i & 3], B = SPACE_COLS[(i + 1) & 3];
    float base[3];
    for (int k = 0; k < 3; k++) { int ca = (A >> (16 - 8 * k)) & 0xFF, cb = (B >> (16 - 8 * k)) & 0xFF; base[k] = ca + (cb - ca) * f; }
    for (int b = 0; b < 64; b++) {
      float v = b / 63.0f; uint8_t c[3];
      for (int k = 0; k < 3; k++) {
        float x = base[k] * min(1.0f, v / 0.75f);
        if (v > 0.75f) x += (255 - x) * (v - 0.75f) / 0.25f * 0.8f;   // the brightest parts glow toward white
        if (x > 255) x = 255;
        c[k] = (uint8_t)(x * BRIGHTNESS / 100.0f);
      }
      spaceLUT[h * 64 + b] = to565(c[0], c[1], c[2]);
    }
  }
}

void buildPalette() { buildPaletteFrom(COLOR_CORE, COLOR_RIM); buildSpaceLUT(); }

void updateColourFade() {             // fade through the colour sets in order, FADE_SECS per fade
  if (!FADE_ON || FADE_COUNT < 1) return;
  int n = 1 + FADE_COUNT;              // main colours + extra sets
  float pos = fmodf(millis() / 1000.0f / FADE_SECS, (float)n);
  int i = (int)pos, j = (i + 1) % n;
  float f = pos - i;
  f = f * f * (3 - 2 * f);
  uint32_t coreA = i == 0 ? COLOR_CORE : FADE_COLS[(i - 1) * 2], rimA = i == 0 ? COLOR_RIM : FADE_COLS[(i - 1) * 2 + 1];
  uint32_t coreB = j == 0 ? COLOR_CORE : FADE_COLS[(j - 1) * 2], rimB = j == 0 ? COLOR_RIM : FADE_COLS[(j - 1) * 2 + 1];
  buildPaletteFrom(mixColor(coreA, coreB, f), mixColor(rimA, rimB, f));
}

// ---------- space helpers ----------
uint32_t hash32(uint32_t n) {
  n = (n ^ 61) ^ (n >> 16);
  n *= 9;
  n ^= n >> 4;
  n *= 0x27d4eb2dUL;
  n ^= n >> 15;
  return n;
}

int starAt(int a, int r) {             // one twinkling star per small patch of sky
  uint32_t h = hash32((uint32_t)((a >> 1) * 977 + (r >> 2) * 131));
  if ((int)(h & 63) >= STARS * 2) return 0;
  if ((a & 1) != (int)((h >> 8) & 1) || (r & 3) != (int)((h >> 10) & 3)) return 0;
  return 120 + ((sinT[((h >> 12) + (uint32_t)twinkle) & 255] + 127) >> 1);
}

// ---------- sparks ----------
void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS * 1.05 + random(0, (int)(RADIUS / 5) + 1);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}

void updateSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= 0.95;                                         // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + RADIUS * 0.22));  // faster near the centre
    if (s.r < 3) respawn(s);
    sparkX[i] = (int16_t)floorf(QX + cosf(s.a) * s.r * OVAL);
    sparkY[i] = (int16_t)floorf((STYLE >= 8 && STYLE <= 13 ? crossYC : QY) + sinf(s.a) * s.r);
  }
}

// ---------- saved settings (EEPROM) ----------
bool validScenes(const Saved &s) {
  if (s.sceneCount > 8 || !(s.holdSecs >= 1 && s.holdSecs <= 3600) || !(s.sceneFade >= 0 && s.sceneFade <= 600)) return false;
  if (s.framePct < 10 || s.framePct > 95) return false;
  if (s.crossW < 25 || s.crossW > 100 || s.beam < 5 || s.beam > 30 || s.bar < 20 || s.bar > 50) return false;
  for (int k = 0; k < 4; k++) if (s.spaceCols[k] > 0xFFFFFF) return false;
  for (uint8_t i = 0; i < s.sceneCount; i++) {
    uint8_t c = s.scenes[i];
    if (c != PORTAL && c >= MAX_PICS && (c < 128 || c >= 128 + MAX_PICS)) return false;
  }
  return true;
}

bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4f && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF && s.bright >= 10 && s.bright <= 100 && s.style <= 16 && s.stars >= 1 && s.stars <= 6 && s.fadeCount >= 1 && s.fadeCount <= 3 && s.fadeSecs >= 1 && s.fadeSecs <= 3600 && s.rimSmooth <= 100 &&
         s.ripples <= 6 && s.ripSpeed >= 0.03f && s.ripSpeed <= 0.3f && s.glow >= 0.3f && s.glow <= 0.9f &&
         validScenes(s);
}

void apply(const Saved &s) {
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim; BRIGHTNESS = s.bright; STYLE = s.style;
  RIPPLES = s.ripples; RIP_SPEED = s.ripSpeed; GLOW_SIZE = s.glow; STARS = s.stars;
  FADE_ON = s.fadeOn; FADE_COUNT = s.fadeCount; FADE_SECS = s.fadeSecs; RIM_SMOOTH = s.rimSmooth;
  for (int k = 0; k < 6; k++) FADE_COLS[k] = s.fadeCols[k] & 0xFFFFFF;
  SCENE_COUNT = s.sceneCount; HOLD_SECS = s.holdSecs; SCENE_FADE = s.sceneFade; FRAME_PCT = s.framePct;
  CROSS_W = s.crossW; BEAM = s.beam; BAR = s.bar;
  for (int k = 0; k < 8; k++) SCENES[k] = s.scenes[k];
  for (int k = 0; k < 4; k++) SPACE_COLS[k] = s.spaceCols[k];
}

void loadSettings() {
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.begin(128);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void saveSettings() {
  Saved s = { BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM, BRIGHTNESS, STYLE, RIPPLES, RIP_SPEED, GLOW_SIZE, STARS, (uint8_t)FADE_ON, FADE_COUNT };
  for (int k = 0; k < 6; k++) s.fadeCols[k] = FADE_COLS[k];
  s.fadeSecs = FADE_SECS;
  s.rimSmooth = RIM_SMOOTH;
  s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
  s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
  for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
  for (int k = 0; k < 4; k++) s.spaceCols[k] = SPACE_COLS[k];
  EEPROM.put(0, s);
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.commit();
#endif
}

Saved pendingSettings;

float clampf(float v, float lo, float hi) { return v < lo ? lo : v > hi ? hi : v; }
uint8_t clampb(uint8_t v, uint8_t lo, uint8_t hi) { return v < lo ? lo : v > hi ? hi : v; }
void clampSettings(Saved &s) {
  s.radius = clampf(s.radius, 6, RADIUS_MAX); s.oval = clampf(s.oval, 1, 2); s.arms = clampb(s.arms, 1, 8);
  s.twist = clampf(s.twist, 0, 6); s.speed = clampf(s.speed, 0, 0.4f); if (s.sparks > MAX_SPARKS) s.sparks = MAX_SPARKS;
  s.core &= 0xFFFFFF; s.rim &= 0xFFFFFF; s.bright = clampb(s.bright, 10, 100); if (s.style > 16) s.style = 0;
  s.stars = clampb(s.stars, 1, 6); s.fadeCount = clampb(s.fadeCount, 1, 3); s.fadeSecs = clampf(s.fadeSecs, 1, 3600);
  if (s.rimSmooth > 100) s.rimSmooth = 100; if (s.ripples > 6) s.ripples = 6;
  s.ripSpeed = clampf(s.ripSpeed, 0.03f, 0.3f); s.glow = clampf(s.glow, 0.3f, 0.9f);
  for (int k = 0; k < 6; k++) s.fadeCols[k] &= 0xFFFFFF;
  for (int k = 0; k < 4; k++) s.spaceCols[k] &= 0xFFFFFF;
  if (s.sceneCount > 8) s.sceneCount = 8;
  s.holdSecs = clampf(s.holdSecs, 1, 3600); s.sceneFade = clampf(s.sceneFade, 0, 600); s.framePct = clampb(s.framePct, 10, 95);
  s.crossW = clampb(s.crossW, 25, 100); s.beam = clampb(s.beam, 5, 30); s.bar = clampb(s.bar, 20, 50);
  for (int k = 0; k < 8; k++) { uint8_t c = s.scenes[k]; if (c != PORTAL && c >= MAX_PICS && (c < 128 || c >= 128 + MAX_PICS)) s.scenes[k] = PORTAL; }
}

// ---------- pictures (ESP32 boards: kept in the flash "spiffs" partition) ----------
// The Studio crops each picture to this screen, sends it as a small JPEG and the
// board unpacks it into flash. Tools -> Partition Scheme -> "No OTA (2MB APP/2MB SPIFFS)"
// gives the most room. Commands: INFO, IMG slot bytes id, D base64..., END.
// (HAS_PICS and the JPEG decoder are set up with the other #includes at the top)
bool    crossReady = false;               // cross outline ready to read (styles 8-13)
int8_t *edgeBuf = NULL;                   // one strip of the cross outline
uint8_t crossRimT[128], crossHaloT[128];  // rim and outer glow, sized to the beam

#if HAS_PICS
struct PicHead { uint32_t magic; uint16_t w, h; uint32_t id, check; };
const uint32_t PIC_MAGIC = 0x43495056UL;   // "VPIC"
const uint32_t STAGE_SIZE = 0x30000;       // room for one arriving JPEG (192 KB, enough for high quality on big screens)
const esp_partition_t *picPart = NULL;
uint32_t slotSize = 0, stageOff = 0;      // stageOff: where an arriving JPEG waits (last 64 KB)
uint32_t crossOff = 0, crossSize = 0;     // the cross outline: distance to the edge for every pixel
uint8_t  picSlots = 0;
volatile uint32_t picId[MAX_PICS];        // 0 = empty slot
volatile bool uploading = false;
uint32_t upLen = 0, upPos = 0, upId = 0, upLast = 0, jpgPos = 0;
uint8_t  upSlot = 0;
uint16_t *band = NULL;
int      bandTop = 0;

void beginPictures() {
  picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_SPIFFS, NULL);
  if (!picPart) picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_FAT, NULL);
  if (!picPart || picPart->size < 0x80000) { picPart = NULL; return; }
  slotSize = (sizeof(PicHead) + (uint32_t)SCR_W * SCR_H * 2 + 4095) & ~4095UL;
  stageOff = (picPart->size - STAGE_SIZE) & ~4095UL;
  crossSize = (16 + (uint32_t)SCR_W * SCR_H + 4095) & ~4095UL;   // the cross outline lives just before the staging area
  crossOff = stageOff - crossSize;
  picSlots = min((uint32_t)MAX_PICS, crossOff / slotSize);
  for (uint8_t i = 0; i < picSlots; i++) {
    PicHead h;
    esp_partition_read(picPart, i * slotSize, &h, sizeof(h));
    bool ok = h.magic == PIC_MAGIC && h.w == SCR_W && h.h == SCR_H && h.id && h.check == (h.id ^ 0xA5A5A5A5UL);
    picId[i] = ok ? h.id : 0;
  }
}

int  picturesAvailable() { return picSlots; }
bool isPicture(uint8_t s) { return s < picSlots && picId[s] != 0; }

void readPicture(uint8_t s, int y0, int rows, uint16_t *dst) {
  esp_partition_read(picPart, s * slotSize + sizeof(PicHead) + (uint32_t)y0 * SCR_W * 2, dst, (uint32_t)rows * SCR_W * 2);
}

bool pausedForUpload() {
  if (uploading && millis() - upLast > 10000) uploading = false;   // the Studio went away mid-picture
  if (uploading) delay(1);
  return uploading;
}

int b64(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
  if (c >= '0' && c <= '9') return c - '0' + 52;
  if (c == '+') return 62;
  if (c == '/') return 63;
  return -1;
}

int unbase64(const char *in, uint8_t *out) {   // returns bytes written, -1 on bad data
  int n = 0, bits = 0;
  uint32_t acc = 0;
  for (; *in && *in != '='; in++) {
    int v = b64(*in);
    if (v < 0) return -1;
    acc = (acc << 6) | v; bits += 6;
    if (bits >= 8) { bits -= 8; out[n++] = (acc >> bits) & 0xFF; }
  }
  return n;
}

UINT jpgIn(JDEC *jd, BYTE *buf, UINT n) {        // JPEG bytes come from the staging area
  if (n > upLen - jpgPos) n = upLen - jpgPos;
  if (buf) esp_partition_read(picPart, stageOff + jpgPos, buf, n);
  jpgPos += n;
  return n;
}

UINT jpgOut(JDEC *jd, void *bmp, JRECT *r) {     // one block of pixels: collect a band, then store it
  BYTE *c = (BYTE *)bmp;
  for (int y = r->top; y <= r->bottom; y++)
    for (int x = r->left; x <= r->right; x++, c += 3)
      band[(y - bandTop) * SCR_W + x] = to565(c[0], c[1], c[2]);
  if (r->right == SCR_W - 1) {
    esp_partition_write(picPart, upSlot * slotSize + sizeof(PicHead) + (uint32_t)bandTop * SCR_W * 2,
                        band, (uint32_t)(r->bottom - bandTop + 1) * SCR_W * 2);
    bandTop = r->bottom + 1;
  }
  return 1;
}

const char *finishPicture() {
  uploading = false;
  if (upPos != upLen) return "ERR incomplete";
  static uint8_t pool[3100];               // the JPEG decoder's work area
  JDEC jd;
  jpgPos = 0;
  if (jd_prepare(&jd, jpgIn, pool, sizeof(pool), NULL) != JDR_OK) return "ERR jpeg";
  if (jd.width != SCR_W || jd.height != SCR_H) return "ERR size";
  band = (uint16_t *)malloc(SCR_W * 16 * 2);
  if (!band) return "ERR memory";
  esp_partition_erase_range(picPart, upSlot * slotSize, slotSize);
  bandTop = 0;
  JRESULT r = jd_decomp(&jd, jpgOut, 0);
  free(band); band = NULL;
  if (r != JDR_OK) return "ERR jpeg";
  PicHead h = { PIC_MAGIC, SCR_W, SCR_H, upId, upId ^ 0xA5A5A5A5UL };
  esp_partition_write(picPart, upSlot * slotSize, &h, sizeof(h));
  picId[upSlot] = upId;
  return "OK";
}

// ---------- cross shapes (styles 8-13), from the Cross Portal Tuner ----------
// Each cross is a union of simple shapes around its junction (the screen centre). The board works out
// the distance to the cross edge for every pixel once, stores it in flash, and reads it back per strip.
struct XShape { uint8_t t, dir; float cx, cy, hw, hh, r, w, a, b, len; };   // t: 0 box, 1 circle, 2 ring, 3 tilted box, 4 flared arm
XShape xs[6];
uint8_t nxs = 0;
const uint32_t CROSS_MAGIC = 0x52435856UL;   // "VXCR"
uint32_t crossKey = 0;

void addX(uint8_t t, float cx, float cy, float hw, float hh, float r = 0, float w = 0, float a = 0, float b = 0, float len = 0, uint8_t dir = 0) {
  XShape &o = xs[nxs++];
  o.t = t; o.cx = cx; o.cy = cy; o.hw = hw; o.hh = hh; o.r = r; o.w = w; o.a = a; o.b = b; o.len = len; o.dir = dir;
}

void crossShapes() {
  float R = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100);   // never taller than the screen (the cross is centred)
  float bot = R, top = bot * BAR / (100.0f - BAR);
  float AW = max(2.0f, R * BEAM / 100.0f), HHL = max(AW + 1, min(R * CROSS_W / 100.0f, SCR_W / 2.0f - 2));
  nxs = 0;
  switch (STYLE - 8) {
    case 1:                                        // Celtic: ring around the junction
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(2, 0, 0, 0, 0, max(AW * 1.9f, 0.62f * min(HHL, top)), max(2.0f, AW * 0.42f));
      break;
    case 2: {                                      // Budded: round ends
      float br = AW * 1.45f;
      addX(0, 0, (bot - top) / 2, AW, (bot - br - (-top + br)) / 2); addX(0, 0, 0, HHL - br, AW);
      addX(1, 0, -top + br, 0, 0, br); addX(1, 0, bot - br, 0, 0, br);
      addX(1, -(HHL - br), 0, 0, 0, br); addX(1, HHL - br, 0, 0, 0, br);
      break;
    }
    case 3: case 4: {                              // Patriarchal / Orthodox: extra bars
      float th = AW * 0.85f, gap = min(AW * 3.4f, top - th - 2);
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(0, 0, -gap, HHL * 0.6f, th);
      if (STYLE == 12) addX(3, 0, bot * 0.62f, HHL * 0.55f, th, 0, 0, -0.35f);
      break;
    }
    case 5: {                                      // Pattee: flared arms
      float a = AW * 0.55f, b = AW * 1.75f;
      addX(0, 0, 0, a, a);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, top, 0); addX(4, 0, 0, 0, 0, 0, 0, a, b, bot, 1);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 2); addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 3);
      break;
    }
    default:                                       // Latin
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
  }
}

float sdBox(float x, float y, float cx, float cy, float hw, float hh) {
  float dx = fabsf(x - cx) - hw, dy = fabsf(y - cy) - hh;
  return hypotf(fmaxf(dx, 0), fmaxf(dy, 0)) + fminf(fmaxf(dx, dy), 0);
}

float crossSD(float x, float y) {               // signed distance: negative inside the cross
  float d = 1e9f;
  for (uint8_t i = 0; i < nxs; i++) {
    const XShape &o = xs[i];
    float e;
    switch (o.t) {
      case 0: e = sdBox(x, y, o.cx, o.cy, o.hw, o.hh); break;
      case 1: e = hypotf(x - o.cx, y - o.cy) - o.r; break;
      case 2: e = fabsf(hypotf(x, y) - o.r) - o.w; break;
      case 3: { float c = cosf(o.a), s = sinf(o.a), dx = x - o.cx, dy = y - o.cy; e = sdBox(c * dx + s * dy, -s * dx + c * dy, 0, 0, o.hw, o.hh); break; }
      default: {
        float u = o.dir == 0 ? -y : o.dir == 1 ? y : o.dir == 2 ? -x : x, v = o.dir < 2 ? x : y, k = (o.b - o.a) / o.len;
        float side = (fabsf(v) - (o.a + k * constrain(u, 0.0f, o.len))) / sqrtf(1 + k * k);
        e = fmaxf(side, fmaxf(-u, u - o.len));
      }
    }
    d = fminf(d, e);
  }
  return d;
}

bool crossAvailable() { return picPart != NULL; }

int crossShift() {                              // move the crossing up so the whole cross is centred on the screen
  float bot = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100), top = bot * BAR / (100.0f - BAR);
  return (int)lroundf((bot - top) / 2);
}

void prepareCross() {                           // (re)build the outline when the cross settings change
  int shift = crossShift();
  crossYC = QY - shift;
  uint32_t key = 2166136261UL;
  uint32_t parts[] = { STYLE, (uint32_t)(RADIUS * 16), CROSS_W, BEAM, BAR, SCR_W, SCR_H, 2 };
  for (uint32_t v : parts) key = (key ^ v) * 16777619UL;
  if (key == crossKey && crossReady) return;
  crossReady = false;
  float rw = max(1.5f, max(2.0f, min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100) * BEAM / 100.0f) * 0.3f);
  for (int k = 0; k < 128; k++) { crossRimT[k] = (uint8_t)(255 * expf(-(k / rw) * (k / rw))); crossHaloT[k] = (uint8_t)(115 * expf(-k / 12.0f)); }
  uint32_t head[4];
  esp_partition_read(picPart, crossOff, head, 16);
  if (head[0] != CROSS_MAGIC || head[1] != key) {
    crossShapes();
    esp_partition_erase_range(picPart, crossOff, crossSize);
    static int8_t row[SCR_W];
    for (int y = 0; y < SCR_H; y++) {
      float fy = y + 0.5f - crossYC;            // relative to the crossing
      for (int x = 0; x < SCR_W; x++) {
        float e = -crossSD(x + 0.5f - SCR_W / 2.0f, fy);
        if (e > 0 && e < 1) e = 1;
        if (e <= 0 && e > -1) e = -1;
        row[x] = (int8_t)constrain((int)e, -127, 127);
      }
      esp_partition_write(picPart, crossOff + 16 + (uint32_t)y * SCR_W, row, SCR_W);
      if ((y & 7) == 7) delay(1);
    }
    uint32_t h2[4] = { CROSS_MAGIC, key, 0, 0 };
    esp_partition_write(picPart, crossOff, h2, 16);
  }
  crossKey = key;
  crossReady = true;
}

void readCrossRows(int y0, int rows) { esp_partition_read(picPart, crossOff + 16 + (uint32_t)y0 * SCR_W, edgeBuf, (uint32_t)rows * SCR_W); }

const char *pictureCommand(char *line) {
  if (strcasecmp(line, "INFO") == 0) {           // PICS slots width height id1 id2 ...
    static char info[128];
    int n = snprintf(info, sizeof(info), "PICS %u %u %u", picSlots, SCR_W, SCR_H);
    for (uint8_t i = 0; i < picSlots; i++) n += snprintf(info + n, sizeof(info) - n, " %lx", (unsigned long)picId[i]);
    return info;
  }
  if (strncasecmp(line, "IMG ", 4) == 0) {       // start a picture: slot, JPEG size, picture id
    unsigned slot; unsigned long len, id;
    if (!picPart || sscanf(line + 4, "%u %lu %lx", &slot, &len, &id) != 3 || slot >= picSlots || !len || len > STAGE_SIZE || !id) return "ERR";
    picId[slot] = 0;                             // stop showing the old picture
    upSlot = slot; upLen = len; upId = id; upPos = 0;
    esp_partition_erase_range(picPart, stageOff, (len + 4095) & ~4095UL);   // only what this picture needs
    uploading = true; upLast = millis();
    return "READY";
  }
  if (line[0] == 'D' && line[1] == ' ' && uploading) {   // a piece of the JPEG, in base64
    uint8_t data[200];
    int n = strlen(line + 2) <= 264 ? unbase64(line + 2, data) : -1;
    if (n < 0 || upPos + n > upLen) { uploading = false; return "ERR data"; }
    esp_partition_write(picPart, stageOff + upPos, data, n);
    upPos += n; upLast = millis();
    return "K";
  }
  if (strcasecmp(line, "END") == 0 && uploading) return finishPicture();
  return NULL;
}
#else
void beginPictures() {}
bool crossAvailable() { return false; }
void prepareCross() {}
void readCrossRows(int y0, int rows) {}
int  picturesAvailable() { return 0; }
bool isPicture(uint8_t s) { return false; }
void readPicture(uint8_t s, int y0, int rows, uint16_t *dst) {}
bool pausedForUpload() { return false; }
const char *pictureCommand(char *line) { return strcasecmp(line, "INFO") == 0 ? "PICS 0" : NULL; }
#endif

// ---------- live tuning over USB serial (and Bluetooth below) ----------
// Command: SET radius oval arms twist speed sparks drift core rim brightness style ripples ripspeed glow stars fade count core2 rim2 core3 rim3 core4 rim4 fadesecs rimsmooth
//              [scenecount scene1..scene8 holdsecs scenefade [framepct [crossw beam bar [space1..space4]]]]   (reply: OK or ERR)
// Pictures: INFO, then IMG slot bytes id / D base64... / END   (see "pictures" above)
char cmd[384];
uint16_t cmdLen = 0;

const char* handleCommand(char *line) {   // returns the reply to send back
  if (strncasecmp(line, "SET ", 4) == 0) {
    float v[44];
    uint8_t n = 0;
    char *p = strtok(line + 4, " ");
    while (p && n < 44) { v[n++] = atof(p); p = strtok(NULL, " "); }
    if (n == 25 || n == 36 || n == 37 || n == 40 || n == 44) {
      Saved s = { BUILD_ID, v[0], v[1], v[3], v[4], (uint8_t)v[2], (uint8_t)v[5], (uint8_t)v[6], (uint32_t)v[7], (uint32_t)v[8], (uint8_t)v[9], (uint8_t)v[10], (uint8_t)v[11], v[12], v[13], (uint8_t)v[14], (uint8_t)v[15], (uint8_t)v[16] };
      for (int k = 0; k < 6; k++) s.fadeCols[k] = (uint32_t)v[17 + k];
      s.fadeSecs = v[23];
      s.rimSmooth = (uint8_t)v[24];
      s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
      s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
      for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
      for (int k = 0; k < 4; k++) s.spaceCols[k] = n == 44 ? (uint32_t)v[40 + k] : SPACE_COLS[k];
      if (n >= 36) {
        s.sceneCount = (uint8_t)v[25];
        for (int k = 0; k < 8; k++) s.scenes[k] = (uint8_t)v[26 + k];
        s.holdSecs = v[34]; s.sceneFade = v[35];
      }
      if (n >= 37) s.framePct = (uint8_t)v[36];
      if (n >= 40) { s.crossW = (uint8_t)v[37]; s.beam = (uint8_t)v[38]; s.bar = (uint8_t)v[39]; }
      clampSettings(s);                  // anything out of range is brought back inside instead of refusing the update
      if (valid(s)) {
        pendingSettings = s;
        havePending = true;              // the drawing loop picks it up before the next frame
        return "OK";
      }
    }
    return "ERR";
  }
  if (strcasecmp(line, "PING") == 0) return "PORTAL";
  return pictureCommand(line);
}

void serialPoll(bool quick) {            // quick: between strips, answer settings at once (pictures wait for the end of the frame)
  while (Serial.available()) {
    if (quick) {
      char f = cmdLen ? cmd[0] : (char)Serial.peek();
      if (pausedForUpload() || !(f == 'S' || f == 's' || f == 'P' || f == 'p' || f == '\n' || f == '\r')) return;
    }
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (cmdLen) {
        cmd[cmdLen] = 0;
        const char *reply = handleCommand(cmd);
        if (reply) Serial.println(reply);
        cmdLen = 0;
        if (quick) return;
      }
    } else if (cmdLen < sizeof(cmd) - 1) {
      cmd[cmdLen++] = c;
    }
  }
}
void readSerial() { serialPoll(false); }
void readSerialQuick() { serialPoll(true); }

// ---------- Bluetooth tuning (ESP32 boards with Bluetooth) ----------
// The board shows up as "Vortex Portal". In the Studio (Chrome on Android or a
// computer), tap "Connect over Bluetooth". Same commands as USB.
#if defined(ESP32) && defined(CONFIG_BT_ENABLED)
  #define HAS_BLE 1
#else
  #define HAS_BLE 0
#endif

#if HAS_BLE
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLE2902.h>

#define BLE_SERVICE "6e400001-b5a3-f393-e0a9-e50e24dcca9e"
#define BLE_RX_CHAR "6e400002-b5a3-f393-e0a9-e50e24dcca9e"   // phone writes commands here
#define BLE_TX_CHAR "6e400003-b5a3-f393-e0a9-e50e24dcca9e"   // board replies here (notify)

BLECharacteristic *bleTx = NULL;
char bleBuf[384], bleLine[384];
uint16_t bleLen = 0;
volatile bool bleHave = false;

class PortalRx : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *c) {     // runs in the Bluetooth task: just collect the line
    String v = c->getValue().c_str();
    for (unsigned i = 0; i < v.length(); i++) {
      char ch = v[i];
      if (ch == '\n' || ch == '\r') {
        if (bleLen && !bleHave) { bleBuf[bleLen] = 0; memcpy(bleLine, bleBuf, bleLen + 1); bleHave = true; }
        bleLen = 0;
      } else if (bleLen < sizeof(bleBuf) - 1) {
        bleBuf[bleLen++] = ch;
      }
    }
  }
};

class PortalServer : public BLEServerCallbacks {
  void onDisconnect(BLEServer *s) { BLEDevice::startAdvertising(); }   // let the phone reconnect
};

void beginBluetooth() {
  BLEDevice::init("Vortex Portal");
  BLEServer *srv = BLEDevice::createServer();
  srv->setCallbacks(new PortalServer());
  BLEService *svc = srv->createService(BLE_SERVICE);
  bleTx = svc->createCharacteristic(BLE_TX_CHAR, BLECharacteristic::PROPERTY_NOTIFY);
  bleTx->addDescriptor(new BLE2902());
  BLECharacteristic *rx = svc->createCharacteristic(BLE_RX_CHAR, BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  rx->setCallbacks(new PortalRx());
  svc->start();
  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(BLE_SERVICE);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
}

void readBluetooth() {                    // handle a received line in the main loop
  if (!bleHave) return;
  const char *reply = handleCommand(bleLine);
  bleHave = false;
  if (reply && bleTx) {                   // sent in 20-byte pieces (the smallest Bluetooth packet), ending with a newline
    char out[136];
    int len = snprintf(out, sizeof(out), "%s\n", reply);
    for (int i = 0; i < len; i += 20) {
      bleTx->setValue((uint8_t *)out + i, min(20, len - i));
      bleTx->notify();
      delay(3);
    }
  }
}
