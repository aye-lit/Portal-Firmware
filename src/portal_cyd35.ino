// Vortex Portal for the 3.5–4.0″ rectangle ST7796 colour display (480x320, landscape)
// Generated by Vortex Portal Studio for: 3.5″ ESP32 display board (Hosyond / LCDwiki E32R35T, screen built in)
// Works on ESP32 (all types), Raspberry Pi Pico (RP2040/RP2350) and Teensy 4.
// To use another board, change the pin numbers in the "Board" section below.
// Libraries (Library Manager): "Adafruit ST7735 and ST7789 Library" and "Adafruit GFX Library".
// The portal is drawn in the centre of the screen.
//
// Wiring:  none, the screen is built into the board. Tools -> Board -> ESP32 Dev Module.
//
// Live tuning: open Vortex Portal Studio in Chrome and tap "Connect over Bluetooth"
// (ESP32 boards), or plug in over USB and click "Connect over USB". The board saves them.

#if defined(__AVR__) || defined(ESP8266)
  #error "This screen needs a board with more memory: an ESP32, Raspberry Pi Pico or Teensy 4."
#endif

#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7796S.h>
#include <EEPROM.h>
#include <math.h>
#if defined(ESP32)
  #include <freertos/FreeRTOS.h>
  #include <freertos/semphr.h>
#endif

// ---------- Board: 3.5″ ESP32 display board (Hosyond / LCDwiki E32R35T, screen built in) ----------
// SPI pins (GPIO numbers). On boards with fixed SPI pins (Uno, Nano, Mega,
// ESP8266, Teensy) CLK and DIN must go to the hardware SPI pins shown in the
// Studio; CS, DC and RST can be any free pins.
#define PIN_SCK   14
#define PIN_MOSI  13
#define PIN_CS    15
#define PIN_DC    2
#define PIN_RST   -1

// Declared early so the Arduino IDE's automatic function prototypes compile
struct Spark;
struct Saved;

void beginBus() {
#if defined(ESP32)
  SPI.begin(PIN_SCK, -1, PIN_MOSI, PIN_CS);
#elif defined(ARDUINO_ARCH_RP2040)
  SPI.setSCK(PIN_SCK);
  SPI.setTX(PIN_MOSI);
  SPI.begin();
#else
  SPI.begin();                     // fixed hardware SPI pins
#endif
}
#define SPI_HZ    27000000UL   // screen speed; lower it if the picture glitches

#define SCR_W      480          // screen width and height as mounted
#define SCR_H      320
#define QX         240          // centre of the screen
#define QY         160
#define TQX        (SCR_W - QX)
#define TQY        (SCR_H - QY)
int      STRIP = 9600 / SCR_W;          // rows drawn per chunk (fewer if memory is tight)
#define MAX_SPARKS 30
#define RADIUS_MAX 159

// ---------- Settings baked in from the Studio ----------
float    RADIUS     = 150.00;   // portal size in pixels
float    OVAL       = 1.00;    // 1.0 = round, higher = wide oval
uint8_t  ARMS       = 4;       // spiral arms
float    TWIST      = 2.40;    // how tightly the arms coil
float    SPEED      = 0.12;    // spin per frame
uint8_t  NUM_SPARKS = 28;      // particles being sucked in
bool     DRIFT      = true;    // not used on LCDs (they don't burn in)
uint32_t COLOR_CORE = 0x3B1CFF;  // inner colour
uint32_t COLOR_RIM  = 0x38F0FF;  // outer colour
uint8_t  BRIGHTNESS = 100;     // 10-100 %: dims the portal's colours
uint8_t  STYLE      = 0;       // 0 Vortex, 1 Toon Spiral, 2 Starburst, 3 Hyperspace, 4 Galaxy, 5 Black hole, 6 Cartoon Swirl, 7 Cartoon Sticker
uint8_t  STARS      = 3;       // space styles: star density (1-6)
bool     FADE_ON    = false;    // fade through the colour sets
uint8_t  FADE_COUNT = 1;       // extra colour sets after the main colours (1-3)
uint32_t FADE_COLS[6] = { 0xFF3D00, 0xFFD36B, 0x000000, 0x000000, 0x000000, 0x000000 };   // core, rim pairs
uint8_t  RIM_SMOOTH = 0;       // 0 = wobbly energy edge, 100 = perfectly smooth ring
float    FADE_SECS  = 8;       // seconds for each fade (0 min 8 sec)
uint8_t  RIPPLES    = 2;       // Starburst: rings expanding at once (0-6)
float    RIP_SPEED  = 0.09;    // Starburst: ripple speed (0.03-0.30)
float    GLOW_SIZE  = 0.55;    // Starburst: centre glow size (0.30-0.90)
// --------------------------------------------------------

// Changes every time you copy a new sketch, so freshly uploaded settings
// win over ones saved earlier by live tuning.
const uint32_t BUILD_ID = 0xDA2BE605UL;

Adafruit_ST7796S tft(PIN_CS, PIN_DC, PIN_RST);   // needs the Adafruit ST7735 and ST7789 Library 1.11 or newer

// Lookup tables: distance and angle for one quarter of the screen (mirrored for the rest)
uint8_t  *rT, *aT;                     // TQX x TQY each, allocated in setup()
uint8_t  colMap[SCR_W];
int8_t   sinT[256];
int16_t  twistT[256], twist2T[256], edgeT[256];
uint8_t  depthT[256], coreT[256], haloT[256], rimT[64], centerT[256];
uint8_t  sbGlowT[256], sbRingT[256], sbOuterT[256], ripCrestT[256], ripTroughT[256];
uint8_t  spCoreT[256], bhRingT[256], bhDiskT[256], bhStarT[256];
uint16_t galFadeT[256];
uint8_t  warpOn[768];
float    warpRR[768], warpLen[768], warpB[768];
int      bhHole = 20, twinkle = 0;
int16_t  linT[256];
uint16_t pal[256];
uint16_t *stripBuf[2];                 // two strips: one is drawn while the other is sent (allocated in setup)

// Dual-core chips (ESP32, ESP32-S3) draw on core 0 while core 1 feeds the screen.
#if defined(ESP32) && !CONFIG_FREERTOS_UNICORE
  #define DUAL_CORE 1
#else
  #define DUAL_CORE 0
#endif

// New settings from live tuning are applied between frames
volatile bool havePending = false;

struct Spark { float a, r; };
Spark sparks[MAX_SPARKS];
int16_t sparkX[MAX_SPARKS], sparkY[MAX_SPARKS];
float t = 0;

struct Saved { uint32_t id; float radius, oval, twist, speed; uint8_t arms, sparks, drift; uint32_t core, rim; uint8_t bright, style, ripples; float ripSpeed, glow; uint8_t stars, fadeOn, fadeCount; uint32_t fadeCols[6]; float fadeSecs; uint8_t rimSmooth; };

// ---------- tables ----------
// Cartoon styles: smooth looping noise tables
uint8_t nzA[32], nzB[64], nzC[256];
uint32_t nzSeed = 12345;
uint8_t nzRnd() { nzSeed = (nzSeed * 1103515245UL + 12345UL) & 0x7fffffffUL; return (nzSeed >> 16) & 255; }

void nzTable(uint8_t *t, int len, int passes) {
  int tmp[256], n[256];
  for (int i = 0; i < len; i++) n[i] = nzRnd();
  for (int p = 0; p < passes; p++) {
    for (int i = 0; i < len; i++) tmp[i] = (n[(i + len - 1) % len] + 2 * n[i] + n[(i + 1) % len]) >> 2;
    for (int i = 0; i < len; i++) n[i] = tmp[i];
  }
  int lo = 255, hi = 0;
  for (int i = 0; i < len; i++) { if (n[i] < lo) lo = n[i]; if (n[i] > hi) hi = n[i]; }
  for (int i = 0; i < len; i++) t[i] = (uint8_t)lroundf((n[i] - lo) * 255.0f / (hi - lo));
}

inline int nz(const uint8_t *t, int mask, int x) {
  int i = x >> 4, f = x & 15;
  return (t[i & mask] * (16 - f) + t[(i + 1) & mask] * f) >> 4;
}

void buildGeometry() {
  nzTable(nzA, 32, 1);
  nzTable(nzB, 64, 1);
  nzTable(nzC, 256, 2);
  for (int qy = 0; qy < TQY; qy++) {
    for (int qx = 0; qx < TQX; qx++) {
      float fx = qx + 0.5f, fy = qy + 0.5f;
      rT[qy * TQX + qx] = (uint8_t)min(255L, lroundf(sqrtf(fx * fx + fy * fy)));
      aT[qy * TQX + qx] = (uint8_t)lroundf(atan2f(fy, fx) / (PI / 2) * 64);
    }
  }
  for (int i = 0; i < 256; i++) sinT[i] = (int8_t)lroundf(127 * sinf(i * TWO_PI / 256));
}

void buildParams() {
  float R = RADIUS;
  for (int r = 0; r < 256; r++) {
    float rn = max((float)r, 0.5f) / R, lr = logf(rn), x = min(rn, 1.0f);
    twistT[r]  = (int16_t)(TWIST * 3.0f * lr * 40.74f);
    twist2T[r] = (int16_t)(TWIST * 1.6f * lr * 40.74f);
    depthT[r]  = (uint8_t)(255 * x * x * (3 - 2 * x));
    coreT[r]   = (uint8_t)(210 * expf(-rn * rn * 18));
    haloT[r]   = (uint8_t)(115 * expf(-r / R * 3.2f));
    linT[r]    = (int16_t)(r * TWIST * 1.2f * 256 / R);
    centerT[r] = (uint8_t)(55 * expf(-powf(rn * 2.2f, 2)));
    // Starburst: glowing centre, soft rings near the centre, rays toward the rim
    float sr = r / R, f1 = min(1.0f, sr / GLOW_SIZE), f2 = min(1.0f, max(0.0f, (sr - 0.15f) / 0.55f));
    int inner = (int)(256 * (1 - f1 * f1 * (3 - 2 * f1)));
    sbOuterT[r] = (uint8_t)min(255, (int)(256 * f2 * f2 * (3 - 2 * f2)));
    sbRingT[r]  = (uint8_t)min(255, (inner * inner * inner) >> 16);
    sbGlowT[r]  = (uint8_t)(105 * expf(-powf(sr / GLOW_SIZE * 1.4f, 2)));
    // Space: bright core, galaxy arm fade, black hole ring and disk
    spCoreT[r]  = (uint8_t)(230 * expf(-powf(rn / 0.16f, 2)));
    galFadeT[r] = (uint16_t)max(0, (int)(256 * (1 - sr * 0.7f)));
    float hr = 0.22f * R, dn = (sr - 0.22f) / 0.45f;
    bhRingT[r]  = (uint8_t)(255 * expf(-powf((r - hr - 1.5f) / 1.8f, 2)));
    bhDiskT[r]  = (dn >= 0 && dn < 1) ? (uint8_t)(235 - dn * 200) : 0;
    bhStarT[r]  = dn > 0.85f ? 1 : 0;
  }
  for (int d = 0; d < 64; d++) rimT[d] = (uint8_t)(255 * expf(-powf(d * 9.0f / R, 2)));
  for (int x = 0; x < SCR_W; x++) {
    int dx = x < QX ? QX - 1 - x : x - QX;
    colMap[x] = (uint8_t)min((long)(TQX - 1), lroundf(dx / OVAL));
  }
}

uint16_t to565(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }

uint32_t mixColor(uint32_t x, uint32_t y, float f) {   // blend two 0xRRGGBB colours
  uint32_t out = 0;
  for (int i = 0; i < 3; i++) {
    int cx = (x >> (16 - 8 * i)) & 0xFF, cy = (y >> (16 - 8 * i)) & 0xFF;
    out |= (uint32_t)(int)(cx + (cy - cx) * f) << (16 - 8 * i);
  }
  return out;
}

void buildPaletteFrom(uint32_t core, uint32_t rim) {   // black -> core -> rim -> near-white
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (core >> (16 - 8 * i)) & 0xFF; b[i] = (rim >> (16 - 8 * i)) & 0xFF; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    pal[i] = to565(c[0], c[1], c[2]);
  }
}

void buildPalette() { buildPaletteFrom(COLOR_CORE, COLOR_RIM); }

void updateColourFade() {             // fade through the colour sets in order, FADE_SECS per fade
  if (!FADE_ON || FADE_COUNT < 1) return;
  int n = 1 + FADE_COUNT;              // main colours + extra sets
  float pos = fmodf(millis() / 1000.0f / FADE_SECS, (float)n);
  int i = (int)pos, j = (i + 1) % n;
  float f = pos - i;
  f = f * f * (3 - 2 * f);
  uint32_t coreA = i == 0 ? COLOR_CORE : FADE_COLS[(i - 1) * 2], rimA = i == 0 ? COLOR_RIM : FADE_COLS[(i - 1) * 2 + 1];
  uint32_t coreB = j == 0 ? COLOR_CORE : FADE_COLS[(j - 1) * 2], rimB = j == 0 ? COLOR_RIM : FADE_COLS[(j - 1) * 2 + 1];
  buildPaletteFrom(mixColor(coreA, coreB, f), mixColor(rimA, rimB, f));
}

// ---------- space helpers ----------
uint32_t hash32(uint32_t n) {
  n = (n ^ 61) ^ (n >> 16);
  n *= 9;
  n ^= n >> 4;
  n *= 0x27d4eb2dUL;
  n ^= n >> 15;
  return n;
}

int starAt(int a, int r) {             // one twinkling star per small patch of sky
  uint32_t h = hash32((uint32_t)((a >> 1) * 977 + (r >> 2) * 131));
  if ((int)(h & 63) >= STARS * 2) return 0;
  if ((a & 1) != (int)((h >> 8) & 1) || (r & 3) != (int)((h >> 10) & 3)) return 0;
  return 120 + ((sinT[((h >> 12) + (uint32_t)twinkle) & 255] + 127) >> 1);
}

// ---------- sparks ----------
void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS * 1.05 + random(0, (int)(RADIUS / 5) + 1);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}

void updateSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= 0.95;                                         // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + RADIUS * 0.22));  // faster near the centre
    if (s.r < 3) respawn(s);
    sparkX[i] = (int16_t)floorf(QX + cosf(s.a) * s.r * OVAL);
    sparkY[i] = (int16_t)floorf(QY + sinf(s.a) * s.r);
  }
}

// ---------- saved settings (EEPROM) ----------
bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4 && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF && s.bright >= 10 && s.bright <= 100 && s.style <= 7 && s.stars >= 1 && s.stars <= 6 && s.fadeCount >= 1 && s.fadeCount <= 3 && s.fadeSecs >= 1 && s.fadeSecs <= 3600 && s.rimSmooth <= 100 &&
         s.ripples <= 6 && s.ripSpeed >= 0.03f && s.ripSpeed <= 0.3f && s.glow >= 0.3f && s.glow <= 0.9f;
}

void apply(const Saved &s) {
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim; BRIGHTNESS = s.bright; STYLE = s.style;
  RIPPLES = s.ripples; RIP_SPEED = s.ripSpeed; GLOW_SIZE = s.glow; STARS = s.stars;
  FADE_ON = s.fadeOn; FADE_COUNT = s.fadeCount; FADE_SECS = s.fadeSecs; RIM_SMOOTH = s.rimSmooth;
  for (int k = 0; k < 6; k++) FADE_COLS[k] = s.fadeCols[k] & 0xFFFFFF;
}

void loadSettings() {
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.begin(128);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void saveSettings() {
  Saved s = { BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM, BRIGHTNESS, STYLE, RIPPLES, RIP_SPEED, GLOW_SIZE, STARS, (uint8_t)FADE_ON, FADE_COUNT };
  for (int k = 0; k < 6; k++) s.fadeCols[k] = FADE_COLS[k];
  s.fadeSecs = FADE_SECS;
  s.rimSmooth = RIM_SMOOTH;
  EEPROM.put(0, s);
#if defined(ESP32) || defined(ESP8266) || defined(ARDUINO_ARCH_RP2040)
  EEPROM.commit();
#endif
}

Saved pendingSettings;

// ---------- live tuning over USB serial (and Bluetooth below) ----------
// Command: SET radius oval arms twist speed sparks drift core rim brightness style ripples ripspeed glow stars fade count core2 rim2 core3 rim3 core4 rim4 fadesecs rimsmooth   (reply: OK or ERR)
char cmd[256];
uint8_t cmdLen = 0;

const char* handleCommand(char *line) {   // returns the reply to send back
  if (strncasecmp(line, "SET ", 4) == 0) {
    float v[25];
    uint8_t n = 0;
    char *p = strtok(line + 4, " ");
    while (p && n < 25) { v[n++] = atof(p); p = strtok(NULL, " "); }
    if (n == 25) {
      Saved s = { BUILD_ID, v[0], v[1], v[3], v[4], (uint8_t)v[2], (uint8_t)v[5], (uint8_t)v[6], (uint32_t)v[7], (uint32_t)v[8], (uint8_t)v[9], (uint8_t)v[10], (uint8_t)v[11], v[12], v[13], (uint8_t)v[14], (uint8_t)v[15], (uint8_t)v[16] };
      for (int k = 0; k < 6; k++) s.fadeCols[k] = (uint32_t)v[17 + k];
      s.fadeSecs = v[23];
      s.rimSmooth = (uint8_t)v[24];
      if (valid(s)) {
        pendingSettings = s;
        havePending = true;              // the drawing loop picks it up before the next frame
        return "OK";
      }
    }
    return "ERR";
  }
  if (strcasecmp(line, "PING") == 0) return "PORTAL";
  return NULL;
}

void readSerial() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n' || c == '\r') {
      if (cmdLen) {
        cmd[cmdLen] = 0;
        const char *reply = handleCommand(cmd);
        if (reply) Serial.println(reply);
        cmdLen = 0;
      }
    } else if (cmdLen < sizeof(cmd) - 1) {
      cmd[cmdLen++] = c;
    }
  }
}

// ---------- Bluetooth tuning (ESP32 boards with Bluetooth) ----------
// The board shows up as "Vortex Portal". In the Studio (Chrome on Android or a
// computer), tap "Connect over Bluetooth". Same commands as USB.
#if defined(ESP32) && defined(CONFIG_BT_ENABLED)
  #define HAS_BLE 1
#else
  #define HAS_BLE 0
#endif

#if HAS_BLE
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLE2902.h>

#define BLE_SERVICE "6e400001-b5a3-f393-e0a9-e50e24dcca9e"
#define BLE_RX_CHAR "6e400002-b5a3-f393-e0a9-e50e24dcca9e"   // phone writes commands here
#define BLE_TX_CHAR "6e400003-b5a3-f393-e0a9-e50e24dcca9e"   // board replies here (notify)

BLECharacteristic *bleTx = NULL;
char bleBuf[256], bleLine[256];
uint16_t bleLen = 0;
volatile bool bleHave = false;

class PortalRx : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *c) {     // runs in the Bluetooth task: just collect the line
    String v = c->getValue().c_str();
    for (unsigned i = 0; i < v.length(); i++) {
      char ch = v[i];
      if (ch == '\n' || ch == '\r') {
        if (bleLen && !bleHave) { bleBuf[bleLen] = 0; memcpy(bleLine, bleBuf, bleLen + 1); bleHave = true; }
        bleLen = 0;
      } else if (bleLen < sizeof(bleBuf) - 1) {
        bleBuf[bleLen++] = ch;
      }
    }
  }
};

class PortalServer : public BLEServerCallbacks {
  void onDisconnect(BLEServer *s) { BLEDevice::startAdvertising(); }   // let the phone reconnect
};

void beginBluetooth() {
  BLEDevice::init("Vortex Portal");
  BLEServer *srv = BLEDevice::createServer();
  srv->setCallbacks(new PortalServer());
  BLEService *svc = srv->createService(BLE_SERVICE);
  bleTx = svc->createCharacteristic(BLE_TX_CHAR, BLECharacteristic::PROPERTY_NOTIFY);
  bleTx->addDescriptor(new BLE2902());
  BLECharacteristic *rx = svc->createCharacteristic(BLE_RX_CHAR, BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  rx->setCallbacks(new PortalRx());
  svc->start();
  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(BLE_SERVICE);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
}

void readBluetooth() {                    // handle a received line in the main loop
  if (!bleHave) return;
  const char *reply = handleCommand(bleLine);
  bleHave = false;
  if (reply && bleTx) {
    bleTx->setValue((uint8_t *)reply, strlen(reply));
    bleTx->notify();
  }
}
#endif

// ---------- one frame ----------
void frameStart() {
  if (havePending) {
    apply(pendingSettings);
    saveSettings();
    buildParams();
    buildPalette();
    resetSparks();
    havePending = false;
  }
  updateColourFade();
  updateSparks();
  for (int a = 0; a < 256; a++) {                     // wobbly rim edge for this frame
    float ang = a * TWO_PI / 256;
    float wob = sinf(ang * 5 + t * 2) * 1.2f + sinf(ang * 3 - t * 3) * 0.8f;
    edgeT[a] = (int16_t)(RADIUS * (1 + wob * 0.025f * (1 - RIM_SMOOTH / 100.0f)));
  }
  // Hyperspace: where each streaking star is this frame (3 layers x 256 directions)
  bhHole = (int)(0.22f * RADIUS);
  twinkle = (int)(t * 25);
  if (STYLE == 3) {
    for (int L = 0; L < 3; L++) {
      for (int a = 0; a < 256; a++) {
        uint32_t h = hash32((uint32_t)(a * 3 + L * 7919));
        int i = L * 256 + a;
        warpOn[i] = (int)(h & 15) < STARS + 1;
        float pos = fmodf((float)((h >> 8) & 1023) + t * (60 + L * 25), 1024.0f) / 1024.0f;
        float rr = pos * pos * 1.15f * RADIUS;
        warpRR[i] = rr;
        warpLen[i] = 1.5f + rr * 0.22f;
        warpB[i] = 145 * min(1.0f, rr / (0.8f * RADIUS));
      }
    }
  }
  // Starburst ripples: rings expanding outward, precomputed per distance for this frame
  memset(ripCrestT, 0, sizeof(ripCrestT));
  memset(ripTroughT, 0, sizeof(ripTroughT));
  if (STYLE == 2) {
    for (uint8_t i = 0; i < RIPPLES; i++) {
      float pr = fmodf(t * RIP_SPEED + (float)i / RIPPLES, 1.0f);
      float rr = 0.16f + pr * 0.62f, w = 0.04f + pr * 0.04f, fade = powf(1 - pr, 1.1f);
      for (int r = 0; r < 256; r++) {
        float d = (r / RADIUS - rr) / w;
        ripCrestT[r]  = (uint8_t)min(255, ripCrestT[r] + (int)(fade * 110 * expf(-d * d)));
        ripTroughT[r] = (uint8_t)min(255, ripTroughT[r] + (int)(fade * 35 * expf(-(d + 1.6f) * (d + 1.6f))));
      }
    }
  }
}

void frameEnd() {
  t += SPEED;
  if (t > TWO_PI * 100) t -= TWO_PI * 100;   // wrap seamlessly so it can run forever
}

inline int cartoonV(int a, int r, int phase) {   // blobby flat-shaded swirl
  int warp = (((nz(nzA, 31, a * 2 + r * 3 + (phase >> 1)) - 128) * 7) >> 3) + ((nz(nzB, 63, a * 4 + r * 6 - phase) - 128) >> 2);
  int sp = sinT[(a * ARMS - linT[r] + phase + warp) & 255];
  return r < 7 ? 232 : sp > 25 ? 232 : sp > -45 ? 182 : 120;
}

void renderStrip(int y0, int rows, uint16_t *strip) {
  const int phase = (int)(t * 1.5f * 40.74f), phase2 = (int)(-t * 40.74f);
  uint16_t *p = strip;
  for (int y = y0; y < y0 + rows; y++) {
    int qy = y < QY ? QY - 1 - y : y - QY;
    bool low = y >= QY;
    for (int x = 0; x < SCR_W; x++) {
      int qi = qy * TQX + colMap[x], r = rT[qi], a0 = aT[qi];
      int a = (x >= QX ? (low ? a0 : 256 - a0) : (low ? 128 - a0 : 128 + a0)) & 255;
      int e = edgeT[a];
      int v;
      if (STYLE == 7) {                                // Cartoon Sticker: ragged edge, light outline, no glow
        int jag = (((nz(nzB, 63, a * 4 + (phase >> 1)) - 128) * 7 + (nz(nzC, 255, a * 16 + phase) - 128) * 4) >> 7) * (100 - RIM_SMOOTH) / 100;
        int e2 = (int)(RADIUS * 1.02f + jag / 4.0f);
        v = r >= e2 ? 0 : r >= e2 - 4 ? 235 : cartoonV(a, r, phase);
      } else if (r < e) {
        if (STYLE == 0) {                              // Vortex
          int s  = sinT[(a * ARMS + twistT[r] + phase) & 255];
          int s2 = sinT[(a * 2 - twist2T[r] + phase2) & 255];
          int d = depthT[r];
          int band = ((s + 127) * 5 + (s2 + 127) * 3) >> 3;
          v = (d * (60 + ((band * 195) >> 8))) >> 8;   // swirling bands, darker toward the throat
          if (s > 100) v += ((s - 100) * 3 * d) >> 8; // bright spiral crests
          if (coreT[r] > v) v = coreT[r];              // glowing core
        } else if (STYLE == 1) {                       // Toon Spiral: flat-shaded wavy bands
          int w  = sinT[(a * 6 + r * 4 + phase2) & 255] >> 2;
          int sp = sinT[(a * ARMS - linT[r] + phase + w) & 255];
          v = sp > 40 ? 235 : sp > -20 ? 190 : sp > -70 ? 150 : 95;
          if (coreT[r] > v) v = coreT[r];
        } else if (STYLE == 6) {                       // Cartoon Swirl: blobby flat-shaded bands
          v = cartoonV(a, r, phase);
        } else if (STYLE == 3) {                       // Hyperspace: stars streak outward
          v = 30 + ((sinT[(a * 3 + (phase >> 3)) & 255] + 127) >> 4) + (spCoreT[r] >> 2);
          for (int L = 0; L < 3; L++) {
            int i = L * 256 + a;
            if (!warpOn[i]) continue;
            float rr = warpRR[i], len = warpLen[i];
            if (r <= rr && r > rr - len) {
              int sv = (int)(110 + warpB[i] * (1 - (rr - r) / len * 0.6f));
              if (sv > v) v = sv;
            }
          }
        } else if (STYLE == 4) {                       // Galaxy: spiral arms, glowing core, stars
          int arm   = sinT[(a * 2 + twistT[r] + (phase >> 2)) & 255];
          int lumps = sinT[(a * 5 + r * 3 - (phase >> 3)) & 255];
          int armV  = ((arm + 127) * galFadeT[r]) >> 8;
          v = 18 + ((armV * 115) >> 8) + ((lumps * (arm + 127)) >> 9) + spCoreT[r];
          int st = starAt(a, r); if (st > v) v = st;
          if (v < 0) v = 0;
        } else if (STYLE == 5) {                       // Black hole: shadow, bright ring, swirling disk
          if (r < bhHole) v = 0;
          else {
            int swirl = sinT[(a * 3 + r * 6 - phase * 2) & 255] + (sinT[(a * 7 - r * 3 - phase) & 255] >> 1);
            int disk  = bhDiskT[r] * (310 + swirl) / 500;
            v = bhRingT[r] > disk ? bhRingT[r] : disk;
            if (bhStarT[r]) { int st = starAt(a, r); if (st > v) v = st; }
          }
        } else {                                       // Starburst: glowing centre, soft rings, rays, ripples
          int ray  = sinT[(a * 11 + (phase >> 2)) & 255] + (sinT[(a * 19 - (phase >> 1)) & 255] >> 1) + (sinT[(a * 37 + phase) & 255] >> 1);
          int wave = sinT[(r * 4 - phase * 2 + (sinT[(a * 9 + (phase >> 2)) & 255] >> 4)) & 255];
          int tex  = sinT[(r * 9 - phase * 3 + (sinT[(a * 7 + (phase >> 1)) & 255] >> 3)) & 255];
          int sd   = sinT[(a * 22 + (phase >> 3)) & 255], sdp = sd > 0 ? sd : 0;
          v = 150 + sbGlowT[r]
            + ((((wave + 127) * 85 >> 8) * sbRingT[r]) >> 8)     // soft rings near the centre
            + ((((tex * 26) >> 7) * sbRingT[r]) >> 8)
            + ((((ray * 32) >> 7) * sbOuterT[r]) >> 8)            // rays toward the rim
            + ((ripCrestT[r] * (141 + ((sdp * 115) >> 7))) >> 8) - ripTroughT[r];   // expanding ripples
          if (v < 0) v = 0;
        }
        int k = e - r; if (k < 64 && rimT[k] > v) v = rimT[k];
      } else {
        int k = r - e; v = k < 64 ? rimT[k] : 0;       // rim
        int h = haloT[k > 255 ? 255 : k]; if (h > v) v = h;   // outer halo
      }
      *p++ = pal[v > 255 ? 255 : v];
    }
  }
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {           // sparks in this strip
    if (STYLE == 5 && sparks[i].r < bhHole) continue;  // they vanish into the black hole
    for (int dy = 0; dy < 2; dy++) for (int dx = 0; dx < 2; dx++) {
      int xx = sparkX[i] + dx, yy = sparkY[i] + dy;
      if (xx >= 0 && xx < SCR_W && yy >= y0 && yy < y0 + rows) strip[(yy - y0) * SCR_W + xx] = pal[235];
    }
  }
}

// ---------- frame-rate readout (Serial Monitor, 115200 baud) ----------
uint32_t fpsFrames = 0, fpsSince = 0;
void countFrame() {
  fpsFrames++;
  uint32_t now = millis();
  if (now - fpsSince >= 5000) {
    Serial.print(F("FPS: "));
    Serial.println(fpsFrames * 1000.0f / (now - fpsSince), 1);
    fpsFrames = 0;
    fpsSince = now;
  }
}

#if DUAL_CORE
SemaphoreHandle_t readySem[2], freeSem[2];

void renderTask(void *) {         // runs on core 0
  uint8_t b = 0;
  for (;;) {
    frameStart();
    for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
      xSemaphoreTake(freeSem[b], portMAX_DELAY);
      renderStrip(y0, min(STRIP, SCR_H - y0), stripBuf[b]);
      xSemaphoreGive(readySem[b]);
      b ^= 1;
    }
    frameEnd();
    vTaskDelay(1);                // let core 0's housekeeping run
  }
}
#endif

// Big tables live on the heap so large screens fit next to Bluetooth
bool allocBuffers() {
  rT = (uint8_t *)malloc(TQX * TQY);
  aT = (uint8_t *)malloc(TQX * TQY);
  if (!rT || !aT) return false;
  for (; STRIP >= 2; STRIP /= 2) {           // smaller strips if memory is tight
    stripBuf[0] = (uint16_t *)malloc(SCR_W * STRIP * 2);
    stripBuf[1] = (uint16_t *)malloc(SCR_W * STRIP * 2);
    if (stripBuf[0] && stripBuf[1]) return true;
    free(stripBuf[0]); free(stripBuf[1]);
  }
  return false;
}

void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println(F("[portal] starting"));
  // Board extras: backlight on, touch chip off the shared SPI bus, speaker and RGB LED off
  pinMode(27, OUTPUT); digitalWrite(27, HIGH);
  pinMode(33, OUTPUT); digitalWrite(33, HIGH);
  pinMode(4, OUTPUT);  digitalWrite(4, HIGH);
  pinMode(22, OUTPUT); digitalWrite(22, HIGH);
  pinMode(16, OUTPUT); digitalWrite(16, HIGH);
  pinMode(17, OUTPUT); digitalWrite(17, HIGH);
  beginBus();
  tft.init(320, 480, 0, 0, ST7796S_BGR);   // if red and blue look swapped, change ST7796S_BGR to ST7796S_RGB
  tft.invertDisplay(true);               // if the colours look like a photo negative, change true to false
  tft.setSPISpeed(SPI_HZ);
  tft.setRotation(1);                // landscape
  tft.fillScreen(0);
  Serial.println(F("[portal] screen ready"));
#if HAS_BLE
  beginBluetooth();                      // Bluetooth first: it needs one big block of memory
  Serial.println(F("[portal] bluetooth ready"));
#endif
  if (!allocBuffers()) {
    for (;;) { Serial.println(F("[portal] not enough memory for this screen")); delay(2000); }
  }
#if defined(ESP32)
  Serial.printf("[portal] memory ok, %u bytes free, %d rows per strip\n", (unsigned)ESP.getFreeHeap(), STRIP);
#endif
  loadSettings();
  randomSeed(micros());
  buildGeometry();
  buildParams();
  buildPalette();
  resetSparks();
#if DUAL_CORE
  for (int i = 0; i < 2; i++) {
    readySem[i] = xSemaphoreCreateBinary();
    freeSem[i] = xSemaphoreCreateBinary();
    xSemaphoreGive(freeSem[i]);
  }
  xTaskCreatePinnedToCore(renderTask, "portal", 4096, NULL, 1, NULL, 0);
#endif
  Serial.println(F("[portal] running"));
}

void loop() {
  readSerial();
#if HAS_BLE
  readBluetooth();
#endif
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W, SCR_H);
#if DUAL_CORE
  static uint8_t b = 0;
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    xSemaphoreTake(readySem[b], portMAX_DELAY);
    tft.writePixels(stripBuf[b], SCR_W * min(STRIP, SCR_H - y0));
    xSemaphoreGive(freeSem[b]);
    b ^= 1;
  }
#else
  frameStart();
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    int rows = min(STRIP, SCR_H - y0);
    renderStrip(y0, rows, stripBuf[0]);
    tft.writePixels(stripBuf[0], SCR_W * rows);
  }
  frameEnd();
#endif
  tft.endWrite();
  countFrame();
}
