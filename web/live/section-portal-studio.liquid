{% comment %} Display Studio: the Studio itself is kept in GitHub (aye-lit/Portal-Firmware, web/live/studio-embed.html) and loaded here, so updates don't need a new theme. {% endcomment %}
<div class="page-width"><div id="vps-mount"><p style="padding:40px 0;text-align:center;opacity:.7">Loading Display Studio…</p></div></div>
<script>
(function () {
  var mount = document.getElementById('vps-mount');
  var path = 'aye-lit/Portal-Firmware/main/web/live/studio-embed.html', t = Math.floor(Date.now() / 60000);
  var sources = ['https://raw.githubusercontent.com/' + path + '?t=' + t,                  // the latest version (a few minutes after each update)
                 'https://cdn.jsdelivr.net/gh/aye-lit/Portal-Firmware@main/web/live/studio-embed.html'];   // backup copy
  function show(html) {
    mount.innerHTML = html;
    mount.querySelectorAll('script').forEach(function (old) {   // scripts added this way don't run by themselves
      var s = document.createElement('script');
      for (var i = 0; i < old.attributes.length; i++) s.setAttribute(old.attributes[i].name, old.attributes[i].value);
      s.textContent = old.textContent;
      old.replaceWith(s);
    });
  }
  function tryFrom(i) {
    if (i >= sources.length) { mount.innerHTML = '<p style="padding:40px 0;text-align:center">Display Studio could not load. Please refresh the page.</p>'; return; }
    fetch(sources[i], { cache: 'no-store' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(function (html) { if (html.indexOf('id="vps"') < 0) throw new Error('bad'); show(html); })
      .catch(function () { tryFrom(i + 1); });
  }
  tryFrom(0);
})();
</script>

{% schema %}
{
  "name": "Display Studio",
  "settings": []
}
{% endschema %}
