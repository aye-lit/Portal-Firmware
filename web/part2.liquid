#define PIN_CS    ${B.spi.cs}
#define PIN_DC    ${B.spi.dc}
#define PIN_RST   ${B.spi.rst}

// Declared early so the Arduino IDE's automatic function prototypes compile
struct Spark;
struct Saved;

void beginBus() {
#if defined(ESP32)
  SPI.begin(PIN_SCK, -1, PIN_MOSI, PIN_CS);
#elif defined(ARDUINO_ARCH_RP2040)
  SPI.setSCK(PIN_SCK);
  SPI.setTX(PIN_MOSI);
  SPI.begin();
#else
  SPI.begin();                     // fixed hardware SPI pins
#endif
}`;
}
