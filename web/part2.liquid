// ---------- live tuning over USB serial (and Bluetooth below) ----------
// Command: SET radius oval arms twist speed sparks drift core rim brightness style ripples ripspeed glow stars fade count core2 rim2 core3 rim3 core4 rim4 fadesecs rimsmooth
//              [scenecount scene1..scene8 holdsecs scenefade [framepct [crossw beam bar [space1..space4 [crossfill [ripple [portrait [tone [warm]]]]]]]]]   (reply: OK or ERR)
//          scenes: 255 the portal, 0-7 pictures, 128-135 portal around a picture, 200-216 another style (200 + style number)
// Pictures: INFO, then IMG slot bytes id / D base64... / END   (see "pictures" above)
char cmd[SHOW_ON ? 1100 : 384];
uint16_t cmdLen = 0;

uint32_t rebootAt = 0;                   // set by the REBOOT command

const char* handleCommand(char *line) {   // returns the reply to send back
  if (strcasecmp(line, "TAP") == 0) { tapCount++; return "OK"; }   // same as tapping the screen: the next style (or scene)
#if HOME_PAGE
  if (strcasecmp(line, "HOME") == 0) { if (!homeActive()) return "ERR"; uiMode = 1; return "OK"; }   // open the home page (Wooden cross)
  if (strncasecmp(line, "UITAP ", 6) == 0) { char *q; simX = strtol(line + 6, &q, 10); simY = strtol(q, NULL, 10); simTap = true; return "OK"; }   // a touch on the home page at x y
  if (strncasecmp(line, "TCAL ", 5) == 0) {                                                        // the touch map, six numbers
    char *q = line + 5;
    for (int i = 0; i < 6; i++) tcal[i] = strtod(q, &q);
    tcalSave();
    return "OK";
  }
#if HOME_DUMP
  if (strcasecmp(line, "HOMEDUMP") == 0) { dumpReq = true; uiDirty = true; return "OK"; }
#endif
#endif
  if (strncasecmp(line, "SET ", 4) == 0) {
    float v[58];
    uint8_t n = 0;
    char *p = strtok(line + 4, " ");
    while (p && n < 58) { v[n++] = atof(p); p = strtok(NULL, " "); }
    if (n == 25 || n == 36 || n == 37 || n == 40 || n == 44 || n == 45 || n == 46 || n == 47 || n == 48 || n == 49 || n == 50 || n == 54 || n == 58) {
      Saved s = { BUILD_ID, v[0], v[1], v[3], v[4], (uint8_t)v[2], (uint8_t)v[5], (uint8_t)v[6], (uint32_t)v[7], (uint32_t)v[8], (uint8_t)v[9], (uint8_t)v[10], (uint8_t)v[11], v[12], v[13], (uint8_t)v[14], (uint8_t)v[15], (uint8_t)v[16] };
      for (int k = 0; k < 6; k++) s.fadeCols[k] = (uint32_t)v[17 + k];
      s.fadeSecs = v[23];
      s.rimSmooth = (uint8_t)v[24];
      s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
      s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
      for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
      for (int k = 0; k < 4; k++) s.spaceCols[k] = n >= 44 ? (uint32_t)v[40 + k] : SPACE_COLS[k];
      s.crossFill = n >= 45 ? (uint8_t)v[44] : CROSS_FILL;
      s.crossRipple = n >= 46 ? (uint8_t)v[45] : CROSS_RIPPLE;
      s.portrait = n >= 47 ? (uint8_t)v[46] : (uint8_t)((wantPortrait ? 1 : 0) | (wantFlip ? 2 : 0));   // portrait / landscape (screens that can turn)
      s.tone = n >= 48 ? (uint8_t)v[47] : TONE;                          // colour depth
      s.warm = n >= 49 ? (uint8_t)v[48] : WARM;                          // warmth
      s.tapOff = n >= 50 ? (v[49] ? 0 : 1) : TAP_OFF;                    // tap for next scene (touchscreens)
      s.fdLen = n >= 54 ? (uint8_t)v[50] : FD_LEN; s.fdStars = n >= 54 ? (uint8_t)v[51] : FD_STARCNT;   // Full day settings
      s.fdClouds = n >= 54 ? (uint8_t)v[52] : FD_CLOUDS; s.fdGlow = n >= 54 ? (uint8_t)v[53] : FD_GLOW;
      if (n >= 36) {
        s.sceneCount = (uint8_t)v[25];
        for (int k = 0; k < 8; k++) s.scenes[k] = (uint8_t)v[26 + k];
        s.holdSecs = v[34]; s.sceneFade = v[35];
      }
      if (n >= 37) s.framePct = (uint8_t)v[36];
      if (n >= 40) { s.crossW = (uint8_t)v[37]; s.beam = (uint8_t)v[38]; s.bar = (uint8_t)v[39]; }
      clampSettings(s);                  // anything out of range is brought back inside instead of refusing the update
      if (valid(s)) {
        if (n == 58) { for (int j = 0; j < 4; j++) pendRipC[j] = (uint32_t)v[54 + j] & 0xFFFFFF; pendRip = true; }   // Gradient ripple colours
        pendingSettings = s;
        havePending = true;              // the drawing loop picks it up before the next frame
        return "OK";
      }
    }
    return "ERR";
  }
  if (strncasecmp(line, "SCN ", 4) == 0) {   // SCN k radius oval arms twist speed sparks drift core rim bright ripples ripspeed glow stars rimsmooth space1..4 style crossfill ripple beam crossw bar  (or SCN k OFF)
    float v[34];                         // no reply: older boards ignore it the same way
    uint8_t n = 0; bool off = false;
    char *p = strtok(line + 4, " ");
    while (p && n < 34) { if (strcasecmp(p, "OFF") == 0) off = true; v[n++] = atof(p); p = strtok(NULL, " "); }
    int k = n ? (int)v[0] : -1;
    if (k < 0 || k > 7) return NULL;
