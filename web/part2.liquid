const TFT_MIN_RAM = 100;
function boardOf() {
  const base = BOARDS[S.board] || BOARDS.esp32s3;
  const B = JSON.parse(JSON.stringify(base));
  if (B.custom) {
    const c = S.custom || {};
    for (const k of ["sck", "mosi", "cs", "dc", "rst"]) if (Number.isInteger(c[k])) B.spi[k] = c[k];
    for (const k of ["sda", "scl"]) if (Number.isInteger(c[k])) B.i2c[k] = c[k];
    if (c.hz >= 1 && c.hz <= 80) B.hz = c.hz;
  }
  const lab = B.lab || {};
  B.lab = {};
  for (const k of ["sck", "mosi", "cs", "dc", "rst"]) B.lab[k] = lab[k] || (B.family === "AVR" || B.family === "Teensy" ? String(B.spi[k]) : "GPIO " + B.spi[k]);
  for (const k of ["sda", "scl"]) B.lab[k] = lab[k] || (B.family === "AVR" || B.family === "Teensy" ? String(B.i2c[k]) : "GPIO " + B.i2c[k]);
  return B;
}
const boardFits = (B, model) => (!B.screen || S.model === B.screen) && (model.kind !== "tft" || B.ram >= TFT_MIN_RAM);   // boards with a built-in screen only fit that screen
function wiringRows(B) {
  if (B.builtin) return [["Screen", "Built into the board"], ["Power and upload", "USB-C cable"]];
  const v = B.volt === 5 ? "5V" : "3V3";
  if (M.kind === "tft") return [["VCC", "3V3"], ["GND", "GND"], ["SCL", B.lab.sck], ["SDA", B.lab.mosi], ["DC", B.lab.dc], ["CS", B.lab.cs], ["RST", B.lab.rst], ["BLK (if present)", "3V3"]];
  if (M.kind === "rgb") return [["VCC", v], ["GND", "GND"], ["SCL (CLK)", B.lab.sck], ["SDA (DIN)", B.lab.mosi], ["RES", B.lab.rst], ["DC", B.lab.dc], ["CS", B.lab.cs]];
  return [["VCC", v], ["GND", "GND"], ["SCL", B.lab.scl], ["SDA", B.lab.sda]];
}
// C code that starts the right bus on whatever board the sketch is compiled for
// Bluetooth tuning (ESP32 boards): the board advertises as "Vortex Portal" and accepts the same
// text commands as USB on a Nordic-UART-style service. The Studio connects with Web Bluetooth.
const BLE_SVC = "6e400001-b5a3-f393-e0a9-e50e24dcca9e", BLE_RX = "6e400002-b5a3-f393-e0a9-e50e24dcca9e", BLE_TX = "6e400003-b5a3-f393-e0a9-e50e24dcca9e";
function bleBlock() { return `
// ---------- Bluetooth tuning (ESP32 boards with Bluetooth) ----------
// The board shows up as "Vortex Portal". In the Studio (Chrome on Android or a
// computer), tap "Connect over Bluetooth". Same commands as USB.
#if 0                                    // Bluetooth is switched off: it needed too much memory (USB only)
  #define HAS_BLE 1
#else
  #define HAS_BLE 0
#endif

#if HAS_BLE
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLE2902.h>

#define BLE_SERVICE "${BLE_SVC}"
#define BLE_RX_CHAR "${BLE_RX}"   // phone writes commands here
#define BLE_TX_CHAR "${BLE_TX}"   // board replies here (notify)

BLECharacteristic *bleTx = NULL;
char bleBuf[384], bleLine[384];
uint16_t bleLen = 0;
volatile bool bleHave = false;

class PortalRx : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *c) {     // runs in the Bluetooth task: just collect the line
    String v = c->getValue().c_str();
    for (unsigned i = 0; i < v.length(); i++) {
      char ch = v[i];
      if (ch == '\\n' || ch == '\\r') {
        if (bleLen && !bleHave) { bleBuf[bleLen] = 0; memcpy(bleLine, bleBuf, bleLen + 1); bleHave = true; }
        bleLen = 0;
      } else if (bleLen < sizeof(bleBuf) - 1) {
        bleBuf[bleLen++] = ch;
      }
    }
  }
};

class PortalServer : public BLEServerCallbacks {
  void onDisconnect(BLEServer *s) { BLEDevice::startAdvertising(); }   // let the phone reconnect
};

void beginBluetooth() {
  BLEDevice::init("Vortex Portal");
  BLEServer *srv = BLEDevice::createServer();
  srv->setCallbacks(new PortalServer());
  BLEService *svc = srv->createService(BLE_SERVICE);
  bleTx = svc->createCharacteristic(BLE_TX_CHAR, BLECharacteristic::PROPERTY_NOTIFY);
  bleTx->addDescriptor(new BLE2902());
  BLECharacteristic *rx = svc->createCharacteristic(BLE_RX_CHAR, BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR);
  rx->setCallbacks(new PortalRx());
  svc->start();
  BLEAdvertising *adv = BLEDevice::getAdvertising();
  adv->addServiceUUID(BLE_SERVICE);
  adv->setScanResponse(true);
  BLEDevice::startAdvertising();
}

void readBluetooth() {                    // handle a received line in the main loop
  if (!bleHave) return;
  const char *reply = handleCommand(bleLine);
  bleHave = false;
  if (reply && bleTx) {                   // sent in 20-byte pieces (the smallest Bluetooth packet), ending with a newline
    char out[136];
    int len = snprintf(out, sizeof(out), "%s\\n", reply);
    for (int i = 0; i < len; i += 20) {
      bleTx->setValue((uint8_t *)out + i, min(20, len - i));
      bleTx->notify();
      delay(3);
    }
  }
}
#endif`; }

// Pictures for colour screens on ESP32 boards: stored in the flash "spiffs" partition
function pictureBlock() { return `
// ---------- pictures (ESP32 boards: kept in the flash "spiffs" partition) ----------
// The Studio crops each picture to this screen, sends it as a small JPEG and the
// board unpacks it into flash. Tools -> Partition Scheme -> "No OTA (2MB APP/2MB SPIFFS)"
// gives the most room. Commands: INFO, IMG slot bytes id, D base64..., END.
// (HAS_PICS and the JPEG decoder are set up with the other #includes at the top)
bool    crossReady = false;               // cross outline ready to read (styles 8-13)
extern uint32_t woodPlaneKey, galFlashKey;
int8_t *edgeBuf = NULL;                   // one strip of the cross outline
uint8_t crossRimT[128], crossHaloT[128];  // rim and outer glow, sized to the beam

#if HAS_PICS
struct PicHead { uint32_t magic; uint16_t w, h; uint32_t id, check; };
const uint32_t PIC_MAGIC = 0x43495056UL;   // "VPIC"
const uint32_t STAGE_SIZE = 0x30000;       // room for one arriving JPEG (192 KB, enough for high quality on big screens)
const esp_partition_t *picPart = NULL;
uint32_t slotSize = 0, stageOff = 0;      // stageOff: where an arriving JPEG waits (last 64 KB)
uint32_t crossOff = 0, crossSize = 0, crossPlane = 0, woodOff = 0;   // the cross outline (distance to the edge for every pixel) and the wood in use
uint8_t  picSlots = 0;
#define MAX_PLANES 10                     // cross outlines and wood kept side by side, so scenes can switch crosses without rebuilding them
uint8_t  nPlanes = 0;
uint32_t planesOff = 0;                   // the first one (they sit just before the staging area)
uint32_t planeMagic[MAX_PLANES], planeKeyOf[MAX_PLANES], planeUse[MAX_PLANES], planeTick = 0;
int8_t   crossSlot = -1, woodSlot = -1;   // the ones in use now
volatile uint32_t picId[MAX_PICS];        // 0 = empty slot
uint16_t picW[MAX_PICS];                  // the width each picture was made for (the screen may have been turned since)
volatile bool uploading = false;
uint32_t upLen = 0, upPos = 0, upId = 0, upLast = 0, jpgPos = 0;
uint8_t  upSlot = 0;
uint16_t *band = NULL;
int      bandTop = 0;

void mapPlanes();
void beginPictures() {
  picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_SPIFFS, NULL);
  if (!picPart) picPart = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_FAT, NULL);
  if (!picPart || picPart->size < 0x80000) { picPart = NULL; return; }
  slotSize = (sizeof(PicHead) + (uint32_t)SCR_W * SCR_H * 2 + 4095) & ~4095UL;
  stageOff = (picPart->size - STAGE_SIZE) & ~4095UL;
  crossPlane = (16 + (uint32_t)SCR_W * SCR_H + 4095) & ~4095UL;
  crossSize = crossPlane;
  {                                        // room for several cross outlines (and wood), keeping at least 5 pictures where possible
    uint32_t room = stageOff, keepPics = min((uint32_t)5, room / slotSize);
    uint32_t n = (room - keepPics * slotSize) / crossPlane;
    if (n < 1) { n = 1; }
    nPlanes = min((uint32_t)MAX_PLANES, n);
  }
  planesOff = stageOff - nPlanes * crossPlane;
  crossOff = woodOff = planesOff;
  picSlots = min((uint32_t)MAX_PICS, planesOff / slotSize);
  for (uint8_t i = 0; i < nPlanes; i++) {   // what each one holds
    uint32_t h[4]; esp_partition_read(picPart, planesOff + (uint32_t)i * crossPlane, h, 16);
    planeMagic[i] = h[0]; planeKeyOf[i] = h[1]; planeUse[i] = 0;
  }
  for (uint8_t i = 0; i < picSlots; i++) {
    PicHead h;
    esp_partition_read(picPart, i * slotSize, &h, sizeof(h));
    bool ok = h.magic == PIC_MAGIC && (uint32_t)h.w * h.h == (uint32_t)SCR_W * SCR_H && h.id && h.check == (h.id ^ 0xA5A5A5A5UL);
    picId[i] = ok ? h.id : 0;
    picW[i] = h.w;
  }
  mapPlanes();                             // the cross and wood strips are read through the flash cache
}

int  picturesAvailable() { return picSlots; }
bool isPicture(uint8_t s) { return s < picSlots && picId[s] != 0 && picW[s] == SCR_W; }

void readPicture(uint8_t s, int y0, int rows, uint16_t *dst) {
  esp_partition_read(picPart, s * slotSize + sizeof(PicHead) + (uint32_t)y0 * SCR_W * 2, dst, (uint32_t)rows * SCR_W * 2);
}

bool pausedForUpload() {
  if (uploading && millis() - upLast > 10000) uploading = false;   // the Studio went away mid-picture
  if (uploading) delay(1);
  return uploading;
}

int b64(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
  if (c >= '0' && c <= '9') return c - '0' + 52;
  if (c == '+') return 62;
  if (c == '/') return 63;
  return -1;
}

int unbase64(const char *in, uint8_t *out) {   // returns bytes written, -1 on bad data
  int n = 0, bits = 0;
  uint32_t acc = 0;
  for (; *in && *in != '='; in++) {
    int v = b64(*in);
    if (v < 0) return -1;
    acc = (acc << 6) | v; bits += 6;
    if (bits >= 8) { bits -= 8; out[n++] = (acc >> bits) & 0xFF; }
  }
  return n;
}

UINT jpgIn(JDEC *jd, BYTE *buf, UINT n) {        // JPEG bytes come from the staging area
  if (n > upLen - jpgPos) n = upLen - jpgPos;
  if (buf) esp_partition_read(picPart, stageOff + jpgPos, buf, n);
  jpgPos += n;
  return n;
}

UINT jpgOut(JDEC *jd, void *bmp, JRECT *r) {     // one block of pixels: collect a band, then store it
  BYTE *c = (BYTE *)bmp;
  for (int y = r->top; y <= r->bottom; y++)
    for (int x = r->left; x <= r->right; x++, c += 3)
      band[(y - bandTop) * SCR_W + x] = to565(c[0], c[1], c[2]);
  if (r->right == SCR_W - 1) {
    esp_partition_write(picPart, upSlot * slotSize + sizeof(PicHead) + (uint32_t)bandTop * SCR_W * 2,
                        band, (uint32_t)(r->bottom - bandTop + 1) * SCR_W * 2);
    bandTop = r->bottom + 1;
  }
  return 1;
}

const char *finishPicture() {
  uploading = false;
  if (upPos != upLen) return "ERR incomplete";
  static uint8_t pool[3100];               // the JPEG decoder's work area
  JDEC jd;
  jpgPos = 0;
  if (jd_prepare(&jd, jpgIn, pool, sizeof(pool), NULL) != JDR_OK) return "ERR jpeg";
  if (jd.width != SCR_W || jd.height != SCR_H) return "ERR size";
  band = (uint16_t *)malloc(SCR_W * 16 * 2);
  if (!band) return "ERR memory";
  esp_partition_erase_range(picPart, upSlot * slotSize, slotSize);
  bandTop = 0;
  JRESULT r = jd_decomp(&jd, jpgOut, 0);
  free(band); band = NULL;
  if (r != JDR_OK) return "ERR jpeg";
  PicHead h = { PIC_MAGIC, SCR_W, SCR_H, upId, upId ^ 0xA5A5A5A5UL };
  esp_partition_write(picPart, upSlot * slotSize, &h, sizeof(h));
  picId[upSlot] = upId;
  picW[upSlot] = SCR_W;
  return "OK";
}

// ---------- cross shapes (styles 8-13), from the Cross Portal Tuner ----------
// Each cross is a union of simple shapes around its junction (the screen centre). The board works out
// the distance to the cross edge for every pixel once, stores it in flash, and reads it back per strip.
struct XShape { uint8_t t, dir; float cx, cy, hw, hh, r, w, a, b, len; };   // t: 0 box, 1 circle, 2 ring, 3 tilted box, 4 flared arm
XShape xs[6];
uint8_t nxs = 0;
const uint32_t CROSS_MAGIC = 0x52435856UL;   // "VXCR"
uint32_t crossKey = 0;

void addX(uint8_t t, float cx, float cy, float hw, float hh, float r = 0, float w = 0, float a = 0, float b = 0, float len = 0, uint8_t dir = 0) {
  XShape &o = xs[nxs++];
  o.t = t; o.cx = cx; o.cy = cy; o.hw = hw; o.hh = hh; o.r = r; o.w = w; o.a = a; o.b = b; o.len = len; o.dir = dir;
}

void crossShapes() {
  float R = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100);   // never taller than the screen (the cross is centred)
  float bot = R, top = bot * BAR / (100.0f - BAR);
  float AW = max(2.0f, R * BEAM / 100.0f), HHL = max(AW + 1, min(R * CROSS_W / 100.0f, SCR_W / 2.0f - 2));
  nxs = 0;
  switch (STYLE - 8) {
    case 1:                                        // Celtic: ring around the junction
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(2, 0, 0, 0, 0, max(AW * 1.9f, 0.62f * min(HHL, top)), max(2.0f, AW * 0.42f));
      break;
    case 2: {                                      // Budded: round ends
      float br = AW * 1.45f;
      addX(0, 0, (bot - top) / 2, AW, (bot - br - (-top + br)) / 2); addX(0, 0, 0, HHL - br, AW);
      addX(1, 0, -top + br, 0, 0, br); addX(1, 0, bot - br, 0, 0, br);
      addX(1, -(HHL - br), 0, 0, 0, br); addX(1, HHL - br, 0, 0, 0, br);
      break;
    }
    case 3: case 4: {                              // Patriarchal / Orthodox: extra bars
      float th = AW * 0.85f, gap = min(AW * 3.4f, top - th - 2);
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
      addX(0, 0, -gap, HHL * 0.6f, th);
      if (STYLE == 12) addX(3, 0, bot * 0.62f, HHL * 0.55f, th, 0, 0, -0.35f);
      break;
    }
    case 5: {                                      // Pattee: flared arms
      float a = AW * 0.55f, b = AW * 1.75f;
      addX(0, 0, 0, a, a);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, top, 0); addX(4, 0, 0, 0, 0, 0, 0, a, b, bot, 1);
      addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 2); addX(4, 0, 0, 0, 0, 0, 0, a, b, HHL, 3);
      break;
    }
    default:                                       // Latin
      addX(0, 0, (bot - top) / 2, AW, (bot + top) / 2); addX(0, 0, 0, HHL, AW);
  }
}

float sdBox(float x, float y, float cx, float cy, float hw, float hh) {
  float dx = fabsf(x - cx) - hw, dy = fabsf(y - cy) - hh;
  return hypotf(fmaxf(dx, 0), fmaxf(dy, 0)) + fminf(fmaxf(dx, dy), 0);
}

float crossSD(float x, float y) {               // signed distance: negative inside the cross
  float d = 1e9f;
  for (uint8_t i = 0; i < nxs; i++) {
    const XShape &o = xs[i];
    float e;
    switch (o.t) {
      case 0: e = sdBox(x, y, o.cx, o.cy, o.hw, o.hh); break;
      case 1: e = hypotf(x - o.cx, y - o.cy) - o.r; break;
      case 2: e = fabsf(hypotf(x, y) - o.r) - o.w; break;
      case 3: { float c = cosf(o.a), s = sinf(o.a), dx = x - o.cx, dy = y - o.cy; e = sdBox(c * dx + s * dy, -s * dx + c * dy, 0, 0, o.hw, o.hh); break; }
      default: {
        float u = o.dir == 0 ? -y : o.dir == 1 ? y : o.dir == 2 ? -x : x, v = o.dir < 2 ? x : y, k = (o.b - o.a) / o.len;
        float side = (fabsf(v) - (o.a + k * constrain(u, 0.0f, o.len))) / sqrtf(1 + k * k);
        e = fmaxf(side, fmaxf(-u, u - o.len));
      }
    }
    d = fminf(d, e);
  }
  return d;
}

bool crossAvailable() { return picPart != NULL; }

int crossShift() {                              // move the crossing up so the whole cross is centred on the screen
  float bot = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100), top = bot * BAR / (100.0f - BAR);
  return (int)lroundf((bot - top) / 2);
}

int findPlane(uint32_t magic, uint32_t key) {
  for (int i = 0; i < nPlanes; i++) if (planeMagic[i] == magic && planeKeyOf[i] == key) return i;
  return -1;
}
int freePlane() {                               // one to (re)build: never the cross or wood in use, otherwise the longest unused
  int best = -1;
  for (int i = 0; i < nPlanes; i++) {
    if (i == crossSlot || i == woodSlot) continue;
    if (best < 0 || planeUse[i] < planeUse[best]) best = i;
  }
  return best >= 0 ? best : (crossSlot == 0 && nPlanes > 1 ? 1 : 0);
}
void prepareCross() {                           // (re)build the outline when the cross settings change
  int shift = crossShift();
  crossYC = QY - shift;
  uint32_t key = 2166136261UL;
  uint32_t parts[] = { STYLE, (uint32_t)(RADIUS * 16), CROSS_W, BEAM, BAR, SCR_W, SCR_H, 2 };
  for (uint32_t v : parts) key = (key ^ v) * 16777619UL;
  if (key == crossKey && crossReady) return;
  crossReady = false;
  int slot = findPlane(CROSS_MAGIC, key);       // made before (another scene's cross): use it as it is
  bool build = slot < 0;
  if (build) { slot = freePlane(); if (slot == woodSlot) { woodSlot = -1; woodPlaneKey = 0; } }
  crossOff = planesOff + (uint32_t)slot * crossPlane; crossSlot = slot; planeUse[slot] = ++planeTick;
  float rw = max(1.5f, max(2.0f, min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100) * BEAM / 100.0f) * 0.18f);
  for (int k = 0; k < 128; k++) { crossRimT[k] = (uint8_t)(255 * expf(-(k / rw) * (k / rw))); crossHaloT[k] = (uint8_t)(115 * expf(-k / 12.0f)); }
  if (build) {
    planeMagic[slot] = 0;
    crossShapes();
    esp_partition_erase_range(picPart, crossOff, crossSize);
    static int8_t row[SCR_WMAX];
    for (int y = 0; y < SCR_H; y++) {
      float fy = y + 0.5f - crossYC;            // relative to the crossing
      for (int x = 0; x < SCR_W; x++) {
        float e = -crossSD(x + 0.5f - SCR_W / 2.0f, fy);
        if (e > 0 && e < 1) e = 1;
        if (e <= 0 && e > -1) e = -1;
        row[x] = (int8_t)constrain((int)e, -127, 127);
      }
      esp_partition_write(picPart, crossOff + 16 + (uint32_t)y * SCR_W, row, SCR_W);
      if ((y & 7) == 7) delay(1);
    }
    uint32_t h2[4] = { CROSS_MAGIC, key, 0, 0 };
    esp_partition_write(picPart, crossOff, h2, 16);
    planeMagic[slot] = CROSS_MAGIC; planeKeyOf[slot] = key;
  }
  crossKey = key;
  crossReady = true;
}

const uint8_t *planeMap = NULL;           // the cross outline and the wood, mapped into memory: read through the fast flash cache
esp_partition_mmap_handle_t planeH;
void mapPlanes() {
  const void *ptr;
  if (!planeMap && esp_partition_mmap(picPart, planesOff, stageOff + STAGE_SIZE - planesOff, ESP_PARTITION_MMAP_DATA, &ptr, &planeH) == ESP_OK) planeMap = (const uint8_t *)ptr;   // (the staging area too: the galaxy picture sits at its end)
}
void readCrossRows(int y0, int rows) {   // (mapped: nothing to copy, edgeRows() points straight at it)
  if (!planeMap) esp_partition_read(picPart, crossOff + 16 + (uint32_t)y0 * SCR_W, edgeBuf, (uint32_t)rows * SCR_W);
}
const int8_t *edgeRows(int y0) { return planeMap ? (const int8_t *)(planeMap + (crossOff - planesOff) + 16 + (uint32_t)y0 * SCR_W) : edgeBuf; }   // a strip of the cross outline (either core)
void readEdgeRow(int y, int8_t *dst) { esp_partition_read(picPart, crossOff + 16 + (uint32_t)y * SCR_W, dst, SCR_W); }
const uint32_t WOOD_MAGIC = 0x444F4F57UL;  // "WOOD"
bool woodPlaneReady(uint32_t key) {             // made before? then use it (otherwise pick a place to make it)
  int s = findPlane(WOOD_MAGIC, key), had = s >= 0;
  if (!had) { s = freePlane(); planeMagic[s] = 0; }
  woodSlot = s; woodOff = planesOff + (uint32_t)s * crossPlane; planeUse[s] = ++planeTick;
  return had;
}
void woodPlaneBegin() { esp_partition_erase_range(picPart, woodOff, crossPlane); }
void woodPlaneRow(int y, const uint8_t *row) { esp_partition_write(picPart, woodOff + 16 + (uint32_t)y * SCR_W, row, SCR_W); }
void woodPlaneEnd(uint32_t key) { uint32_t h[4] = { WOOD_MAGIC, key, 0, 0 }; esp_partition_write(picPart, woodOff, h, 16); planeMagic[woodSlot] = WOOD_MAGIC; planeKeyOf[woodSlot] = key; }
void readWoodRows(int y0, int rows, uint8_t *dst) {
  if (!planeMap) esp_partition_read(picPart, woodOff + 16 + (uint32_t)y0 * SCR_W, dst, (uint32_t)rows * SCR_W);
