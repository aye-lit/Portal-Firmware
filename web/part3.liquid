uint8_t  RIM_SMOOTH = ${S.rimsmooth};       // 0 = wobbly energy edge, 100 = perfectly smooth ring
uint32_t CROSS_COL  = 0x${colCode(S.crossCol).toString(16).toUpperCase()};   // glowing crosses: the outline colour (0x1000000: the main colours)
