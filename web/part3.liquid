uint8_t  CROSS_FILL = ${S.crossFill};       // crosses: what's drawn inside (0 Vortex, 1 Toon Spiral, 2 Starburst, 3 Hyperspace, 4 Galaxy, 5 Black hole, 6 Cartoon Swirl, 14 Nebula, 15 Wormhole, 16 Meteor Shower, 11 Solid colour; the Wooden cross: what's behind it, 7 warm glow, 8 blue sky, 9 sunset, 10 heavenly light)
uint32_t SPACE_COLS[4] = { ${S.spaceCols.map(c => "0x" + hex6(c)).join(", ")} };   // Galaxy, Nebula, Wormhole, Meteor Shower: four colours blended together
uint8_t  CROSS_W    = ${S.crossw};      // crosses: how far the crossbar reaches, % of the lower arm (25-100)
