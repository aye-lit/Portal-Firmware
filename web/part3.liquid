    uint32_t h = hash32((uint32_t)(i + 1) * 7919u), h2 = hash32(h ^ 0x9e3779b9u);
    nbBX[i] = h % SCR_W; nbBY[i] = h2 % SCR_H; nbBR[i] = (2 + ((h >> 12) & 255) / 85.0f) * k; nbBW[i] = (h2 >> 9) & 1; nbBP[i] = ((h2 >> 12) & 255) / 40.0f;
  }
  nebKey = key; nebReady = true;
  return true;
}
HOT void nebulaStrip(int y0, int rows, uint16_t *strip) {
  const uint8_t *H0 = planeMap + (nebHOff - planesOff) + 16, *V0 = planeMap + (nebVOff - planesOff) + 16;
  const int hs = nebHue, dens = 7 * STARS / 3, gapMax = dens > 0 ? max(2, 2048 / dens) : 0;
  uint16_t *p = strip;
  for (int y = y0; y < y0 + rows; y++) {
    const uint8_t *hr = H0 + (uint32_t)y * SCR_W, *vr = V0 + (uint32_t)y * SCR_W;
    uint32_t rs = hash32((uint32_t)y * 2654435761UL + 0x5bd1e995UL);
    int sx = gapMax ? (int)(rs % (uint32_t)gapMax) : SCR_W;
    for (int x = 0; x < SCR_W; x++) {
      int hi = (hr[x] + hs) & 63, vi = vr[x];
      if (x == sx) {                    // a twinkling star here
        uint32_t h = hash32((uint32_t)(y * SCR_W + x) * 2654435761UL);
        int svi = 47 + sinT[(spTw + (h >> 10)) & 255] / 10;
        if (svi > vi) { hi = (h >> 20) & 63; vi = min(63, svi + 13); }
        rs = rs * 1664525UL + 1013904223UL; sx += 1 + (int)((rs >> 16) % (uint32_t)(gapMax - 1));
      }
      *p++ = spaceLUT[hi * 64 + vi];
    }
  }
