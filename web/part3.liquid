const f2 = v => Number(v).toFixed(2);
const hex6 = h => h.slice(1).toUpperCase();
function tftSketch() {
const B = boardOf();
const rot = M.rect && M.w !== M.h ? (M.w > M.h ? 1 : 0) : 0;
const hz = M.driver === "st7735" ? Math.min(B.hz, 27) : M.driver === "ili9341" ? Math.min(B.hz, 40) : M.driver === "st7796" ? Math.min(B.hz, 80) : B.hz;
