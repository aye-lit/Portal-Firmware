int16_t  nbBX[NEB_BIG], nbBY[NEB_BIG]; float nbBR[NEB_BIG], nbBP[NEB_BIG]; uint8_t nbBW[NEB_BIG], nbBN = 0;   // the bright stars
inline float nbSS(float a, float b, float x) { float t = (x - a) / (b - a); t = t < 0 ? 0 : t > 1 ? 1 : t; return t * t * (3 - 2 * t); }
float nbFbm(float x, float y, int o) { float s = 0, a = 0.5f, n = 0; for (int i = 0; i < o; i++) { s += vn(x, y) * a; n += a; x = x * 2.03f + 17.1f; y = y * 2.03f - 9.7f; a *= 0.5f; } return s / n; }
void nebulaPixel(int x, int y, uint8_t &h, uint8_t &v) {   // same maths as the Studio
