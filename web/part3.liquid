{% raw %}}
function paint() {
  g.fillStyle = "#020305"; g.fillRect(0, 0, cv.width, cv.height);
  g.shadowBlur = K * 1.2;
  if (M.kind === "rgb") {
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) if (buf[y * W + x]) {
      const c = pal[shadeIdx(x, y)]; g.fillStyle = c; g.shadowColor = c;
      g.fillRect(x * K + .3, y * K + .3, K - .6, K - .6);
    }
  } else {
    const [, top, rest] = TINTS[S.tint] || TINTS.white;
    for (let y = 0; y < H; y++) {
      const c = y < 16 ? top : rest;      // two-colour modules: top 16 rows are yellow
      g.fillStyle = c; g.shadowColor = c;
      for (let x = 0; x < W; x++) if (buf[y * W + x]) g.fillRect(x * K + .3, y * K + .3, K - .6, K - .6);
    }
  }
  g.shadowBlur = 0;
}
let last = 0;
function loop(now) {
  if (now - last >= 1000 / 28) { last = now; if (M.kind === "tft") tftFrame(); else { step(); paint(); } }
  requestAnimationFrame(loop);
}

// ---------------- sketch generator ----------------
const f2 = v => Number(v).toFixed(2);
const hex6 = h => h.slice(1).toUpperCase();
function tftSketch() {
const B = boardOf();
const rot = M.rect && M.w !== M.h ? (M.w > M.h ? 1 : 0) : 0;
const hz = M.driver === "st7735" ? Math.min(B.hz, 27) : M.driver === "ili9341" ? Math.min(B.hz, 40) : M.driver === "st7796" ? Math.min(B.hz, 27) : B.hz;
const DISP = {
  gc9a01:  { inc: "Adafruit_GC9A01A.h", decl: "Adafruit_GC9A01A tft(PIN_CS, PIN_DC, PIN_RST);", begin: "  tft.begin(SPI_HZ);" },
  st7789:  { inc: "Adafruit_ST7789.h", decl: "Adafruit_ST7789 tft(PIN_CS, PIN_DC, PIN_RST);",
             begin: `  tft.init(${M.nw}, ${M.nh});              // the panel's own size (some modules without a CS pin need: tft.init(${M.nw}, ${M.nh}, SPI_MODE3))\n  tft.setSPISpeed(SPI_HZ);\n  tft.setRotation(${rot});                // ${rot ? "landscape" : M.w === M.h ? "square" : "portrait"}` },
  st7735:  { inc: "Adafruit_ST7735.h", decl: "Adafruit_ST7735 tft(PIN_CS, PIN_DC, PIN_RST);",
             begin: `  tft.initR(INITR_BLACKTAB);             // if the colours or edges look wrong, try INITR_GREENTAB or INITR_REDTAB\n  tft.setSPISpeed(SPI_HZ);\n  tft.setRotation(${rot});                // ${rot ? "landscape" : "portrait"}` },
  st7796:  { inc: "Adafruit_ST7796S.h", decl: "Adafruit_ST7796S tft(PIN_CS, PIN_DC, PIN_RST);   // needs the Adafruit ST7735 and ST7789 Library 1.11 or newer",
             begin: `  tft.init(${M.nw}, ${M.nh}, 0, 0, ST7796S_BGR);   // if red and blue look swapped, change ST7796S_BGR to ST7796S_RGB\n  tft.invertDisplay(true);               // if the colours look like a photo negative, change true to false\n  tft.setSPISpeed(SPI_HZ);\n  tft.setRotation(${rot});                // ${rot ? "landscape" : "portrait"}` },
  ili9341: { inc: "Adafruit_ILI9341.h", decl: "Adafruit_ILI9341 tft(PIN_CS, PIN_DC, PIN_RST);",
             begin: `  tft.begin(SPI_HZ);\n  tft.setRotation(${rot});                // ${rot ? "landscape" : "portrait"}` },
}[M.driver];
return `// Vortex Portal for the ${M.spec.split(" · ")[0]} ${M.chip} colour display (${M.w}x${M.h}${M.rect && M.w !== M.h ? (rot ? ", landscape" : ", portrait") : ""})
// Generated by Vortex Portal Studio for: ${B.name}
// Works on ESP32 (all types), Raspberry Pi Pico (RP2040/RP2350) and Teensy 4.
// To use another board, change the pin numbers in the "Board" section below.
// Libraries (Library Manager): "${M.lib}" and "Adafruit GFX Library".
// The portal is drawn in the centre of the screen.
//
${B.builtin ? "// Wiring:  none, the screen is built into the board. Tools -> Board -> ESP32 Dev Module." : `// Wiring:  VCC->3V3  GND->GND  SCL->${B.lab.sck}  SDA->${B.lab.mosi}  DC->${B.lab.dc}  CS->${B.lab.cs}  RST->${B.lab.rst}  BLK->3V3 (if present)`}
//
// Live tuning: open Vortex Portal Studio in Chrome and tap "Connect over Bluetooth"
// (ESP32 boards), or plug in over USB and click "Connect over USB". The board saves them.

#if defined(__AVR__) || defined(ESP8266)
  #error "This screen needs a board with more memory: an ESP32, Raspberry Pi Pico or Teensy 4."
#endif

#include <SPI.h>
#include <Adafruit_GFX.h>
#include <${DISP.inc}>
#include <EEPROM.h>
#include <math.h>
#if defined(ESP32)
  #include <freertos/FreeRTOS.h>
  #include <freertos/semphr.h>
#endif
#if defined(ESP32) && __has_include("rom/tjpgd.h")
  #define HAS_PICS 1                      // pictures: stored in flash, unpacked by the chip's built-in JPEG decoder
  #include <esp_partition.h>
  #include "rom/tjpgd.h"
#else
  #define HAS_PICS 0
#endif

${pinBlock(B, "spi")}
#define SPI_HZ    ${hz}000000UL   // ${hz >= 80 ? "turbo: if the picture glitches or stays dark, change to 40000000UL" : "screen speed; lower it if the picture glitches"}

#define SCR_W      ${M.w}          // screen width and height as mounted
#define SCR_H      ${M.h}
#define QX         ${M.w >> 1}          // centre of the screen
#define QY         ${M.h >> 1}
#define TQX        (SCR_W - QX)
#define TQY        (SCR_H - QY)
int      STRIP = 9600 / SCR_W;          // rows drawn per chunk (fewer if memory is tight)
#define MAX_SPARKS 30
#define MAX_PICS   8                     // picture slots
#define PORTAL     255                   // scene number for the portal itself
#define RADIUS_MAX ${Math.max(rmax(M), ...[8, 9, 10, 11, 12, 13].map(st => crossMax(M, st)))}
#define SP_EXT     ${spaceExt(M)}          // space styles: distance from the centre to the edge of the picture area

// ---------- Settings baked in from the Studio ----------
float    RADIUS     = ${f2(S.radius)};   // portal size in pixels
float    OVAL       = ${f2(S.oval)};    // 1.0 = round, higher = wide oval
uint8_t  ARMS       = ${S.arms};       // spiral arms
float    TWIST      = ${f2(S.twist)};    // how tightly the arms coil
float    SPEED      = ${f2(S.speed)};    // spin per frame
uint8_t  NUM_SPARKS = ${S.sparks};      // particles being sucked in
bool     DRIFT      = ${S.reverse};    // Wormhole: true = Reverse, the rings fly out toward you (LCDs don't need burn-in drift)
uint32_t COLOR_CORE = 0x${hex6(S.c1)};  // inner colour
uint32_t COLOR_RIM  = 0x${hex6(S.c2)};  // outer colour
uint8_t  BRIGHTNESS = ${S.bright};     // 10-100 %: dims the portal's colours
uint8_t  STYLE      = ${S.style};       // 0 Vortex, 1 Toon Spiral, 2 Starburst, 3 Hyperspace, 4 Galaxy (Hubble-style spiral), 5 Black hole, 6 Cartoon Swirl, 7 Cartoon Sticker,
                                // crosses: 8 Latin, 9 Celtic, 10 Budded, 11 Patriarchal, 12 Orthodox, 13 Pattee (ESP32 boards)
                                // more space: 14 Nebula, 15 Wormhole, 16 Meteor Shower
uint8_t  CROSS_FILL = ${S.crossFill};       // crosses: what's drawn inside (0 Vortex, 1 Toon Spiral, 2 Starburst, 3 Hyperspace, 4 Galaxy, 5 Black hole, 6 Cartoon Swirl, 14 Nebula, 15 Wormhole, 16 Meteor Shower)
uint32_t SPACE_COLS[4] = { ${S.spaceCols.map(c => "0x" + hex6(c)).join(", ")} };   // Galaxy, Nebula, Wormhole, Meteor Shower: four colours blended together
uint8_t  CROSS_W    = ${S.crossw};      // crosses: how far the crossbar reaches, % of the lower arm (25-100)
uint8_t  BEAM       = ${S.beam};      // crosses: beam thickness, % of the portal size (5-30)
uint8_t  BAR        = ${S.bar};      // crosses: crossbar height (20-50, 50 = all arms the same length)
uint8_t  STARS      = ${S.stars};       // space styles: star density (1-6)
bool     FADE_ON    = ${S.fade};    // fade through the colour sets
uint8_t  FADE_COUNT = ${S.fadeSets.length};       // extra colour sets after the main colours (1-3)
uint32_t FADE_COLS[6] = { ${[0,1,2].map(i => S.fadeSets[i] ? `0x${hex6(S.fadeSets[i].core)}, 0x${hex6(S.fadeSets[i].rim)}` : "0x000000, 0x000000").join(", ")} };   // core, rim pairs
uint8_t  RIM_SMOOTH = ${S.rimsmooth};       // 0 = wobbly energy edge, 100 = perfectly smooth ring
float    FADE_SECS  = ${S.fadesec};       // seconds for each fade (${Math.floor(S.fadesec / 60)} min ${S.fadesec % 60} sec)
uint8_t  RIPPLES    = ${S.ripples};       // Starburst: rings expanding at once (0-6)
float    RIP_SPEED  = ${f2(S.rspeed)};    // Starburst: ripple speed (0.03-0.30)
float    GLOW_SIZE  = ${f2(S.glow)};    // Starburst: centre glow size (0.30-0.90)
uint8_t  SCENE_COUNT = ${sceneList().length};      // scenes shown in turn (0 = just the portal)
uint8_t  SCENES[8]  = { ${[...sceneList(), ...Array(8).fill(255)].slice(0, 8).join(", ")} };   // 255 = the portal, 0-7 = pictures, 128-135 = portal around a picture
float    HOLD_SECS  = ${S.holdsec};       // seconds each scene stays on screen
float    SCENE_FADE = ${S.scenefade};       // seconds to fade into the next scene (0 = instant)
uint8_t  FRAME_PCT  = ${S.frame};      // "portal around a picture" scenes (128 + picture): how much of the picture the portal covers, 10-95 %
// --------------------------------------------------------

// Changes every time you copy a new sketch, so freshly uploaded settings
// win over ones saved earlier by live tuning.
const uint32_t BUILD_ID = 0x${BUILD_ID}UL;

${DISP.decl}

// Lookup tables: distance and angle for one quarter of the screen (mirrored for the rest)
uint8_t  *rT, *aT;                     // TQX x TQY each, allocated in setup()
uint8_t  colMap[SCR_W];
int8_t   sinT[256];
int16_t  twistT[256], twist2T[256], edgeT[256];
uint8_t  depthT[256], coreT[256], haloT[256], rimT[64], centerT[256];
uint8_t  sbGlowT[256], sbRingT[256], sbOuterT[256], ripCrestT[256], ripTroughT[256];
uint8_t  spCoreT[256], bhRingT[256], bhDiskT[256], bhStarT[256];
uint16_t galFadeT[256];
uint8_t  warpOn[768];
float    warpRR[768], warpLen[768], warpB[768];
int      bhHole = 20, twinkle = 0;
int16_t  linT[256];
uint16_t pal[256];
uint16_t *stripBuf[2];                 // two strips: one is drawn while the other is sent (allocated in setup)
uint16_t *picBuf = NULL;               // a third strip, for fading between scenes
int      crossYC = QY;                 // crosses: row of the crossing (the cross is centred, so this sits above the middle)
bool     crossOn = false;               // a cross is being drawn (its outline is ready)
int      spCY = QY;                     // centre row for the space styles (the crossing when inside a cross)

// Dual-core chips (ESP32, ESP32-S3) draw on core 0 while core 1 feeds the screen.
#if defined(ESP32) && !CONFIG_FREERTOS_UNICORE
  #define DUAL_CORE 1
#else
  #define DUAL_CORE 0
#endif

// New settings from live tuning are applied between frames
volatile bool havePending = false;

struct Spark { float a, r; };
Spark sparks[MAX_SPARKS];
int16_t sparkX[MAX_SPARKS], sparkY[MAX_SPARKS];
float t = 0;

struct Saved { uint32_t id; float radius, oval, twist, speed; uint8_t arms, sparks, drift; uint32_t core, rim; uint8_t bright, style, ripples; float ripSpeed, glow; uint8_t stars, fadeOn, fadeCount; uint32_t fadeCols[6]; float fadeSecs; uint8_t rimSmooth; uint8_t sceneCount, scenes[8]; float holdSecs, sceneFade; uint8_t framePct, crossW, beam, bar; uint32_t spaceCols[4]; uint8_t crossFill; };
static_assert(sizeof(Saved) <= 128, "settings must fit the 128 bytes of EEPROM");

// ---------- tables ----------
// Cartoon styles: smooth looping noise tables
uint8_t nzA[32], nzB[64], nzC[256];
uint32_t nzSeed = 12345;
uint8_t nzRnd() { nzSeed = (nzSeed * 1103515245UL + 12345UL) & 0x7fffffffUL; return (nzSeed >> 16) & 255; }

void nzTable(uint8_t *t, int len, int passes) {
  int tmp[256], n[256];
  for (int i = 0; i < len; i++) n[i] = nzRnd();
  for (int p = 0; p < passes; p++) {
    for (int i = 0; i < len; i++) tmp[i] = (n[(i + len - 1) % len] + 2 * n[i] + n[(i + 1) % len]) >> 2;
    for (int i = 0; i < len; i++) n[i] = tmp[i];
  }
  int lo = 255, hi = 0;
  for (int i = 0; i < len; i++) { if (n[i] < lo) lo = n[i]; if (n[i] > hi) hi = n[i]; }
  for (int i = 0; i < len; i++) t[i] = (uint8_t)lroundf((n[i] - lo) * 255.0f / (hi - lo));
}

inline int nz(const uint8_t *t, int mask, int x) {
  int i = x >> 4, f = x & 15;
  return (t[i & mask] * (16 - f) + t[(i + 1) & mask] * f) >> 4;
}

void buildGeometry() {
  nzTable(nzA, 32, 1);
  nzTable(nzB, 64, 1);
  nzTable(nzC, 256, 2);
  for (int qy = 0; qy < TQY; qy++) {
    for (int qx = 0; qx < TQX; qx++) {
      float fx = qx + 0.5f, fy = qy + 0.5f;
      rT[qy * TQX + qx] = (uint8_t)min(255L, lroundf(sqrtf(fx * fx + fy * fy)));
      aT[qy * TQX + qx] = (uint8_t)lroundf(atan2f(fy, fx) / (PI / 2) * 64);
    }
  }
  for (int i = 0; i < 256; i++) sinT[i] = (int8_t)lroundf(127 * sinf(i * TWO_PI / 256));
}

void buildParams() {
  float R = RADIUS;
  for (int r = 0; r < 256; r++) {
    float rn = max((float)r, 0.5f) / R, lr = logf(rn), x = min(rn, 1.0f);
    twistT[r]  = (int16_t)(TWIST * 3.0f * lr * 40.74f);
    twist2T[r] = (int16_t)(TWIST * 1.6f * lr * 40.74f);
    depthT[r]  = (uint8_t)(255 * x * x * (3 - 2 * x));
    coreT[r]   = (uint8_t)(210 * expf(-rn * rn * 18));
    haloT[r]   = (uint8_t)(115 * expf(-r / R * 3.2f));
    linT[r]    = (int16_t)(r * TWIST * 1.2f * 256 / R);
    centerT[r] = (uint8_t)(55 * expf(-powf(rn * 2.2f, 2)));
    // Starburst: glowing centre, soft rings near the centre, rays toward the rim
    float sr = r / R, f1 = min(1.0f, sr / GLOW_SIZE), f2 = min(1.0f, max(0.0f, (sr - 0.15f) / 0.55f));
    int inner = (int)(256 * (1 - f1 * f1 * (3 - 2 * f1)));
    sbOuterT[r] = (uint8_t)min(255, (int)(256 * f2 * f2 * (3 - 2 * f2)));
    sbRingT[r]  = (uint8_t)min(255, (inner * inner * inner) >> 16);
    sbGlowT[r]  = (uint8_t)(105 * expf(-powf(sr / GLOW_SIZE * 1.4f, 2)));
    // Space: bright core, galaxy arm fade, black hole ring and disk
    spCoreT[r]  = (uint8_t)(230 * expf(-powf(rn / 0.16f, 2)));
    galFadeT[r] = (uint16_t)max(0, (int)(256 * (1 - sr * 0.7f)));
    float hr = 0.22f * R, dn = (sr - 0.22f) / 0.45f;
    bhRingT[r]  = (uint8_t)(255 * expf(-powf((r - hr - 1.5f) / 1.8f, 2)));
    bhDiskT[r]  = (dn >= 0 && dn < 1) ? (uint8_t)(235 - dn * 200) : 0;
    bhStarT[r]  = dn > 0.85f ? 1 : 0;
  }
  for (int d = 0; d < 64; d++) rimT[d] = (uint8_t)(255 * expf(-powf(d * 9.0f / R, 2)));
  for (int x = 0; x < SCR_W; x++) {
    int dx = x < QX ? QX - 1 - x : x - QX;
    colMap[x] = (uint8_t)min((long)(TQX - 1), lroundf(dx / OVAL));
  }
}

uint16_t to565(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }

uint32_t mixColor(uint32_t x, uint32_t y, float f) {   // blend two 0xRRGGBB colours
  uint32_t out = 0;
  for (int i = 0; i < 3; i++) {
    int cx = (x >> (16 - 8 * i)) & 0xFF, cy = (y >> (16 - 8 * i)) & 0xFF;
    out |= (uint32_t)(int)(cx + (cy - cx) * f) << (16 - 8 * i);
  }
  return out;
}

void buildPaletteFrom(uint32_t core, uint32_t rim) {   // black -> core -> rim -> near-white
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (core >> (16 - 8 * i)) & 0xFF; b[i] = (rim >> (16 - 8 * i)) & 0xFF; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    pal[i] = to565(c[0], c[1], c[2]);
  }
}

// Space colour table: 64 hues blended around the four space colours x 64 brightness levels
uint16_t *spaceLUT = NULL;             // allocated the first time a space style is shown
void buildSpaceLUT() {
  if (!spaceLUT) return;
  for (int h = 0; h < 64; h++) {
    float p = h / 16.0f; int i = (int)p; float f = p - i; f = f * f * (3 - 2 * f);
    uint32_t A = SPACE_COLS[i & 3], B = SPACE_COLS[(i + 1) & 3];
    float base[3];
    for (int k = 0; k < 3; k++) { int ca = (A >> (16 - 8 * k)) & 0xFF, cb = (B >> (16 - 8 * k)) & 0xFF; base[k] = ca + (cb - ca) * f; }
    for (int b = 0; b < 64; b++) {
      float v = b / 63.0f; uint8_t c[3];
      for (int k = 0; k < 3; k++) {
        float x = base[k] * min(1.0f, v / 0.75f);
        if (v > 0.75f) x += (255 - x) * (v - 0.75f) / 0.25f * 0.8f;   // the brightest parts glow toward white
        if (x > 255) x = 255;
        c[k] = (uint8_t)(x * BRIGHTNESS / 100.0f);
      }
      spaceLUT[h * 64 + b] = to565(c[0], c[1], c[2]);
    }
  }
}

void buildPalette() { buildPaletteFrom(COLOR_CORE, COLOR_RIM); buildSpaceLUT(); }

void updateColourFade() {             // fade through the colour sets in order, FADE_SECS per fade
  if (!FADE_ON || FADE_COUNT < 1) return;
  int n = 1 + FADE_COUNT;              // main colours + extra sets
  float pos = fmodf(millis() / 1000.0f / FADE_SECS, (float)n);
  int i = (int)pos, j = (i + 1) % n;
  float f = pos - i;
  f = f * f * (3 - 2 * f);
  uint32_t coreA = i == 0 ? COLOR_CORE : FADE_COLS[(i - 1) * 2], rimA = i == 0 ? COLOR_RIM : FADE_COLS[(i - 1) * 2 + 1];
  uint32_t coreB = j == 0 ? COLOR_CORE : FADE_COLS[(j - 1) * 2], rimB = j == 0 ? COLOR_RIM : FADE_COLS[(j - 1) * 2 + 1];
  buildPaletteFrom(mixColor(coreA, coreB, f), mixColor(rimA, rimB, f));
}

// ---------- space helpers ----------
uint32_t hash32(uint32_t n) {
  n = (n ^ 61) ^ (n >> 16);
  n *= 9;
  n ^= n >> 4;
  n *= 0x27d4eb2dUL;
  n ^= n >> 15;
  return n;
}

int starAt(int a, int r) {             // one twinkling star per small patch of sky
  uint32_t h = hash32((uint32_t)((a >> 1) * 977 + (r >> 2) * 131));
  if ((int)(h & 63) >= STARS * 2) return 0;
  if ((a & 1) != (int)((h >> 8) & 1) || (r & 3) != (int)((h >> 10) & 3)) return 0;
  return 120 + ((sinT[((h >> 12) + (uint32_t)twinkle) & 255] + 127) >> 1);
}

// ---------- sparks ----------
void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS * 1.05 + random(0, (int)(RADIUS / 5) + 1);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}

void updateSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= 0.95;                                         // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + RADIUS * 0.22));  // faster near the centre
    if (s.r < 3) respawn(s);
    sparkX[i] = (int16_t)floorf(QX + cosf(s.a) * s.r * OVAL);
    sparkY[i] = (int16_t)floorf((crossOn ? crossYC : QY) + sinf(s.a) * s.r);
  }
}

// ---------- saved settings (EEPROM) ----------
bool validFill(uint8_t f) { return f <= 6 || (f >= 14 && f <= 16); }   // styles that can go inside a cross

bool validScenes(const Saved &s) {
  if (s.sceneCount > 8 || !(s.holdSecs >= 1 && s.holdSecs <= 3600) || !(s.sceneFade >= 0 && s.sceneFade <= 600)) return false;
  if (s.framePct < 10 || s.framePct > 95) return false;
  if (s.crossW < 25 || s.crossW > 100 || s.beam < 5 || s.beam > 30 || s.bar < 20 || s.bar > 50) return false;
  for (int k = 0; k < 4; k++) if (s.spaceCols[k] > 0xFFFFFF) return false;
  if (!validFill(s.crossFill)) return false;
  for (uint8_t i = 0; i < s.sceneCount; i++) {
    uint8_t c = s.scenes[i];
    if (c != PORTAL && c >= MAX_PICS && (c < 128 || c >= 128 + MAX_PICS)) return false;
  }
  return true;
}

bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4f && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF && s.bright >= 10 && s.bright <= 100 && s.style <= 16 && s.stars >= 1 && s.stars <= 6 && s.fadeCount >= 1 && s.fadeCount <= 3 && s.fadeSecs >= 1 && s.fadeSecs <= 3600 && s.rimSmooth <= 100 &&
         s.ripples <= 6 && s.ripSpeed >= 0.03f && s.ripSpeed <= 0.3f && s.glow >= 0.3f && s.glow <= 0.9f &&
         validScenes(s);
}

void apply(const Saved &s) {
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim; BRIGHTNESS = s.bright; STYLE = s.style;
  RIPPLES = s.ripples; RIP_SPEED = s.ripSpeed; GLOW_SIZE = s.glow; STARS = s.stars;
  FADE_ON = s.fadeOn; FADE_COUNT = s.fadeCount; FADE_SECS = s.fadeSecs; RIM_SMOOTH = s.rimSmooth;
  for (int k = 0; k < 6; k++) FADE_COLS[k] = s.fadeCols[k] & 0xFFFFFF;
  SCENE_COUNT = s.sceneCount; HOLD_SECS = s.holdSecs; SCENE_FADE = s.sceneFade; FRAME_PCT = s.framePct;
  CROSS_W = s.crossW; BEAM = s.beam; BAR = s.bar;
  for (int k = 0; k < 8; k++) SCENES[k] = s.scenes[k];
  for (int k = 0; k < 4; k++) SPACE_COLS[k] = s.spaceCols[k];
  CROSS_FILL = s.crossFill;
}

void loadSettings() {
${EEPROM_BEGIN_GUARD}
  EEPROM.begin(128);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void saveSettings() {
  Saved s = { BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM, BRIGHTNESS, STYLE, RIPPLES, RIP_SPEED, GLOW_SIZE, STARS, (uint8_t)FADE_ON, FADE_COUNT };
  for (int k = 0; k < 6; k++) s.fadeCols[k] = FADE_COLS[k];
  s.fadeSecs = FADE_SECS;
  s.rimSmooth = RIM_SMOOTH;
  s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
  s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
  for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
  for (int k = 0; k < 4; k++) s.spaceCols[k] = SPACE_COLS[k];
  s.crossFill = CROSS_FILL;
  EEPROM.put(0, s);
${EEPROM_BEGIN_GUARD}
