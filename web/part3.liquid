inline void pollTap() {}
inline void beginTap() {}
#endif

bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4f && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF && s.bright >= 10 && s.bright <= 100 && s.style <= 17 && s.stars >= 1 && s.stars <= 6 && s.fadeCount >= 1 && s.fadeCount <= 3 && s.fadeSecs >= 1 && s.fadeSecs <= 3600 && s.rimSmooth <= 100 &&
         s.ripples <= 6 && s.ripSpeed >= 0.03f && s.ripSpeed <= 0.3f && s.glow >= 0.3f && s.glow <= 0.9f &&
         validScenes(s);
}

void apply(const Saved &s) {
  tapMode = false; tapIdx = -1;          // new settings: show them (not a style picked by tapping)
#if TAP_PIN >= 0
  tapCur = tapNext = 0;                  // tap for next scene: start again from the first scene
#endif
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim; BRIGHTNESS = s.bright; STYLE = s.style;
  RIPPLES = s.ripples; RIP_SPEED = s.ripSpeed; GLOW_SIZE = s.glow; STARS = s.stars;
  FADE_ON = s.fadeOn; FADE_COUNT = s.fadeCount; FADE_SECS = s.fadeSecs; RIM_SMOOTH = s.rimSmooth;
  for (int k = 0; k < 6; k++) FADE_COLS[k] = s.fadeCols[k] & 0xFFFFFF;
  SCENE_COUNT = s.sceneCount; HOLD_SECS = s.holdSecs; SCENE_FADE = s.sceneFade; FRAME_PCT = s.framePct;
  CROSS_W = s.crossW; BEAM = s.beam; BAR = s.bar;
  for (int k = 0; k < 8; k++) SCENES[k] = s.scenes[k];
  for (int k = 0; k < 4; k++) SPACE_COLS[k] = s.spaceCols[k];
  CROSS_FILL = s.crossFill;
  CROSS_RIPPLE = s.crossRipple;
#if TURNS
  wantPortrait = (s.portrait & 1) != 0;  // turned at the start of the next frame
  wantFlip = (s.portrait & 2) != 0;       // (and the other way round)
#endif
  TONE = s.tone <= 100 ? s.tone : 0;
  WARM = s.warm <= 100 ? s.warm : 0;
  TAP_OFF = s.tapOff == 1;               // (older saved settings: tapping stays on)
  if (s.fdLen >= 2 && s.fdLen <= 30 && s.fdStars <= 100 && s.fdClouds <= 100 && s.fdGlow >= 20 && s.fdGlow <= 150) {   // (older saved settings: Full day keeps its defaults)
    FD_LEN = s.fdLen; FD_STARCNT = s.fdStars; FD_CLOUDS = s.fdClouds; FD_GLOW = s.fdGlow;
  }
}

void loadSettings() {
${EEPROM_BEGIN_GUARD}
  EEPROM.begin(EE_SIZE);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void fillSaved(Saved &s) {               // the settings in use now
  s = Saved{ BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM, BRIGHTNESS, STYLE, RIPPLES, RIP_SPEED, GLOW_SIZE, STARS, (uint8_t)FADE_ON, FADE_COUNT };
  for (int k = 0; k < 6; k++) s.fadeCols[k] = FADE_COLS[k];
  s.fadeSecs = FADE_SECS;
  s.rimSmooth = RIM_SMOOTH;
  s.sceneCount = SCENE_COUNT; s.holdSecs = HOLD_SECS; s.sceneFade = SCENE_FADE; s.framePct = FRAME_PCT;
  s.crossW = CROSS_W; s.beam = BEAM; s.bar = BAR;
  for (int k = 0; k < 8; k++) s.scenes[k] = SCENES[k];
  for (int k = 0; k < 4; k++) s.spaceCols[k] = SPACE_COLS[k];
  s.crossFill = CROSS_FILL;
  s.crossRipple = CROSS_RIPPLE;
  s.portrait = (wantPortrait ? 1 : 0) | (wantFlip ? 2 : 0);
  s.tone = TONE;
  s.warm = WARM;
  s.tapOff = TAP_OFF;
  s.fdLen = FD_LEN; s.fdStars = FD_STARCNT; s.fdClouds = FD_CLOUDS; s.fdGlow = FD_GLOW;
}

void saveSettings() {
  Saved s;
  fillSaved(s);
  EEPROM.put(0, s);
${EEPROM_BEGIN_GUARD}
  EEPROM.commit();
#endif
}

