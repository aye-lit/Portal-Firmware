bool prepareNebula() {                  // once per frame while the Nebula shows (the slow part only the first time)
  nebHue = (int)(spaceT * 0.0198) & 63;  // colours move round the four space colours (about 2 minutes at the usual speed)
  if (!picPart || !planeMap || nPlanes < 4) return false;   // no room: the simpler Nebula
  uint32_t key = 2166136261UL;
  uint32_t parts[] = { (uint32_t)SCR_W, (uint32_t)SCR_H, 1 };
  for (uint32_t v : parts) key = (key ^ v) * 16777619UL;
  if (nebReady && key == nebKey) return true;
  nebReady = false;
  int sh = findPlane(NEBH_MAGIC, key), sv = findPlane(NEBV_MAGIC, key);
  if (sh < 0 || sv < 0) {
    if (sh < 0) { sh = freePlane(); } nebHSlot = sh;
    if (sv < 0 || sv == sh) { sv = freePlane(); } nebVSlot = sv;
    if (sv == sh) return false;
    planeMagic[sh] = planeMagic[sv] = 0;
    uint32_t ho = planesOff + (uint32_t)sh * crossPlane, vo = planesOff + (uint32_t)sv * crossPlane;
    esp_partition_erase_range(picPart, ho, crossPlane); esp_partition_erase_range(picPart, vo, crossPlane);
    static uint8_t rh[SCR_WMAX], rv[SCR_WMAX];
    for (int y = 0; y < SCR_H; y++) {
      for (int x = 0; x < SCR_W; x++) nebulaPixel(x, y, rh[x], rv[x]);
      esp_partition_write(picPart, ho + 16 + (uint32_t)y * SCR_W, rh, SCR_W);
      esp_partition_write(picPart, vo + 16 + (uint32_t)y * SCR_W, rv, SCR_W);
      if (y & 1) delay(1);
    }
    uint32_t h1[4] = { NEBH_MAGIC, key, 0, 0 }, h2[4] = { NEBV_MAGIC, key, 0, 0 };
    esp_partition_write(picPart, ho, h1, 16); esp_partition_write(picPart, vo, h2, 16);
    planeMagic[sh] = NEBH_MAGIC; planeKeyOf[sh] = key; planeMagic[sv] = NEBV_MAGIC; planeKeyOf[sv] = key;
  }
  nebHSlot = sh; nebVSlot = sv; planeUse[sh] = ++planeTick; planeUse[sv] = ++planeTick;
  nebHOff = planesOff + (uint32_t)sh * crossPlane; nebVOff = planesOff + (uint32_t)sv * crossPlane;
  nbBN = max(4, min(NEB_BIG, (int)lroundf(9.0f * SCR_W * SCR_H / 153600)));   // a few bright stars, same places as the Studio
  float k = min(SCR_W, SCR_H) / 320.0f;
