  }
}

inline bool spaceStar(uint32_t i, int density, int &hi, int &vi) {   // a twinkling star with its own colour
  uint32_t h = hash32(i * 2654435761UL);
  if ((int)(h & 1023) >= density) return false;
  vi = 47 + sinT[(spTw + (h >> 10)) & 255] / 10;
  hi = (h >> 20) & 63;
  return true;
}

void prepareSpace() {                   // once per frame
  spFrame++;                            // (the shared grid rows from the last frame are out of date)
  spU = look == 15 ? 118.0f / SP_EXT : 236.0f / min(SCR_W, SCR_H);   // scaled to the screen
  spExt = SP_EXT * spU;
  double T = spaceT;
  float ang = (float)fmod(T * 0.004, TWO_PI);
  nbCa = cosf(ang); nbSa = sinf(ang);
  nbO1 = (float)fmod(T * 0.004, 64.0); nbO2 = (float)fmod(T * 0.003, 64.0); nbO3 = (float)fmod(T * 0.002, 64.0);
  spTw = (int)(fmod(T * 0.25, TWO_PI) * 40.74f);
  if (look == 4) {                      // Galaxy: screen -> the galaxy's own slowly turning plane
    float rot = (float)fmod(T * 0.007, TWO_PI), cr = cosf(rot), sr = sinf(rot), cp = cosf(GAL_PA), sp = sinf(GAL_PA);
    gax = (cp * cr + sp * sr / GAL_TILT) * GAL_ZOOM; gbx = (-sp * cr + cp * sr / GAL_TILT) * GAL_ZOOM;
    gay = (-cp * sr + sp * cr / GAL_TILT) * GAL_ZOOM; gby = (sp * sr + cp * cr / GAL_TILT) * GAL_ZOOM;
    galK = 3 + TWIST * 2.5f;            // Spiral setting (TWIST 0-6)
    gpx = cp * GAL_ZOOM; gqx = -sp * GAL_ZOOM; gpy = sp / GAL_TILT * GAL_ZOOM; gqy = cp / GAL_TILT * GAL_ZOOM;   // before turning
    gRot = rot;
    gtReady = galaxyTex();
  }
  if (look == 14) prepareNebula();       // Nebula: the detailed picture (made once)
  if (look == 15) {                     // Wormhole: rings falling away, worked out per distance
    whCoreR = 0;
    float rev = DRIFT ? -1 : 1;          // Reverse: rings fly out toward you
    whPh = (int)(rev * fmod(T * 0.06, TWO_PI) * 40.74f);
    float off = rev * (float)fmod(T * 0.09, 100.0);
    for (int r = 0; r < 256; r++) {
      float ru = max(r * spU, 1.0f), depth = 90 / ru, ringPos = depth * 2.6f - off, fl = floorf(ringPos);
      whRingT[r] = (uint8_t)(255 * (0.5f + 0.5f * cosf((ringPos - fl) * TWO_PI)));
      float near = min(1.0f, ru / 95);
      whNearT[r] = (uint8_t)(255 * (0.25f + 0.75f * near * near));
      whOffT[r] = (int16_t)((int)(TWIST * (depth * 0.667f + 3 * logf(ru / 20)) * 40.74f) & 255);   // Twist: how much the walls spiral
      whHueT[r] = (int32_t)floorf(fl * 0.27f * 256) & 255;               // each ring its own colour
      whCoreT[r] = ru < 18 ? (int16_t)min(63.0f, expf(-(ru / 9) * (ru / 9)) * 1.05f * 63) : -1;
      whRing133T[r] = whRingT[r] * 133;
      whHue8T[r] = (uint8_t)whHueT[r];
      if (whCoreT[r] >= 0) whCoreR = r + 1;
    }
    for (int i = 0; i < 256; i++) { int sp = sinT[i] + 127; spokeVT[i] = sp * 123; spokeHT[i] = sp * 20 / 254; }
    whFineR = (int)ceilf(sqrtf(8 * 234.0f / spU)) + 2;   // nearer the far end the rings are tight (under 8 pixels apart): every pixel there
  }
  if (look == 16) {                     // Meteor Shower: where each shooting star is
    float P = sqrtf((float)SCR_W * SCR_W + (float)SCR_H * SCR_H) / 340;
    int N = NUM_SPARKS < 2 ? 2 : NUM_SPARKS > 30 ? 30 : NUM_SPARKS;   // Meteors setting
    meteorCount = N;
    for (int m = 0; m < N; m++) {
      float ph = (float)fmod(T * 0.006 * (1 + (m % 4) * 0.12) + (double)m / N + (m % 3) * 0.13, 1.0), lane = (m * 37 % 100) / 100.0f;
      float side = ((m * 61 % 100) / 100.0f - 0.5f) * 160;   // spread across the sky
      meteors[m].x = QX + (110 - ph * 320 + lane * 110 + side * 0.6f) * P;
      meteors[m].y = QY + (-170 + ph * 240 + lane * 70 + side * 0.8f) * P;
      meteors[m].len = (38 + lane * 30) * P;
      meteors[m].hue = m * 64 / N;
    }
  }
}

HOT void renderSpaceStrip(int y0, int rows, uint16_t *strip) {
  const SceneLook &L = lk[CORE_ID()]; const uint8_t look = L.look; const int spCY = L.spCY; const float spU = L.spU;   // this core's style
  uint16_t *p = strip;
  if (look == 15) {                     // Wormhole
    for (int y = y0; y < y0 + rows; y++) {
      int cy = y < spCY ? spCY - 1 - y : y - spCY;
      if (cy < TQY) {                    // the usual case: distance and angle straight from the tables, one half at a time
        const bool low = y >= spCY;
        const uint8_t *rr = rT + cy * TQX, *aa = aT + cy * TQX, *CM = colMap;
        const uint16_t *LUT = spaceLUT; const int coreR = whCoreR, qx = QX, W = SCR_W, fine = W >= 400 ? whFineR : 9999;   // (kept at hand: not looked up again for every pixel)
        for (int half = 0; half < 2; half++) {
          const int xa = half ? qx : 0, xb = half ? W : qx;
          const int base = (half ? (low ? 0 : 256) : 128) * 6 + whPh, sg6 = (half ? low : !low) ? 6 : -6;
          auto wpx = [&](int x, int &r, int &hue) __attribute__((always_inline)) -> int {      // brightness (0-63) and colour row of one pixel
            const int ci = CM[x]; r = rr[ci]; const int i = (base + sg6 * aa[ci] + whOffT[r]) & 255;
            int vi = (powT[(whRing133T[r] + spokeVT[i]) >> 8] * whNearT[r]) >> 10;
            if (r < coreR) { if (whCoreT[r] > vi) vi = whCoreT[r]; hue = 48; return vi; }   // glowing far end
            hue = ((whHue8T[r] + spokeHT[i]) >> 2) & 63; return vi;
          };
          int pend = -1, pv = 0, ph = 0;
          for (int x = xa; x < xb; x += 2) {       // big screens: every other pixel worked out where the rings are wide, the one between blended
            int r, hue, vi = wpx(x, r, hue);
            if (pend >= 0) p[pend - xa] = LUT[(hue == ph ? hue : ph) * 64 + ((pv + vi) >> 1)];
            p[x - xa] = LUT[hue * 64 + vi]; pend = -1;
            if (x + 1 < xb) {
              if (r < fine) { int r1, h1, v1 = wpx(x + 1, r1, h1); p[x + 1 - xa] = LUT[h1 * 64 + v1]; }
              else { pend = x + 1; pv = vi; ph = hue; }
            }
          }
          if (pend >= 0) p[pend - xa] = LUT[ph * 64 + pv];
          p += xb - xa;
        }
        continue;
      }
      for (int x = 0; x < SCR_W; x++) {
        int r, a; polarAt(x, y, spCY, r, a);
        int s = sinT[(a * 6 + whOffT[r] + whPh) & 255] + 127;          // spokes, 0..254
        int vi = (powT[(whRingT[r] * 133 + s * 123) >> 8] * whNearT[r]) >> 10;
        if (whCoreT[r] >= 0) { if (whCoreT[r] > vi) vi = whCoreT[r]; *p++ = spaceLUT[48 * 64 + vi]; continue; }   // glowing far end
        *p++ = spaceLUT[(((whHueT[r] + s * 20 / 254) >> 2) & 63) * 64 + vi];
      }
    }
    return;
  }
  if (look == 14 && nebReady) { nebulaStrip(y0, rows, strip); return; }   // Nebula: the stored picture
  // Galaxy, Nebula and Meteor Shower: gas worked out on a coarse grid, smoothed in between
  uint8_t *gH = spH, *gV = spV, *gX = spX;
#if defined(ESP32) && !CONFIG_FREERTOS_UNICORE
  if (xPortGetCoreID() == 1 && spX1) { gH = spH1; gV = spV1; gX = spX1; }   // core 1 has its own grid
#endif
  const int C = look == 4 ? (min(SCR_W, SCR_H) < 300 ? 3 : 4) : 8, WM = C == 3 ? 7282 : 65536 / (C * C), GC = SCR_W / C + 2;   // Nebula and Meteor Shower: softer gas, coarser grid (4x less work); WM: 1 / (C * C) in 1/65536ths
  int gy0 = y0 / C, gy1 = (y0 + rows - 1) / C + 1;
  const bool ring = ringN && !(sceneMix > 0 && sceneA != sceneB);   // (not while two styles fade: each core then draws both)
  const uint32_t tagBase = (spFrame << 16) | ((uint32_t)look << 8);
  const uint8_t *pH[24], *pV[24], *pX[24];
  for (int gy = gy0; gy <= gy1; gy++) {
    const int k = gy - gy0;
    uint8_t *h, *v, *xx; int s = 0; bool need = true;
    if (ring) {
      s = gy % ringN; h = ringH + s * SP_RING_W; v = ringV + s * SP_RING_W; xx = ringX + s * SP_RING_W;
      need = ringTag[s] != (tagBase | gy);           // the other core may have worked this row out already
    } else { h = gH + k * GC; v = gV + k * GC; xx = gX + k * GC; }
    if (need) {
      for (int gx = 0; gx < GC; gx++) spaceNode((gx * C + 0.5f - QX) * spU, (gy * C + 0.5f - spCY) * spU, h[gx], v[gx], xx[gx]);
      if (ring) { __sync_synchronize(); ringTag[s] = tagBase | gy; }
    }
    pH[k] = h; pV[k] = v; pX[k] = xx;
  }
  int dens = (look == 14 ? 7 : look == 4 ? 4 : 10) * STARS / 3, densBand = 22 * STARS / 3;
  const int genD = look == 16 ? densBand : dens, gapMax = genD > 0 ? max(2, 2048 / genD) : 0;   // stars: jump straight from one to the next instead of testing every pixel
  static int16_t colHc[2][SCR_WMAX / 3 + 3], colVc[2][SCR_WMAX / 3 + 3], colXc[2][SCR_WMAX / 3 + 3];   // one row of the grid, blended down to this pixel row (one set per core)
  const int core = CORE_ID();
  int16_t *colH = colHc[core], *colV = colVc[core], *colX = colXc[core];
  const int CW = C * WM;
  for (int y = y0; y < y0 + rows; y++) {
    int gy = y / C - gy0, fy = y % C;
    float Y = (y + 0.5f - spCY) * spU;
    const int cy = C - fy;
    const uint8_t *tH = pH[gy], *tV = pV[gy], *tX = pX[gy], *bH = pH[gy + 1], *bV = pV[gy + 1], *bX = pX[gy + 1];
    for (int g = 0; g < GC; g++) {                   // blend between the grid rows once per row, then only across
      colH[g] = tH[g] * cy + bH[g] * fy; colV[g] = tV[g] * cy + bV[g] * fy;
      colX[g] = tX[g] * cy + bX[g] * fy;
    }
    int lkx = 1 << 30, lky = 0; uint32_t lkh = 0;   // Galaxy: the knot patch the last pixel was in
    const float X0 = (0.5f - QX) * spU, xr0 = gax * X0 + gbx * Y, yr0 = gay * X0 + gby * Y, dxr = gax * spU, dyr = gay * spU;   // Galaxy: where this row is in the galaxy's plane
    uint32_t rs = hash32((uint32_t)y * 2654435761UL + 0x5bd1e995UL);
    int sx = gapMax ? (int)(rs % (uint32_t)gapMax) : SCR_W;
    for (int x = 0, g = 0; x < SCR_W; g++) {
      int hA = colH[g] * CW, dH = (colH[g + 1] - colH[g]) * WM;   // across one grid cell the gas only needs adding up
      int vA = colV[g] * CW, dV = (colV[g + 1] - colV[g]) * WM;
      int aA = colX[g] * CW, dA = (colX[g + 1] - colX[g]) * WM;
      const int xe = x + C < SCR_W ? x + C : SCR_W;
      for (; x < xe; x++, hA += dH, vA += dV, aA += dA) {
        int hi = (hA >> 17) & 63, vi = vA >> 18;
        if (look == 4 && (aA >> 16) > 90) {             // knots on the arms: pink star nurseries, blue clusters
          int am = aA >> 16;
          float xr = xr0 + x * dxr, yr = yr0 + x * dyr;
          int kx = (int)(xr * 0.25f + 4096) - 4096, ky = (int)(yr * 0.25f + 4096) - 4096;   // (floor, without the library call)
          if (kx != lkx || ky != lky) { lkx = kx; lky = ky; lkh = hash32((uint32_t)(kx + 4096) * 7919u + (uint32_t)(ky + 4096) * 104729u); }   // same patch as the last pixel: same knot
          uint32_t kh = lkh;
          int kind = kh & 15;
          if (kind < 3) {
            float dx = xr - (kx * 4 + 1 + (int)((kh >> 8) & 1) * 2), dy = yr - (ky * 4 + 1 + (int)((kh >> 9) & 1) * 2), d2 = dx * dx + dy * dy, size = kind == 0 ? 1.6f : 0.9f;
            if (d2 < size) { int kv = (int)((0.62f + am / 700.0f) * 63 * (1 - d2 / size * 0.4f)); if (kv > vi) { hi = kind == 0 ? 17 : 33; vi = min(63, kv); } }
          }
        }
        if (x == sx) {                                  // a star here
          uint32_t h = hash32((uint32_t)(y * SCR_W + x) * 2654435761UL);
          int svi = 47 + sinT[(spTw + (h >> 10)) & 255] / 10, shi = (h >> 20) & 63;
          if (look == 4) { if (svi > vi + 8) { hi = 42; vi = svi; } }
          else if (look == 14) { if (svi > vi) { hi = shi; vi = min(63, svi + 13); } }
          else if (tX[g] || (int)(h >> 26) * densBand < dens * 64) { hi = shi; vi = svi; }   // fewer away from the Milky Way
          rs = rs * 1664525UL + 1013904223UL;
          sx += 1 + (int)((rs >> 16) % (uint32_t)(gapMax - 1));
        }
        *p++ = spaceLUT[hi * 64 + vi];
      }
    }
  }
  if (look == 16) for (int m = 0; m < meteorCount; m++) {           // shooting stars with coloured tails
    const Meteor &M = meteors[m];
    int k0 = (int)((M.y + 0.5f - (y0 + rows)) / 0.6f) - 1, k1 = (int)((M.y + 0.5f - y0 + 1) / 0.6f) + 2;   // only the part of the tail that crosses this strip
    if (k0 < 0) k0 = 0;
    if (k1 > (int)M.len + 1) k1 = (int)M.len + 1;
    for (int k = k0; k < k1 && k < M.len; k++) {
      float f = 1 - k / M.len;
      int x = (int)floorf(M.x + 0.8f * k + 0.5f), y = (int)floorf(M.y - 0.6f * k + 0.5f);
      int vi = k < 3 ? 63 : (int)((0.9f * f * f + 0.05f) * 63);
