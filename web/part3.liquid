int    dipK = 256;                       // scenes with different settings fade through black: 256 = full brightness

// ---------- tables ----------
// Cartoon styles: smooth looping noise tables
uint8_t nzA[32], nzB[64], nzC[256];
uint32_t nzSeed = 12345;
uint8_t nzRnd() { nzSeed = (nzSeed * 1103515245UL + 12345UL) & 0x7fffffffUL; return (nzSeed >> 16) & 255; }

void nzTable(uint8_t *t, int len, int passes) {
  int tmp[256], n[256];
  for (int i = 0; i < len; i++) n[i] = nzRnd();
  for (int p = 0; p < passes; p++) {
    for (int i = 0; i < len; i++) tmp[i] = (n[(i + len - 1) % len] + 2 * n[i] + n[(i + 1) % len]) >> 2;
    for (int i = 0; i < len; i++) n[i] = tmp[i];
  }
  int lo = 255, hi = 0;
  for (int i = 0; i < len; i++) { if (n[i] < lo) lo = n[i]; if (n[i] > hi) hi = n[i]; }
  for (int i = 0; i < len; i++) t[i] = (uint8_t)lroundf((n[i] - lo) * 255.0f / (hi - lo));
}

static inline __attribute__((always_inline)) int nz(const uint8_t *t, int mask, int x) {
  int i = x >> 4, f = x & 15;
  return (t[i & mask] * (16 - f) + t[(i + 1) & mask] * f) >> 4;
}

void buildGeometry() {
  nzTable(nzA, 32, 1);
  nzTable(nzB, 64, 1);
  nzTable(nzC, 256, 2);
  for (int qy = 0; qy < TQY; qy++) {
    for (int qx = 0; qx < TQX; qx++) {
      float fx = qx + 0.5f, fy = qy + 0.5f;
      rT[qy * TQX + qx] = (uint8_t)min(255L, lroundf(sqrtf(fx * fx + fy * fy)));
      aT[qy * TQX + qx] = (uint8_t)lroundf(atan2f(fy, fx) / (PI / 2) * 64);
    }
  }
  for (int i = 0; i < 256; i++) sinT[i] = (int8_t)lroundf(127 * sinf(i * TWO_PI / 256));
}

void buildParams() {
  float R = RADIUS;
  for (int r = 0; r < 256; r++) {
    float rn = max((float)r, 0.5f) / R, lr = logf(rn), x = min(rn, 1.0f);
    twistT[r]  = (int16_t)(TWIST * 3.0f * lr * 40.74f);
    twist2T[r] = (int16_t)(TWIST * 1.6f * lr * 40.74f);
    depthT[r]  = (uint8_t)(255 * x * x * (3 - 2 * x));
    coreT[r]   = (uint8_t)(210 * expf(-rn * rn * 18));
    haloT[r]   = (uint8_t)(115 * expf(-r / R * ${M.rect ? "9.0f" : "3.2f"}));   // outer glow${M.rect ? ": short on this rectangle screen" : ""}
    linT[r]    = (int16_t)(r * TWIST * 1.2f * 256 / R);
    centerT[r] = (uint8_t)(55 * expf(-powf(rn * 2.2f, 2)));
    // Starburst: glowing centre, soft rings near the centre, rays toward the rim
    float sr = r / R, f1 = min(1.0f, sr / GLOW_SIZE), f2 = min(1.0f, max(0.0f, (sr - 0.15f) / 0.55f));
    int inner = (int)(256 * (1 - f1 * f1 * (3 - 2 * f1)));
    sbOuterT[r] = (uint8_t)min(255, (int)(256 * f2 * f2 * (3 - 2 * f2)));
    sbRingT[r]  = (uint8_t)min(255, (inner * inner * inner) >> 16);
    sbGlowT[r]  = (uint8_t)(105 * expf(-powf(sr / GLOW_SIZE * 1.4f, 2)));
    // Space: bright core, galaxy arm fade, black hole ring and disk
    spCoreT[r]  = (uint8_t)(230 * expf(-powf(rn / 0.16f, 2)));
    galFadeT[r] = (uint16_t)max(0, (int)(256 * (1 - sr * 0.7f)));
    float hr = 0.22f * R, dn = (sr - 0.22f) / 0.45f;
    bhRingT[r]  = (uint8_t)(255 * expf(-powf((r - hr - 1.5f) / 1.8f, 2)));
    bhDiskT[r]  = (dn >= 0 && dn < 1) ? (uint8_t)(235 - dn * 200) : 0;
    bhStarT[r]  = dn > 0.85f ? 1 : 0;
  }
  for (int d = 0; d < 64; d++) rimT[d] = (uint8_t)(255 * expf(-powf(d * 9.0f / (R * RIM_W / 100.0f), 2)));   // Rim thickness
  for (int x = 0; x < SCR_W; x++) {
    int dx = x < QX ? QX - 1 - x : x - QX;
    colMap[x] = (uint8_t)min((long)(TQX - 1), lroundf(dx / OVAL));
  }
}

uint8_t  TONE = ${turns(M) ? S.tone : 0};             // Colour depth: darker mid-tones for screens that look washed out (0 = as drawn)
uint8_t  FD_LEN = ${S.fdLen}, FD_STARCNT = ${S.fdStars}, FD_CLOUDS = ${S.fdClouds}, FD_GLOW = ${S.fdGlow};   // Full day: day length (minutes), star count, cloud amount, sun and moon brightness (%)
uint8_t  TAP_OFF = ${S.tapnext === false ? 1 : 0};             // 1: tapping the screen does nothing
uint8_t  WARM = ${turns(M) ? S.warm : 0};             // Warmth: less blue (and a little less green) for screens that lean blue
uint16_t toneS[256];                    // how much to scale a colour by, from its brightest channel (keeps the hue)
uint16_t warmG = 256, warmB = 256;
void buildTone() {
  float g = 1 + TONE / 100.0f;           // 0 -> straight line, 100 -> gamma 2 (on the colour's brightness, so pinks stay pink)
  toneS[0] = 256;
  for (int i = 1; i < 256; i++) toneS[i] = (uint16_t)lroundf(256 * powf(i / 255.0f, g) * 255 / i);
  warmB = (uint16_t)(256 - WARM * 0.65f * 2.56f); warmG = (uint16_t)(256 - WARM * 0.18f * 2.56f);   // 100%: blue x0.35, green x0.82
}
uint32_t toneRGB(uint8_t r, uint8_t g, uint8_t b) {   // the colour curve, before rounding to the screen's colours
  uint8_t m = r > g ? (r > b ? r : b) : (g > b ? g : b);
  uint32_t k = toneS[m];
  r = (r * k) >> 8; g = (g * k * warmG) >> 16; b = (b * k * warmB) >> 16;
  return ((uint32_t)r << 16) | ((uint32_t)g << 8) | b;
}
uint16_t to565(uint8_t r, uint8_t g, uint8_t b) {
  uint32_t c = toneRGB(r, g, b);
  return ((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0) | ((c & 0xFF) >> 3);
}
static inline __attribute__((always_inline)) uint32_t toneRGBi(int r, int g, int b) {   // the same, inlined for the per-pixel loops
  const int m = r > g ? (r > b ? r : b) : (g > b ? g : b);
  const uint32_t k = toneS[m];
  return (((uint32_t)r * k >> 8) << 16) | (((uint32_t)g * k * warmG >> 16) << 8) | ((uint32_t)b * k * warmB >> 16);
}
static inline __attribute__((always_inline)) uint16_t to565i(int r, int g, int b) {
  const uint32_t c = toneRGBi(r, g, b);
  return ((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0) | ((c & 0xFF) >> 3);
}
uint16_t to565raw(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }   // without the colour curve (the wood: dark browns would lose their grain)

uint32_t mixColor(uint32_t x, uint32_t y, float f) {   // blend two 0xRRGGBB colours
  uint32_t out = 0;
  for (int i = 0; i < 3; i++) {
    int cx = (x >> (16 - 8 * i)) & 0xFF, cy = (y >> (16 - 8 * i)) & 0xFF;
    out |= (uint32_t)(int)(cx + (cy - cx) * f) << (16 - 8 * i);
  }
  return out;
}

void buildPaletteFrom(uint32_t core, uint32_t rim) {   // black -> core -> rim -> near-white
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (core >> (16 - 8 * i)) & 0xFF; b[i] = (rim >> (16 - 8 * i)) & 0xFF; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    pal[i] = to565(c[0], c[1], c[2]);
    palRGB[i] = toneRGB(c[0], c[1], c[2]);
  }
}

// Space colour table: 64 hues blended around the four space colours x 64 brightness levels
uint16_t *spaceLUT = NULL;             // allocated the first time a space style is shown
void buildSpaceLUT() {
  if (!spaceLUT) return;
  for (int h = 0; h < 64; h++) {
    float p = h / 16.0f; int i = (int)p; float f = p - i; f = f * f * (3 - 2 * f);
    uint32_t A = SPACE_COLS[i & 3], B = SPACE_COLS[(i + 1) & 3];
    float base[3];
    for (int k = 0; k < 3; k++) { int ca = (A >> (16 - 8 * k)) & 0xFF, cb = (B >> (16 - 8 * k)) & 0xFF; base[k] = ca + (cb - ca) * f; }
    for (int b = 0; b < 64; b++) {
      float v = b / 63.0f; uint8_t c[3];
      for (int k = 0; k < 3; k++) {
        float x = base[k] * min(1.0f, v / 0.75f);
        if (v > 0.75f) x += (255 - x) * (v - 0.75f) / 0.25f * 0.8f;   // the brightest parts glow toward white
        if (x > 255) x = 255;
        c[k] = (uint8_t)(x * BRIGHTNESS / 100.0f);
      }
      spaceLUT[h * 64 + b] = to565(c[0], c[1], c[2]);
    }
  }
}

uint16_t xPalOwn[256];                    // the cross outline in its own colour
uint16_t *xpal = pal;                     // what the cross outline is drawn with
bool xOwn = false;
void buildCrossPal() {                    // black -> the cross colour -> a lighter one -> near-white
  xOwn = CROSS_COL <= 0xFFFFFF; xpal = xOwn ? xPalOwn : pal;
  if (!xOwn) return;
  uint8_t a[3], b[3];
  for (int i = 0; i < 3; i++) { a[i] = (CROSS_COL >> (16 - 8 * i)) & 0xFF; b[i] = a[i] + (255 - a[i]) * 35 / 100; }
  for (int i = 0; i < 256; i++) {
    uint8_t c[3];
    for (int k = 0; k < 3; k++) {
      float v;
      if (i < 110)      v = a[k] * (i / 110.0f);
      else if (i < 200) v = a[k] + (b[k] - a[k]) * ((i - 110) / 90.0f);
      else              v = b[k] + (255 - b[k]) * ((i - 200) / 55.0f * 0.6f);
      c[k] = (uint8_t)(v * BRIGHTNESS / 100.0f);
    }
    xPalOwn[i] = to565(c[0], c[1], c[2]);
  }
}
void buildPalette() { buildPaletteFrom(COLOR_CORE, COLOR_RIM); buildCrossPal(); buildSpaceLUT(); }

void updateColourFade() {             // fade through the colour sets in order, FADE_SECS per fade
  if (!FADE_ON || FADE_COUNT < 1) return;
  int n = 1 + FADE_COUNT;              // main colours + extra sets
  float pos = fmodf(millis() / 1000.0f / FADE_SECS, (float)n);
  int i = (int)pos, j = (i + 1) % n;
  float f = pos - i;
  f = f * f * (3 - 2 * f);
  uint32_t coreA = i == 0 ? COLOR_CORE : FADE_COLS[(i - 1) * 2], rimA = i == 0 ? COLOR_RIM : FADE_COLS[(i - 1) * 2 + 1];
  uint32_t coreB = j == 0 ? COLOR_CORE : FADE_COLS[(j - 1) * 2], rimB = j == 0 ? COLOR_RIM : FADE_COLS[(j - 1) * 2 + 1];
  buildPaletteFrom(mixColor(coreA, coreB, f), mixColor(rimA, rimB, f));
}

// ---------- space helpers ----------
#if defined(ESP32)
  #define HOT IRAM_ATTR                  // the drawing loops run from the chip's own fast memory, not through the flash cache
#else
  #define HOT
#endif
static inline __attribute__((always_inline)) uint32_t hash32(uint32_t n) {   // (inline: it runs for every pixel of the space styles)
  n = (n ^ 61) ^ (n >> 16);
  n *= 9;
  n ^= n >> 4;
  n *= 0x27d4eb2dUL;
  n ^= n >> 15;
  return n;
}

int starAt(int a, int r) {             // one twinkling star per small patch of sky
  uint32_t h = hash32((uint32_t)((a >> 1) * 977 + (r >> 2) * 131));
  if ((int)(h & 63) >= STARS * 2) return 0;
  if ((a & 1) != (int)((h >> 8) & 1) || (r & 3) != (int)((h >> 10) & 3)) return 0;
  return 120 + ((sinT[((h >> 12) + (uint32_t)twinkle) & 255] + 127) >> 1);
}

// ---------- sparks ----------
void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS * 1.05 + random(0, (int)(RADIUS / 5) + 1);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}

float frameK = 1;                                        // how many Studio frames (1/28 s) the last frame took
void updateSparks() {
  float fall = powf(0.95f, frameK);
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= fall;                                         // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + RADIUS * 0.22)) * frameK;  // faster near the centre
    if (s.r < 3) respawn(s);
    sparkX[i] = (int16_t)floorf(QX + cosf(s.a) * s.r * OVAL);
    sparkY[i] = (int16_t)floorf((crossOn ? crossYC : QY) + sinf(s.a) * s.r);
  }
}

// ---------- saved settings (EEPROM) ----------
bool validOut(uint8_t f) { return f == 255 || f <= 4 || f == 6 || f == 11 || (f >= 14 && f <= 16); }   // what can go outside a glowing cross
bool validFill(uint8_t f) { return f <= 11 || (f >= 14 && f <= 16) || f == 18; }   // styles that can go inside a cross (Wooden cross only: 7 warm glow, 8 blue sky, 9 sunset, 10 heavenly light, 18 full day)

inline bool isStyleScene(uint8_t c) { return c >= 200 && c <= 217; }   // 200 + style: another style to fade into (crosses too)
inline bool isCrossSt(uint8_t st) { return (st >= 8 && st <= 13) || st == 17; }
inline bool validScene(uint8_t c) { return c == PORTAL || c < MAX_PICS || (c >= 128 && c < 128 + MAX_PICS) || isStyleScene(c); }

bool validScenes(const Saved &s) {
  if (s.sceneCount > 8 || !(s.holdSecs >= 1 && s.holdSecs <= 3600) || !(s.sceneFade >= 0 && s.sceneFade <= 600)) return false;
  if (s.framePct < 10 || s.framePct > 95) return false;
  if (s.crossW < 25 || s.crossW > 100 || s.beam < 5 || s.beam > 30 || s.bar < 20 || s.bar > 50) return false;
  for (int k = 0; k < 4; k++) if (s.spaceCols[k] > 0xFFFFFF) return false;
  if (!validFill(s.crossFill)) return false;
  if (s.crossRipple > 10) return false;   // (crosses: ripple 0-2; the Wooden cross: wood style 0-10)
  for (uint8_t i = 0; i < s.sceneCount; i++) {
    if (!validScene(s.scenes[i])) return false;
  }
  return true;
}

