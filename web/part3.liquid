void frameStart() {
  updateScene();
  if (havePending) {
    apply(pendingSettings);
    saveSettings();
    if (pendRip) { pendRip = false; for (int j = 0; j < 4; j++) RIP_C[j] = pendRipC[j]; saveExtra(); }
    if (pendRim) { pendRim = false; if (pendRimW != RIM_W) { RIM_W = pendRimW; saveExtra(); buildParams(); } }
    if (pendXout) { pendXout = false; if (pendOut != CROSS_OUT) { CROSS_OUT = pendOut; saveExtra(); } }
    if (pendXcol) { pendXcol = false; if (pendCol != CROSS_COL) { CROSS_COL = pendCol; saveExtra(); } }
    grabLook(mainLook); curLook = -1;      // the main settings are loaded now
    buildTone();
    if (spaceLUT) buildSpaceLUT();       // space colours go through the colour curve too
    buildParams();
    buildPalette();
    resetSparks();
    havePending = false;
  }
  if (scenePending) {                    // a scene's own settings changed
    scenePending = false;
    for (int k = 0; k < 8; k++) { SCENE_HAS[k] = pendHas[k]; SCENE_LOOKS[k] = pendLook[k]; }
    saveScenes();
    if (curLook >= 0) { int c = curLook; curLook = -2; useSceneLook(c); }   // showing one now: load its new settings
  }
  pickSceneLook();
#if TURNS
  if (wantPortrait != PORTRAIT) turnScreen(wantPortrait);
  if (wantFlip != FLIP) { FLIP = wantFlip; turnPending = true; }   // a half turn: the same size, the panel just faces the other way
#endif
  bool isCross = ((STYLE >= 8 && STYLE <= 13) || STYLE == 17) && curLook != -3;   // 17: Wooden cross (-3: another style is showing, sized as a portal: no cross needed)
  if (isCross && crossAvailable() && edgeBuf) prepareCross();
  crossOn = isCross && crossReady;
  woodOn = crossOn && STYLE == 17;
  look = crossOn ? CROSS_FILL : isCross ? 0 : STYLE;   // crosses: the chosen style is drawn inside (the Wooden cross: behind)
  if (crossOn && ((look >= 7 && look <= 10) || look == 18) && !woodOn) look = 0;   // the warm glow and the skies are only for the Wooden cross
  if (woodOn && look == 11) look = 7;                            // solid colour is for the glowing crosses
  if (woodOn) {
    prepareWood();
    static float ph = 0; static uint32_t phMs = 0;   // the warm glow breathes faster with a higher Spin speed (0.12: as before)
    const uint32_t nowMs = millis(); ph += (phMs ? (float)min((uint32_t)500, nowMs - phMs) : 0.0f) / 1000.0f * 1.3f * SPEED / 0.12f; phMs = nowMs;
    if (ph > 6283.2f) ph -= 6283.2f;
    woodPulse = (int)(256 * (0.75f + 0.25f * sinf(ph)));
  }
  if (crossOn && !woodOn) buildCrossRipple(); else memset(crossRipT, 0, sizeof(crossRipT));
  if (woodOn && ((look >= 8 && look <= 10) || look == 18)) {           // a cloud sky (no room: the warm glow)
    if (cloudMemory()) { prepareClouds(look == 18 ? 1 : look - 8, look == 18 ? FD_CLOUDS : -1); if (look == 18) prepareFullDay(); }
    else { static bool said = false; if (!said) { said = true; Serial.printf("[portal] not enough memory for the sky (%u free, %u in one piece): showing the warm glow\\n", (unsigned)ESP.getFreeHeap(), (unsigned)ESP.getMaxAllocHeap()); } look = 7; }
  }
  bool baseCross = crossOn;
  int baseLook = look;
  lookA = isStyleScene(sceneA) ? sceneA - 200 : baseLook; crossA = !isStyleScene(sceneA) && baseCross;
  lookB = isStyleScene(sceneB) ? sceneB - 200 : baseLook; crossB = !isStyleScene(sceneB) && baseCross;
  bool needB = sceneMix > 0 && sceneA != sceneB;
  for (int k = 0; k < 2; k++) {                       // space styles: worked out per frame (no room: show the Vortex)
    int &L = k ? lookB : lookA;
    if (k && !needB && sceneMix < 128) break;
    if (L == 4 || (L >= 14 && L <= 16)) { look = L; if (spaceMemory()) prepareSpace(); else L = 0; }
  }
  if (!needB && sceneMix < 128) lookB = lookA;
  outLook = baseCross && !woodOn && CROSS_OUT != 255 && validOut(baseLook) ? baseLook : 255;   // Background on: the very same style as inside the cross
  if (isGridSpace(outLook)) {                         // a space picture outside: only one space picture at a time
    bool other = (isGridSpace(lookA) && lookA != outLook) || (isGridSpace(lookB) && lookB != outLook);
    if (other) outLook = 255;
    else if (!isGridSpace(lookA) && !isGridSpace(lookB)) { look = outLook; if (spaceMemory()) prepareSpace(); else outLook = 255; }
  }
  {
    auto gridLook = [](int L) { return L == 4 || (L == 14 && !nebReady) || L == 16; };

    if (gridLook(lookA) || gridLook(lookB) || gridLook(outLook)) ringMemory(); else if (ringTried) freeRing();
  }
  look = lookA;
  crossOn = baseCross;
  spCY = crossOn ? crossYC : QY;
  updateColourFade();
  updateSparks();
  for (int a = 0; a < 256; a++) {                     // wobbly rim edge for this frame
    float ang = a * TWO_PI / 256;
    float wob = sinf(ang * 5 + t * 2) * 1.2f + sinf(ang * 3 - t * 3) * 0.8f;
    edgeT[a] = (int16_t)(RADIUS * (1 + wob * 0.025f * (1 - RIM_SMOOTH / 100.0f)));
  }
  // Hyperspace: where each streaking star is this frame (3 layers x 256 directions)
  bhHole = (int)(0.22f * RADIUS);
  twinkle = (int)(t * 25);
  if (lookA == 3 || lookB == 3 || outLook == 3) {
    for (int L = 0; L < 3; L++) {
      for (int a = 0; a < 256; a++) {
        uint32_t h = hash32((uint32_t)(a * 3 + L * 7919));
        int i = L * 256 + a;
        warpOn[i] = (int)(h & 15) < STARS + 1;
        float pos = fmodf((float)((h >> 8) & 1023) + t * (60 + L * 25), 1024.0f) / 1024.0f;
        float rr = pos * pos * 1.15f * RADIUS, len = 1.5f + rr * 0.22f, m = min(1.0f, rr / (0.8f * RADIUS));
        if (!warpOn[i]) { warpLo[i] = 1; warpHi[i] = 0; continue; }
        warpLo[i] = (int16_t)floorf(rr - len) + 1; warpHi[i] = (int16_t)floorf(rr);   // the pixels it lights: rr - len < r <= rr
        warpA[i] = (int32_t)((110 + 145 * m - 87 * m * rr / len) * 256); warpB[i] = (int16_t)(87 * m / len * 256);   // brighter toward its head
      }
    }
  }
  // Starburst ripples: rings expanding outward, precomputed per distance for this frame
  memset(ripCrestT, 0, sizeof(ripCrestT));
  memset(ripTroughT, 0, sizeof(ripTroughT));
  if (lookA == 2 || lookB == 2 || outLook == 2) {
    for (uint8_t i = 0; i < RIPPLES; i++) {
      float pr = fmodf(t * RIP_SPEED + (float)i / RIPPLES, 1.0f);
      float rr = 0.16f + pr * 0.62f, w = 0.04f + pr * 0.04f, fade = powf(1 - pr, 1.1f);
      for (int r = 0; r < 256; r++) {
        float d = (r / RADIUS - rr) / w;
        ripCrestT[r]  = (uint8_t)min(255, ripCrestT[r] + (int)(fade * 110 * expf(-d * d)));
        ripTroughT[r] = (uint8_t)min(255, ripTroughT[r] + (int)(fade * 35 * expf(-(d + 1.6f) * (d + 1.6f))));
      }
    }
  }
}

void frameEnd() {
  static uint32_t lastMs = millis();     // everything moves by the clock, so every screen matches the Studio at any frame rate
  uint32_t now = millis();
  frameK = min(8.0f, (now - lastMs) / 35.7f);   // the Studio preview steps 28 times a second
  t += SPEED * frameK;
  spaceT += SPEED * 8 * min(8.0f, (now - lastMs) / 35.7f);   // the Studio preview steps 28 times a second
  cloudDrift += 6 * min(8.0f, (now - lastMs) / 1000.0f) * (SPEED / 0.12f);   // clouds drift by the clock, faster with a higher Spin speed
  if (cloudDrift > 1e6f) cloudDrift = 0;
  ripplePh = fmodf(ripplePh + 0.3f * min(8.0f, (now - lastMs) / 1000.0f) * (SPEED / 0.12f), 1.0f);   // Ripple rings move by the clock, faster with a higher Spin speed
  lastMs = now;
  if (spaceT > 1e7) spaceT = 0;
  if (t > TWO_PI * 100) t -= TWO_PI * 100;   // wrap seamlessly so it can run forever
}

static inline __attribute__((always_inline)) int cartoonV(int a, int r, int phase) {   // blobby flat-shaded swirl
  int warp = (((nz(nzA, 31, a * 2 + r * 3 + (phase >> 1)) - 128) * 7) >> 3) + ((nz(nzB, 63, a * 4 + r * 6 - phase) - 128) >> 2);
  int sp = sinT[(a * ARMS - linT[r] + phase + warp) & 255];
  return r < 7 ? 232 : sp > 25 ? 232 : sp > -45 ? 182 : 120;
}

static inline __attribute__((always_inline)) int styleV(int look, int a, int r, int phase, int phase2) {   // brightness (0-255) inside the portal for one style
  int v;
  if (look == 11) return 110;                   // Solid colour (crosses): the inner colour, flat
  if (look == 7 || look == 6) return cartoonV(a, r, phase);
  if (look == 0) {                              // Vortex
    int s  = sinT[(a * ARMS + twistT[r] + phase) & 255];
    int s2 = sinT[(a * 2 - twist2T[r] + phase2) & 255];
    int d = depthT[r];
    int band = ((s + 127) * 5 + (s2 + 127) * 3) >> 3;
    v = (d * (60 + ((band * 195) >> 8))) >> 8;   // swirling bands, darker toward the throat
    if (s > 100) v += ((s - 100) * 3 * d) >> 8; // bright spiral crests
    if (coreT[r] > v) v = coreT[r];              // glowing core
  } else if (look == 1) {                       // Toon Spiral: flat-shaded wavy bands
    int w  = sinT[(a * 6 + r * 4 + phase2) & 255] >> 2;
    int sp = sinT[(a * ARMS - linT[r] + phase + w) & 255];
    v = sp > 40 ? 235 : sp > -20 ? 190 : sp > -70 ? 150 : 95;
    if (coreT[r] > v) v = coreT[r];
  } else if (look == 6) {                       // Cartoon Swirl: blobby flat-shaded bands
    v = cartoonV(a, r, phase);
  } else if (look == 3) {                       // Hyperspace: stars streak outward
    v = 30 + ((sinT[(a * 3 + (phase >> 3)) & 255] + 127) >> 4) + (spCoreT[r] >> 2);
    for (int i = a; i < 768; i += 256)          // the three layers of stars
      if (r >= warpLo[i] && r <= warpHi[i]) { int sv = (warpA[i] + warpB[i] * r) >> 8; if (sv > v) v = sv; }
  } else if (look == 5) {                       // Black hole: shadow, bright ring, swirling disk
    if (r < bhHole) v = 0;
    else {
      int swirl = sinT[(a * 3 + r * 6 - phase * 2) & 255] + (sinT[(a * 7 - r * 3 - phase) & 255] >> 1);
      int disk  = bhDiskT[r] * (310 + swirl) / 500;
      v = bhRingT[r] > disk ? bhRingT[r] : disk;
      if (bhStarT[r]) { int st = starAt(a, r); if (st > v) v = st; }
    }
  } else {                                       // Starburst: glowing centre, soft rings, rays, ripples
    int ray  = sinT[(a * 11 + (phase >> 2)) & 255] + (sinT[(a * 19 - (phase >> 1)) & 255] >> 1) + (sinT[(a * 37 + phase) & 255] >> 1);
    int wave = sinT[(r * 4 - phase * 2 + (sinT[(a * 9 + (phase >> 2)) & 255] >> 4)) & 255];
    int tex  = sinT[(r * 9 - phase * 3 + (sinT[(a * 7 + (phase >> 1)) & 255] >> 3)) & 255];
    int sd   = sinT[(a * 22 + (phase >> 3)) & 255], sdp = sd > 0 ? sd : 0;
    v = 115 + sbGlowT[r]
      + ((((wave + 127) * 85 >> 8) * sbRingT[r]) >> 8)     // soft rings near the centre
      + ((((tex * 26) >> 7) * sbRingT[r]) >> 8)
      + ((((ray * 32) >> 7) * sbOuterT[r]) >> 8)            // rays toward the rim
      + ((ripCrestT[r] * (141 + ((sdp * 115) >> 7))) >> 8) - ripTroughT[r];   // expanding ripples
    if (v < 0) v = 0;
  }
  return v < 0 ? 0 : v;
}

static inline __attribute__((always_inline)) uint16_t max565(uint16_t a, uint16_t b) {   // brighter of two colours, channel by channel
  return max(a & 0xF800, b & 0xF800) | max(a & 0x07E0, b & 0x07E0) | max(a & 0x001F, b & 0x001F);
}

// ---------- Ripple (glowing crosses): copies of the outline echo through the inside of the cross ----------
uint8_t crossRipT[128];                 // extra brightness by distance inside the cross edge, this frame
float   ripplePh = 0;
uint8_t  ripA[128];                     // how strongly each ring covers what's below
uint16_t ripC565[128];                  // Gradient ripple: each ring's colour by distance inside the cross edge
bool     ripColOn = false;
HOT inline uint16_t add565(uint16_t a, uint16_t b) {   // brighten a by b, channel by channel
  int r = (a >> 11) + (b >> 11), g = ((a >> 5) & 63) + ((b >> 5) & 63), bl = (a & 31) + (b & 31);
  return (min(r, 31) << 11) | (min(g, 63) << 5) | min(bl, 31);
}
void ripRGB(float ph, float *c) {         // Gradient: a ring's colour for how far it has travelled (0-1), through the four colours
  float x = min(2.999f, max(0.0f, ph) * 3); int i = (int)x; float f = x - i;
  for (int k = 0; k < 3; k++) { float a = (RIP_C[i] >> (16 - 8 * k)) & 255, b = (RIP_C[i + 1] >> (16 - 8 * k)) & 255; c[k] = a + (b - a) * f; }
}
void buildCrossRipple() {
  memset(crossRipT, 0, sizeof(crossRipT));
  ripColOn = false;
  int dir = CROSS_RIPPLE % 3, mode = CROSS_RIPPLE / 3;   // ripple direction (1 out, 2 in) and colour (0 glow, 1 gradient)
  if (!dir) return;
  if (mode > 1) mode = 0;                // (the old Rainbow setting: plain glow)
  static float acc[128 * 4];
  if (mode) memset(acc, 0, sizeof(acc));
  float R = min(RADIUS, (SCR_H - 8) * (100.0f - BAR) / 100), AW = max(2.0f, R * BEAM / 100.0f), s = R / 149.0f;
  float rw = max(1.5f, AW * 0.18f), span = AW - rw;
  for (int j = 0; j < 3; j++) {
    float ph = fmodf(ripplePh + j / 3.0f, 1.0f), e0 = dir == 1 ? AW - ph * span : rw + ph * span;   // 1: outward, 2: inward
    float b = 150 * (0.35f + 0.65f * sinf(ph * PI));
    if (mode) {                          // coloured rings
      float c[3]; ripRGB(dir == 1 ? ph : 1 - ph, c);
      for (int k = 1; k < 128; k++) { float q = (k - 0.5f - e0) / (1.4f * s), w = b / 150 * expf(-q * q); if (w > 0.01f) { for (int m = 0; m < 3; m++) acc[k * 4 + m] += c[m] * w; acc[k * 4 + 3] += w; } }
      continue;
    }
    for (int k = 1; k < 128; k++) { float q = (k - 0.5f - e0) / (1.4f * s); crossRipT[k] = (uint8_t)min(255.0f, crossRipT[k] + b * expf(-q * q)); }
  }
  if (mode) {                            // each ring in its own colour, covering what's below where it's strong
    for (int k = 0; k < 128; k++) {
      float W = acc[k * 4 + 3];
      if (W < 0.02f) { ripC565[k] = 0; ripA[k] = 0; continue; }
      float m = BRIGHTNESS / 100.0f / W;
      ripC565[k] = to565((uint8_t)min(255.0f, acc[k * 4] * m), (uint8_t)min(255.0f, acc[k * 4 + 1] * m), (uint8_t)min(255.0f, acc[k * 4 + 2] * m)) | 0;
      ripA[k] = (uint8_t)min(255.0f, W * 1.6f * 256);
      if (!ripA[k]) ripC565[k] = 0;
    }
    ripColOn = true;
  }
}

#define OUT_DIM 256                      // the background around a glowing cross: the same colours as inside
static inline __attribute__((always_inline)) uint16_t dim565(uint16_t c, int m) {    // darken a colour (m: 0-255)
  return ((((c >> 11) * m) >> 8) << 11) | (((((c >> 5) & 63) * m) >> 8) << 5) | (((c & 31) * m) >> 8);
}
static inline __attribute__((always_inline)) int outV(int x, int y, int phase, int phase2) { int r, a; polarAt(x, y, QY, r, a); return (styleV(outLook, a, r, phase, phase2) * OUT_DIM) >> 8; }   // centred on the screen (quick: straight from the tables)
HOT void crossMask(int y0, int rows, uint16_t *strip, int look, int phase, int phase2) {   // glowing cross outline over a space picture
  const int8_t *edgeBuf = edgeRows(y0);
  for (int i = 0; i < rows * SCR_W; i++) {
    int ce = edgeBuf[i];
    if (ce <= 0 && outLook != 255) {                  // something outside the cross
      uint16_t g = xpal[max(crossRimT[-ce], crossHaloT[-ce])];
      if (outLook == look) strip[i] = max565(dim565(strip[i], OUT_DIM), g);
      else if (!isGridSpace(outLook)) strip[i] = max565(pal[min(255, outV(i % SCR_W, y0 + i / SCR_W, phase, phase2))], g);
      else strip[i] = g;
      continue;
    }
    if (ce > 0) { int rv = max((int)crossRimT[ce], crossRipT[ce] > 8 ? min(255, crossRipT[ce] + 60) : 0); if (rv > 8) strip[i] = max565(strip[i], xpal[rv]); if (ripColOn && ripA[ce]) strip[i] = mix565(strip[i], ripC565[ce], ripA[ce]); }
    else strip[i] = xpal[max(crossRimT[-ce], crossHaloT[-ce])];
  }
}

// ---------- Wooden cross (style 17): carved wood, the crossbar joined flush with the upright ----------
// Behind it (CROSS_FILL): 7 = a warm glow in the main colours, otherwise any portal or space style.
bool     woodOn = false;
uint8_t  woodGT[256], woodShT[128], woodVigT[256];
uint16_t woodGlowT[128], woodWideT[256];   // warm glow, in 1/16ths of a palette step
DRAM_ATTR const uint8_t BAYER4[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
static inline __attribute__((always_inline)) uint16_t glowPx(int vf, int x, int y) {   // a palette position in 1/16ths -> a smooth, dithered screen colour
  if (vf > 255 * 16) vf = 255 * 16;
  int i = vf >> 4, f = vf & 15, j = i < 255 ? i + 1 : 255, d = BAYER4[((y & 3) << 2) | (x & 3)];
  uint32_t A = palRGB[i], B = palRGB[j];
  int r = (int)(A >> 16) + ((((int)(B >> 16) - (int)(A >> 16)) * f) >> 4) + (d >> 1);
  int g = (int)((A >> 8) & 255) + ((((int)((B >> 8) & 255) - (int)((A >> 8) & 255)) * f) >> 4) + (d >> 2);
  int b = (int)(A & 255) + ((((int)(B & 255) - (int)(A & 255)) * f) >> 4) + (d >> 1);
  if (r > 255) r = 255; if (g > 255) g = 255; if (b > 255) b = 255;
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}
uint8_t (*woodWobT)[1024] = NULL;          // grain sway along each beam (made when the Wooden cross is first shown)
float    woodAW = 10, woodHHL = 20, woodBot = 100, woodTop = 50, woodS = 1;
int      woodVS = 51, woodFS = 384, woodUS = 51, woodPulse = 256;
uint32_t woodKey = 0;

float woodNoise(float x, uint32_t seed) {      // smooth 1-D noise, 0..1
  int i = (int)floorf(x);
  float f = x - i; f = f * f * (3 - 2 * f);
  float a = (hash32((uint32_t)(i * 7919) + seed) & 1023) / 1023.0f, b = (hash32((uint32_t)((i + 1) * 7919) + seed) & 1023) / 1023.0f;
  return a + (b - a) * f;
}

float woodBox(float x, float y, float cx, float cy, float hw, float hh) {
  float dx = fabsf(x - cx) - hw, dy = fabsf(y - cy) - hh;
  return hypotf(fmaxf(dx, 0), fmaxf(dy, 0)) + fminf(fmaxf(dx, dy), 0);
}
float woodSD(float x, float y) {               // one solid piece: upright and crossbar together
  return fminf(woodBox(x, y, 0, (woodBot - woodTop) / 2, woodAW, (woodBot + woodTop) / 2), woodBox(x, y, 0, 0, woodHHL, woodAW));
}

// Eleven woods (CROSS_RIPPLE picks it for the Wooden cross): 0 classic, 1 pine, 2 rustic oak, 3 walnut, 4 cherry, 5 mahogany,
// 6 cedar, 7 driftwood, 8 ebony, 9 maple, 10 olive wood.
// The wood never moves, so the board works it out once per pixel and keeps it in flash next to the cross outline:
// one byte per pixel, 32 wood tones x 8 shades, then just looks the colours up while drawing.
struct WoodGrain { float early[3], late[3], freq, arch, off, warp, l0, l1, tone, pores, poreLen, poreDark, u0V, u0H; };
const WoodGrain WOOD_GRAINS[10] = {
  { { 222, 176, 118 }, { 156, 94, 46 }, 0.15f, 0.10f, 20, 3.0f, 0.50f, 0.86f, 0.10f, 0.008f, 9, 0.85f, 30, -25 },   // pine
  { { 150, 100, 58 }, { 88, 54, 30 }, 0.26f, 0.08f, 22, 2.4f, 0.45f, 0.82f, 0.16f, 0.025f, 8, 0.78f, -20, 60 },    // rustic oak
  { { 124, 84, 58 }, { 60, 38, 26 }, 0.19f, 0.09f, 18, 3.2f, 0.46f, 0.84f, 0.16f, 0.045f, 10, 0.68f, 10, -40 },   // walnut
  { { 200, 118, 80 }, { 150, 76, 48 }, 0.15f, 0.1f, 24, 2.4f, 0.55f, 0.9f, 0.16f, 0.004f, 9, 0.85f, -30, 20 },   // cherry
  { { 158, 76, 52 }, { 104, 46, 32 }, 0.32f, 0.03f, 30, 1.4f, 0.42f, 0.82f, 0.12f, 0.05f, 16, 0.7f, 0, 0 },   // mahogany
  { { 226, 154, 112 }, { 150, 78, 56 }, 0.17f, 0.12f, 16, 3.6f, 0.48f, 0.82f, 0.18f, 0.006f, 9, 0.85f, 40, -10 },   // cedar
  { { 186, 178, 164 }, { 122, 114, 104 }, 0.2f, 0.06f, 20, 4.5f, 0.4f, 0.78f, 0.24f, 0.07f, 26, 0.55f, -10, 30 },   // driftwood
  { { 56, 46, 40 }, { 36, 30, 27 }, 0.3f, 0.04f, 26, 1.8f, 0.55f, 0.92f, 0.1f, 0.01f, 12, 0.8f, 20, -20 },   // ebony
  { { 238, 214, 172 }, { 214, 182, 136 }, 0.12f, 0.1f, 22, 2.2f, 0.58f, 0.92f, 0.08f, 0.002f, 9, 0.9f, -20, 50 },   // maple
  { { 220, 194, 140 }, { 104, 80, 46 }, 0.22f, 0.16f, 12, 9.0f, 0.58f, 0.86f, 0.2f, 0.006f, 9, 0.85f, 50, -60 }    // olive wood
};
const float WOOD_SHADE[8] = { 0.70f, 0.78f, 0.86f, 0.93f, 1.0f, 1.08f, 1.17f, 1.28f };
uint16_t woodPal8[256];
uint8_t *woodBuf = NULL;                   // one strip of wood bytes
uint32_t woodPlaneKey = 0;
int      woodGrain = 0;

float woodHash01(int a, int b) { return (hash32((uint32_t)(a * 73856093) ^ (uint32_t)(b * 19349663)) & 65535) / 65536.0f; }
float woodNoise2(float x, float y, uint32_t seed) {
  int ix = (int)floorf(x), iy = (int)floorf(y);
  float u = x - ix, w = y - iy; u = u * u * (3 - 2 * u); w = w * w * (3 - 2 * w);
  float L[4];
  for (int k = 0; k < 4; k++) L[k] = (hash32((uint32_t)((ix + (k & 1)) * 73856093) ^ (uint32_t)((iy + (k >> 1)) * 19349663) ^ (uint32_t)(seed * 83492791)) & 1023) / 1023.0f;
  return (L[0] + (L[1] - L[0]) * u) * (1 - w) + (L[2] + (L[3] - L[2]) * u) * w;
}
inline float woodSst(float a, float b, float x) { float t = fminf(1, fmaxf(0, (x - a) / (b - a))); return t * t * (3 - 2 * t); }

void woodColorOf(int grain, int tn, float *c) {            // wood tone tn (0-31) of a grain
  if (grain == 0) {
    const float c0[3] = { 46, 26, 12 }, c1[3] = { 112, 66, 32 }, c2[3] = { 176, 120, 66 };   // dark walnut -> oak
    float tt = 0.40f + tn / 31.0f * 0.36f;
    for (int j = 0; j < 3; j++) c[j] = tt < 0.5f ? c0[j] + (c1[j] - c0[j]) * tt * 2 : c1[j] + (c2[j] - c1[j]) * (tt - 0.5f) * 2;
  } else {
    const WoodGrain &G = WOOD_GRAINS[grain - 1];
    float q = tn / 31.0f * 1.05f;
    for (int j = 0; j < 3; j++) {
      if (q < 0.25f) c[j] = G.late[j] * 0.55f + (G.late[j] - G.late[j] * 0.55f) * q / 0.25f;
      else { float g = (q - 0.25f) / 0.75f; c[j] = g <= 1 ? G.late[j] + (G.early[j] - G.late[j]) * g : G.early[j] * (1 + (g - 1) * 0.5f); }
    }
  }
}

uint8_t woodByte(int x, int y, int ce) {                     // one pixel of wood: tone and shade
  float fx = x + 0.5f - SCR_W / 2.0f, fy = y + 0.5f - crossYC;
  bool inH = fabsf(fy) < woodAW && fabsf(fx) < woodHHL;      // the crossbar (its grain runs across)
  int seed = inH ? 11 : 3, idx;
  if (woodGrain == 0) {                                      // classic: even, straight lines
    int u = (int)floorf(inH ? fx : fy), v = (int)floorf(inH ? fy : fx);
    int ring = (v * woodVS + woodWobT[inH][constrain(u + 512, 0, 1023)]) & 255;
    int fi = (v * woodFS) >> 8, fu = (u * woodUS) >> 8;
    int h = hash32((uint32_t)(fi * 7919 + fu * 104729 + seed * 97)) & 255;
    float t = 0.66f - woodGT[ring] / 255.0f * 0.2f + (h - 128) / 256.0f * 0.05f;
    idx = (int)lroundf((t - 0.40f) / 0.36f * 31);
  } else {                                                   // pine / rustic oak: growth rings round a pith off the board
    const WoodGrain &G = WOOD_GRAINS[woodGrain - 1];
    float uu = (inH ? fx : fy) / woodS, vv = (inH ? fy : fx) / woodS;
    float warp = (woodNoise2(uu * 0.02f + seed, vv * 0.06f + seed * 3, seed) - 0.5f) * G.warp + (woodNoise(uu * 0.004f + seed * 7, seed + 101) - 0.5f) * G.warp * 2;
    float cu = (uu - (inH ? G.u0H : G.u0V)) * G.arch, dv = vv + G.off + warp;
    float rc = sqrtf(dv * dv + cu * cu) * G.freq, f = rc - floorf(rc);
    float late = woodSst(G.l0, G.l1, f) * (1 - woodSst(0.96f, 1, f));
    float tonef = 1 + (woodNoise(uu * 0.01f + seed * 13, seed + 202) - 0.5f) * G.tone;
    float pore = woodHash01((int)floorf(vv * 1.2f) + seed * 131, (int)floorf(uu / G.poreLen)) < G.pores ? G.poreDark : 1;
    float fib = 1 + (woodHash01((int)floorf(vv * 2) + seed * 17, (int)floorf(uu * 0.3f)) - 0.5f) * 0.06f;
    float q = (0.25f + 0.75f * (1 - late)) * tonef * pore * fib;
    idx = (int)lroundf(q / 1.05f * 31);
  }
  float k = 1;
  if (ce <= 5) {                                             // bevelled edges, lit from the top left
    float e = -woodSD(fx, fy), bev = 3.2f * woodS;
    if (e < bev) {
      float gx = woodSD(fx + 1, fy) - woodSD(fx - 1, fy), gy = woodSD(fx, fy + 1) - woodSD(fx, fy - 1), gl = hypotf(gx, gy);
