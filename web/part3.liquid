// ---- touch: the XPT2046 shares the screen's SPI pins ----
uint16_t xptCmd(uint8_t c) {
#if USE_DMA
  if (lcdDma) {
    if (!touchDevOk) return 0;
    spi_transaction_t t;
    memset(&t, 0, sizeof(t));
    t.length = 24; t.rxlength = 24; t.flags = SPI_TRANS_USE_TXDATA | SPI_TRANS_USE_RXDATA;
    t.tx_data[0] = c;
    if (spi_device_polling_transmit(touchDev, &t) != ESP_OK) return 0;
    return ((t.rx_data[1] << 8) | t.rx_data[2]) >> 3;
  }
#endif
  SPI.transfer(c);
  uint16_t h = SPI.transfer(0), l = SPI.transfer(0);
  return ((h << 8) | l) >> 3;
}
bool touchRaw(int &rx, int &ry) {        // only between frames: the screen isn't being sent anything
  if (digitalRead(TAP_PIN) != LOW) return false;
#if USE_DMA
  const bool dma = lcdDma;
#else
  const bool dma = false;
#endif
  digitalWrite(PIN_CS, HIGH);            // the screen stops listening
  if (!dma) SPI.beginTransaction(SPISettings(2000000, MSBFIRST, SPI_MODE0));
  digitalWrite(TAP_CS, LOW);
  uint16_t xs[7], ys[7];
  xptCmd(0xD0);                          // (the first reading settles)
  for (int i = 0; i < 7; i++) { xs[i] = xptCmd(0xD0); ys[i] = xptCmd(0x90); }
  xptCmd(0x90);
  digitalWrite(TAP_CS, HIGH);
  if (!dma) SPI.endTransaction();
  if (dma) digitalWrite(PIN_CS, LOW);    // the screen listens again
  for (int i = 1; i < 7; i++) for (int j = i; j > 0 && xs[j] < xs[j - 1]; j--) { uint16_t t = xs[j]; xs[j] = xs[j - 1]; xs[j - 1] = t; }
  for (int i = 1; i < 7; i++) for (int j = i; j > 0 && ys[j] < ys[j - 1]; j--) { uint16_t t = ys[j]; ys[j] = ys[j - 1]; ys[j - 1] = t; }
  rx = xs[3]; ry = ys[3];
  if (xs[5] - xs[1] > 150 || ys[5] - ys[1] > 150) return false;   // still moving, or a light touch
  return digitalRead(TAP_PIN) == LOW && rx > 60 && rx < 4040 && ry > 60 && ry < 4040;
}
// raw touch -> the upright (portrait) screen, then to the way the screen is turned now
void panelToScreen(float px, float py, int &x, int &y) {
  int P = (int)px, Q = (int)py;
  switch (rotNow()) {
    case 0: x = P; y = Q; break;
    case 1: x = Q; y = SCR_SHORT - 1 - P; break;
    case 2: x = SCR_SHORT - 1 - P; y = SCR_WMAX - 1 - Q; break;
    default: x = SCR_WMAX - 1 - Q; y = P; break;
  }
}
void screenToPanel(int x, int y, float &px, float &py) {
  switch (rotNow()) {
    case 0: px = x; py = y; break;
    case 1: px = SCR_SHORT - 1 - y; py = x; break;
    case 2: px = SCR_SHORT - 1 - x; py = SCR_WMAX - 1 - y; break;
    default: px = y; py = SCR_WMAX - 1 - x; break;
  }
}
bool touchXY(int &x, int &y) {
  int rx, ry;
  if (!touchRaw(rx, ry)) return false;
  panelToScreen(tcal[0] * rx + tcal[1] * ry + tcal[2], tcal[3] * rx + tcal[4] * ry + tcal[5], x, y);
  return true;
}
void tcalLoad() {
  Preferences pr;
  if (pr.begin("touch", true)) {
    float m[6];
    if (pr.getBytes("cal", m, sizeof(m)) == sizeof(m) && pr.getUInt("ok", 0) == 0x5A17u) { for (int i = 0; i < 6; i++) tcal[i] = m[i]; tcalOk = true; }
    pr.end();
  }
}
void tcalSave() {
  Preferences pr;
  if (pr.begin("touch", false)) { pr.putBytes("cal", tcal, sizeof(float) * 6); pr.putUInt("ok", 0x5A17u); pr.end(); }
  tcalOk = true;
}
// ---- the home button, drawn over the picture ----
#define HB 44
float hbSeg(float x, float y, float ax, float ay, float bx, float by) {
  float vx = bx - ax, vy = by - ay, t = ((x - ax) * vx + (y - ay) * vy) / (vx * vx + vy * vy);
  t = t < 0 ? 0 : t > 1 ? 1 : t;
  float dx = x - ax - vx * t, dy = y - ay - vy * t;
  return sqrtf(dx * dx + dy * dy);
}
const float HB_SEGS[8][4] = { { 10, 22, 22, 10.5f }, { 22, 10.5f, 34, 22 }, { 14, 19.5f, 14, 33 }, { 30, 19.5f, 30, 33 }, { 14, 33, 30, 33 }, { 19.5f, 33, 19.5f, 26 }, { 19.5f, 26, 24.5f, 26 }, { 24.5f, 26, 24.5f, 33 } };
void homeIcon(uint16_t *buf, int y0, int rows) {   // a strip that's ready to send: draw the button where it overlaps (worked out each time: no memory kept)
  const int bx = SCR_W - HB - 8, by = SCR_H - HB - 8;
  if (y0 + rows <= by || y0 >= by + HB) return;
#if USE_DMA
  const bool sw = lcdDma;
#else
  const bool sw = false;
#endif
  for (int y = (y0 > by ? y0 : by); y < y0 + rows && y < by + HB; y++) {
    uint16_t *p = buf + (y - y0) * SCR_W + bx;
    const float fy = y - by + 0.5f, cy = fy < 11 ? 11 - fy : fy > HB - 11 ? fy - (HB - 11) : 0;
    for (int x = 0; x < HB; x++) {
      const float fx = x + 0.5f, cx = fx < 11 ? 11 - fx : fx > HB - 11 ? fx - (HB - 11) : 0;
      const float e = 11 - sqrtf(cx * cx + cy * cy);       // inside the rounded square (pixels from its edge)
      if (e <= 0) continue;
      const int a = e >= 1 ? 255 : (int)(e * 255);
      int l = e < 3 ? (int)(150 * fminf(1, e) * fminf(1, 3 - e)) : 0;   // the gold edge
      if (fx > 8 && fx < 36 && fy > 8 && fy < 36) {        // the house
        float d = 99;
        for (int k = 0; k < 8; k++) d = fminf(d, hbSeg(fx, fy, HB_SEGS[k][0], HB_SEGS[k][1], HB_SEGS[k][2], HB_SEGS[k][3]));
        if (d < 1.6f) { int ic = d < 0.6f ? 255 : (int)((1.6f - d) * 255); if (ic > l) l = ic; }
      }
      uint16_t v = p[x];
      if (sw) v = (v >> 8) | (v << 8);
      int r = (v >> 11) << 3, g = ((v >> 5) & 63) << 2, b = (v & 31) << 3;
      int k = 256 - (a * 150 >> 8);                  // darker behind the button
      r = r * k >> 8; g = g * k >> 8; b = b * k >> 8;
      r += (0xFF - r) * l >> 8; g += (0xD9 - g) * l >> 8; b += (0x9A - b) * l >> 8;
      v = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
      if (sw) v = (v >> 8) | (v << 8);
      p[x] = v;
    }
  }
}

// ---- sending the page to the screen ----
void uiSend(int rows) {
  swapBytes565(uiBuf, SCR_W * rows);
#if USE_DMA
  if (lcdDma) {
    spi_transaction_t t, *r;
    memset(&t, 0, sizeof(t));
    t.length = SCR_W * rows * 16; t.tx_buffer = uiBuf; t.user = (void *)2;
    if (spi_device_queue_trans(lcdDev, &t, pdMS_TO_TICKS(1000)) == ESP_OK) spi_device_get_trans_result(lcdDev, &r, pdMS_TO_TICKS(1000));
    return;
  }
#endif
  sendStrip(uiBuf, rows);
}
void uiPaintSetBand();
void uiPaintRows(int ya, int yb) {         // redraw rows ya to yb (the whole page, or just what changed)
  const int start = ya < 0 ? 0 : (ya / uiMaxRows) * uiMaxRows;
#if USE_DMA
  if (lcdDma) lcdWindowFrom(start, 1000); else
#endif
  { tft.startWrite(); tft.setAddrWindow(0, start, SCR_W, SCR_H - start); }
  for (uiY0 = start; uiY0 < SCR_H && uiY0 < yb; uiY0 += uiMaxRows) {
    uiRows = SCR_H - uiY0 < uiMaxRows ? SCR_H - uiY0 : uiMaxRows;
    if (uiPage == 1) uiPaintSetBand(); else uiPaintHomeBand();
#if HOME_DUMP
    if (dumpReq) for (int r = 0; r < uiRows; r++) {
      Serial.print(F("ROW ")); Serial.print(uiY0 + r); Serial.print(' ');
      for (int x = 0; x < SCR_W; x++) { uint16_t v = uiBuf[r * SCR_W + x]; const char *hx = "0123456789abcdef"; char o[5] = { hx[v >> 12], hx[(v >> 8) & 15], hx[(v >> 4) & 15], hx[v & 15], 0 }; Serial.print(o); }
      Serial.println();
    }
#endif
    uiSend(uiRows);
  }
#if USE_DMA
  if (!lcdDma)
#endif
  tft.endWrite();
#if HOME_DUMP
  if (dumpReq) { dumpReq = false; Serial.println(F("DUMP END")); }
#endif
}
void uiPaint() { uiPaintRows(0, SCR_H); }

// ---- opening and closing the page ----
void uiOpen() {
  uiOwnBuf = false;
  if (picBuf2) {                           // core 1's fade strip is free while the page shows
    uiBuf = picBuf2;
    uiMaxRows = STRIP * SCR_WMAX / SCR_W;
    if (uiMaxRows > 24) uiMaxRows = 24;
  } else {
    for (uiMaxRows = 8; uiMaxRows >= 2 && !uiBuf; uiMaxRows /= 2) {
#if USE_DMA
      uiBuf = (uint16_t *)heap_caps_malloc(SCR_W * uiMaxRows * 2, MALLOC_CAP_DMA);
#else
      uiBuf = (uint16_t *)malloc(SCR_W * uiMaxRows * 2);
#endif
      if (uiBuf) break;
    }
    uiOwnBuf = true;
    if (!uiBuf && picBuf) {                // memory is tight (the sky's clouds): borrow the fade strip once the other core has paused
      delay(200);
      uiBuf = picBuf; uiOwnBuf = false;
      uiMaxRows = STRIP * SCR_WMAX / SCR_W;
      if (uiMaxRows > 24) uiMaxRows = 24;
    }
  }
  if (!uiBuf) { Serial.println(F("[portal] no memory for the home page")); uiMode = 0; return; }
  ug.setTextWrap(false);
  uiLayout();
  uiSelWood = CROSS_RIPPLE <= 10 ? CROSS_RIPPLE : 0;
  uiSelBack = 0;
  for (int i = 0; i < 9; i++) if (UI_BACKS[i] == CROSS_FILL) uiSelBack = i;
  uiCore = COLOR_CORE; uiRim = COLOR_RIM;
  for (int k = 0; k < 4; k++) uiSpace[k] = SPACE_COLS[k];
  uiSelCol = uiColMatch();
  uiBright = BRIGHTNESS; uiRadius = (int)RADIUS; uiBeam = BEAM; uiSpeed = SPEED; uiFdLen = FD_LEN;
  uiSaved = false; uiPage = 0; uiDrag = -1;
  uiHeld = true;                           // the touch that opened this has to lift first
  uiDirty = true;
  uiLastTouch = millis();
}
void uiClose(bool use) {
  if (uiOwnBuf) free(uiBuf);               // give the page's memory back first
  uiBuf = NULL;
  if (use) {                               // the choices become the board's settings (and are saved)
    Saved s;
    fillSaved(s);
    s.crossRipple = uiSelWood;
    s.crossFill = UI_BACKS[uiSelBack];
    s.core = uiCore; s.rim = uiRim;
    for (int k = 0; k < 4; k++) s.spaceCols[k] = uiSpace[k];
    s.fadeOn = 0;                          // the colours picked here stay put
    s.bright = uiBright; s.radius = uiRadius; s.beam = uiBeam; s.speed = uiSpeed; s.fdLen = uiFdLen;   // and the settings page's
    const uint8_t f = s.crossFill;
    if ((f >= 8 && f <= 10) || f == 18) cloudMemory();   // a sky: make room for its clouds now, while the other core is paused
    pendingSettings = s;
    havePending = true;
  }
  uiMode = 0;
  tapIgnore = true;                        // the touch that closed it isn't a tap on the cross
  Serial.println(use ? F("[portal] home page: new choices saved") : F("[portal] home page closed"));
}
void uiSetTouch(int x, int y);
void uiTouch(int x, int y) {
  if (uiPage == 1) { uiSetTouch(x, y); return; }
  for (int i = 0; i < 11; i++) if (uiIn(uiWood[i], x, y)) { uiSelWood = i; uiDirty = true; return; }
  for (int i = 0; i < 9; i++) if (uiIn(uiBack[i], x, y)) { uiSelBack = i; uiSelCol = uiColMatch(); uiDirty = true; return; }
  int kind = uiColKind();
  if (kind) for (int i = 0; i < 6; i++) if (uiIn(uiCol[i], x, y)) {
    uiSelCol = i;
    if (kind == 1) { uiCore = UI_GLOW[i][0]; uiRim = UI_GLOW[i][1]; } else for (int k = 0; k < 4; k++) uiSpace[k] = UI_SPACE[i][k];
    uiDirty = true; return;
  }
  if (uiIn(uiSetBtn, x, y)) {
    stBright = uiBright; stRadius = uiRadius; stBeam = uiBeam; stSpeed = uiSpeed; stFdLen = uiFdLen;
    stCore = uiCore; stRim = uiRim; for (int k = 0; k < 4; k++) stSpace[k] = uiSpace[k]; stSelCol = uiSelCol;
    uiPage = 1; uiDirty = true; return;
  }
  if (uiIn(uiShow, x, y)) uiClose(true);
}
void uiPaintRows(int ya, int yb);
void uiSlideTo(int k, int x) {             // a slider moved: redraw just that slider
  const UiRect &r = uiSl[k];
  uiSlSet(k, (x - r.x) / (float)r.w);
  uiPaintRows(r.y - 4, r.y + r.h + 4);
}
void uiSetTouch(int x, int y) {            // the settings page
  if (uiIn(uiBackBtn, x, y)) { uiPage = 0; uiDirty = true; return; }   // back: forget the changes
  if (uiIn(uiSave, x, y)) {                 // SAVE: keep them, back to the home page
    uiBright = stBright; uiRadius = stRadius; uiBeam = stBeam; uiSpeed = stSpeed; uiFdLen = stFdLen;
    uiCore = stCore; uiRim = stRim; for (int k = 0; k < 4; k++) uiSpace[k] = stSpace[k]; uiSelCol = stSelCol;
    uiSaved = true; uiPage = 0; uiDirty = true; return;
  }
  const int kind = uiColKind();
  if (kind) for (int i = 0; i < 6; i++) if (uiIn(uiSetCol[i], x, y)) {   // a colour: the preview shows it straight away
    stSelCol = i;
    if (kind == 1) { stCore = UI_GLOW[i][0]; stRim = UI_GLOW[i][1]; } else for (int k = 0; k < 4; k++) stSpace[k] = UI_SPACE[i][k];
    const int a = uiPrev.y < uiSetCol[0].y ? uiPrev.y : uiSetCol[0].y, b = uiPrev.y + uiPrev.h > uiSetCol[0].y + uiSetCol[0].h ? uiPrev.y + uiPrev.h : uiSetCol[0].y + uiSetCol[0].h;
    uiPaintRows(a - 6, b + 6);
    return;
  }
  for (int k = 0; k < 4; k++) {
    const UiRect &r = uiSl[k];
    if (y >= r.y - 8 && y < r.y + r.h + 10 && x >= r.x - 14 && x < r.x + r.w + 14) { uiDrag = k; uiSlideTo(k, x); return; }
  }
}
void uiDragEnd() {                         // let go of a slider: the preview catches up
  if (uiDrag < 0) return;
  const int k = uiDrag;
  uiDrag = -1;
  uiPaintRows(uiPrev.y - 4, uiPrev.y + uiPrev.h + 4);
  uiPaintRows(uiSl[k].y - 4, uiSl[k].y + uiSl[k].h + 4);
}
void uiLoop() {                            // runs instead of the drawing while the page shows
  static uint32_t upSince = 0;
  if (!uiBuf) { uiOpen(); if (!uiBuf) return; }
  if (havePending && uiMode == 1) { uiClose(false); return; }   // new settings from the Studio: show them
  if (uiDirty) { uiDirty = false; uiPaint(); }
  if (simTap) {                            // UITAP x y over USB (for testing)
    simTap = false; uiLastTouch = millis();
    if (uiMode == 1) { uiTouch(simX, simY); uiDragEnd(); }   // (a tap: pressed and let go)
    return;
  }
  if (digitalRead(TAP_PIN) == LOW) {
    upSince = 0;
    if (!uiHeld) {
      uiHeld = true;
      uiLastTouch = millis();
      delay(25);                           // let the touch settle
      int x, y;
      if (touchXY(x, y)) uiTouch(x, y);
    } else if (uiDrag >= 0) {              // dragging a slider: follow the finger
      static uint32_t lastDrag = 0;
      if (millis() - lastDrag > 30) {
        lastDrag = millis(); uiLastTouch = lastDrag;
        int x, y;
        if (touchXY(x, y)) uiSlideTo(uiDrag, x);
      }
    }
  } else {
    if (!upSince) upSince = millis() | 1;
    if (uiHeld && millis() - upSince > 80) { uiHeld = false; uiDragEnd(); }
  }
  if (uiMode && millis() - uiLastTouch > 90000UL) uiClose(uiSaved);   // left alone: back to the cross (saved settings are kept)
  delay(4);
}
// between frames: was the home button pressed?
void homeCheck() {
  if (!homeActive()) {
    if (pressPending) { pressPending = false; if (!TAP_OFF) tapCount++; }
    pressHave = false;
    return;
  }
  if (!pressPending) return;
  pressPending = false;
  const bool had = pressHave;
  pressHave = false;
  int x = pressX, y = pressY;
  bool ok = had ? pressOk : touchXY(x, y);
  if (ok && x >= SCR_W - 74 && y >= SCR_H - 74) { uiMode = 1; return; }
  if (!TAP_OFF) tapCount++;
}
#endif


void loop() {
  readSerial();
#if defined(ESP32)
  if (rebootAt && (int32_t)(millis() - rebootAt) >= 0) ESP.restart();   // Restart board button in the Studio
#endif
#if HAS_BLE
  readBluetooth();
#endif
  if (pausedForUpload()) return;         // the screen holds still while a picture arrives
#if HOME_PAGE
  if (uiMode) { uiLoop(); return; }      // the home page is showing
#endif
#if DUAL_CORE
  static uint8_t b = 0;
  uint32_t frameT0 = micros();
  int pending = -1;
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    xSemaphoreTake(goSem[b], portMAX_DELAY);
    int rows = stripRows[b], help = stripHelp[b];
    if (y0 == 0) {                       // a new frame: its size is settled now
#if TURNS
      if (turnPending) {                 // the screen was turned: tell the panel
#if USE_DMA
        if (lcdDma) { uint8_t c = 0x36, m = MADCTL_ROT[rotNow()]; lcdSend(&c, 1, false, 1000); lcdSend(&m, 1, true, 1000); } else
#endif
        tft.setRotation(rotNow());
        turnPending = false;
      }
#endif
#if USE_DMA
      if (lcdDma) lcdWindow(1000); else
#endif
      { tft.startWrite(); tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX); }
    }
    if (help) {                          // core 1's share of the drawing: the bottom rows
      uint16_t *dst = stripBuf[b] + (rows - help) * SCR_W;
      composeStrip(stripY0[b] + rows - help, help, dst);
      swapBytes565(dst, SCR_W * help);
    }
    if (y0 + STRIP >= SCR_H) xSemaphoreGive(helperIdle);   // core 0 can start the next frame
    uint32_t t0 = micros();
    xSemaphoreTake(readySem[b], portMAX_DELAY);
    wait1Us += micros() - t0;
#if HOME_PAGE
    if (homeActive()) homeIcon(stripBuf[b], stripY0[b], rows);   // the home button in the corner
#endif
#if USE_DMA
    if (lcdDma) {                        // send this strip in the background, then free the one before
      lcdQueue(b, rows, 1000);
      if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
      pending = b;
    } else
#endif
    {
      t0 = micros();
      sendStrip(stripBuf[b], rows);
      sendUs += micros() - t0;
      xSemaphoreGive(freeSem[b]);
    }
#if HOME_PAGE
    if (pressPending && !pressHave) {    // a press on the Wooden cross: read where it is now, before the finger lifts
      const int ny = y0 + rows;          // (the screen pauses between two strips, then carries on from the next row)
#if USE_DMA
      if (lcdDma) { if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); pending = -1; } } else
#endif
      tft.endWrite();
      pressOk = touchXY(pressX, pressY);
      pressHave = true;
#if USE_DMA
      if (lcdDma) { if (ny < SCR_H) lcdWindowFrom(ny, 1000); } else
#endif
      { tft.startWrite(); if (ny < SCR_H) tft.setAddrWindow(0, ny, SCR_W, SCR_H - ny); }
    }
#endif
    b ^= 1;
    readSerialQuick();                   // new settings get an answer even while a slow frame is drawn
    pollTap();
  }
#if USE_DMA
  if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
  if (!lcdDma)
#endif
  tft.endWrite();
#if HOME_PAGE
  homeCheck();                           // the screen is quiet now: was that press on the home button?
#endif
  countFrame();
  balanceCores(micros() - frameT0);
  return;
#else
  frameStart();
#if TURNS
  if (turnPending) { tft.setRotation(rotNow()); turnPending = false; }
#endif
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX);
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    int rows = min(STRIP, SCR_H - y0);
    uint32_t t0 = micros();
    composeStrip(y0, rows, stripBuf[0]);
    uint32_t t1 = micros();
    sendStrip(stripBuf[0], rows);
    drawUs += t1 - t0; sendUs += micros() - t1;
    readSerialQuick();
    pollTap();
  }
  frameEnd();
  tft.endWrite();
  countFrame();
#endif
}
`;
}

