      int rr = (c >> 11) + (s >> 11), gg = ((c >> 5) & 63) + ((s >> 5) & 63), bb = (c & 31) + (s & 31);
      c = (min(rr, 31) << 11) | (min(gg, 63) << 5) | min(bb, 31);
