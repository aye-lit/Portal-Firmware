    float R = nbBR[i] * (0.9f + 0.15f * sinf(spTw / 40.74f * 5.2f + nbBP[i]));
    int E = (int)ceilf(R * 4), cx = nbBX[i], cy = nbBY[i];
    if (cy + E < y0 || cy - E >= y0 + rows) continue;
    const float tr = nbBW[i] ? 255 : 200, tg = nbBW[i] ? 235 : 220, tb = nbBW[i] ? 200 : 255, b = BRIGHTNESS / 100.0f;
    for (int y = max(y0, cy - E); y <= min(y0 + rows - 1, cy + E); y++) for (int x = max(0, cx - E); x <= min(SCR_W - 1, cx + E); x++) {
      float dx = x - cx, dy = y - cy, r2 = dx * dx + dy * dy, spike = (dx == 0 || dy == 0) ? expf(-sqrtf(r2) / (R * 1.6f)) * 0.6f : 0, a = min(1.0f, expf(-r2 / (R * R * 0.35f)) + spike) * b;
      if (a < 0.02f) continue;
