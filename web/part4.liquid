// ---------- drawing (1 = lit pixel, 0 = dark) ----------
void drawArms() {
  for (uint8_t i = 0; i < ARMS; i++) {
    float base = t + i * (TWO_PI / ARMS);
    int lx = 0, ly = 0;
    bool first = true;
    for (float r = 3.0; r <= RADIUS; r *= 1.12) {
      float a = base + TWIST * log(r / RADIUS);   // logarithmic spiral
      int x = px(a, r), y = py(a, r);
      if (!first) gfx.drawLine(lx, ly, x, y, 1);
      if (r > RADIUS * 0.55) gfx.drawPixel(px(a + 0.12, r), py(a + 0.12, r), 1);
      lx = x; ly = y; first = false;
    }
  }
}

void drawRim() {
  const uint8_t N = 72;
  int lx = 0, ly = 0;
  for (uint8_t k = 0; k <= N; k++) {
    float a = k * TWO_PI / N;
    float wob = sin(a * 5 + t * 2) * 1.2 + sin(a * 3 - t * 3) * 0.8;
    float r = RADIUS + 1.5 + wob;
    int x = px(a, r), y = py(a, r);
    if (k > 0) gfx.drawLine(lx, ly, x, y, 1);   // wavy edge
    lx = x; ly = y;
    if (k % 3 == 0) {                            // rotating dotted halo
      float ha = a + t * 0.5;
      float hr = RADIUS + 4.5 + wob * 1.5;
      gfx.drawPixel(px(ha, hr), py(ha, hr), 1);
    }
  }
}

void updateSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= 0.95;                                  // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + 6));   // faster near the centre
    if (s.r < 3) respawn(s);
  }
}

void drawSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) gfx.drawPixel(px(sparks[i].a, sparks[i].r), py(sparks[i].a, sparks[i].r), 1);
}

void drawCore() {
  gfx.fillCircle((int)floor(cx), (int)floor(cy), 3, 0);         // dark throat
  int pulse = 1 + (int)((sin(t * 4) + 1.0) * 1.0);              // 1..3 px
  gfx.drawCircle((int)floor(cx), (int)floor(cy), pulse, 1);
}

void drawAll() { drawArms(); drawRim(); drawSparks(); drawCore(); }

void setup() {
  Serial.begin(115200);
  loadSettings();
  beginBus();
#if HAS_BLE
  beginBluetooth();
#endif
${beginCode}
  randomSeed(micros());
  resetSparks();
}

void loop() {
  readSerial();
#if HAS_BLE
  readBluetooth();
#endif

  if (DRIFT) {
    baseCx = SCREEN_W / 2.0 + sin(t * 0.01) * 4.0;
    baseCy = SCREEN_H / 2.0 + cos(t * 0.02) * 2.0;
  } else {
    baseCx = SCREEN_W / 2.0;
    baseCy = SCREEN_H / 2.0;
  }

${frame}

  t += SPEED;
  if (t > TWO_PI * 100) t -= TWO_PI * 100;   // wrap seamlessly so it can run forever
}
`;
