}
async function sendPictures() {
  const st = $("pic-status"), bar = progressBar("pic");
  const sayP = (m, c = "") => { st.className = "status " + c; st.textContent = m; };
  if (!port && !bleRx) { sayP("Connect over USB first (button above), then send the pictures.", "warn"); return; }
  if (busy) { sayP("Wait a moment, the board is busy. Then try again."); return; }
  busy = true; $("send-pics").disabled = true; sayP("");
  try {
    bar.step(1, 1, "Checking the board"); bar.set(null);
    const info = (await boardRequest("INFO", /PICS[^\n]*\n/, 4000)).match(/PICS ([^\r\n]*)/);
    if (!info) throw new Error("the board didn't answer. Install the latest firmware (Quick install) or upload the new sketch, then try again");
    const [slots, w, h, ...ids] = info[1].trim().split(/\s+/);
    boardPics = { slots: +slots, w: +w, h: +h, ids };
    if (!boardPics.slots) throw new Error("the program on the board can't store pictures. Install the latest firmware (Quick install) or upload the new sketch with an ESP32 board");
    if (boardPics.w !== M.w || boardPics.h !== M.h) throw new Error(`the board's screen is ${boardPics.w} × ${boardPics.h}, but the Studio is set to ${M.w} × ${M.h}. Pick the matching display${M.rect ? " and orientation" : ""} above`);
    const count = Math.min(S.pics.length, boardPics.slots);
    let sent = 0;
    for (let i = 0; i < count; i++) {
      bar.step(i + 1, count, `Preparing picture ${i + 1}`); bar.set(0);
      const jpg = await picJpeg(S.pics[i]), id = picHash(jpg);
      if (boardPics.ids[i] === id) { bar.set(1); continue; }   // already on the board
      bar.step(i + 1, count, `Sending picture ${i + 1}`);
      const r = await boardRequest(`IMG ${i} ${jpg.length} ${id}`, /READY|ERR/, 8000);
      if (!/READY/.test(r)) throw new Error("the board couldn't make room for the picture");
      const text = b64(jpg);
      for (let k = 0; k < text.length; k += 240) {
        const a = await boardRequest("D " + text.slice(k, k + 240), /(^|\n)(K|ERR[^\n]*)\r?\n/, 4000);
        if (!/(^|\n)K\r?\n/.test(a)) throw new Error("the picture data didn't arrive. Try again");
        bar.set(Math.min(0.95, (k + 240) / text.length));
      }
      bar.step(i + 1, count, `Saving picture ${i + 1} on the board`); bar.set(null);
      const e = await boardRequest("END", /(^|\n)(OK|ERR[^\n]*)\r?\n/, 25000);
      if (!/(^|\n)OK\r?\n/.test(e)) throw new Error(/ERR size/.test(e) ? "the picture size didn't match the screen" : "the board couldn't unpack the picture");
      boardPics.ids[i] = id; sent++;
    }
    bar.done(sent ? `${sent} picture${sent > 1 ? "s" : ""} sent` : "The board already has these pictures");
    busy = false;
    await new Promise(r => setTimeout(r, 50));
    send();                                         // and the play order
    sayP(S.pics.length > count ? `Sent the first ${count} pictures. This board has room for ${count}.` : "Pictures saved on the board.", S.pics.length > count ? "warn" : "ok");
  } catch (e) {
    bar.fail();
    sayP("Couldn't send the pictures: " + ((e && e.message) || "the connection dropped") + ".", "warn");
  } finally {
    busy = false; $("send-pics").disabled = false;
    renderPics();
    if (pending) { pending = false; send(); }
  }
}
$("send-pics").addEventListener("click", sendPictures);

