// ---- touch: the XPT2046 shares the screen's SPI pins ----
uint16_t xptCmd(uint8_t c) {
#if USE_DMA
  if (lcdDma) {
    if (!touchDevOk) return 0;
    spi_transaction_t t;
    memset(&t, 0, sizeof(t));
    t.length = 24; t.rxlength = 24; t.flags = SPI_TRANS_USE_TXDATA | SPI_TRANS_USE_RXDATA;
    t.tx_data[0] = c;
    if (spi_device_polling_transmit(touchDev, &t) != ESP_OK) return 0;
    return ((t.rx_data[1] << 8) | t.rx_data[2]) >> 3;
  }
#endif
  SPI.transfer(c);
  uint16_t h = SPI.transfer(0), l = SPI.transfer(0);
  return ((h << 8) | l) >> 3;
}
bool touchRaw(int &rx, int &ry) {        // only between frames: the screen isn't being sent anything
  if (digitalRead(TAP_PIN) != LOW) return false;
#if USE_DMA
  const bool dma = lcdDma;
#else
  const bool dma = false;
#endif
  digitalWrite(PIN_CS, HIGH);            // the screen stops listening
  if (!dma) SPI.beginTransaction(SPISettings(2000000, MSBFIRST, SPI_MODE0));
  digitalWrite(TAP_CS, LOW);
  uint16_t xs[7], ys[7];
  xptCmd(0xD0);                          // (the first reading settles)
  for (int i = 0; i < 7; i++) { xs[i] = xptCmd(0xD0); ys[i] = xptCmd(0x90); }
  xptCmd(0x90);
  digitalWrite(TAP_CS, HIGH);
  if (!dma) SPI.endTransaction();
  if (dma) digitalWrite(PIN_CS, LOW);    // the screen listens again
  for (int i = 1; i < 7; i++) for (int j = i; j > 0 && xs[j] < xs[j - 1]; j--) { uint16_t t = xs[j]; xs[j] = xs[j - 1]; xs[j - 1] = t; }
  for (int i = 1; i < 7; i++) for (int j = i; j > 0 && ys[j] < ys[j - 1]; j--) { uint16_t t = ys[j]; ys[j] = ys[j - 1]; ys[j - 1] = t; }
  rx = xs[3]; ry = ys[3];
  if (xs[5] - xs[1] > 150 || ys[5] - ys[1] > 150) return false;   // still moving, or a light touch
  return digitalRead(TAP_PIN) == LOW && rx > 60 && rx < 4040 && ry > 60 && ry < 4040;
}
// raw touch -> the upright (portrait) screen, then to the way the screen is turned now
void panelToScreen(float px, float py, int &x, int &y) {
  int P = (int)px, Q = (int)py;
  switch (rotNow()) {
    case 0: x = P; y = Q; break;
    case 1: x = Q; y = SCR_SHORT - 1 - P; break;
    case 2: x = SCR_SHORT - 1 - P; y = SCR_WMAX - 1 - Q; break;
    default: x = SCR_WMAX - 1 - Q; y = P; break;
  }
}
void screenToPanel(int x, int y, float &px, float &py) {
  switch (rotNow()) {
    case 0: px = x; py = y; break;
    case 1: px = SCR_SHORT - 1 - y; py = x; break;
    case 2: px = SCR_SHORT - 1 - x; py = SCR_WMAX - 1 - y; break;
    default: px = y; py = SCR_WMAX - 1 - x; break;
  }
}
bool touchXY(int &x, int &y) {
  int rx, ry;
  if (!touchRaw(rx, ry)) return false;
  panelToScreen(tcal[0] * rx + tcal[1] * ry + tcal[2], tcal[3] * rx + tcal[4] * ry + tcal[5], x, y);
  return true;
}
void tcalLoad() {
  Preferences pr;
  if (pr.begin("touch", true)) {
    float m[6];
    if (pr.getBytes("cal", m, sizeof(m)) == sizeof(m) && pr.getUInt("ok", 0) == 0x5A17u) { for (int i = 0; i < 6; i++) tcal[i] = m[i]; tcalOk = true; }
    pr.end();
  }
}
void tcalSave() {
  Preferences pr;
  if (pr.begin("touch", false)) { pr.putBytes("cal", tcal, sizeof(float) * 6); pr.putUInt("ok", 0x5A17u); pr.end(); }
  tcalOk = true;
}
// ---- the home button, drawn over the picture ----
#define HB 44
float hbSeg(float x, float y, float ax, float ay, float bx, float by) {
  float vx = bx - ax, vy = by - ay, t = ((x - ax) * vx + (y - ay) * vy) / (vx * vx + vy * vy);
  t = t < 0 ? 0 : t > 1 ? 1 : t;
  float dx = x - ax - vx * t, dy = y - ay - vy * t;
  return sqrtf(dx * dx + dy * dy);
}
const float HB_SEGS[8][4] = { { 10, 22, 22, 10.5f }, { 22, 10.5f, 34, 22 }, { 14, 19.5f, 14, 33 }, { 30, 19.5f, 30, 33 }, { 14, 33, 30, 33 }, { 19.5f, 33, 19.5f, 26 }, { 19.5f, 26, 24.5f, 26 }, { 24.5f, 26, 24.5f, 33 } };
void homeIcon(uint16_t *buf, int y0, int rows) {   // a strip that's ready to send: draw the button where it overlaps (worked out each time: no memory kept)
  const int bx = SCR_W - HB - 8, by = SCR_H - HB - 8;
  if (y0 + rows <= by || y0 >= by + HB) return;
#if USE_DMA
  const bool sw = lcdDma;
#else
  const bool sw = false;
#endif
  for (int y = (y0 > by ? y0 : by); y < y0 + rows && y < by + HB; y++) {
    uint16_t *p = buf + (y - y0) * SCR_W + bx;
    const float fy = y - by + 0.5f, cy = fy < 11 ? 11 - fy : fy > HB - 11 ? fy - (HB - 11) : 0;
    for (int x = 0; x < HB; x++) {
      const float fx = x + 0.5f, cx = fx < 11 ? 11 - fx : fx > HB - 11 ? fx - (HB - 11) : 0;
      const float e = 11 - sqrtf(cx * cx + cy * cy);       // inside the rounded square (pixels from its edge)
      if (e <= 0) continue;
      const int a = e >= 1 ? 255 : (int)(e * 255);
      int l = e < 3 ? (int)(150 * fminf(1, e) * fminf(1, 3 - e)) : 0;   // the gold edge
      if (fx > 8 && fx < 36 && fy > 8 && fy < 36) {        // the house
        float d = 99;
        for (int k = 0; k < 8; k++) d = fminf(d, hbSeg(fx, fy, HB_SEGS[k][0], HB_SEGS[k][1], HB_SEGS[k][2], HB_SEGS[k][3]));
        if (d < 1.6f) { int ic = d < 0.6f ? 255 : (int)((1.6f - d) * 255); if (ic > l) l = ic; }
      }
      uint16_t v = p[x];
      if (sw) v = (v >> 8) | (v << 8);
      int r = (v >> 11) << 3, g = ((v >> 5) & 63) << 2, b = (v & 31) << 3;
      int k = 256 - (a * 150 >> 8);                  // darker behind the button
      r = r * k >> 8; g = g * k >> 8; b = b * k >> 8;
      r += (0xFF - r) * l >> 8; g += (0xD9 - g) * l >> 8; b += (0x9A - b) * l >> 8;
      v = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
      if (sw) v = (v >> 8) | (v << 8);
      p[x] = v;
    }
  }
}

// ---- sending the page to the screen ----
void uiSend(int rows, int w = SCR_W) {
  swapBytes565(uiBuf, w * rows);
#if USE_DMA
  if (lcdDma) {
    spi_transaction_t t, *r;
    memset(&t, 0, sizeof(t));
    t.length = w * rows * 16; t.tx_buffer = uiBuf; t.user = (void *)2;
    if (spi_device_queue_trans(lcdDev, &t, pdMS_TO_TICKS(1000)) == ESP_OK) spi_device_get_trans_result(lcdDev, &r, pdMS_TO_TICKS(1000));
    return;
  }
#endif
  sendStrip(uiBuf, rows);
}
void uiPaintSetBand();
void uiPaintRows(int ya, int yb, int xa, int xb) {   // redraw rows ya to yb (the whole page, or just what changed; columns xa to xb)
  const int start = ya < 0 ? 0 : (ya / uiMaxRows) * uiMaxRows;
  xa = xa < 0 ? 0 : xa; xb = xb > SCR_W ? SCR_W : xb;
#if USE_DMA
  if (!lcdDma || xb - xa < 8) { xa = 0; xb = SCR_W; }
#else
  xa = 0; xb = SCR_W;
#endif
  const int w = xb - xa;
  uiColA = xa; uiColB = xb;
#if USE_DMA
  if (lcdDma) lcdWindowFrom(start, 1000, xa, xb - 1); else
#endif
  { tft.startWrite(); tft.setAddrWindow(0, start, SCR_W, SCR_H - start); }
  for (uiY0 = start; uiY0 < SCR_H && uiY0 < yb; uiY0 += uiMaxRows) {
    uiRows = SCR_H - uiY0 < uiMaxRows ? SCR_H - uiY0 : uiMaxRows;
    if (uiPage == 2) uiPaintWheelBand(); else if (uiPage == 1) uiPaintSetBand(); else if (uiKind) uiPaintPSBand(); else uiPaintHomeBand();
#if HOME_DUMP
    if (dumpReq) for (int r = 0; r < uiRows; r++) {
      Serial.print(F("ROW ")); Serial.print(uiY0 + r); Serial.print(' ');
      for (int x = 0; x < SCR_W; x++) { uint16_t v = uiBuf[r * SCR_W + x]; const char *hx = "0123456789abcdef"; char o[5] = { hx[v >> 12], hx[(v >> 8) & 15], hx[(v >> 4) & 15], hx[v & 15], 0 }; Serial.print(o); }
      Serial.println();
    }
#endif
    if (w < SCR_W) for (int r = 0; r < uiRows; r++) memmove(uiBuf + r * w, uiBuf + r * SCR_W + xa, w * 2);   // just these columns
    uiSend(uiRows, w);
  }
  uiColA = 0; uiColB = SCR_W;
#if USE_DMA
  if (!lcdDma)
#endif
  tft.endWrite();
#if HOME_DUMP
  if (dumpReq) { dumpReq = false; Serial.println(F("DUMP END")); }
#endif
}
void uiPaint() { uiPaintRows(0, SCR_H); }

// ---- opening and closing the page ----
void uiOpen() {
  uiOwnBuf = false;
  if (picBuf2) {                           // core 1's fade strip is free while the page shows
    uiBuf = picBuf2;
    uiMaxRows = STRIP * SCR_WMAX / SCR_W;
    if (uiMaxRows > 24) uiMaxRows = 24;
  } else {
    for (uiMaxRows = 8; uiMaxRows >= 2 && !uiBuf; uiMaxRows /= 2) {
#if USE_DMA
      uiBuf = (uint16_t *)heap_caps_malloc(SCR_W * uiMaxRows * 2, MALLOC_CAP_DMA);
#else
      uiBuf = (uint16_t *)malloc(SCR_W * uiMaxRows * 2);
#endif
      if (uiBuf) break;
    }
    uiOwnBuf = true;
    if (!uiBuf && picBuf) {                // memory is tight (the sky's clouds): borrow the fade strip once the other core has paused
      delay(200);
      uiBuf = picBuf; uiOwnBuf = false;
      uiMaxRows = STRIP * SCR_WMAX / SCR_W;
      if (uiMaxRows > 24) uiMaxRows = 24;
    }
  }
  if (!uiBuf) { Serial.println(F("[portal] no memory for the home page")); uiMode = 0; return; }
  ug.setTextWrap(false);
  uiKind = homeKind() < 0 ? 0 : homeKind();
  uiLayout();
  if (uiKind) uiLayoutPS();
  uiSelStyle = 0;
  if (uiKind == 3) uiSelStyle = STYLE == 21 ? 1 : 0;
  else if (uiKind) for (int i = 0; i < 4; i++) if (UI_PS[uiKind - 1][i] == STYLE) uiSelStyle = i;
  uiCf[0] = CF_BG; uiCf[1] = CF_GAP; uiCf[2] = CF_TGT; uiCf[3] = CF_PAL; uiCf[4] = CF_TWIST; uiCf[5] = CF_WOB; uiCf[6] = CF_FLOW;
  uiSparks = NUM_SPARKS; uiStars = STARS; uiArms = ARMS; uiTwist = TWIST;
  uiSelWood = CROSS_RIPPLE <= 10 ? CROSS_RIPPLE : 0;
  uiSelBack = 0;
  for (int i = 0; i < 9; i++) if (UI_BACKS[i] == CROSS_FILL) uiSelBack = i;
  uiCore = COLOR_CORE; uiRim = COLOR_RIM;
  for (int k = 0; k < 4; k++) uiSpace[k] = SPACE_COLS[k];
  uiSelCol = uiColMatch();
  uiBright = BRIGHTNESS; uiRadius = (int)RADIUS; uiBeam = BEAM; uiSpeed = SPEED; uiFdLen = FD_LEN;
  uiSaved = false; uiPage = 0; uiDrag = -1;
  uiRotLayout();
  if (uiReopen) { uiReopen = false; uiToSettings(); }   // back from a quarter turn: straight to the settings
  uiHeld = true;                           // the touch that opened this has to lift first
  uiDirty = true;
  uiLastTouch = millis();
}
void uiClose(bool use) {
  if (uiOwnBuf) free(uiBuf);               // give the page's memory back first
  uiBuf = NULL;
  if (use) {                               // the choices become the board's settings (and are saved)
    Saved s;
    fillSaved(s);
    if (uiKind == 0) { s.crossRipple = uiSelWood; s.crossFill = UI_BACKS[uiSelBack]; }
    else if (uiKind == 3) {                // the cross fractals: the pattern, and their own settings
      s.style = 20 + uiSelStyle;
      for (int j = 0; j < 7; j++) pendCf[j] = (uint8_t)uiCf[j];
      pendCfOn = true;
    } else {                                 // a portal or space style
      s.style = UI_PS[uiKind - 1][uiSelStyle];
      s.sparks = uiSparks; s.stars = uiStars; s.arms = uiArms; s.twist = uiTwist;
    }
    s.core = uiCore; s.rim = uiRim;
    for (int k = 0; k < 4; k++) s.spaceCols[k] = uiSpace[k];
    s.fadeOn = 0;                          // the colours picked here stay put
    if (uiRotTo != 255) { s.portrait = uiRotTo; uiRotTo = 255; }   // Rotate: turned at the start of the next frame
    s.bright = uiBright; s.radius = uiRadius; s.beam = uiBeam; s.speed = uiSpeed; s.fdLen = uiFdLen;   // and the settings page's
    const uint8_t f = s.crossFill;
    if (uiKind == 0 && ((f >= 8 && f <= 10) || f == 18)) cloudMemory();   // a sky: make room for its clouds now, while the other core is paused
    pendingSettings = s;
    havePending = true;
  }
  uiMode = 0;
  tapIgnore = true;                        // the touch that closed it isn't a tap on the cross
  Serial.println(use ? F("[portal] home page: new choices saved") : F("[portal] home page closed"));
}
void uiSetTouch(int x, int y);
void uiToSettings() {                      // open the settings page with the choices as they are
  stBright = uiBright; stRadius = uiRadius; stBeam = uiBeam; stSpeed = uiSpeed; stFdLen = uiFdLen; stSparks = uiSparks; stStars = uiStars;
  stCore = uiCore; stRim = uiRim; for (int k = 0; k < 4; k++) stSpace[k] = uiSpace[k]; stSelCol = uiSelCol;
  for (int j = 0; j < 7; j++) stCf[j] = uiCf[j];
  uiPage = 1; uiDirty = true;
}
void uiTouch(int x, int y) {
  if (uiPage >= 1) { uiSetTouch(x, y); return; }
  if (uiKind == 3) {                       // the cross fractals: the pattern, then the colours
    for (int i = 0; i < 2; i++) if (uiIn(uiTile[i], x, y)) { if (i != uiSelStyle) { uiSelStyle = i; uiCf[3] = i ? 2 : 0; uiDirty = true; } return; }
    for (int i = 0; i < 5; i++) if (uiIn(uiCol[i], x, y)) { uiCf[3] = i; uiDirty = true; return; }
  } else if (uiKind) {                     // portal and space pages
    for (int i = 0; i < 4; i++) if (uiIn(uiTile[i], x, y)) {
      if (i != uiSelStyle) {               // another style: its own shape and colours, as in the Studio
        const int code = UI_PS[uiKind - 1][i];
        uiSelStyle = i;
        if (code == 0) { uiArms = 4; uiTwist = 2.4f; }
        if (code == 1) { uiArms = 2; uiTwist = 2.2f; uiCore = 0x0B6B1A; uiRim = 0x8DFF4F; }
        if (code == 6) { uiArms = 2; uiTwist = 1.8f; uiCore = 0x0B6B1A; uiRim = 0x8DFF4F; }
        if (code == 2) { uiCore = 0xA400FF; uiRim = 0xFF4FD8; }
        if (code == 3) { uiCore = 0x1B2A8A; uiRim = 0x9FE8FF; }
        if (code == 16) uiSparks = 14;
        uiSelCol = uiColMatch();
        uiDirty = true;
      }
      return;
    }
    const int kind = uiColKind();
    for (int i = 0; i < 6; i++) if (uiIn(uiCol[i], x, y)) {
      uiSelCol = i;
      if (kind == 1) { uiCore = UI_GLOW[i][0]; uiRim = UI_GLOW[i][1]; } else for (int k = 0; k < 4; k++) uiSpace[k] = UI_SPACE[i][k];
      uiDirty = true; return;
    }
  } else {                                 // the cross page
    for (int i = 0; i < 11; i++) if (uiIn(uiWood[i], x, y)) { uiSelWood = i; uiDirty = true; return; }
    for (int i = 0; i < 9; i++) if (uiIn(uiBack[i], x, y)) { uiSelBack = i; uiSelCol = uiColMatch(); uiDirty = true; return; }
    int kind = uiColKind();
    if (kind) for (int i = 0; i < 6; i++) if (uiIn(uiCol[i], x, y)) {
      uiSelCol = i;
      if (kind == 1) { uiCore = UI_GLOW[i][0]; uiRim = UI_GLOW[i][1]; } else for (int k = 0; k < 4; k++) uiSpace[k] = UI_SPACE[i][k];
      uiDirty = true; return;
    }
  }
  if (uiIn(uiSetBtn, x, y)) { uiToSettings(); return; }
  if (uiIn(uiShow, x, y)) uiClose(true);
}
void uiSlideTo(int k, int x) {             // a slider moved: redraw just that slider
  const UiRect &r = uiSl[k];
  uiSlSet(k, (x - r.x) / (float)r.w);
  uiPaintRows(r.y - 4, r.y + r.h + 4);
}
void uiSetTouch(int x, int y) {            // the settings page
  if (uiPage == 2) { uiWheelTouch(x, y); return; }
  if (uiIn(uiBackBtn, x, y)) { uiPage = 0; uiDirty = true; return; }   // back: forget the changes
  if (uiIn(uiRotBtn, x, y)) {               // Rotate: keep the settings, turn a quarter (as the Studio's Rotate 90), then come back here
    uiBright = stBright; uiRadius = stRadius; uiBeam = stBeam; uiSpeed = stSpeed; uiFdLen = stFdLen; uiSparks = stSparks; uiStars = stStars;
    uiCore = stCore; uiRim = stRim; for (int k = 0; k < 4; k++) uiSpace[k] = stSpace[k]; uiSelCol = stSelCol;
    for (int j = 0; j < 7; j++) uiCf[j] = stCf[j];
    const bool p = !PORTRAIT, f = PORTRAIT ? FLIP : !FLIP;
    uiRotTo = (p ? 1 : 0) | (f ? 2 : 0);
    uiClose(true);
    uiReopen = true;
    return;
  }
  if (uiIn(uiSave, x, y)) {                 // SAVE: keep them, back to the home page
    uiBright = stBright; uiRadius = stRadius; uiBeam = stBeam; uiSpeed = stSpeed; uiFdLen = stFdLen; uiSparks = stSparks; uiStars = stStars;
    uiCore = stCore; uiRim = stRim; for (int k = 0; k < 4; k++) uiSpace[k] = stSpace[k]; uiSelCol = stSelCol;
    for (int j = 0; j < 7; j++) uiCf[j] = stCf[j];
    uiSaved = true; uiPage = 0; uiDirty = true; return;
  }
  const int kind = uiColKind();
  if (kind == 3) {                          // the cross fractals' colours: the preview shows them straight away
    for (int i = 0; i < 5; i++) if (uiIn(uiSetCol[i], x, y)) {
      stCf[3] = i;
      const int a = uiPrev.y < uiSetCol[0].y ? uiPrev.y : uiSetCol[0].y, b = uiPrev.y + uiPrev.h > uiSetCol[0].y + uiSetCol[0].h ? uiPrev.y + uiPrev.h : uiSetCol[0].y + uiSetCol[0].h;
      uiPaintRows(a - 6, b + 6);
      return;
    }
  } else {
  if (kind && uiIn(uiSetCol[6], x, y)) { uiWheelOpen(); return; }   // the colour wheel
  if (kind) for (int i = 0; i < 6; i++) if (uiIn(uiSetCol[i], x, y)) {   // a colour: the preview shows it straight away
    stSelCol = i;
    if (kind == 1) { stCore = UI_GLOW[i][0]; stRim = UI_GLOW[i][1]; } else for (int k = 0; k < 4; k++) stSpace[k] = UI_SPACE[i][k];
    const int a = uiPrev.y < uiSetCol[0].y ? uiPrev.y : uiSetCol[0].y, b = uiPrev.y + uiPrev.h > uiSetCol[0].y + uiSetCol[0].h ? uiPrev.y + uiPrev.h : uiSetCol[0].y + uiSetCol[0].h;
    uiPaintRows(a - 6, b + 6);
    return;
  }
  }
  for (int k = 0; k < 4; k++) {
    const UiRect &r = uiSl[k];
    if (y >= r.y - 8 && y < r.y + r.h + 10 && x >= r.x - 14 && x < r.x + r.w + 14) { uiDrag = k; uiSlideTo(k, x); return; }
  }
}
void uiDragEnd() {                         // let go of a slider: the preview catches up
  if (uiDrag < 0) return;
  const int k = uiDrag;
  uiDrag = -1;
  if (k >= 10) { uiWheelDragEnd(k); return; }
  uiPaintRows(uiPrev.y - 4, uiPrev.y + uiPrev.h + 4);
  uiPaintRows(uiSl[k].y - 4, uiSl[k].y + uiSl[k].h + 4);
}
void uiLoop() {                            // runs instead of the drawing while the page shows
  static uint32_t upSince = 0;
  if (!uiBuf) { uiOpen(); if (!uiBuf) return; }
  if (havePending && uiMode == 1) { uiClose(false); return; }   // new settings from the Studio: show them
  if (uiDirty) { uiDirty = false; uiPaint(); }
  if (simTap) {                            // UITAP x y over USB (for testing)
    simTap = false; uiLastTouch = millis();
    if (uiMode == 1) { uiTouch(simX, simY); uiDragEnd(); }   // (a tap: pressed and let go)
    return;
  }
  if (digitalRead(TAP_PIN) == LOW) {
    upSince = 0;
    if (!uiHeld) {
      uiHeld = true;
      uiLastTouch = millis();
      delay(25);                           // let the touch settle
      int x, y;
      if (touchXY(x, y)) uiTouch(x, y);
    } else if (uiDrag >= 0) {              // dragging a slider: follow the finger
      static uint32_t lastDrag = 0;
      if (millis() - lastDrag > 30) {
        lastDrag = millis(); uiLastTouch = lastDrag;
        int x, y;
        if (touchXY(x, y)) { if (uiDrag == 10) uiWheelAt(x, y); else if (uiDrag == 11) uiWSlideTo(x); else uiSlideTo(uiDrag, x); }
      }
    }
  } else {
    if (!upSince) upSince = millis() | 1;
    if (uiHeld && millis() - upSince > 80) { uiHeld = false; uiDragEnd(); }
  }
  if (uiMode && millis() - uiLastTouch > 90000UL) uiClose(uiSaved);   // left alone: back to the cross (saved settings are kept)
  delay(4);
}
// between frames: was the home button pressed?
void homeCheck() {
  if (!homeActive()) {
    if (pressPending) { pressPending = false; if (!TAP_OFF) tapCount++; }
    pressHave = false;
    return;
  }
  if (!pressPending) return;
  pressPending = false;
  const bool had = pressHave;
  pressHave = false;
  int x = pressX, y = pressY;
  bool ok = had ? pressOk : touchXY(x, y);
  if (ok && x >= SCR_W - 74 && y >= SCR_H - 74) { uiMode = 1; return; }
  if (!TAP_OFF) tapCount++;
}
#endif


void loop() {
#if SHOW_ON
  showSerialTick(Serial.available() > 0);
#endif
  readSerial();
#if defined(ESP32)
  if (rebootAt && (int32_t)(millis() - rebootAt) >= 0) ESP.restart();   // Restart board button in the Studio
#endif
#if HAS_BLE
  readBluetooth();
#endif
  if (pausedForUpload()) return;         // the screen holds still while a picture arrives
#if HOME_PAGE
  if (uiReopen && !uiMode && !havePending && wantPortrait == PORTRAIT && wantFlip == FLIP && !turnPending) {   // turned: the settings page again
    static uint8_t frames = 0;
    if (++frames > 2) { frames = 0; uiMode = 1; }
  }
  if (uiMode) { uiLoop(); return; }      // the home page is showing
#endif
#if DUAL_CORE
  static uint8_t b = 0;
  uint32_t frameT0 = micros();
  int pending = -1;
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    xSemaphoreTake(goSem[b], portMAX_DELAY);
    int rows = stripRows[b], help = stripHelp[b];
    if (y0 == 0) {                       // a new frame: its size is settled now
#if TURNS
      if (turnPending) {                 // the screen was turned: tell the panel
#if USE_DMA
        if (lcdDma) { uint8_t c = 0x36, m = MADCTL_ROT[rotNow()]; lcdSend(&c, 1, false, 1000); lcdSend(&m, 1, true, 1000); } else
#endif
        tft.setRotation(rotNow());
        turnPending = false;
      }
#endif
#if USE_DMA
      if (lcdDma) lcdWindow(1000); else
#endif
      { tft.startWrite(); tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX); }
    }
    if (help) {                          // core 1's share of the drawing: the bottom rows
      uint16_t *dst = stripBuf[b] + (rows - help) * SCR_W;
      composeStrip(stripY0[b] + rows - help, help, dst);
      swapBytes565(dst, SCR_W * help);
    }
    if (y0 + STRIP >= SCR_H) xSemaphoreGive(helperIdle);   // core 0 can start the next frame
    uint32_t t0 = micros();
    xSemaphoreTake(readySem[b], portMAX_DELAY);
    wait1Us += micros() - t0;
#if HOME_PAGE
    if (homeActive()) homeIcon(stripBuf[b], stripY0[b], rows);   // the home button in the corner
#endif
#if USE_DMA
    if (lcdDma) {                        // send this strip in the background, then free the one before
      lcdQueue(b, rows, 1000);
      if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
      pending = b;
    } else
#endif
    {
      t0 = micros();
      sendStrip(stripBuf[b], rows);
      sendUs += micros() - t0;
      xSemaphoreGive(freeSem[b]);
    }
#if HOME_PAGE
    if (pressPending && !pressHave) {    // a press on the Wooden cross: read where it is now, before the finger lifts
      const int ny = y0 + rows;          // (the screen pauses between two strips, then carries on from the next row)
#if USE_DMA
      if (lcdDma) { if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); pending = -1; } } else
#endif
      tft.endWrite();
      pressOk = touchXY(pressX, pressY);
      pressHave = true;
#if USE_DMA
      if (lcdDma) { if (ny < SCR_H) lcdWindowFrom(ny, 1000); } else
#endif
      { tft.startWrite(); if (ny < SCR_H) tft.setAddrWindow(0, ny, SCR_W, SCR_H - ny); }
    }
#endif
    b ^= 1;
    readSerialQuick();                   // new settings get an answer even while a slow frame is drawn
    pollTap();
  }
#if USE_DMA
  if (pending >= 0) { lcdFinish(pending, 1000); xSemaphoreGive(freeSem[pending]); }
  if (!lcdDma)
#endif
  tft.endWrite();
#if HOME_PAGE
  homeCheck();                           // the screen is quiet now: was that press on the home button?
#endif
  countFrame();
  balanceCores(micros() - frameT0);
  return;
#else
  frameStart();
#if TURNS
  if (turnPending) { tft.setRotation(rotNow()); turnPending = false; }
#endif
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W * PX, SCR_H * PX);
  for (int y0 = 0; y0 < SCR_H; y0 += STRIP) {
    int rows = min(STRIP, SCR_H - y0);
    uint32_t t0 = micros();
    composeStrip(y0, rows, stripBuf[0]);
    uint32_t t1 = micros();
    sendStrip(stripBuf[0], rows);
    drawUs += t1 - t0; sendUs += micros() - t1;
    readSerialQuick();
    pollTap();
  }
  frameEnd();
  tft.endWrite();
  countFrame();
#endif
}
`;
}

function sketch() {
  if (M.kind === "tft") return tftSketch();
  const rgb = M.kind === "rgb", d = M.driver, B = boardOf();
  const wiringLines = "// Wiring:  " + wiringRows(B).map(w => `${w[0].split(" ")[0]}->${w[1]}`).join("  ");
  const includes = {
    ssd1306: "#include <Wire.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SSD1306.h>",
    sh1106:  "#include <Wire.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SH110X.h>",
    ssd1331: "#include <SPI.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SSD1331.h>",
    ssd1351: "#include <SPI.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SSD1351.h>",
  }[d];
  const displayDecl = {
    ssd1306: `#define OLED_ADDR  ${S.addr}      // if the screen stays blank, try ${S.addr === "0x3C" ? "0x3D" : "0x3C"}

// 400 kHz I2C during and after begin() for a smoother frame rate
Adafruit_SSD1306 oled(SCREEN_W, SCREEN_H, &Wire, -1, 400000UL, 400000UL);
Adafruit_GFX &gfx = oled;`,
    sh1106: `#define OLED_ADDR  ${S.addr}      // if the screen stays blank, try ${S.addr === "0x3C" ? "0x3D" : "0x3C"}

Adafruit_SH1106G oled(SCREEN_W, SCREEN_H, &Wire, -1, 400000UL, 400000UL);
Adafruit_GFX &gfx = oled;`,
    ssd1331: "", ssd1351: "",
  }[d];
  const spiPins = "";
  const colorDecl = rgb ? `${d === "ssd1331"
  ? "Adafruit_SSD1331 oled(&SPI, PIN_CS, PIN_DC, PIN_RST);"
  : "Adafruit_SSD1351 oled(SCREEN_W, SCREEN_H, &SPI, PIN_CS, PIN_DC, PIN_RST);"}

// Colour panels have no frame buffer, so each frame is drawn into a small
// 1-bit strip, then pushed to the screen in colour. ${H / M.band > 1 ? `${H / M.band} strips per frame.` : "One strip covers the whole screen."}
#define BAND ${M.band}
GFXcanvas1 canvas(SCREEN_W, BAND);
Adafruit_GFX &gfx = canvas;
uint16_t rowBuf[SCREEN_W];
uint16_t pal[8];` : "";
  const beginCode = {
    ssd1306: `  if (!oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    for (;;) {}  // display not found: check wiring and OLED_ADDR
  }`,
    sh1106: `  if (!oled.begin(OLED_ADDR, true)) {
    for (;;) {}  // display not found: check wiring and OLED_ADDR
  }`,
    ssd1331: `  oled.begin();
  oled.fillScreen(0);
  buildPalette();`,
    ssd1351: `  oled.begin();
  oled.fillScreen(0);
  buildPalette();`,
  }[d];
  const colorFns = rgb ? `
// ---------- colour ----------
uint16_t to565(uint8_t r, uint8_t g, uint8_t b) { return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3); }

void buildPalette() {            // 8 shades from core colour to rim colour
  for (uint8_t k = 0; k < 8; k++) {
    uint8_t c[3];
    for (uint8_t i = 0; i < 3; i++) {
      int16_t a = (COLOR_CORE >> (16 - 8 * i)) & 0xFF;
      int16_t b = (COLOR_RIM  >> (16 - 8 * i)) & 0xFF;
      c[i] = a + (b - a) * k / 7;
    }
    pal[k] = to565(c[0], c[1], c[2]);
  }
}

uint16_t shade(int16_t x, int16_t y) {
  float dx = (x - baseCx) / OVAL, dy = y - baseCy;
  float d = sqrt(dx * dx + dy * dy) / (RADIUS + 5) * 7.0;
  return pal[d > 7 ? 7 : (uint8_t)d];
}

void pushBand(int16_t by) {
  oled.startWrite();
  oled.setAddrWindow(0, by, SCREEN_W, BAND);
  for (int16_t y = 0; y < BAND; y++) {
    for (int16_t x = 0; x < SCREEN_W; x++) {
      rowBuf[x] = canvas.getPixel(x, y) ? shade(x, y + by) : 0;
    }
    oled.writePixels(rowBuf, SCREEN_W);
  }
  oled.endWrite();
}
` : "";
  const frame = rgb ? `  updateSparks();
  for (int16_t by = 0; by < SCREEN_H; by += BAND) {
    canvas.fillScreen(0);
    cx = baseCx;
    cy = baseCy - by;            // draw the part of the portal that falls in this strip
    drawAll();
    pushBand(by);
  }` : `  updateSparks();
  cx = baseCx;
  cy = baseCy;
  oled.clearDisplay();
  drawAll();
  oled.display();`;

return `// Vortex Portal for the ${M.spec.split(" · ")[0]} ${M.chip} ${rgb ? "colour " : ""}OLED (${M.w}x${M.h})
// Generated by Display Studio for: ${B.name}
// Works on Arduino (Uno, Nano, Mega), ESP32 (all types), ESP8266, Raspberry Pi Pico
// and Teensy. To use another board, change the pin numbers in the "Board" section below.
// Libraries (Library Manager): "${M.lib}" and "Adafruit GFX Library".
//
${wiringLines}
//
// Live tuning: plug in over USB, open Display Studio in Chrome or Edge and click
// "Connect over USB". The board saves the settings.

${includes}
#include <EEPROM.h>
#include <math.h>

${pinBlock(B, rgb ? "spi" : "i2c")}

#define SCREEN_W   ${M.w}
#define SCREEN_H   ${M.h}
#define MAX_SPARKS 30
#define RADIUS_MAX ${rmax(M)}

// ---------- Settings baked in from the Studio ----------
float    RADIUS     = ${f2(S.radius)};   // portal size in pixels
float    OVAL       = ${f2(S.oval)};    // 1.0 = round, higher = wide oval
uint8_t  ARMS       = ${S.arms};       // spiral arms
float    TWIST      = ${f2(S.twist)};    // how tightly the arms coil
float    SPEED      = ${f2(S.speed)};    // spin per frame (radians)
uint8_t  NUM_SPARKS = ${S.sparks};      // particles being sucked in
bool     DRIFT      = ${S.drift};    // slow wander to reduce OLED burn-in
uint32_t COLOR_CORE = 0x${hex6(S.c1)};  // ${rgb ? "inner colour" : "used by colour displays only"}
uint32_t COLOR_RIM  = 0x${hex6(S.c2)};  // ${rgb ? "outer colour" : "used by colour displays only"}
// --------------------------------------------------------

// Changes every time you copy a new sketch, so freshly uploaded settings
// win over ones saved earlier by live tuning.
const uint32_t BUILD_ID = 0x${BUILD_ID}UL;

${rgb ? colorDecl : displayDecl}

struct Spark { float a, r; };
Spark sparks[MAX_SPARKS];

float t = 0;
float baseCx = SCREEN_W / 2.0, baseCy = SCREEN_H / 2.0;   // portal centre on screen
float cx = baseCx, cy = baseCy;                           // centre in drawing coordinates

struct Saved { uint32_t id; float radius, oval, twist, speed; uint8_t arms, sparks, drift; uint32_t core, rim; };

inline int px(float a, float r) { return (int)floor(cx + cos(a) * r * OVAL); }
inline int py(float a, float r) { return (int)floor(cy + sin(a) * r); }

void respawn(Spark &s) {
  s.a = random(0, 628) / 100.0;
  s.r = RADIUS + random(2, 10);
}

void resetSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    respawn(sparks[i]);
    sparks[i].r = random(4, (int)RADIUS + 10);
  }
}
${colorFns}
// ---------- saved settings (EEPROM) ----------
bool valid(const Saved &s) {
  return s.radius >= 6 && s.radius <= RADIUS_MAX && s.oval >= 1 && s.oval <= 2 &&
         s.arms >= 1 && s.arms <= 8 && s.twist >= 0 && s.twist <= 6 &&
         s.speed >= 0 && s.speed <= 0.4 && s.sparks <= MAX_SPARKS &&
         s.core <= 0xFFFFFF && s.rim <= 0xFFFFFF;
}

void apply(const Saved &s) {
  RADIUS = s.radius; OVAL = s.oval; TWIST = s.twist; SPEED = s.speed;
  ARMS = s.arms; NUM_SPARKS = s.sparks; DRIFT = s.drift;
  COLOR_CORE = s.core; COLOR_RIM = s.rim;
}

void loadSettings() {
${EEPROM_BEGIN_GUARD}
  EEPROM.begin(64);
#endif
  Saved s;
  EEPROM.get(0, s);
  if (s.id == BUILD_ID && valid(s)) apply(s);
}

void saveSettings() {
  Saved s = { BUILD_ID, RADIUS, OVAL, TWIST, SPEED, ARMS, NUM_SPARKS, (uint8_t)DRIFT, COLOR_CORE, COLOR_RIM };
  EEPROM.put(0, s);
${EEPROM_BEGIN_GUARD}
  EEPROM.commit();
#endif
}

// ---------- live tuning over USB serial (and Bluetooth below) ----------
// Command: SET radius oval arms twist speed sparks drift core rim   (reply: OK or ERR)
char cmd[72];
uint8_t cmdLen = 0;

const char* handleCommand(char *line) {   // returns the reply to send back
  if (strncasecmp(line, "SET ", 4) == 0) {
    float v[9];
    uint8_t n = 0;
    char *p = strtok(line + 4, " ");
    while (p && n < 9) { v[n++] = atof(p); p = strtok(NULL, " "); }
    if (n == 9) {
      Saved s = { BUILD_ID, v[0], v[1], v[3], v[4], (uint8_t)v[2], (uint8_t)v[5], (uint8_t)v[6], (uint32_t)v[7], (uint32_t)v[8] };
      if (valid(s)) {
        apply(s);
        saveSettings();
        resetSparks();${rgb ? "\n        buildPalette();" : ""}
        return "OK";
      }
    }
    return "ERR";
  }
  if (strcasecmp(line, "PING") == 0) return "PORTAL";
  return NULL;
}

void readSerial() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\\n' || c == '\\r') {
      if (cmdLen) {
        cmd[cmdLen] = 0;
        const char *reply = handleCommand(cmd);
        if (reply) Serial.println(reply);
        cmdLen = 0;
      }
    } else if (cmdLen < sizeof(cmd) - 1) {
      cmd[cmdLen++] = c;
    }
  }
}
${bleBlock()}

// ---------- drawing (1 = lit pixel, 0 = dark) ----------
void drawArms() {
  for (uint8_t i = 0; i < ARMS; i++) {
    float base = t + i * (TWO_PI / ARMS);
    int lx = 0, ly = 0;
    bool first = true;
    for (float r = 3.0; r <= RADIUS; r *= 1.12) {
      float a = base + TWIST * log(r / RADIUS);   // logarithmic spiral
      int x = px(a, r), y = py(a, r);
      if (!first) gfx.drawLine(lx, ly, x, y, 1);
      if (r > RADIUS * 0.55) gfx.drawPixel(px(a + 0.12, r), py(a + 0.12, r), 1);
      lx = x; ly = y; first = false;
    }
  }
}

void drawRim() {
  const uint8_t N = 72;
  int lx = 0, ly = 0;
  for (uint8_t k = 0; k <= N; k++) {
    float a = k * TWO_PI / N;
    float wob = sin(a * 5 + t * 2) * 1.2 + sin(a * 3 - t * 3) * 0.8;
    float r = RADIUS + 1.5 + wob;
    int x = px(a, r), y = py(a, r);
    if (k > 0) gfx.drawLine(lx, ly, x, y, 1);   // wavy edge
    lx = x; ly = y;
    if (k % 3 == 0) {                            // rotating dotted halo
      float ha = a + t * 0.5;
      float hr = RADIUS + 4.5 + wob * 1.5;
      gfx.drawPixel(px(ha, hr), py(ha, hr), 1);
    }
  }
}

void updateSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) {
    Spark &s = sparks[i];
    s.r *= 0.95;                                  // fall inward
    s.a += SPEED * 2.0 * (RADIUS / (s.r + 6));   // faster near the centre
    if (s.r < 3) respawn(s);
  }
}

void drawSparks() {
  for (uint8_t i = 0; i < NUM_SPARKS; i++) gfx.drawPixel(px(sparks[i].a, sparks[i].r), py(sparks[i].a, sparks[i].r), 1);
}

void drawCore() {
  gfx.fillCircle((int)floor(cx), (int)floor(cy), 3, 0);         // dark throat
  int pulse = 1 + (int)((sin(t * 4) + 1.0) * 1.0);              // 1..3 px
  gfx.drawCircle((int)floor(cx), (int)floor(cy), pulse, 1);
}

void drawAll() { drawArms(); drawRim(); drawSparks(); drawCore(); }

void setup() {
  Serial.begin(115200);
  loadSettings();
  beginBus();
#if HAS_BLE
  beginBluetooth();
#endif
${beginCode}
  randomSeed(micros());
  resetSparks();
}

void loop() {
  readSerial();
#if HAS_BLE
  readBluetooth();
#endif

  if (DRIFT) {
    baseCx = SCREEN_W / 2.0 + sin(t * 0.01) * 4.0;
    baseCy = SCREEN_H / 2.0 + cos(t * 0.02) * 2.0;
  } else {
    baseCx = SCREEN_W / 2.0;
    baseCy = SCREEN_H / 2.0;
  }

${frame}

  t += SPEED;
  if (t > TWO_PI * 100) t -= TWO_PI * 100;   // wrap seamlessly so it can run forever
}
`;
}

// ---------------- UI ----------------

const codeEl = $("code");
const fmt = { crossw: v => v + "%", beam: v => v + "%", bar: v => v + "%", radius: v => v + " px", oval: v => f2(v), arms: v => v, twist: v => (+v).toFixed(1), speed: v => f2(v), sparks: v => v, bright: v => v + "%", tone: v => v + "%", warm: v => v + "%", ripples: v => v, rspeed: v => f2(v), glow: v => f2(v), stars: v => v, rimsmooth: v => v + "%", rimw: v => v + "%", fdLen: v => v + " min", fdStars: v => v + "%", fdClouds: v => v + "%", fdGlow: v => v + "%", cfGap: v => v + "%", cfTwist: v => v + "°", cfWob: v => v + "%", cfFlow: v => v + "%" };
let codeTimer;
const refreshCode = () => { clearTimeout(codeTimer); codeTimer = setTimeout(() => codeEl.textContent = withMain(sketch), 120); };

// display model dropdown: screen size first, part number and details underneath
const modelTitle = m => { const size = m.spec.split(" · ")[0]; return /round|rectangle|square/.test(size) ? size : `${size} ${m.w === m.h ? "square" : "rectangle"}`; };
const TESTED_SCREENS = ["gc9a01", "st7796"], TESTED_BOARDS = ["esp32s3", "cyd35"];   // tried on real hardware; the rest should work but haven't been tried yet
for (const [label, test] of [["Tested", k => TESTED_SCREENS.includes(k)], ["Untested: color screens", (k, m) => !TESTED_SCREENS.includes(k) && m.kind !== "mono"], ["Untested: one-color screens", (k, m) => !TESTED_SCREENS.includes(k) && m.kind === "mono"]]) {
  const grp = document.createElement("optgroup"); grp.label = label;
  const bySize = Object.entries(MODELS).sort((x, y) => parseFloat(x[1].spec) - parseFloat(y[1].spec));   // smallest screen first
  for (const [key, m] of bySize) {
    if (!test(key, m)) continue;
    const o = document.createElement("option"); o.value = key; o.textContent = modelTitle(m);
    grp.appendChild(o);
  }
  $("model").appendChild(grp);
}
$("model").addEventListener("change", e => selectModel(e.target.value, true));
function showModelDetail() {
  const m = MODELS[S.model], rest = m.spec.split(" · ").slice(1);
  $("model-detail").innerHTML = `<span class="tag ${m.kind !== "mono" ? "rgb" : ""}">${m.kind === "mono" ? "ONE COLOR" : "COLOR"}</span><span class="tag">${TESTED_SCREENS.includes(S.model) ? "TESTED" : "UNTESTED"}</span><span>${[m.chip, ...rest].join(" · ")}</span>`;
}
// board picker (every display)
for (const [label, tested] of [["Tested", true], ["Untested", false]]) {   // boards tried on real hardware first
  const grp = document.createElement("optgroup"); grp.label = label;
  for (const [k, b] of Object.entries(BOARDS)) { if (TESTED_BOARDS.includes(k) !== tested) continue; const o = document.createElement("option"); o.value = k; o.textContent = b.name; grp.appendChild(o); }
  $("board").appendChild(grp);
}
function refreshBoardOptions() {
  [...$("board").options].forEach(o => {
    const fits = boardFits(BOARDS[o.value], M);
    o.disabled = !fits;
    o.textContent = BOARDS[o.value].name + (fits ? "" : BOARDS[o.value].screen ? ` (pick ${MODELS[BOARDS[o.value].screen].chip} ${MODELS[BOARDS[o.value].screen].spec.split(" · ")[0]} to use it)` : " (not enough memory for this screen)");
  });
  if (!boardFits(BOARDS[S.board], M)) S.board = "esp32s3";
  $("board").value = S.board;
}
$("board").addEventListener("change", e => {
