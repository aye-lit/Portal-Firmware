  if (dx * dx + dy * dy <= (uiWR + 14.0f) * (uiWR + 14)) { uiDrag = 10; uiWheelAt(x, y); return; }
  const UiRect &r = uiWSl;
  if (y >= r.y - 8 && y < r.y + r.h + 10 && x >= r.x - 14 && x < r.x + r.w + 14) { uiDrag = 11; uiWSlideTo(x); }
}
