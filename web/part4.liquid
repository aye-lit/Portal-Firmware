// ---------- live tuning over USB serial (and Bluetooth below) ----------
// Command: SET radius oval arms twist speed sparks drift core rim   (reply: OK or ERR)
char cmd[72];
uint8_t cmdLen = 0;

const char* handleCommand(char *line) {   // returns the reply to send back
  if (strncasecmp(line, "SET ", 4) == 0) {
    float v[9];
    uint8_t n = 0;
    char *p = strtok(line + 4, " ");
    while (p && n < 9) { v[n++] = atof(p); p = strtok(NULL, " "); }
    if (n == 9) {
      Saved s = { BUILD_ID, v[0], v[1], v[3], v[4], (uint8_t)v[2], (uint8_t)v[5], (uint8_t)v[6], (uint32_t)v[7], (uint32_t)v[8] };
      if (valid(s)) {
        apply(s);
        saveSettings();
        resetSparks();${rgb ? "\n        buildPalette();" : ""}
        return "OK";
      }
    }
    return "ERR";
  }
  if (strcasecmp(line, "PING") == 0) return "PORTAL";
  return NULL;
}

void readSerial() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\\n' || c == '\\r') {
      if (cmdLen) {
        cmd[cmdLen] = 0;
        const char *reply = handleCommand(cmd);
        if (reply) Serial.println(reply);
        cmdLen = 0;
      }
    } else if (cmdLen < sizeof(cmd) - 1) {
      cmd[cmdLen++] = c;
    }
  }
}
