  const canvasJpeg = (c, q) => new Promise((ok, bad) => c.toBlob(b => b ? b.arrayBuffer().then(a => ok(new Uint8Array(a)), bad) : bad(new Error("the browser couldn't make a JPEG")), "image/jpeg", q));
