    await sleep(60);
    await port.open({ baudRate: baud });
    await sleep(120);
  }
  async function ping(ms) { return /PORTAL/.test(await boardRequest("PING", /PORTAL/, ms)); }
  async function streamLines(lines, onAck) {     // many lines, a few ahead of the board's replies (each one answers K)
    const AHEAD = 1, enc = new TextEncoder(), dec = new TextDecoder();   // one line at a time: while the board writes its flash it can't take in more (bytes sent then are lost)
    const reader = port.readable.getReader(), writer = port.writable.getWriter();
