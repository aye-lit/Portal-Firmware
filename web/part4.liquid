void uiWMarker(int &mx, int &my) {        // where the picked colour sits on the wheel
  const float a = uiWH * 6.2832f;
  mx = uiWCX + (int)lroundf(cosf(a) * uiWS * uiWR); my = uiWCY - (int)lroundf(sinf(a) * uiWS * uiWR);
