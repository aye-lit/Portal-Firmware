  if (fw) $("fw-note").textContent = IS_ANDROID && fw.phone
    ? "Select the correct board from the drop down list. Plug the board into your phone, tap the Install on my board button.\nTakes about a minute.\n(Only works with Android. A terminal app may be needed)"
    : "Select the correct board from the drop down list to the right. Plug the board into your computer, click the Install on my board button. Works in Chrome or Edge on a computer.\nTakes about a minute.";
}
let esptool = null;
async function installFirmware() {
  const fw = firmwareFor(); if (!fw) return;
  const st = $("fw-status"), bar = progressBar("fw");
  const sayF = (m, c = "") => { st.className = "status " + c; st.textContent = m; };
  const viaUsb = IS_ANDROID && fw.phone && !!navigator.usb;      // phones: CH340 boards over WebUSB
  if (IS_ANDROID && !fw.phone) { sayF("Installing on this board needs a computer with Chrome or Edge. After that, you can change everything over USB.", "warn"); return; }
  if (!viaUsb && !("serial" in navigator)) { sayF("This browser can't install on USB boards. Use Chrome or Edge on a computer.", "warn"); return; }
  if (port) { try { await port.close(); } catch (_) {} port = null; }   // free the USB link if it's open
  let transport = null;
  $("fw-install").disabled = true;
  try {
    sayF("");
    bar.step(1, 4, "Loading the installer");
    if (!esptool) {
      try {                                    // downloaded with a progress bar, then started
        const code = await fetchWithProgress(FW_BASE + "esptool.js", f => bar.set(f));
        const url = URL.createObjectURL(new Blob([code], { type: "text/javascript" }));
        try { esptool = await import(url); } finally { URL.revokeObjectURL(url); }
      } catch (_) { bar.set(null); esptool = await import(FW_BASE + "esptool.js"); }
    }
    bar.set(1);
    bar.step(2, 4, "Pick your board in the list, then connecting");
