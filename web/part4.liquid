    bar.step(3, 4, "Downloading the firmware");
    const data = await fetchWithProgress(FW_FILES + fw.file, f => bar.set(f));
    if (await sha256Hex(data) !== fw.sha256) throw new Error("the firmware download didn't match the expected file, so nothing was installed. Please try again later.");
    bar.step(4, 4, "Installing on the board. Keep it plugged in.");
