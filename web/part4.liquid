const FW_BASE = "https://cdn.jsdelivr.net/gh/aye-lit/Portal-Firmware@861b9a6fa183a606851f83c01e12ccf98674c100/";
// The firmware is locked to one exact release: a fixed GitHub commit (whose files can never change), and each file's
// fingerprint is checked before installing. A new firmware release only reaches customers with a website update.
const FW_VERSION = "1.10.21";
const FW_FILES = "https://raw.githubusercontent.com/aye-lit/Portal-Firmware/7213e50900d9f890a6aead69bac94ae5ae277793/";
const FIRMWARE = {                     // board|screen -> prebuilt firmware (landscape for rectangles)
  "esp32s3|gc9a01": { file: "firmware/portal_s3_gc9a01.bin", chip: "ESP32-S3", phone: false, sha256: "930b95793843c40e7704185bac6b4c27e5bd6df3cdddf2fa68623cb2d4f782da" },
  "cyd35|st7796":   { file: "firmware/portal_cyd35.bin",     chip: "ESP32",    phone: true, turns: true, sha256: "3f11cb72ea2fca1fed2732b1ebf65763d06aad6ecc991e14fc4babdce242260f" },
};
async function sha256Hex(bytes) {
