      const W = SW(), H = SH();
      const r = await boardRequest(pdCmdLine().trim(), /(^|\n)(OK|ERR)\r?\n/, 6000);   // the Picture Display, the right way round
      if (!/(^|\n)OK\r?\n/.test(r)) throw new Error("the board doesn't have the Picture Display yet. Click Install on my board first, then Connect over USB and send again");
      await sleep(400);                            // (a turned screen settles)
      const info = (await boardRequest("SHOWINFO", /SHOW \d+ \d+ \d+[^\n]*\n|ERR/, 4000)).match(/SHOW (\d+) (\d+) (\d+)/);
      if (!info) throw new Error("the board doesn't have the Picture Display yet. Click Install on my board first, then Connect over USB and send again");
