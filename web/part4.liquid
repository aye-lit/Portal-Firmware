    let fast = false, firstTry = "";
    const backToNormal = async () => {            // the normal speed again (if the board missed the word, it goes back by itself after 10 quiet seconds)
      try { await boardRequest("BAUD 115200", /(^|\n)(OK|ERR)\r?\n/, 1500); } catch (_) {}
      try { await reopen(115200); } catch (_) {}
