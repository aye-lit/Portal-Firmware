void uiSwatchWheel(const UiRect &r, int R, int kind, bool sel) {   // the settings page's last swatch: a rainbow ring round the colours picked
  const int cx = r.x + R, cy = r.y + R;
  if (!uiRowsHit(cy - R - 5, 2 * R + 10)) return;
  if (sel) { ug.fillCircle(cx, cy, R + 4, uiRGB(0xFFFFFF)); ug.fillCircle(cx, cy, R + 1, uiRGB(0x0B0B10)); }
  for (int y = cy - R; y <= cy + R; y++) {
    if (y < uiY0 || y >= uiY0 + uiRows) continue;
    for (int x = cx - R; x <= cx + R; x++) {
      const float dx = x - cx, dy = y - cy, d = sqrtf(dx * dx + dy * dy) / R;
      if (d > 1) continue;
      uint32_t c;
      if (d > 0.6f) c = uiHsv(atan2f(-dy, dx) / 6.2832f, 1, 1);
      else if (d > 0.52f) c = 0x0B0B10;
      else if (kind == 1) c = uiMix(stRim, stCore, d / 0.52f);
      else { float a = (atan2f(dy, dx) + 3.1416f) / 6.2832f * 4; int j = (int)a & 3; c = uiMix(stSpace[j], stSpace[(j + 1) & 3], a - (int)a); }
      if (d > 0.9f) c = uiMix(c, 0x000000, (d - 0.9f) * 6);
      ug.drawPixel(x, y, uiRGB(c));
    }
  }
}
