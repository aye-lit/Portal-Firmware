// ---------- sending pictures to the board ----------
async function picJpeg(pic) {                       // the screen-sized JPEG the board unpacks (192 KB max), as sharp as fits
  const c = cropCanvas(pic); if (!c) throw new Error("a picture is still loading");
  for (const q of [0.95, 0.92, 0.88, 0.84, 0.8, 0.7, 0.6, 0.5, 0.4]) {
    const blob = await new Promise(r => c.toBlob(r, "image/jpeg", q));
    if (blob && blob.size <= 0x2FF00) return new Uint8Array(await blob.arrayBuffer());
  }
  throw new Error("a picture is too detailed to fit");
}
function picHash(bytes) {                            // FNV-1a, never 0
  let h = 0x811c9dc5;
  for (let i = 0; i < bytes.length; i++) { h ^= bytes[i]; h = Math.imul(h, 0x01000193); }
  return ((h >>> 0) || 1).toString(16);
}
function b64(bytes) { let s = ""; for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]); return btoa(s); }
let bleChunk = 180;
async function bleWrite(data) {                     // bigger pieces when the link allows, 20 bytes otherwise
  for (let i = 0; i < data.length;) {
    const part = data.slice(i, i + bleChunk);
    try { if (bleRx.writeValueWithResponse) await bleRx.writeValueWithResponse(part); else await bleRx.writeValue(part); i += part.length; }
    catch (e) { if (bleChunk > 20) bleChunk = 20; else throw e; }
  }
}
async function usbReadUntil(re, ms) {
  const reader = port.readable.getReader(), dec = new TextDecoder(); let text = "";
  const timer = setTimeout(() => reader.cancel().catch(() => {}), ms);
  try {
    while (true) { const { value, done } = await reader.read(); if (done) break; text += dec.decode(value); if (re.test(text)) break; }
  } catch (e) {} finally { clearTimeout(timer); reader.releaseLock(); }
  return text;
}
async function boardRequest(line, re, ms) {          // send one command line, wait for a reply that matches
  const data = new TextEncoder().encode(line + "\n");
  if (bleRx) {
    bleText = "";
    const reply = new Promise(res => { bleWaitRe = re; bleWait = res; setTimeout(() => res(bleText), ms); });
    try { await bleWrite(data); return await reply; } finally { bleWait = null; bleWaitRe = null; }
  }
  const w = port.writable.getWriter();
  try { await w.write(data); } finally { w.releaseLock(); }
