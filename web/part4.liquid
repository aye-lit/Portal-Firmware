const IS_ANDROID = /Android/i.test(navigator.userAgent);
function firmwareFor() {
  const fw = FIRMWARE[S.board + "|" + S.model];
  return fw && (fw.turns || !(M.rect && S.portrait && M.w !== M.h)) ? fw : null;   // boards that turn: portrait is set over USB after installing
}
function showFirmware() {
  const fw = firmwareFor();
