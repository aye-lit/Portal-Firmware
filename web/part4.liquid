}
async function sendUsb() {
  if (!port && phoneUsb()) {                        // phone: pick the board from the USB list, then carry on as normal
    if (busy) { pending = true; return; }
    busy = true;
    try {
      const et = await loadEsptool();
      const dev = await et.WebUSBSerialPort.requestPort();
      setConn("busy", "Connecting over USB…");
      const p = serialLike(dev);
      await p.open({ baudRate: 115200 });
      port = p;
      say("Connected. Waiting for the board…");
      await sleep(1200);
    } catch (e) {
      busy = false;
      if (e && e.name === "NotFoundError") say("No board selected.");
      else say("Couldn't open the board over USB: " + ((e && e.message) || e) + ". Unplug it, plug it back in and try again.", "warn");
      port = null; refreshConn();
      return;
    }
    busy = false;
  }
  if (!port && !("serial" in navigator)) {
    say("This browser can't talk to USB boards. Use Chrome or Edge on a computer, or Chrome on an Android phone (update Chrome if it's old), and open the downloaded Display Studio file rather than the shared link. iPhone and iPad browsers can't do this.", "warn");
    return;
  }
  if (busy) { pending = true; return; }
  busy = true;
  try {
    if (!port) {
      const p = await navigator.serial.requestPort();
      setConn("busy", "Connecting over USB…");
      await p.open({ baudRate: 115200 });
      port = p;
      say("Connected. Waiting for the board to restart…");
      await sleep(2200);   // Uno/Nano reboot when the port opens
    }
    const w = port.writable.getWriter();
    await w.write(new TextEncoder().encode(cmdLine())); w.releaseLock();
    const reply = await readReply(5000);
    if (/\bOK\b/.test(reply)) { say("Sent and saved on the board.", "ok"); refreshConn(); }
    else if (/\bERR\b/.test(reply)) { say("The board rejected those settings. If you changed the display model, copy and upload the new sketch first.", "warn"); refreshConn(); }
    else setConn("busy", "USB open, but the board isn't answering"), say("No reply from the board. If the portal program isn't on it yet, install it first (Quick install above, or upload the sketch with Arduino). Also close the Arduino Serial Monitor.", "warn");
  } catch (e) {
    if (e && e.name === "NotFoundError") say("No board selected.");
    else if (e && e.name === "SecurityError") say("USB access is blocked on this page. Open the downloaded Display Studio file in Chrome or Edge on a computer, or Chrome on an Android phone.", "warn");
    else say("Couldn't open the board's port. Close the Arduino Serial Monitor and try again.", "warn");
    try { if (port) await port.close(); } catch (_) {}
    port = null;
    countPlugged();
  } finally {
    busy = false;
    if (pending) { pending = false; send(); }
  }
}
$("send").addEventListener("click", sendUsb);
$("fw-usb").addEventListener("click", sendUsb);   // the same, right under Install

// ---------------- live tuning over Bluetooth (Web Bluetooth) ----------------
const send = () => bleRx ? sendBle() : sendUsb();
async function sendBle() {
  if (busy) { pending = true; return; }
  busy = true;
  try {
    const data = new TextEncoder().encode(cmdLine());
    bleText = "";
    const reply = new Promise(res => { bleWait = res; setTimeout(() => res(bleText), 2500); });
    for (let i = 0; i < data.length; i += 20) {          // small chunks fit any Bluetooth packet size
      const part = data.slice(i, i + 20);
      if (bleRx.writeValueWithResponse) await bleRx.writeValueWithResponse(part); else await bleRx.writeValue(part);
    }
    const r = await reply;
    if (/\bOK\b/.test(r)) say("Sent over Bluetooth and saved on the board.", "ok");
    else if (/\bERR\b/.test(r)) say("The board rejected those settings. If you changed the display model, copy and upload the new sketch first.", "warn");
    else say("No reply from the board over Bluetooth. Try sending again.", "warn");
  } catch (e) {
    say("The Bluetooth connection dropped. Tap Connect over Bluetooth again.", "warn");
    bleRx = null; refreshConn();
  } finally {
    bleWait = null; busy = false;
    if (pending) { pending = false; send(); }
  }
}
$("reboot").addEventListener("click", async () => {
  if (busy) return;
  if (!port && !bleRx) { say("Connect over USB first. Or just unplug the board and plug it back in.", "warn"); return; }
  busy = true;
  try {
    const data = new TextEncoder().encode("REBOOT\n");
    if (bleRx) { if (bleRx.writeValueWithResponse) await bleRx.writeValueWithResponse(data); else await bleRx.writeValue(data); }
    else { const w = port.writable.getWriter(); await w.write(data); w.releaseLock(); }
    say("Restarting the board. It's back in a few seconds" + (bleRx ? "; tap Connect over Bluetooth again." : ". If changes stop sending, tap Connect over USB again."), "ok");
    if (bleRx) { bleRx = null; refreshConn(); }
  } catch (e) {
    say("Couldn't reach the board. Unplug it and plug it back in instead.", "warn");
  } finally { busy = false; }
});
const IS_IOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
if (false) $("ble-note").innerHTML = "<b>Bluetooth on iPhone/iPad:</b> Safari and Chrome on iPhone can't use Bluetooth. Install the free “Bluefy – Web BLE Browser” app from the App Store, open this page in it, then tap Connect over Bluetooth.";
$("ble").addEventListener("click", async () => {
  if (!navigator.bluetooth) {
    say(IS_IOS ? "iPhone and iPad browsers like Safari and Chrome can't use Bluetooth from a web page. Install the free “Bluefy – Web BLE Browser” app from the App Store, open this page in it, and tap Connect over Bluetooth again."
               : "This browser can't use Bluetooth. Use Chrome on Android or on a computer, or the Bluefy browser on iPhone.", "warn");
    return;
  }
  try {
    const dev = await navigator.bluetooth.requestDevice({ filters: [{ services: [BLE_SVC] }] });
    say("Connecting to " + (dev.name || "the board") + "…");
    setConn("busy", "Connecting over Bluetooth…");
    dev.addEventListener("gattserverdisconnected", () => { bleRx = null; refreshConn(); say("Bluetooth disconnected. Tap Connect over Bluetooth to reconnect."); });
    const svc = await (await dev.gatt.connect()).getPrimaryService(BLE_SVC);
    const tx = await svc.getCharacteristic(BLE_TX);
    tx.addEventListener("characteristicvaluechanged", e => {
      bleText += new TextDecoder().decode(e.target.value);
      if (bleWait && (bleWaitRe || /\b(OK|ERR)\b/).test(bleText)) bleWait(bleText);
    });
    await tx.startNotifications();
    bleRx = await svc.getCharacteristic(BLE_RX);
    refreshConn();
    await sendBle();
  } catch (e) {
    if (e && e.name === "NotFoundError") say("No board selected. If “Vortex Portal” isn't in the list, upload the latest sketch (it adds Bluetooth) and make sure the board is powered.");
    else if (e && e.name === "SecurityError") say("Bluetooth is blocked on this page. Open the Studio on ayelit.com in Chrome.", "warn");
    else say("Couldn't connect over Bluetooth. Make sure the board is powered and has the latest sketch, then try again.", "warn");
    bleRx = null; refreshConn();
  }
});
$("copy-cmd").addEventListener("click", async () => {
  const line = cmdLine().trim(), st = $("cmd-status");
  try { await navigator.clipboard.writeText(line); st.className = "status ok"; st.textContent = "Copied. Paste it into the terminal app and send. The board replies OK when it's saved."; }
  catch (e) { st.className = "status warn"; st.textContent = "Copy this line: " + line; }
});
let liveTimer;
function liveSend() {
  if (!$("live").checked || (!port && !bleRx)) return;
  clearTimeout(liveTimer); liveTimer = setTimeout(send, 350);
}

