uint32_t uiHsv(float h, float s, float v) {   // hue 0-1 round the wheel, strength, brightness -> 0xRRGGBB
  h -= floorf(h); h *= 6;
  const int i = (int)h; const float f = h - i, p = v * (1 - s), q = v * (1 - s * f), t = v * (1 - s * (1 - f));
  float r, g, b;
  switch (i) { case 0: r = v; g = t; b = p; break; case 1: r = q; g = v; b = p; break; case 2: r = p; g = v; b = t; break;
               case 3: r = p; g = q; b = v; break; case 4: r = t; g = p; b = v; break; default: r = v; g = p; b = q; }
  return ((uint32_t)(r * 255 + 0.5f) << 16) | ((uint32_t)(g * 255 + 0.5f) << 8) | (uint32_t)(b * 255 + 0.5f);
}
void uiToHsv(uint32_t c, float &h, float &s, float &v) {
  const float r = ((c >> 16) & 255) / 255.0f, g = ((c >> 8) & 255) / 255.0f, b = (c & 255) / 255.0f;
  const float mx = fmaxf(r, fmaxf(g, b)), mn = fminf(r, fminf(g, b)), d = mx - mn;
  v = mx; s = mx > 0 ? d / mx : 0;
  if (d <= 0) return;                     // a grey: keep the hue it had
  h = mx == r ? (g - b) / d : mx == g ? 2 + (b - r) / d : 4 + (r - g) / d;
  h /= 6; if (h < 0) h += 1;
}
uint32_t *uiWCol(int t) { return uiColKind() == 1 ? (t == 0 ? &stCore : &stRim) : &stSpace[t & 3]; }   // the colour being changed
