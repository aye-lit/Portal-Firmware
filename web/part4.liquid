      bar.step(3, 3, "Sending to the board"); bar.set(null);
      if (/OK/.test(await boardRequest("BAUD 921600", /(^|\n)(OK|ERR)\r?\n/, 2500))) {   // a faster link for the big part
        try { await reopen(921600); fast = await ping(1500); } catch (_) { fast = false; }
        if (!fast) {                               // (some USB chips can't: back to the normal speed)
          await reopen(115200);
          if (!(await ping(4000)) && !(await ping(4000))) throw new Error("the board stopped answering. Unplug it, plug it back in, then Connect over USB and send again");
        }
      }
      const upload = async chunk => {             // the show, in pieces of chunk base64 characters, each one answered K
        const r2 = await boardRequest(`SHOW ${show.bin.length} ${show.id}`, /(^|\n)(READY|ERR[^\n]*)\r?\n/, 8000);
        if (!/READY/.test(r2)) throw new Error("the board couldn't make room for the show");
        const text = b64(show.bin), lines = [];
        for (let k = 0; k < text.length; k += chunk) lines.push("B " + text.slice(k, k + chunk));
        const tStart = Date.now();
        await streamLines(lines, a => {
          bar.set(a / lines.length);
          const secs = (Date.now() - tStart) / 1000 / a * (lines.length - a);
          if (a > 5) $("pd-stage").innerHTML = `<b>Step 3 of 3</b> Sending to the board · about ${secs > 90 ? Math.ceil(secs / 60) + " min" : Math.ceil(secs) + " s"} left`;
        });
        bar.step(3, 3, "Checking it on the board"); bar.set(null);
        const e = await boardRequest("SHOWEND", /(^|\n)(OK|ERR[^\n]*)\r?\n/, 30000);
        if (!/(^|\n)OK\r?\n/.test(e)) throw new Error(/ERR check/.test(e) ? "some of the data got mixed up on the way. Send again" : "the board couldn't store the show");
      };
      try { await upload(1064); }
      catch (e1) {                                 // didn't go through: once more at the normal speed, in the small pieces pictures use
        if (!e1.stall && !fast) throw e1;
        firstTry = e1.message;
        bar.step(3, 3, "Trying again at the safe speed"); bar.set(null);
        if (fast) { await backToNormal(); fast = false; }
        await upload(264);
      }
      bar.done(`${items.length} item${items.length > 1 ? "s" : ""}, ${mb(show.bin.length)}`, "On the board");
      say("Sent. The board is playing your show, and keeps it when it's switched off.", "ok");
    } catch (err) {
      bar.fail();
      say("Couldn't send the show: " + ((err && err.message) || "the connection dropped") + "." + (firstTry ? " (First try at the fast speed: " + firstTry + ".)" : ""), "warn");
    } finally {
      if (fast && port) {                          // back to the normal speed
        await backToNormal();
        if (typeof refreshConn === "function") try { refreshConn(); } catch (_) {}
      }
      sending = false; busy = false; $("pd-send").disabled = false;
    }
  }
  $("pd-send").addEventListener("click", sendShow);
  memory();
  return { enter, leave, isOpen: () => open, say };
})();
function picMode() { const pg = DISPLAY_PAGES[(location.hash || "").slice(1).toLowerCase()]; return !!(pg && pg.pics); }
function pdCmdLine() {                            // the Picture Display: style 22, no scenes, the screen the right way round
  const keep = { style: S.style, scenes: S.scenes };
  S.style = 22; S.scenes = [];
  try { return cmdLineMain(); } finally { S.style = keep.style; S.scenes = keep.scenes; }
}
if (picMode()) PDX.enter();
showDisplayPage(true);

})();
