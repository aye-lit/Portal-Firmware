{% raw %}<!-- Display Studio (embedded). Everything is scoped under #vps so it does not affect the store theme. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
#vps {
  --brand-red: #f32c2c; --brand-red-soft: transparent;
  --bg: #eef0f4;
  --surface: #ffffff;
  --ink: #000000;
  --dim: #000000;
  --line: #d6dae4;
  --accent: #f32c2c;
  --accent-ink: #ffffff;
  --accent-soft: rgba(243, 44, 44, .08);
  --ok: #18804a;
  --warn: #b0560f;
  --code-bg: #f6f7fa;
  --pcb: #123a6b;
  --pcb-edge: #0b2748;
  --glass: #020305;
  --display: "Chakra Petch", "Segoe UI", system-ui, sans-serif;
  --body: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
#vps, #vps * { box-sizing: border-box; }
#vps [hidden] { display: none !important; }
#vps { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.55 var(--body); }
#vps .wrap { max-width: 1180px; margin: 0 auto; padding-inline: 20px; padding-block: 28px 48px; display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
#vps header { display: grid; gap: 4px; }
#vps h1 { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 4vw, 36px); letter-spacing: .02em; margin: 0; text-wrap: balance; }
#vps header p { margin: 0; color: var(--dim); max-width: 62ch; }
#vps header { justify-items: center; text-align: center; position: relative; }
#vps header h1 { text-align: center; }
#vps header .back { justify-self: start; color: var(--accent); font-weight: 600; text-decoration: none; font-size: 15px; }
#vps header .back:hover { text-decoration: underline; }
#vps header p.sub { color: var(--ink); opacity: .8; font-size: 16px; font-weight: 400; letter-spacing: 0; text-transform: none; }
#vps .srow.mode-off { display: none !important; }
#vps .dpick { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
@media (max-width: 860px) {
#vps .dpick { grid-template-columns: minmax(0, 1fr); }
 }
#vps .dcard { background: var(--surface); border: 1.5px solid var(--accent); border-radius: 14px; padding: 24px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; color: var(--ink); text-decoration: none; transition: transform .15s, box-shadow .15s; }
#vps .dcard:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,.12); }
#vps .dcard img { width: 100%; max-width: 250px; height: auto; border-radius: 10px; }
#vps .dcard h2 { margin: 18px 0 6px; font-family: var(--body); font-size: 24px; font-weight: 700; letter-spacing: 0; text-transform: none; }
#vps .dcard p { margin: 0 0 18px; font-size: 15px; line-height: 1.45; max-width: 34ch; }
#vps .dcard .go { background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 16px; padding: 11px 26px; border-radius: 9px; }
#vps .dcard .tag { font: 600 11.5px var(--mono); letter-spacing: .06em; color: var(--dim); margin-top: 14px; }
#vps .cols { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 24px; align-items: start; }
@media (max-width: 760px) {
#vps .cols, #vps .cols.top { grid-template-columns: minmax(0, 1fr); }
 }
@media (max-width: 760px) {
#vps .cols.top { display: flex; flex-direction: column; align-items: stretch; gap: 20px; }
#vps .cols.top > .col { display: contents; }
#vps section[aria-label="Preview"] { order: 1; }
#vps section[aria-label="Settings"] { order: 2; }
#vps section[aria-label="Display model"] { order: 3; }
#vps section[aria-label="Put it on your board"] { order: 4; }
#vps section[aria-label="Your board and wiring"] { order: 5; }
#vps section[aria-label="Sketch"] { order: 6; }

}
#vps .col { display: grid; gap: 20px; min-width: 0; }
#vps h2 { font-family: var(--display); font-weight: 700; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); margin: 0 0 10px; }
#vps .card { background: linear-gradient(var(--brand-red-soft), var(--brand-red-soft)), var(--surface); border: 1px solid var(--brand-red); border-radius: 12px; padding: 18px; min-width: 0; }
#vps .modelpick { display: grid; gap: 6px; font-size: 13px; font-weight: 700; }
#vps .modelpick select { width: 100%; font: 600 15px var(--body); padding: 10px 34px 10px 12px; border-radius: 8px; }
#vps .modeldetail { margin: 8px 0 0; color: var(--dim); font: 12px var(--mono); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
#vps .modeldetail .tag { font: 600 10px var(--mono); letter-spacing: .08em; padding: 1px 6px; border-radius: 99px; border: 1px solid var(--line); color: var(--dim); }
#vps .modeldetail .tag.rgb { border: 0; color: #fff; background: linear-gradient(90deg, #e2384d, #e8a92c, #3fb56b, #3a7bd5, #8a4fd8); }
#vps .module {
  background: var(--pcb); border: 2px solid var(--pcb-edge); border-radius: 10px;
  padding: 10px 14px 18px; display: grid; gap: 8px; margin-inline: auto; width: 100%;
  box-shadow: 0 10px 30px rgba(0,0,0,.25);
}
#vps .pins { display: flex; justify-content: center; gap: clamp(8px, 3vw, 20px); flex-wrap: wrap; font: 500 10px var(--mono); color: #c9d6ea; letter-spacing: .06em; }
#vps .pins span { display: grid; justify-items: center; gap: 3px; }
#vps .pins span::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: #d8b35a; box-shadow: inset 0 0 0 2px #8a6a22; }
#vps .glass { background: var(--glass); border-radius: 3px; padding: 6px; border: 1px solid #000; }
#vps #vps-oled { display: block; width: 100%; height: auto; image-rendering: pixelated; }
#vps .glass.round { border-radius: 50%; padding: 0; overflow: hidden; border: 6px solid #000; }
#vps .glass.round #vps-oled { image-rendering: auto; border-radius: 50%; }
#vps .glass.tft #vps-oled { image-rendering: auto; }
#vps .spacecols { display: grid; justify-content: stretch; gap: 8px; }
#vps .spacecols .chips { display: flex; gap: 6px; flex-wrap: wrap; }
#vps .spchip { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 12px; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px 4px 4px; cursor: pointer; }
#vps .spchip i { width: 30px; height: 14px; border-radius: 999px; display: block; }
#vps .spchip[aria-pressed="true"] { border-color: var(--ink); }
#vps .below { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 12px; font-size: 13px; color: var(--dim); }
#vps .seg { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--brand-red); border-radius: 8px; overflow: hidden; }
#vps .seg button { border: 0; border-radius: 0; background: transparent; padding: 5px 10px; font: 500 12px var(--mono); color: var(--dim); cursor: pointer; }
#vps .seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
#vps .seg button:disabled { opacity: .35; cursor: not-allowed; }
#vps .styles { margin: 0 0 14px; }
#vps .styles-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
#vps .colors { margin: 0 0 14px; }
#vps .colors .below { justify-content: flex-start; margin-top: 0; margin-bottom: 10px; }
#vps .colors .ctitle { font-weight: 700; color: var(--ink); min-width: 4.5em; }
#vps .style-groups { display: grid; gap: 8px; }
#vps .srow { display: grid; grid-template-columns: 56px minmax(0, 1fr); align-items: center; gap: 10px; }
#vps .srow .seg { justify-self: start; }
#vps .slab { font: 700 11px var(--display); letter-spacing: .12em; text-transform: uppercase; color: var(--dim); }
#vps .fps { font: 12px var(--mono); color: var(--dim); margin: 8px 0 0; }
#vps .swatches { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
#vps .sw { width: 26px; height: 26px; border-radius: 50%; padding: 0; cursor: pointer; border: 2px solid var(--line);
  background: radial-gradient(circle, var(--a) 0 35%, var(--b) 75%); }
#vps .sw[aria-pressed="true"] { border-color: var(--ink); }
#vps .pick { display: flex; align-items: center; gap: 6px; font-size: 12px; }
#vps input[type=color] { width: 30px; height: 22px; border: 1px solid var(--line); border-radius: 5px; padding: 0; background: none; cursor: pointer; }
#vps .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
@media (max-width: 480px) {
#vps .grid { grid-template-columns: minmax(0, 1fr); }
 }
#vps .sliders { grid-column: 1 / -1; columns: 2; column-gap: 22px; }
#vps .sliders > label.ctl { break-inside: avoid; margin-bottom: 10px; }
@media (max-width: 480px) {
#vps .sliders { columns: 1; }
 }
#vps label.ctl { display: grid; gap: 4px; font-size: 13px; align-content: start; }
#vps label.ctl span { font-weight: 700; display: flex; justify-content: space-between; gap: 8px; }
#vps label.ctl output { font: 500 12px var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }
#vps label.ctl small { color: var(--dim); font-size: 12px; line-height: 1.3; }
#vps input[type=range] { width: 100%; accent-color: var(--accent); margin: 0; }
#vps .row { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; margin-top: 14px; font-size: 13px; }
#vps .row label { display: flex; align-items: center; gap: 8px; }
#vps select {
  font: 500 13px var(--mono); padding: 5px 30px 5px 8px; border-radius: 6px; border: 1px solid var(--line); color: var(--ink); cursor: pointer;
  -webkit-appearance: none; appearance: none; background-color: var(--surface);
  background-image: linear-gradient(45deg, transparent 50%, var(--dim) 50%), linear-gradient(135deg, var(--dim) 50%, transparent 50%);
  background-position: calc(100% - 15px) 52%, calc(100% - 10px) 52%; background-size: 5px 5px; background-repeat: no-repeat;
}
#vps select:hover { border-color: var(--accent); }
#vps ol.steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: s; }
#vps ol.steps > li { counter-increment: s; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; }
#vps ol.steps > li::before {
  content: counter(s); font: 700 14px var(--display); width: 28px; height: 28px; border-radius: 50%;
  display: grid; place-items: center; border: 1.5px solid var(--accent); color: var(--ink); font-weight: 700;
}
#vps .steps h3 { margin: 2px 0 4px; font-size: 15px; font-weight: 700; }
#vps .steps p { margin: 0 0 6px; color: var(--dim); font-size: 14px; }
#vps code { font: 13px var(--mono); background: var(--code-bg); border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; }
#vps .btns { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 6px; }
#vps button.b {
  font: 600 14px var(--body); padding: 8px 14px; border-radius: 8px; cursor: pointer;
  border: 1px solid var(--accent); background: var(--accent); color: var(--accent-ink);
}
#vps button.b.ghost { background: transparent; color: var(--ink); }
#vps button:focus-visible, #vps input:focus-visible, #vps select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
#vps .quick { border: 1px solid var(--brand-red); background: var(--brand-red-soft); border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; }
#vps .quick h3 { margin: 0 0 4px; font-size: 15px; font-weight: 700; }
#vps .manual { border: 1px solid var(--brand-red); background: var(--brand-red-soft); border-radius: 10px; padding: 12px 14px; }
#vps .fade-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; }
#vps .manual > h3 { margin: 0 0 10px; font-size: 15px; font-weight: 700; }
#vps .sketch-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
#vps .sketch-head h3 { margin: 0; }
#vps .quick p { margin: 0 0 6px; color: var(--dim); font-size: 14px; }
#vps .pbar { margin-top: 10px; }
#vps .pbar-top { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--dim); margin-bottom: 4px; }
#vps .pbar-top b { color: var(--ink); font-weight: 600; }
#vps .pbar-top span:last-child { font: 500 12px var(--mono); font-variant-numeric: tabular-nums; }
#vps .pbar-track { height: 8px; border-radius: 4px; background: var(--line); overflow: hidden; position: relative; }
#vps .pbar-fill { height: 100%; width: 0; background: var(--accent); border-radius: 4px; transition: width .2s; }
#vps .pbar.busy .pbar-fill { width: 30% !important; position: absolute; animation: pslide 1.1s ease-in-out infinite; }
#vps .pbar.done .pbar-fill { background: var(--ok); }
#vps .pbar.failed .pbar-fill { background: var(--accent); }
#vps @keyframes pslide { from { left: -30%; }
#vps to { left: 100%; }
#vps }
@media (prefers-reduced-motion: reduce) { .pbar.busy .pbar-fill { animation: none; left: 0; width: 100% !important; opacity: .5; }
#vps }
.card-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
#vps .card-head h2 { margin-bottom: 0; }
#vps .card-head { margin-bottom: 14px; }
#vps .conn { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--dim); }
#vps .conn i { width: 9px; height: 9px; border-radius: 50%; background: var(--dim); opacity: .6; flex: none; }
#vps .conn[data-state="on"] { color: var(--ok); border-color: currentColor; }
#vps .conn[data-state="on"] i { background: var(--ok); opacity: 1; box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent); }
#vps .conn[data-state="busy"] { color: var(--warn); border-color: currentColor; }
#vps .conn[data-state="busy"] i { background: var(--warn); opacity: 1; animation: blink 1s infinite; }
#vps .conn[data-state="plugged"] { color: var(--ink); }
#vps .conn[data-state="plugged"] i { background: var(--warn); opacity: 1; }
#vps @keyframes blink { 50% { opacity: .3; }
#vps }
.status { font-size: 13px; margin-top: 6px; color: var(--dim); min-height: 1.4em; }
#vps .status.ok { color: var(--ok); }
#vps .status.warn { color: var(--warn); }
#vps .tablewrap { overflow-x: auto; }
#vps .wiring { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 4px; }
#vps .wiring th, #vps .wiring td { text-align: left; padding: 4px 10px 4px 0; border-bottom: 1px solid var(--line); white-space: nowrap; }
#vps .wiring th { color: var(--dim); font-weight: 700; }
#vps .wiring td { font-family: var(--mono); }
#vps .note { color: var(--dim); font-size: 13px; margin: 6px 0 0; border: 1px solid var(--accent); border-radius: 10px; padding: 6px 12px; background: transparent; }
#vps .boardpick { margin: 4px 0 10px; font-size: 14px; }
#vps .fadebox { display: grid; gap: 10px; border: 1px solid var(--brand-red); border-radius: 10px; padding: 12px; }
#vps .orient { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 13px; }
#vps .fadebox .chk { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
#vps .fadeopts { display: grid; gap: 12px; }
#vps .fadesets { display: grid; gap: 6px; }
#vps .fset { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; }
#vps .fset[aria-current="true"] { border-color: var(--accent); background: var(--accent-soft); }
#vps .fset .fname { font: 600 12px var(--mono); min-width: 3.6em; background: none; border: 0; padding: 0; color: var(--ink); cursor: pointer; text-align: left; }
#vps .fset .fmain { color: var(--dim); }
#vps .fset .chip { width: 22px; height: 16px; border-radius: 4px; border: 1px solid var(--line); display: inline-block; vertical-align: middle; }
#vps .fset .fdel { margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; color: var(--dim); font-size: 14px; line-height: 1; padding: 3px 8px; cursor: pointer; }
#vps button.b.small, #vps label.b.small { font-size: 13px; padding: 5px 10px; justify-self: start; }
#vps label.b { display: inline-block; font: 600 14px var(--body); padding: 8px 14px; border-radius: 8px; cursor: pointer; border: 1px solid var(--accent); }
#vps label.b.ghost { background: transparent; color: var(--ink); }
#vps label.b:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
#vps .vh { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
#vps .pics { display: grid; grid-template-columns: repeat(auto-fill, minmax(108px, 1fr)); gap: 10px; }
#vps .pic { display: grid; gap: 6px; padding: 8px; border: 1px solid var(--line); border-radius: 8px; font-size: 12px; }
#vps .pic canvas { width: 100%; height: auto; display: block; border-radius: 4px; background: #000; }
#vps .pic.round canvas { border-radius: 50%; }
#vps .pic .pname { font: 600 12px var(--mono); }
#vps .pic .pbtns { display: flex; gap: 6px; flex-wrap: wrap; }
#vps .pic button, #vps .scene button { background: none; border: 1px solid var(--line); border-radius: 6px; color: var(--dim); font-size: 12px; padding: 3px 7px; cursor: pointer; }
#vps .pic button:hover, #vps .scene button:hover { border-color: var(--accent); color: var(--accent); }
#vps .scenes { display: grid; gap: 6px; }
#vps .scene.editing { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
#vps .scene button.save { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
#vps .editbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; border: 2px solid var(--accent); border-radius: 10px; padding: 8px 12px; margin: 0 0 12px; font-size: 13px; }
#vps .editbar b { display: block; font-size: 14px; }
#vps .scene { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; }
#vps .scene .snum { font: 600 12px var(--mono); min-width: 1.6em; color: var(--dim); }
#vps .scene canvas { width: 34px; height: 34px; object-fit: cover; border-radius: 4px; background: #000; }
#vps .scene.round canvas { border-radius: 50%; }
#vps .scene .sgap { margin-left: auto; display: flex; gap: 4px; }
#vps .sub { font-size: 13px; font-weight: 700; margin: 4px 0 0; }
#vps .fadepresets { display: grid; gap: 6px; font-size: 13px; color: var(--dim); }
#vps .fadetime { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 13px; color: var(--dim); }
#vps .fadetime label { display: flex; align-items: center; gap: 6px; color: var(--ink); }
#vps .fadetime input { width: 64px; font: 14px var(--mono); padding: 4px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }
#vps .boardpick label { font-weight: 700; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
#vps .boardpick select { max-width: 100%; }
#vps .custompins { border: 1px dashed var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; }
#vps .pinrow { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 6px; font: 12px var(--mono); }
#vps .pinrow label { display: flex; align-items: center; gap: 6px; }
#vps .pinrow input { width: 56px; font: 13px var(--mono); padding: 3px 5px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }
#vps pre { margin: 0; background: var(--code-bg); border: 1px solid var(--line); border-radius: 10px; padding: 14px; overflow: auto; max-height: 420px; font: 12px/1.5 var(--mono); }
@media (prefers-reduced-motion: reduce) {
#vps, #vps * { transition: none !important; }
 }


#vps { color-scheme: light; border-radius: 16px; }
#vps .wrap { padding-block: 20px 32px; }
#vps button { text-transform: none; letter-spacing: normal; min-height: 0; box-shadow: none; }
#vps input[type=range] { padding: 0; border: 0; background: transparent; height: auto; box-shadow: none; }
#vps input[type=checkbox] { width: auto; height: auto; }
#vps label { margin: 0; }
#vps h2, #vps h3 { line-height: 1.3; }
#vps table { margin: 0; }
#vps pre { white-space: pre; }
#vps .wiring th, #vps .wiring td { border: 0; border-bottom: 1px solid var(--line); background: transparent; }
#vps canvas { max-width: 100%; }
#vps .grid { margin: 0; padding: 0; list-style: none; }
#vps .grid::before, #vps .grid::after, #vps .row::before, #vps .row::after { content: none; display: none; }
#vps label { font-weight: inherit; text-transform: none; letter-spacing: normal; }
#vps select { width: auto; max-width: 100%; }
#vps input[type=number] { width: 64px; margin: 0; }
#vps input[type=color] { margin: 0; min-height: 0; }
#vps h2 { margin-top: 0; }
</style>
<div id="vps">
<div class="wrap">
  <header>
    <a class="back" id="vps-backlink" href="#" hidden>← All displays</a>
    <h1 id="vps-studio-title">Display Studio</h1>
    <p class="sub" id="vps-studio-sub">Pick the kind of display you're making.</p>
